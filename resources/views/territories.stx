@extends('layouts/default')

@section('title', 'Territory Map - WildLoop')

@section('content')
<script server>
  /*
   * SEO for this page.
   *
   * `<script server>` because a crawler reads the HTML it is served and never
   * runs the client script — tags set after hydration are tags nobody indexes.
   * `useSeoMeta` rather than `useHead` because only the former reaches the
   * composed document head from a page. And written out here rather than
   * wrapped in a composable: the engine injects `useSeoMeta` into a page's own
   * script scope and not into a module it imports, where it is simply
   * undefined and the call fails without a word.
   *
   * URLs are absolute. A crawler resolves `og:image` against nothing, so a
   * relative path is dropped and the link previews as a bare URL.
   */
  useSeoMeta({
    title: 'Territory — WildLoop',
    description: 'Every closed loop you run claims the ground inside it. See who holds what, and what is being contested right now.',
    canonical: 'https://wildloop.org/territories',
    robots: 'index, follow, max-image-preview:large',
    ogTitle: 'Territory — WildLoop',
    ogDescription: 'Every closed loop you run claims the ground inside it. See who holds what, and what is being contested right now.',
    ogType: 'website',
    ogUrl: 'https://wildloop.org/territories',
    ogImage: 'https://wildloop.org/images/social/og-territory.jpg',
    ogSiteName: 'WildLoop',
    ogLocale: 'en_US',
    twitterCard: 'summary_large_image',
    twitterTitle: 'Territory — WildLoop',
    twitterDescription: 'Every closed loop you run claims the ground inside it. See who holds what, and what is being contested right now.',
    twitterImage: 'https://wildloop.org/images/social/og-territory.jpg',
  })
</script>

<script client>
  import { useTerritoryExplorer } from '../composables/useTerritoryExplorer'
  import { territoryError } from '../composables/useTerritoryCatalog'


  const wl = useStore('wl')
  const {
    filter,
    currentUserId,
    filtered,
    rankedLeaderboard,
    formatArea,
    mountTerritoryMap,
  } = useTerritoryExplorer(wl)

  onMount(() => mountTerritoryMap())
</script>

  <!-- Hero -->
  <section class="border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 pt-14 pb-12">
    <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-3 tracking-tight">Your territory map</h1>
      <p class="text-slate-600 dark:text-slate-400 max-w-xl mb-7 leading-relaxed">Green is yours. Orange belongs to someone else. Tap a zone, then hit Capture to run the lines that steal it.</p>
      <StxLink to="/record" class="inline-flex items-center gap-2 px-6 py-3 font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-full transition active:scale-[0.98]">
        <Icon name="play" size="18" />
        Start tracking
      </StxLink>
    </div>
  </section>

  <!-- API failure notice - otherwise an unreachable map silently shows stale seed data -->
  <div :if="territoryError" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-4">
    <div class="flex items-center gap-2 p-3 text-sm text-amber-800 dark:text-amber-300 bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-800/40 rounded-xl">
      <Icon name="alert-triangle" size="16" />
      <span>Showing saved territory data. We couldn't reach the live map. It'll refresh on your next visit.</span>
    </div>
  </div>

  <!-- Map -->
  <section class="-mt-8 mx-auto px-4 py-12 sm:px-6 lg:px-8 max-w-7xl">
    <div class="card p-0 overflow-hidden">
      <div id="territories-map" data-stx-ignore class="trail-map-panel ts-map-container"></div>
    </div>
  </section>

  <!-- Stats & Territories Grid -->
  <section class="mx-auto px-4 py-12 sm:px-6 lg:px-8 max-w-7xl">
    <div class="grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="flex items-center justify-between mb-6">
          <h2 class="font-display text-2xl font-bold text-gray-900 dark:text-white">Nearby Territories</h2>
          <div class="flex gap-2">
            <button @click="filter.set('all')" x-class="filter === 'all' ? 'text-emerald-600 bg-emerald-50' : 'text-gray-600 hover:bg-gray-100'" class="px-4 py-2 text-sm font-medium rounded-lg transition">All</button>
            <button @click="filter.set('mine')" x-class="filter === 'mine' ? 'text-emerald-600 bg-emerald-50' : 'text-gray-600 hover:bg-gray-100'" class="px-4 py-2 text-sm font-medium rounded-lg transition">Mine</button>
            <button @click="filter.set('contested')" x-class="filter === 'contested' ? 'text-emerald-600 bg-emerald-50' : 'text-gray-600 hover:bg-gray-100'" class="px-4 py-2 text-sm font-medium rounded-lg transition">Contested</button>
          </div>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          <template :for="territory in filtered">
            <StxLink x-to="'/territory/' + territory.id" class="card block hover:shadow-md transition">
              <div class="flex items-center justify-between mb-3">
                <h3 class="font-bold dark:text-white">{{ territory.name }}</h3>
                <span class="px-2 py-0.5 text-xs rounded-full font-medium" x-class="territory.user_id === currentUserId() ? 'bg-emerald-100 text-emerald-700' : territory.status === 'contested' ? 'bg-red-100 text-red-700' : 'bg-gray-100 text-gray-700'">{{ territory.user_id === currentUserId() ? 'Yours' : territory.status === 'contested' ? 'Contested' : 'Enemy' }}</span>
              </div>
              <div class="grid grid-cols-3 gap-2 text-center pt-3 border-t border-gray-100 dark:border-slate-700">
                <div>
                  <p class="font-bold text-sm text-emerald-600">{{ formatArea(territory.areaSize) }}</p>
                  <p class="metric-label">Size</p>
                </div>
                <div>
                  <p class="font-bold text-sm dark:text-white">{{ territory.conquestCount }}</p>
                  <p class="metric-label">Conquests</p>
                </div>
                <div>
                  <p class="font-bold text-sm dark:text-white">{{ territory.defendCount }}</p>
                  <p class="metric-label">Defenses</p>
                </div>
              </div>
            </StxLink>
          </template>

          <div :if="filtered().length === 0" class="col-span-2 py-16 text-center">
            <div class="w-20 h-20 mx-auto mb-6 bg-emerald-100 dark:bg-emerald-900/20 rounded-2xl flex items-center justify-center">
              <Icon name="map" size="40" class="text-emerald-400" />
            </div>
            <h3 class="text-lg font-semibold dark:text-white mb-2">No territories yet</h3>
            <p class="text-gray-500 dark:text-slate-400 max-w-sm mx-auto mb-6">Run a closed loop to claim your first territory.</p>
            <StxLink to="/record" class="px-6 py-2.5 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Start a Run</StxLink>
          </div>
        </div>
      </div>

      <!-- Sidebar: leaderboard -->
      <div class="space-y-6">
        <div class="card">
          <h3 class="flex items-center gap-2 font-bold text-lg dark:text-white mb-4">
            <Icon name="trophy" size="18" class="text-yellow-500" />
            Territory Leaders
          </h3>
          <div class="space-y-2">
            <template :for="entry in rankedLeaderboard">
              <div class="flex items-center gap-3 p-2 rounded-lg" x-class="entry.user_id === currentUserId() ? 'bg-emerald-50 dark:bg-emerald-900/10' : ''">
                <span class="w-6 text-center font-bold" x-class="entry.rank <= 3 ? 'text-yellow-500' : 'text-gray-400'">{{ entry.rank }}</span>
                <div class="flex-1 min-w-0">
                  <p class="font-medium text-sm dark:text-white truncate">{{ entry.user_id === currentUserId() ? 'You' : entry.userName }}</p>
                  <p class="text-xs text-gray-500">{{ formatArea(entry.totalAreaOwned) }}</p>
                </div>
                <span class="text-xs font-semibold text-gray-600 dark:text-slate-400">{{ entry.totalTerritoriesOwned + ' owned' }}</span>
              </div>
            </template>
            <div :if="rankedLeaderboard().length === 0" class="py-6 text-center text-sm text-gray-500 dark:text-slate-400">
              No territory leaders yet. Claim a zone to get on the board.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
@endsection
