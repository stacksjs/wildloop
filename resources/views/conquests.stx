@extends('layouts/default')

@section('title', 'Conquests - Wildloop')

@section('content')
<script server>
  /*
   * Page metadata, in `<script server>` so it is in the HTML a crawler is
   * served rather than something only hydration produces. See athletes.stx for
   * the full reasoning; the short version is that `useSeoMeta` is the only one
   * of the head helpers that reaches the composed document head from a page,
   * and it has to be written inline because the engine injects it into the
   * page's own scope and not into a module it imports.
   */
  useSeoMeta({
    title: 'Your Conquests — Wildloop',
    description: 'Every territory you have taken, and every attempt on the ground you hold.',
    robots: 'noindex, nofollow',
  })
</script>

<script client>
  import { avatarUrl } from '../functions/avatars'
  useHead({ title: 'Your Conquests — Wildloop' })

  const wl = useStore('wl')
  const filter = state<'all' | 'attacks' | 'defenses' | 'lost'>('all')

  const conquestStats = derived(() => wl?.conquestStats())
  // Signed out, `conquestStats` is the seeded fixture — nobody's record, shown
  // as the visitor's own. Only a signed-in athlete gets the counters.
  const signedIn = derived(() => Boolean(wl && wl.currentUserId() > 0))
  const currentUserId = derived(() => wl?.currentUserId())

  const filtered = derived(() => {
    if (!wl) return []
    const f = filter()
    const uid = wl.currentUserId()
    if (f === 'all') return wl.conquests()
    if (f === 'attacks') return wl.conquests().filter((c: any) => c.attacker_id === uid)
    if (f === 'defenses') return wl.conquests().filter((c: any) => c.defender_id === uid)
    return wl.conquests().filter((c: any) => c.defender_id === uid && c.status === 'conquered')
  })

  function photoOf(avatar: string | null | undefined): string {
    return avatarUrl(avatar ?? null)
  }

  const underAttack = derived(() =>
    wl ? wl.conquests().filter((c: any) => c.defender_id === wl.currentUserId() && c.status === 'active').slice(0, 5) : []
  )
</script>

  <!-- Hero -->
  <section class="border-b border-slate-200 bg-white pb-8 pt-8 sm:pb-10 sm:pt-12 dark:border-slate-800 dark:bg-slate-950">
    <div class="mx-auto flex max-w-6xl flex-col gap-5 px-4 sm:flex-row sm:items-end sm:justify-between sm:px-6 lg:px-8">
      <div class="min-w-0">
        <h1 class="font-display text-3xl font-bold tracking-tight text-slate-900 md:text-4xl dark:text-white">Your conquests</h1>
        <p class="mt-2 max-w-xl leading-relaxed text-slate-600 dark:text-slate-400">Track every territory you have taken, and every attempt on the ground you hold.</p>
      </div>
      <div class="flex shrink-0 gap-2">
        <StxLink to="/territories" class="inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-full bg-emerald-600 px-5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 active:scale-[0.98] sm:flex-none">
          <i class="i-lucide-map h-4 w-4" aria-hidden="true"></i>View map
        </StxLink>
        <StxLink to="/record" class="inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-full border border-slate-300 px-5 text-sm font-semibold text-slate-900 transition hover:bg-slate-50 active:scale-[0.98] sm:flex-none dark:border-slate-700 dark:text-white dark:hover:bg-slate-900">
          <i class="i-lucide-play h-4 w-4" aria-hidden="true"></i>Start tracking
        </StxLink>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 pb-12 pt-6 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <!-- Stats -->
        <dl :if="signedIn && conquestStats" class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
            <dt class="flex items-center gap-1.5 metric-label"><i class="i-lucide-swords h-3.5 w-3.5 text-orange-500" aria-hidden="true"></i>Conquered</dt>
            <dd class="mt-1 font-display text-2xl font-bold tabular-nums text-slate-900 dark:text-white">{{ conquestStats.totalConquests }}</dd>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
            <dt class="flex items-center gap-1.5 metric-label"><i class="i-lucide-flag-off h-3.5 w-3.5 text-red-500" aria-hidden="true"></i>Lost</dt>
            <dd class="mt-1 font-display text-2xl font-bold tabular-nums text-slate-900 dark:text-white">{{ conquestStats.territoriesLost }}</dd>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
            <dt class="flex items-center gap-1.5 metric-label"><i class="i-lucide-shield h-3.5 w-3.5 text-emerald-500" aria-hidden="true"></i>Defended</dt>
            <dd class="mt-1 font-display text-2xl font-bold tabular-nums text-slate-900 dark:text-white">{{ conquestStats.successfulDefenses }}</dd>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
            <dt class="flex items-center gap-1.5 metric-label"><i class="i-lucide-percent h-3.5 w-3.5 text-slate-400" aria-hidden="true"></i>Win rate</dt>
            <dd class="mt-1 font-display text-2xl font-bold tabular-nums text-slate-900 dark:text-white">{{ conquestStats.winRate + '%' }}</dd>
          </div>
        </dl>

        <h2 class="mb-3 font-display text-xl font-bold text-slate-900 dark:text-white">Battle log</h2>

        <div class="-mx-4 mb-5 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] sm:mx-0 sm:px-0">
          <button @click="filter.set('all')" x-class="filter === 'all' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900' : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'" class="min-h-10 shrink-0 whitespace-nowrap rounded-full px-4 text-sm font-semibold transition active:scale-[0.98]">All</button>
          <button @click="filter.set('attacks')" x-class="filter === 'attacks' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900' : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'" class="min-h-10 shrink-0 whitespace-nowrap rounded-full px-4 text-sm font-semibold transition active:scale-[0.98]">My attacks</button>
          <button @click="filter.set('defenses')" x-class="filter === 'defenses' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900' : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'" class="min-h-10 shrink-0 whitespace-nowrap rounded-full px-4 text-sm font-semibold transition active:scale-[0.98]">Defenses</button>
          <button @click="filter.set('lost')" x-class="filter === 'lost' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900' : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'" class="min-h-10 shrink-0 whitespace-nowrap rounded-full px-4 text-sm font-semibold transition active:scale-[0.98]">Lost</button>
        </div>

        <ol :if="filtered.length > 0" class="divide-y divide-slate-100 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:divide-slate-700/70 dark:border-slate-700 dark:bg-slate-800 dark:shadow-none">
          <template :for="conquest in filtered">
            <li class="flex items-start gap-3 px-4 py-4">
              <div class="grid h-11 w-11 shrink-0 place-items-center rounded-xl" x-class="conquest.attacker_id === currentUserId ? 'bg-orange-50 text-orange-600 dark:bg-orange-500/15 dark:text-orange-400' : conquest.status === 'defended' ? 'bg-emerald-50 text-emerald-600 dark:bg-emerald-500/15 dark:text-emerald-400' : 'bg-red-50 text-red-600 dark:bg-red-500/15 dark:text-red-400'">
                <Icon :if="conquest.attacker_id === currentUserId" name="swords" size="20" />
                <Icon :if="conquest.attacker_id !== currentUserId" name="shield" size="20" />
              </div>
              <div class="min-w-0 flex-1">
                <div class="mb-1 flex flex-wrap items-center gap-2">
                  <span class="rounded-full px-2 py-0.5 text-[11px] font-semibold" x-class="conquest.attacker_id === currentUserId ? 'bg-orange-100 text-orange-700 dark:bg-orange-500/15 dark:text-orange-300' : conquest.status === 'defended' ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300' : 'bg-red-100 text-red-700 dark:bg-red-500/15 dark:text-red-300'">{{ conquest.attacker_id === currentUserId ? 'Attack' : conquest.status === 'defended' ? 'Defended' : 'Conquered' }}</span>
                  <span class="text-xs text-slate-500 dark:text-slate-400">{{ wl.timeAgo(conquest.created_at) }}</span>
                </div>
                <p class="font-semibold leading-snug text-slate-900 dark:text-white">
                  <span>{{ conquest.attacker_id === currentUserId ? 'You conquered' : conquest.attackerName + ' attacked' }}</span>
                  <StxLink x-to="'/territory/' + conquest.territory_id" class="text-emerald-700 hover:underline dark:text-emerald-400">{{ ' ' + conquest.territoryName }}</StxLink>
                </p>
                <p :if="conquest.description" class="mt-1 text-sm text-slate-500 dark:text-slate-400">{{ conquest.description }}</p>
              </div>
            </li>
          </template>
        </ol>

        <div :if="filtered.length === 0" class="rounded-2xl border border-dashed border-slate-300 px-6 py-14 text-center dark:border-slate-700">
          <div class="mx-auto mb-5 grid h-16 w-16 place-items-center rounded-2xl bg-emerald-50 dark:bg-emerald-500/10">
            <Icon name="flame" size="30" class="text-emerald-600 dark:text-emerald-400" />
          </div>
          <h3 class="text-lg font-semibold text-slate-900 dark:text-white">No conquests yet</h3>
          <p class="mx-auto mt-1 max-w-sm text-slate-500 dark:text-slate-400">Find a territory on the map and run through it.</p>
          <StxLink to="/territories" class="mt-6 inline-flex min-h-11 items-center rounded-full bg-emerald-600 px-6 text-sm font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98]">Find territories</StxLink>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:shadow-none">
          <h3 class="mb-3 font-semibold text-slate-900 dark:text-white">Empire status</h3>
          <p :if="!signedIn" class="text-sm text-slate-500 dark:text-slate-400">Sign in to see your power rating, streaks and rivals beaten.</p>
          <dl :if="signedIn && conquestStats" class="divide-y divide-slate-100 dark:divide-slate-700/70">
            <div class="flex min-h-11 items-center justify-between">
              <dt class="text-sm text-slate-600 dark:text-slate-400">Power rating</dt>
              <dd class="font-display text-lg font-bold tabular-nums text-emerald-700 dark:text-emerald-400">{{ conquestStats.powerRating }}</dd>
            </div>
            <div class="flex min-h-11 items-center justify-between">
              <dt class="text-sm text-slate-600 dark:text-slate-400">Longest streak</dt>
              <dd class="font-semibold tabular-nums text-slate-900 dark:text-white">{{ conquestStats.longestConquestStreak === 1 ? '1 win' : conquestStats.longestConquestStreak + ' wins' }}</dd>
            </div>
            <div class="flex min-h-11 items-center justify-between">
              <dt class="text-sm text-slate-600 dark:text-slate-400">Rivals beaten</dt>
              <dd class="font-semibold tabular-nums text-slate-900 dark:text-white">{{ conquestStats.uniqueRivalsBeaten }}</dd>
            </div>
          </dl>
        </section>

        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:shadow-none">
          <h3 class="mb-3 flex items-center gap-2 font-semibold text-slate-900 dark:text-white">
            <span class="h-2 w-2 animate-pulse rounded-full bg-red-500"></span>
            Under attack
          </h3>
          <div class="space-y-2">
            <template :for="conquest in underAttack">
              <div class="flex items-center gap-3 rounded-xl bg-red-50 p-3 dark:bg-red-500/10">
                <Image :if="photoOf(conquest.attackerAvatar)" x-src="photoOf(conquest.attackerAvatar)" x-alt="conquest.attackerName" width="36" height="36" sizes="36px" loading="lazy" class="h-9 w-9 shrink-0 rounded-full object-cover" />
                <div :if="!photoOf(conquest.attackerAvatar)" class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-red-100 text-xs font-bold text-red-700 dark:bg-red-500/20 dark:text-red-300" aria-hidden="true">{{ conquest.attackerName.charAt(0) }}</div>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">{{ conquest.attackerName }}</p>
                  <p class="truncate text-xs text-red-600 dark:text-red-400">{{ 'Targeting ' + conquest.territoryName }}</p>
                </div>
                <StxLink x-to="'/territory/' + conquest.territory_id" class="inline-flex min-h-9 shrink-0 items-center rounded-full bg-red-600 px-3 text-xs font-semibold text-white transition hover:bg-red-700">Defend</StxLink>
              </div>
            </template>
            <div :if="underAttack.length === 0" class="flex items-center gap-2 rounded-xl bg-slate-50 px-3 py-3 text-sm text-slate-500 dark:bg-slate-900/60 dark:text-slate-400">
              <i class="i-lucide-shield-check h-4 w-4 text-emerald-500" aria-hidden="true"></i>
              No active threats.
            </div>
          </div>
        </section>
      </aside>
    </div>
  </div>
@endsection
