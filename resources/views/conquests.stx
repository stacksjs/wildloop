@extends('layouts/default')

@section('title', 'Conquests - WildLoop')

@section('content')
<script server>
  /*
   * Page metadata, in `<script server>` so it is in the HTML a crawler is
   * served rather than something only hydration produces. See athletes.stx for
   * the full reasoning; the short version is that `useSeoMeta` is the only one
   * of the head helpers that reaches the composed document head from a page,
   * and it has to be written inline because the engine injects it into the
   * page's own scope and not into a module it imports.
   */
  useSeoMeta({
    title: 'Your Conquests — WildLoop',
    description: 'Every territory you have taken, and every attempt on the ground you hold.',
    robots: 'noindex, nofollow',
  })
</script>

<script client>
  useHead({ title: 'Your Conquests — WildLoop' })

  const wl = useStore('wl')
  const filter = state<'all' | 'attacks' | 'defenses' | 'lost'>('all')

  const conquestStats = derived(() => wl?.conquestStats())
  const currentUserId = derived(() => wl?.currentUserId())

  const filtered = derived(() => {
    if (!wl) return []
    const f = filter()
    const uid = wl.currentUserId()
    if (f === 'all') return wl.conquests()
    if (f === 'attacks') return wl.conquests().filter((c: any) => c.attacker_id === uid)
    if (f === 'defenses') return wl.conquests().filter((c: any) => c.defender_id === uid)
    return wl.conquests().filter((c: any) => c.defender_id === uid && c.status === 'conquered')
  })

  const underAttack = derived(() =>
    wl ? wl.conquests().filter((c: any) => c.defender_id === wl.currentUserId() && c.status === 'active').slice(0, 5) : []
  )
</script>

  <!-- Hero -->
  <section class="border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 pt-14 pb-12">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
      <h1 class="mb-3 font-bold font-display text-3xl text-slate-900 dark:text-white md:text-4xl tracking-tight">Your conquests</h1>
      <p class="mb-7 max-w-xl text-slate-600 dark:text-slate-400 leading-relaxed">Track every territory you have taken, and every attempt on the ground you hold.</p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <StxLink to="/territories" class="px-6 py-3 text-center font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-full transition active:scale-[0.98]">View map</StxLink>
        <StxLink to="/record" class="px-6 py-3 text-center font-semibold text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-900 rounded-full transition active:scale-[0.98]">Start tracking</StxLink>
      </div>
    </div>
  </section>

  <div class="mx-auto px-4 py-8 sm:px-6 lg:px-8 max-w-7xl">
    <div class="grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <!-- Stats -->
        <div :if="conquestStats" class="grid gap-4 grid-cols-2 sm:grid-cols-4 mb-8">
          <div class="text-center card">
            <p class="font-bold text-2xl text-orange-600">{{ conquestStats.totalConquests }}</p>
            <p class="metric-label">Conquered</p>
          </div>
          <div class="text-center card">
            <p class="font-bold text-2xl text-red-600">{{ conquestStats.territoriesLost }}</p>
            <p class="metric-label">Lost</p>
          </div>
          <div class="text-center card">
            <p class="font-bold text-2xl text-emerald-600">{{ conquestStats.successfulDefenses }}</p>
            <p class="metric-label">Defended</p>
          </div>
          <div class="text-center card">
            <p class="font-bold text-2xl text-blue-600">{{ conquestStats.winRate + '%' }}</p>
            <p class="metric-label">Win Rate</p>
          </div>
        </div>

        <h2 class="font-bold font-display text-2xl text-gray-900 dark:text-white mb-6">Battle Log</h2>

        <div class="flex gap-2 mb-6 overflow-x-auto pb-2">
          <button @click="filter.set('all')" x-class="filter === 'all' ? 'bg-orange-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 font-medium text-sm whitespace-nowrap rounded-lg transition">All</button>
          <button @click="filter.set('attacks')" x-class="filter === 'attacks' ? 'bg-orange-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 font-medium text-sm whitespace-nowrap rounded-lg transition">My Attacks</button>
          <button @click="filter.set('defenses')" x-class="filter === 'defenses' ? 'bg-orange-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 font-medium text-sm whitespace-nowrap rounded-lg transition">Defenses</button>
          <button @click="filter.set('lost')" x-class="filter === 'lost' ? 'bg-orange-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 font-medium text-sm whitespace-nowrap rounded-lg transition">Lost</button>
        </div>

        <div class="space-y-4">
          <template :for="conquest in filtered">
            <div class="card">
              <div class="flex gap-4 items-start">
                <div class="flex items-center justify-center shrink-0 h-12 w-12 rounded-xl" x-class="conquest.attacker_id === currentUserId ? 'bg-orange-100 dark:bg-orange-900/20 text-orange-600' : 'bg-red-100 dark:bg-red-900/20 text-red-600'">
                  <Icon :if="conquest.attacker_id === currentUserId" name="swords" size="20" />
                  <Icon :if="conquest.attacker_id !== currentUserId" name="shield" size="20" />
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex gap-2 items-center mb-1">
                    <span class="px-2 py-0.5 font-semibold text-xs rounded-full" x-class="conquest.attacker_id === currentUserId ? 'bg-orange-100 text-orange-700' : conquest.status === 'defended' ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700'">{{ conquest.attacker_id === currentUserId ? 'ATTACK' : conquest.status === 'defended' ? 'DEFENDED' : 'CONQUERED' }}</span>
                    <span class="text-xs text-gray-500 dark:text-slate-400">{{ wl.timeAgo(conquest.created_at) }}</span>
                  </div>
                  <p class="font-semibold text-gray-900 dark:text-white">
                    <span>{{ conquest.attacker_id === currentUserId ? 'You conquered' : conquest.attackerName + ' attacked' }}</span>
                    <StxLink x-to="'/territory/' + conquest.territory_id" class="text-emerald-600 hover:underline">{{ ' ' + conquest.territoryName }}</StxLink>
                  </p>
                  <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">{{ conquest.description }}</p>
                </div>
              </div>
            </div>
          </template>

          <div :if="filtered.length === 0" class="py-20 text-center">
            <div class="w-20 h-20 mx-auto mb-6 bg-orange-100 dark:bg-orange-900/20 rounded-2xl flex items-center justify-center">
              <Icon name="flame" size="40" class="text-orange-400" />
            </div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">No conquests yet</h3>
            <p class="text-gray-500 dark:text-slate-400 max-w-sm mx-auto mb-6">Find a territory on the map and run through it.</p>
            <StxLink to="/territories" class="px-6 py-2.5 bg-orange-600 text-white text-sm font-semibold rounded-lg hover:bg-orange-700 transition">Find Territories</StxLink>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <div class="card">
          <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-4">Empire Status</h3>
          <div :if="conquestStats" class="space-y-3">
            <div class="flex items-center justify-between p-3 bg-orange-50 dark:bg-orange-900/10 rounded-xl">
              <span class="text-sm text-gray-600 dark:text-slate-400">Power Rating</span>
              <span class="font-bold text-orange-600">{{ conquestStats.powerRating }}</span>
            </div>
            <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-slate-700/50 rounded-xl">
              <span class="text-sm text-gray-600 dark:text-slate-400">Longest Streak</span>
              <span class="font-bold dark:text-white">{{ conquestStats.longestConquestStreak + ' wins' }}</span>
            </div>
            <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-slate-700/50 rounded-xl">
              <span class="text-sm text-gray-600 dark:text-slate-400">Rivals Beaten</span>
              <span class="font-bold dark:text-white">{{ conquestStats.uniqueRivalsBeaten }}</span>
            </div>
          </div>
        </div>

        <div class="card">
          <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-4 flex items-center">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse mr-2"></span>
            Under Attack
          </h3>
          <div class="space-y-3">
            <template :for="conquest in underAttack">
              <div class="flex items-center gap-3 p-3 bg-red-50 dark:bg-red-900/10 rounded-xl">
                <div class="w-8 h-8 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center text-red-600 text-xs font-bold">{{ conquest.attackerName.charAt(0) }}</div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-gray-900 dark:text-white truncate">{{ conquest.attackerName }}</p>
                  <p class="text-xs text-red-600">{{ 'Targeting ' + conquest.territoryName }}</p>
                </div>
                <StxLink x-to="'/territory/' + conquest.territory_id" class="text-xs px-2 py-1 bg-red-600 text-white rounded-lg hover:bg-red-700 transition font-medium">Defend</StxLink>
              </div>
            </template>
            <div :if="underAttack.length === 0" class="text-center py-6 text-gray-400 dark:text-slate-500 text-sm">
              <p>No active threats.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
@endsection
