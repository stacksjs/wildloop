@extends('layouts/default')

@section('title', 'Training Stats - WildLoop')

@section('content')
<script server>
  /*
   * Page metadata, in `<script server>` so it is in the HTML a crawler is
   * served rather than something only hydration produces. See athletes.stx for
   * the full reasoning; the short version is that `useSeoMeta` is the only one
   * of the head helpers that reaches the composed document head from a page,
   * and it has to be written inline because the engine injects it into the
   * page's own scope and not into a module it imports.
   */
  useSeoMeta({
    title: 'Training Stats — WildLoop',
    description: 'Your training volume, elevation and streaks on WildLoop.',
    robots: 'noindex, nofollow',
  })
</script>

<script client>
  useHead({ title: 'Training Stats — WildLoop' })

  const wl = useStore('wl')
  const period = state<'weekly' | 'monthly' | 'alltime'>('weekly')

  const myActivities = derived(() => wl ? wl.activities().filter((a: any) => a.user_id === wl.currentUserId()) : [])
  const userStats = derived(() => wl?.userStats())

  const maxWeeklyDistance = derived(() => {
    const hist = wl?.userStats()?.weeklyHistory || []
    return Math.max(...hist.map((w: any) => w.distance), 1)
  })
</script>

  <div class="mx-auto px-4 py-6 sm:px-6 lg:px-8 max-w-5xl">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="font-bold text-2xl dark:text-white">Training Stats</h1>
        <p class="mt-1 text-gray-500 text-sm dark:text-slate-400">Your performance at a glance</p>
      </div>
      <div class="flex gap-2">
        <button @click="period.set('weekly')" x-class="period === 'weekly' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium transition">Weekly</button>
        <button @click="period.set('monthly')" x-class="period === 'monthly' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium transition">Monthly</button>
        <button @click="period.set('alltime')" x-class="period === 'alltime' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium transition">All Time</button>
      </div>
    </div>

    <div :if="userStats">
      <!-- Summary cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
        <div class="card text-center">
          <p class="text-3xl font-bold text-emerald-600">{{ period === 'weekly' ? userStats.weeklyDistance : period === 'monthly' ? userStats.monthlyDistance : userStats.totalDistance }}</p>
          <p class="metric-label">Miles</p>
        </div>
        <div class="card text-center">
          <p class="text-3xl font-bold text-blue-600">{{ (period === 'weekly' ? userStats.weeklyElevation : period === 'monthly' ? userStats.monthlyElevation : userStats.totalElevation).toLocaleString() }}</p>
          <p class="metric-label">Elev (ft)</p>
        </div>
        <div class="card text-center">
          <p class="text-3xl font-bold text-orange-600">{{ period === 'weekly' ? userStats.weeklyActivities : userStats.totalActivities }}</p>
          <p class="metric-label">Activities</p>
        </div>
        <div class="card text-center">
          <p class="text-3xl font-bold text-purple-600">{{ userStats.currentStreak }}</p>
          <p class="metric-label">Day Streak</p>
          <p class="text-xs text-purple-500 mt-1">{{ 'Best: ' + userStats.longestStreak + ' days' }}</p>
        </div>
      </div>

      <!-- Weekly distance chart -->
      <div class="card mb-8">
        <h2 class="font-bold text-lg text-gray-900 dark:text-white mb-6">Weekly Distance</h2>
        <div :if="userStats.weeklyHistory.length > 0" class="flex items-end gap-3 h-40">
          <template :for="(week, i) in userStats.weeklyHistory">
            <div class="flex-1 flex flex-col items-center gap-2">
              <span class="text-xs font-semibold dark:text-white">{{ week.distance.toFixed(1) }}</span>
              <div class="w-full rounded-t-lg transition-all duration-500" x-class="i === userStats.weeklyHistory.length - 1 ? 'bg-emerald-500' : 'bg-emerald-200 dark:bg-emerald-800'" x-style="'height: ' + (week.distance / maxWeeklyDistance * 100) + '%'"></div>
              <span class="text-xs text-gray-500 dark:text-slate-400 whitespace-nowrap">{{ week.week }}</span>
            </div>
          </template>
        </div>
        <div :if="userStats.weeklyHistory.length === 0" class="h-40 flex flex-col items-center justify-center text-center">
          <Icon name="bar-chart-3" size="28" class="text-gray-300 dark:text-slate-600 mb-2" />
          <p class="text-sm text-gray-500 dark:text-slate-400">Not enough activity this period yet. Log a few runs to see your weekly trend.</p>
        </div>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 mb-8">
        <!-- Personal Records -->
        <div class="card">
          <h2 class="flex items-center gap-2 font-bold text-lg text-gray-900 dark:text-white mb-4">
            <Icon name="trophy" size="20" class="text-yellow-500" />
            Personal Records
          </h2>
          <div class="space-y-3">
            <div class="flex items-center justify-between p-3 bg-yellow-50 dark:bg-yellow-900/10 rounded-xl">
              <span class="flex items-center gap-2 text-sm text-gray-600 dark:text-slate-400">
                <Icon name="zap" size="16" class="text-yellow-500" />
                Fastest Mile
              </span>
              <span class="font-bold text-gray-900 dark:text-white">{{ userStats.personalRecords.fastestMile + ' /mi' }}</span>
            </div>
            <div class="flex items-center justify-between p-3 bg-emerald-50 dark:bg-emerald-900/10 rounded-xl">
              <span class="flex items-center gap-2 text-sm text-gray-600 dark:text-slate-400">
                <Icon name="footprints" size="16" class="text-emerald-500" />
                Longest Run
              </span>
              <span class="font-bold text-gray-900 dark:text-white">{{ userStats.personalRecords.longestRun + ' mi' }}</span>
            </div>
            <div class="flex items-center justify-between p-3 bg-blue-50 dark:bg-blue-900/10 rounded-xl">
              <span class="flex items-center gap-2 text-sm text-gray-600 dark:text-slate-400">
                <Icon name="mountain" size="16" class="text-blue-500" />
                Biggest Climb
              </span>
              <span class="font-bold text-gray-900 dark:text-white">{{ userStats.personalRecords.biggestClimb.toLocaleString() + ' ft' }}</span>
            </div>
            <div class="flex items-center justify-between p-3 bg-orange-50 dark:bg-orange-900/10 rounded-xl">
              <span class="flex items-center gap-2 text-sm text-gray-600 dark:text-slate-400">
                <Icon name="flame" size="16" class="text-orange-500" />
                Longest Streak
              </span>
              <span class="font-bold text-gray-900 dark:text-white">{{ userStats.personalRecords.longestStreak + ' days' }}</span>
            </div>
          </div>
        </div>

        <!-- Activity Breakdown -->
        <div class="card">
          <h2 class="font-bold text-lg text-gray-900 dark:text-white mb-4">Activity Breakdown</h2>
          <div class="space-y-4">
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm text-gray-600 dark:text-slate-400">Trail Runs</span>
                <span class="text-sm font-medium dark:text-white">{{ myActivities.filter((a) => a.activityType === 'Trail Run').length + ' activities' }}</span>
              </div>
              <div class="h-2 bg-gray-200 dark:bg-slate-700 rounded-full overflow-hidden">
                <div class="h-full bg-emerald-500 rounded-full" x-style="'width: ' + (myActivities.filter((a) => a.activityType === 'Trail Run').length / Math.max(myActivities.length, 1) * 100) + '%'"></div>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm text-gray-600 dark:text-slate-400">Hikes</span>
                <span class="text-sm font-medium dark:text-white">{{ myActivities.filter((a) => a.activityType === 'Hike').length + ' activities' }}</span>
              </div>
              <div class="h-2 bg-gray-200 dark:bg-slate-700 rounded-full overflow-hidden">
                <div class="h-full bg-blue-500 rounded-full" x-style="'width: ' + (myActivities.filter((a) => a.activityType === 'Hike').length / Math.max(myActivities.length, 1) * 100) + '%'"></div>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm text-gray-600 dark:text-slate-400">Walks</span>
                <span class="text-sm font-medium dark:text-white">{{ myActivities.filter((a) => a.activityType === 'Walk').length + ' activities' }}</span>
              </div>
              <div class="h-2 bg-gray-200 dark:bg-slate-700 rounded-full overflow-hidden">
                <div class="h-full bg-purple-500 rounded-full" x-style="'width: ' + (myActivities.filter((a) => a.activityType === 'Walk').length / Math.max(myActivities.length, 1) * 100) + '%'"></div>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm text-gray-600 dark:text-slate-400">Bike Rides</span>
                <span class="text-sm font-medium dark:text-white">{{ myActivities.filter((a) => a.activityType === 'Bike').length + ' activities' }}</span>
              </div>
              <div class="h-2 bg-gray-200 dark:bg-slate-700 rounded-full overflow-hidden">
                <div class="h-full bg-orange-500 rounded-full" x-style="'width: ' + (myActivities.filter((a) => a.activityType === 'Bike').length / Math.max(myActivities.length, 1) * 100) + '%'"></div>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-gray-100 dark:border-slate-700 space-y-2 text-sm">
            <div class="flex justify-between"><span class="text-gray-500 dark:text-slate-400">Total Time</span><span class="font-bold dark:text-white">{{ userStats.totalTime }}</span></div>
            <div class="flex justify-between"><span class="text-gray-500 dark:text-slate-400">Avg Pace</span><span class="font-bold dark:text-white">{{ userStats.avgPace }}</span></div>
            <div class="flex justify-between"><span class="text-gray-500 dark:text-slate-400">Total Calories</span><span class="font-bold dark:text-white">{{ userStats.totalCalories.toLocaleString() }}</span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Empty state -->
    <div :if="!userStats" class="py-20 text-center">
      <div class="w-20 h-20 mx-auto mb-6 bg-purple-100 dark:bg-purple-900/20 rounded-2xl flex items-center justify-center">
        <Icon name="bar-chart-3" size="40" class="text-purple-400" />
      </div>
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">No stats to show</h3>
      <p class="text-gray-500 dark:text-slate-400 max-w-sm mx-auto mb-6">Record some activities and your training stats will appear here.</p>
      <StxLink to="/record" class="px-6 py-2.5 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Record Activity</StxLink>
    </div>
  </div>
@endsection
