@extends('layouts/default')

@section('title', 'Athlete - Wildloop')

@section('content')
<script client>
  import { fetchAthlete, reportContent, toggleBlock, toggleFollow } from '../../assets/scripts/game-api'
  import { fetchRecords } from '../../assets/scripts/records-api'
  import { readRouteParam } from '../../composables/useRouteParam'
  import { recordTitle, setPageSeo } from '../../composables/usePageSeo'
  import { CATEGORY_LABELS, STYLE_LABELS } from '../../functions/route-records'

  useHead({ title: 'Athlete - Wildloop' })

  const wl = useStore('wl')
  const profile = state<any>(null)
  const loading = state(true)
  const loadError = state(false)
  const safetyOpen = state(false)
  const reportReason = state('harassment')
  const safetyMessage = state<string | null>(null)

  // -1 is a no-match sentinel so an unresolved param renders "not found"
  // rather than silently loading athlete 0/1 (#987).
  const athleteId = readRouteParam('id') ?? -1

  const isSelf = derived(() => !!wl && athleteId === wl.currentUserId())
  const isFollowing = derived(() => !!wl && wl.isFollowing(athleteId))

  async function loadAthlete() {
    loading.set(true)
    loadError.set(false)
    try {
      // A null result means "no such athlete" (404); a thrown error means the
      // request itself failed - surface those as different states so a network
      // blip doesn't masquerade as a permanent "not found".
      const data = await fetchAthlete(athleteId)
      profile.set(data)
    }
    catch {
      loadError.set(true)
    }
    loading.set(false)
  }

  // This athlete's verified records. Separate from the profile payload
  // because it is a different question - "what have they held" rather than
  // "what have they run" - and a profile that has none should not pay for the
  // join on every load.
  const records = state<any[]>([])

  async function loadRecords() {
    const result = await fetchRecords({ userId: athleteId, status: 'verified', limit: 20 })
    records.set(result?.efforts ?? [])
  }

  onMount(() => {
    void loadAthlete()
    void loadRecords()
  })

  function styleLabel(style: string) {
    return STYLE_LABELS[style] ?? style
  }

  function categoryLabel(category: string) {
    return CATEGORY_LABELS[category] ?? category
  }

  function recordDate(iso: string) {
    const date = new Date(iso)
    return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })
  }

  async function onFollow() {
    if (!wl || isSelf()) return
    const was = wl.isFollowing(athleteId)
    wl.setFollowing(athleteId, !was) // optimistic
    const res = await toggleFollow(athleteId, !was)
    if (res && res.success) {
      wl.setFollowing(athleteId, !!res.following)
      if (profile() && typeof res.followerCount === 'number')
        profile.set({ ...profile(), followerCount: res.followerCount })
    }
    else {
      wl.setFollowing(athleteId, was)
    }
  }

  async function onBlock() {
    if (isSelf()) return
    const result = await toggleBlock(athleteId, true)
    if (result.success && result.blocked) {
      safetyMessage.set('Athlete blocked and follow connections removed.')
      profile.set(null)
    }
    else if (!result.success) safetyMessage.set(result.error ?? 'Could not block athlete')
  }

  async function onReport() {
    const result = await reportContent({
      subject_type: 'user',
      subject_id: athleteId,
      reason: reportReason() as any,
    })
    safetyMessage.set(result.success ? 'Report received. Thank you.' : result.error ?? 'Could not submit report')
    if (result.success) safetyOpen.set(false)
  }

  // The record's own identity, once it loads. Without it every athlete page
  // serves one title and no canonical. Applied on the client rather than in
  // a `<script server>` block — see usePageSeo for why that is forced.
  effect(() => {
    const seoAthlete = profile()
    if (!seoAthlete)
      return

    // `/api/users/{id}` answers with an envelope, not a flat athlete: identity
    // under `user`, numbers under `stats`, only the follow counts at the top.
    const seoWho = seoAthlete.user ?? seoAthlete
    const seoStats = seoAthlete.stats ?? {}
    const seoId = seoWho.id ?? seoAthlete.id
    if (!seoId)
      return

    const seoName = String(seoWho.name ?? 'Athlete')
    const seoNum = (value: unknown): number => Number(value ?? 0) || 0
    const seoParts: string[] = []
    if (seoNum(seoStats.activityCount)) seoParts.push(seoNum(seoStats.activityCount) === 1 ? '1 activity' : `${seoNum(seoStats.activityCount)} activities`)
    if (seoNum(seoAthlete.followerCount)) seoParts.push(seoNum(seoAthlete.followerCount) === 1 ? '1 follower' : `${seoNum(seoAthlete.followerCount)} followers`)
    if (seoNum(seoStats.territoriesOwned)) seoParts.push(seoNum(seoStats.territoriesOwned) === 1 ? '1 territory held' : `${seoNum(seoStats.territoriesOwned)} territories held`)

    setPageSeo({
      title: recordTitle(seoName),
      description: seoParts.length
        ? `${seoName} on Wildloop — ${seoParts.join(', ')}. Recent runs, territory and records.`
        : `${seoName} on Wildloop. Recent runs, territory and records.`,
      canonical: `/athlete/${seoId}`,
    })
  })
</script>

  <div class="mx-auto max-w-4xl px-4 pb-12 pt-4 sm:px-6 lg:px-8">
    <StxLink to="/athletes" class="-ml-2 mb-3 inline-flex min-h-11 items-center gap-1 rounded-full px-2 text-sm font-medium text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">
      <i class="i-lucide-chevron-left h-4 w-4" aria-hidden="true"></i>
      Athletes
    </StxLink>

    <div :if="loading" aria-hidden="true" class="space-y-6">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
        <div class="flex flex-col items-center gap-5 sm:flex-row">
          <div class="skeleton h-24 w-24 shrink-0 rounded-full"></div>
          <div class="w-full flex-1 space-y-3"><div class="skeleton mx-auto h-7 w-48 sm:mx-0"></div><div class="skeleton mx-auto h-4 w-32 sm:mx-0"></div></div>
        </div>
        <div class="skeleton mt-6 h-16 rounded-2xl"></div>
      </div>
      <div class="skeleton h-40 rounded-2xl"></div>
    </div>

    <div :if="!loading && loadError" class="py-20 text-center">
      <div class="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-2xl bg-red-50 dark:bg-red-500/10">
        <Icon name="alert-triangle" size="28" class="text-red-500" />
      </div>
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Couldn't load this athlete</h3>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Something went wrong reaching the server.</p>
      <button @click="loadAthlete()" class="mt-5 min-h-11 rounded-full bg-emerald-600 px-6 text-sm font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98]">Try again</button>
    </div>

    <div :if="!loading && !loadError && !profile" class="py-20 text-center">
      <div class="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-2xl bg-slate-100 dark:bg-slate-800">
        <i class="i-lucide-user-x h-7 w-7 text-slate-400" aria-hidden="true"></i>
      </div>
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Athlete not found</h3>
      <p :if="safetyMessage" class="mt-1 text-sm text-slate-500 dark:text-slate-400">{{ safetyMessage }}</p>
      <StxLink to="/feed" class="mt-5 inline-flex min-h-11 items-center rounded-full bg-emerald-600 px-6 text-sm font-semibold text-white transition hover:bg-emerald-700">Back to feed</StxLink>
    </div>

    <template :if="!loading && !loadError && profile">
      <!-- Header -->
      <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6 dark:border-slate-700 dark:bg-slate-800 dark:shadow-none">
        <div class="flex flex-col items-center gap-5 text-center sm:flex-row sm:text-left">
          <div class="grid h-24 w-24 shrink-0 place-items-center rounded-full bg-emerald-100 font-display text-4xl font-bold text-emerald-700 ring-4 ring-emerald-50 dark:bg-emerald-500/15 dark:text-emerald-300 dark:ring-emerald-500/10" aria-hidden="true">{{ (profile.user.name || 'U').charAt(0) }}</div>
          <div class="min-w-0 flex-1">
            <h1 class="font-display text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-white">{{ profile.user.name }}</h1>
            <p :if="isSelf" class="mt-1 text-sm text-slate-500 dark:text-slate-400">This is you.</p>
            <div :if="!isSelf" class="mt-4 flex items-center justify-center gap-2 sm:justify-start">
              <button
                @click="onFollow()"
                x-class="isFollowing ? 'bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-700 dark:text-slate-200 dark:hover:bg-slate-600' : 'bg-emerald-600 text-white hover:bg-emerald-700'"
                class="inline-flex min-h-11 items-center gap-1.5 rounded-full px-6 text-sm font-semibold transition active:scale-[0.98]"
              >
                <i x-class="isFollowing ? 'i-lucide-check' : 'i-lucide-user-plus'" class="h-4 w-4" aria-hidden="true"></i>
                {{ isFollowing ? 'Following' : 'Follow' }}
              </button>
              <button @click="safetyOpen.set(!safetyOpen())" x-aria-expanded="safetyOpen() ? 'true' : 'false'" aria-label="Safety options" class="grid h-11 w-11 place-items-center rounded-full border border-slate-200 text-slate-500 transition hover:border-slate-300 hover:text-slate-800 dark:border-slate-600 dark:text-slate-400 dark:hover:text-white">
                <i class="i-lucide-shield-alert h-5 w-5" aria-hidden="true"></i>
              </button>
            </div>
          </div>
        </div>

        <div :if="safetyOpen && !isSelf" class="mt-5 rounded-2xl bg-slate-50 p-4 dark:bg-slate-900/60">
          <p class="text-sm font-semibold text-slate-900 dark:text-white">Safety</p>
          <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Report this athlete to the Wildloop team, or block them.</p>
          <div class="mt-3 flex flex-col gap-2 sm:flex-row">
            <select x-value="reportReason" @change="reportReason.set($event.target.value)" aria-label="Report reason" class="min-h-11 flex-1 rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 dark:border-slate-600 dark:bg-slate-800 dark:text-white">
              <option value="harassment">Harassment</option>
              <option value="spam">Spam</option>
              <option value="unsafe">Unsafe behavior</option>
              <option value="cheating">Cheating</option>
              <option value="privacy">Privacy concern</option>
              <option value="other">Other</option>
            </select>
            <div class="grid grid-cols-2 gap-2 sm:flex">
              <button @click="onReport()" class="min-h-11 rounded-full bg-amber-500 px-4 text-sm font-semibold text-white transition hover:bg-amber-600">Report</button>
              <button @click="onBlock()" class="min-h-11 rounded-full bg-red-600 px-4 text-sm font-semibold text-white transition hover:bg-red-700">Block athlete</button>
            </div>
          </div>
        </div>
        <p :if="safetyMessage" role="status" class="mt-3 text-center text-sm text-slate-500 sm:text-left dark:text-slate-400">{{ safetyMessage }}</p>

        <dl class="mt-5 grid grid-cols-3 gap-y-1 rounded-2xl bg-slate-50 text-center sm:grid-cols-6 dark:bg-slate-900/60">
            <div class="px-1 py-3">
              <dd class="font-display text-lg font-bold tabular-nums text-slate-900 sm:text-xl dark:text-white">{{ profile.stats.totalDistance.toFixed(1) }}</dd>
              <dt class="metric-label mt-0.5">Miles</dt>
            </div>
            <div class="px-1 py-3">
              <dd class="font-display text-lg font-bold tabular-nums text-slate-900 sm:text-xl dark:text-white">{{ profile.stats.activityCount }}</dd>
              <dt class="metric-label mt-0.5">Activities</dt>
            </div>
            <div class="px-1 py-3">
              <dd class="font-display text-lg font-bold tabular-nums text-slate-900 sm:text-xl dark:text-white">{{ profile.stats.totalElevation.toLocaleString() }}</dd>
              <dt class="metric-label mt-0.5">Elev ft</dt>
            </div>
            <div class="px-1 py-3">
              <dd class="font-display text-lg font-bold tabular-nums text-slate-900 sm:text-xl dark:text-white">{{ profile.stats.territoriesOwned }}</dd>
              <dt class="metric-label mt-0.5">Territories</dt>
            </div>
            <div class="px-1 py-3">
              <dd class="font-display text-lg font-bold tabular-nums text-slate-900 sm:text-xl dark:text-white">{{ profile.followerCount }}</dd>
              <dt class="metric-label mt-0.5">Followers</dt>
            </div>
            <div class="px-1 py-3">
              <dd class="font-display text-lg font-bold tabular-nums text-slate-900 sm:text-xl dark:text-white">{{ profile.followingCount }}</dd>
              <dt class="metric-label mt-0.5">Following</dt>
            </div>
        </dl>
      </section>

      <!-- Records -->
      <!-- Only verified times. An athlete's profile is where a record is read
           as a credential, so a claim nobody has checked does not belong on
           it - it lives on the route's board, marked as pending. -->
      <section :if="records.length > 0" class="mb-6">
        <h2 class="mb-3 flex items-center gap-2 font-display text-xl font-bold text-slate-900 dark:text-white">
          <i class="i-lucide-timer h-5 w-5 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
          Records
        </h2>
        <div class="divide-y divide-slate-100 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:divide-slate-700/70 dark:border-slate-700 dark:bg-slate-800 dark:shadow-none">
          <template :for="record in records">
            <StxLink x-to="'/effort/' + record.id" class="group flex min-h-16 items-center justify-between gap-4 px-4 py-3 transition hover:bg-slate-50 dark:hover:bg-slate-700/40">
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-slate-900 group-hover:text-emerald-700 dark:text-white dark:group-hover:text-emerald-400">{{ record.trailName }}</p>
                <p class="truncate text-xs text-slate-500 dark:text-slate-400">{{ styleLabel(record.style) + ' · ' + categoryLabel(record.category) + ' · ' + recordDate(record.finishedAt || record.startedAt) }}</p>
              </div>
              <p class="shrink-0 font-display text-base font-bold tabular-nums text-emerald-700 dark:text-emerald-400">{{ record.elapsedLabel }}</p>
            </StxLink>
          </template>
        </div>
      </section>

      <!-- Recent activities -->
      <section>
        <h2 class="mb-3 font-display text-xl font-bold text-slate-900 dark:text-white">Recent activities</h2>
        <div :if="profile.recentActivities.length > 0" class="divide-y divide-slate-100 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:divide-slate-700/70 dark:border-slate-700 dark:bg-slate-800 dark:shadow-none">
          <template :for="a in profile.recentActivities">
            <StxLink x-to="'/activity/' + a.id" class="group flex min-h-16 items-center gap-3 px-4 py-3 transition hover:bg-slate-50 dark:hover:bg-slate-700/40">
              <div class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-500/15 dark:text-emerald-400">
                <i x-class="a.activityType === 'Hike' ? 'i-lucide-mountain' : a.activityType === 'Bike' ? 'i-lucide-bike' : 'i-lucide-footprints'" class="h-5 w-5" aria-hidden="true"></i>
              </div>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-semibold text-slate-900 group-hover:text-emerald-700 dark:text-white dark:group-hover:text-emerald-400">
                  <span>{{ a.activityType }}</span>
                  <span :if="a.trailName" class="font-normal text-slate-500 dark:text-slate-400"> · <span>{{ a.trailName }}</span></span>
                </p>
                <p class="text-xs text-slate-500 dark:text-slate-400">{{ wl.timeAgo(a.completedAt) }}</p>
              </div>
              <div class="shrink-0 text-right">
                <p class="text-sm font-bold tabular-nums text-slate-900 dark:text-white">{{ a.distance.toFixed(1) + ' mi' }}</p>
                <p class="text-xs tabular-nums text-slate-400 dark:text-slate-500">{{ a.elevationGain.toLocaleString() + ' ft' }}</p>
              </div>
            </StxLink>
          </template>
        </div>
        <p :if="profile.recentActivities.length === 0" class="rounded-2xl border border-dashed border-slate-300 px-6 py-10 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">No activities yet.</p>
      </section>
    </template>
  </div>
@endsection
