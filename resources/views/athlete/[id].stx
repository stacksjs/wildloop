@extends('layouts/default')

@section('title', 'Athlete - WildLoop')

@section('content')
<script client>
  import { fetchAthlete, reportContent, toggleBlock, toggleFollow } from '../../assets/scripts/game-api'
  import { fetchRecords } from '../../assets/scripts/records-api'
  import { readRouteParam } from '../../composables/useRouteParam'
  import { recordTitle, setPageSeo } from '../../composables/usePageSeo'
  import { CATEGORY_LABELS, STYLE_LABELS } from '../../functions/route-records'

  useHead({ title: 'Athlete - WildLoop' })

  const wl = useStore('wl')
  const profile = state<any>(null)
  const loading = state(true)
  const loadError = state(false)
  const safetyOpen = state(false)
  const reportReason = state('harassment')
  const safetyMessage = state<string | null>(null)

  // -1 is a no-match sentinel so an unresolved param renders "not found"
  // rather than silently loading athlete 0/1 (#987).
  const athleteId = readRouteParam('id') ?? -1

  const isSelf = derived(() => !!wl && athleteId === wl.currentUserId())
  const isFollowing = derived(() => !!wl && wl.isFollowing(athleteId))

  async function loadAthlete() {
    loading.set(true)
    loadError.set(false)
    try {
      // A null result means "no such athlete" (404); a thrown error means the
      // request itself failed - surface those as different states so a network
      // blip doesn't masquerade as a permanent "not found".
      const data = await fetchAthlete(athleteId)
      profile.set(data)
    }
    catch {
      loadError.set(true)
    }
    loading.set(false)
  }

  // This athlete's verified records. Separate from the profile payload
  // because it is a different question - "what have they held" rather than
  // "what have they run" - and a profile that has none should not pay for the
  // join on every load.
  const records = state<any[]>([])

  async function loadRecords() {
    const result = await fetchRecords({ userId: athleteId, status: 'verified', limit: 20 })
    records.set(result?.efforts ?? [])
  }

  onMount(() => {
    void loadAthlete()
    void loadRecords()
  })

  function styleLabel(style: string) {
    return STYLE_LABELS[style] ?? style
  }

  function categoryLabel(category: string) {
    return CATEGORY_LABELS[category] ?? category
  }

  function recordDate(iso: string) {
    const date = new Date(iso)
    return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })
  }

  async function onFollow() {
    if (!wl || isSelf()) return
    const was = wl.isFollowing(athleteId)
    wl.setFollowing(athleteId, !was) // optimistic
    const res = await toggleFollow(athleteId)
    if (res && res.success) {
      wl.setFollowing(athleteId, !!res.following)
      if (profile() && typeof res.followerCount === 'number')
        profile.set({ ...profile(), followerCount: res.followerCount })
    }
    else {
      wl.setFollowing(athleteId, was)
    }
  }

  async function onBlock() {
    if (isSelf()) return
    const result = await toggleBlock(athleteId)
    if (result.success && result.blocked) {
      safetyMessage.set('Athlete blocked and follow connections removed.')
      profile.set(null)
    }
    else if (!result.success) safetyMessage.set(result.error ?? 'Could not block athlete')
  }

  async function onReport() {
    const result = await reportContent({
      subject_type: 'user',
      subject_id: athleteId,
      reason: reportReason() as any,
    })
    safetyMessage.set(result.success ? 'Report received. Thank you.' : result.error ?? 'Could not submit report')
    if (result.success) safetyOpen.set(false)
  }

  // The record's own identity, once it loads. Without it every athlete page
  // serves one title and no canonical. Applied on the client rather than in
  // a `<script server>` block — see usePageSeo for why that is forced.
  effect(() => {
    const record = profile()
    if (!record)
      return

    const name = String(record.name ?? 'Athlete')
    const facts: string[] = []
    if (record.activityCount) facts.push(record.activityCount === 1 ? '1 activity' : `${record.activityCount} activities`)
    if (record.followerCount) facts.push(record.followerCount === 1 ? '1 follower' : `${record.followerCount} followers`)
    if (record.territoriesOwned) facts.push(`${record.territoriesOwned} territories held`)

    setPageSeo({
      title: recordTitle(name),
      description: facts.length
        ? `${name} on WildLoop — ${facts.join(', ')}. Recent runs, territory and records.`
        : `${name} on WildLoop. Recent runs, territory and records.`,
      canonical: `/athlete/${record.id}`,
    })
  })
</script>

  <div class="mx-auto px-4 py-6 sm:px-6 lg:px-8 max-w-4xl">
    <div :if="loading" class="py-20 text-center text-gray-400">Loading athlete…</div>

    <div :if="!loading && loadError" class="py-20 text-center">
      <div class="w-16 h-16 mx-auto mb-4 bg-red-100 dark:bg-red-900/20 rounded-2xl flex items-center justify-center">
        <Icon name="alert-triangle" size="28" class="text-red-400" />
      </div>
      <h3 class="mb-1 font-semibold text-gray-900 text-lg dark:text-white">Couldn't load this athlete</h3>
      <p class="mb-4 text-sm text-gray-500 dark:text-slate-400">Something went wrong reaching the server.</p>
      <button @click="loadAthlete()" class="px-5 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Try again</button>
    </div>

    <div :if="!loading && !loadError && !profile" class="py-20 text-center">
      <h3 class="mb-2 font-semibold text-gray-900 text-lg dark:text-white">Athlete not found</h3>
      <StxLink to="/feed" class="text-emerald-600 text-sm font-semibold">← Back to feed</StxLink>
    </div>

    <template :if="!loading && !loadError && profile">
      <!-- Header -->
      <div class="mb-6 card">
        <div class="flex flex-col gap-6 items-center sm:flex-row">
          <div class="flex items-center justify-center h-24 w-24 font-bold text-3xl text-emerald-600 bg-emerald-100 dark:bg-emerald-900/30 rounded-full">{{ (profile.user.name || 'U').charAt(0) }}</div>
          <div class="flex-1 text-center sm:text-left">
            <div class="flex flex-col sm:flex-row sm:items-center gap-3 justify-center sm:justify-start">
              <h1 class="font-bold text-2xl dark:text-white">{{ profile.user.name }}</h1>
              <button
                :if="!isSelf"
                @click="onFollow()"
                x-class="isFollowing ? 'bg-gray-100 text-gray-600 dark:bg-slate-700 dark:text-slate-300' : 'bg-emerald-600 text-white hover:bg-emerald-700'"
                class="px-4 py-1.5 font-semibold text-sm rounded-lg transition"
>{{ isFollowing ? 'Following' : 'Follow' }}</button>
              <button :if="!isSelf" @click="safetyOpen.set(!safetyOpen())" class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-gray-200 dark:border-slate-600 text-gray-500 dark:text-slate-400 hover:text-red-500 transition">Safety</button>
            </div>
            <div :if="safetyOpen && !isSelf" class="mt-3 flex flex-wrap gap-2 justify-center sm:justify-start">
              <select x-value="reportReason" @change="event => reportReason.set(event.target.value)" class="px-3 py-2 text-sm rounded-lg border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700">
                <option value="harassment">Harassment</option>
                <option value="spam">Spam</option>
                <option value="unsafe">Unsafe behavior</option>
                <option value="cheating">Cheating</option>
                <option value="privacy">Privacy concern</option>
                <option value="other">Other</option>
              </select>
              <button @click="onReport()" class="px-3 py-2 text-xs font-semibold rounded-lg bg-amber-500 text-white">Report</button>
              <button @click="onBlock()" class="px-3 py-2 text-xs font-semibold rounded-lg bg-red-600 text-white">Block athlete</button>
            </div>
            <p :if="safetyMessage" class="mt-2 text-xs text-gray-500 dark:text-slate-400">{{ safetyMessage }}</p>
            <div class="flex flex-wrap gap-4 justify-center sm:justify-start mt-3">
              <div class="text-center">
                <p class="text-lg font-bold text-emerald-600">{{ profile.stats.totalDistance.toFixed(1) }}</p>
                <p class="metric-label">Miles</p>
              </div>
              <div class="text-center">
                <p class="text-lg font-bold text-emerald-600">{{ profile.stats.activityCount }}</p>
                <p class="metric-label">Activities</p>
              </div>
              <div class="text-center">
                <p class="text-lg font-bold text-emerald-600">{{ profile.stats.totalElevation.toLocaleString() }}</p>
                <p class="metric-label">Elev (ft)</p>
              </div>
              <div class="text-center">
                <p class="text-lg font-bold text-emerald-600">{{ profile.stats.territoriesOwned }}</p>
                <p class="metric-label">Territories</p>
              </div>
              <div class="text-center">
                <p class="text-lg font-bold text-emerald-600">{{ profile.followerCount }}</p>
                <p class="metric-label">Followers</p>
              </div>
              <div class="text-center">
                <p class="text-lg font-bold text-emerald-600">{{ profile.followingCount }}</p>
                <p class="metric-label">Following</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Records -->
      <!-- Only verified times. An athlete's profile is where a record is read
           as a credential, so a claim nobody has checked does not belong on
           it - it lives on the route's board, marked as pending. -->
      <div :if="records.length > 0" class="mb-6 card">
        <h2 class="mb-4 font-bold text-lg dark:text-white">Records</h2>
        <div class="space-y-2">
          <template :for="record in records">
            <StxLink x-to="'/effort/' + record.id" class="flex items-center justify-between gap-4 py-3 border-b border-gray-100 dark:border-slate-700 last:border-0">
              <div class="min-w-0">
                <p class="truncate font-semibold text-sm dark:text-white">{{ record.trailName }}</p>
                <p class="text-gray-400 text-xs">{{ styleLabel(record.style) + ' · ' + categoryLabel(record.category) + ' · ' + recordDate(record.finishedAt || record.startedAt) }}</p>
              </div>
              <p class="shrink-0 font-bold text-emerald-600 text-sm">{{ record.elapsedLabel }}</p>
            </StxLink>
          </template>
        </div>
      </div>

      <!-- Recent activities -->
      <div class="card">
        <h2 class="mb-4 font-bold text-lg dark:text-white">Recent activities</h2>
        <div class="space-y-2">
          <template :for="a in profile.recentActivities">
            <StxLink x-to="'/activity/' + a.id" class="flex items-center justify-between py-3 border-b border-gray-100 dark:border-slate-700 last:border-0">
              <div>
                <p class="font-semibold text-sm dark:text-white">
                  <span>{{ a.activityType }}</span>
                  <span :if="a.trailName" class="text-gray-500 dark:text-slate-400"> · <span>{{ a.trailName }}</span></span>
                </p>
                <p class="text-gray-400 text-xs">{{ wl.timeAgo(a.completedAt) }}</p>
              </div>
              <div class="text-right">
                <p class="font-bold text-emerald-600 text-sm">{{ a.distance.toFixed(1) + ' mi' }}</p>
                <p class="text-gray-400 text-xs">{{ a.elevationGain.toLocaleString() + ' ft' }}</p>
              </div>
            </StxLink>
          </template>
          <p :if="profile.recentActivities.length === 0" class="py-4 text-center text-gray-400 text-sm">No activities yet.</p>
        </div>
      </div>
    </template>
  </div>
@endsection
