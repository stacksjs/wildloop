@extends('layouts/default')

@section('title', 'Explore Trails - Wildloop')

@section('content')
<script server>
  /*
   * SEO for this page.
   *
   * `<script server>` because a crawler reads the HTML it is served and never
   * runs the client script — tags set after hydration are tags nobody indexes.
   * `useSeoMeta` rather than `useHead` because only the former reaches the
   * composed document head from a page. And written out here rather than
   * wrapped in a composable: the engine injects `useSeoMeta` into a page's own
   * script scope and not into a module it imports, where it is simply
   * undefined and the call fails without a word.
   *
   * URLs are absolute. A crawler resolves `og:image` against nothing, so a
   * relative path is dropped and the link previews as a bare URL.
   */
  useSeoMeta({
    title: 'Explore trails — Wildloop',
    description: 'Search half a million trails across the US, Germany, Austria and Switzerland by name, park, forest or Land — with distance, ascent and difficulty on every one.',
    canonical: 'https://wildloop.org/trails',
    robots: 'index, follow, max-image-preview:large',
    ogTitle: 'Explore trails — Wildloop',
    ogDescription: 'Search half a million trails across the US, Germany, Austria and Switzerland by name, park, forest or Land — with distance, ascent and difficulty on every one.',
    ogType: 'website',
    ogUrl: 'https://wildloop.org/trails',
    ogImage: 'https://wildloop.org/images/social/og-trails.jpg',
    ogSiteName: 'Wildloop',
    ogLocale: 'en_US',
    twitterCard: 'summary_large_image',
    twitterTitle: 'Explore trails — Wildloop',
    twitterDescription: 'Search half a million trails across the US, Germany, Austria and Switzerland by name, park, forest or Land — with distance, ascent and difficulty on every one.',
    twitterImage: 'https://wildloop.org/images/social/og-trails.jpg',
  })
</script>

<script client>
  import { catalogError, EMPTY_COVERAGE, fetchCoverage, queryTrails, shouldFallbackToCatalog } from '../composables/useTrailCatalog'
  import {
    activeFilterCount,
    bucketChipLabel,
    DIFFICULTY_OPTIONS,
    ELEVATION_BUCKETS,
    filtersFromQuery,
    filtersToQuery,
    LENGTH_BUCKETS,
    RATING_OPTIONS,
    ROUTE_TYPE_OPTIONS,
    SORT_OPTIONS,
  } from '../composables/useTrailFilters'
  import { downloadedTrailIds, downloadMessage, downloadingTrailId, refreshDownloads, toggleDownload } from '../composables/useOfflineDownloads'
  import { routePreviewDataUri } from '../composables/useRoutePreview'
  import { routeShapeFor } from '../composables/useRouteShape'
  import { loadReviewers, trailReviewers } from '../composables/useTrailReviewers'
  import { avatarInitial, avatarTint, newReviewsLabel, overflowLabel } from '../functions/avatars'
  import { useSavedTrails } from '../composables/useSavedTrails'
  import { clearNearby, locatePrecisely, locating, nearby, nearbyError, resolveNearby } from '../composables/useNearby'
  import { usePlaceSearch, type PlaceResult } from '../composables/usePlaceSearch'
  import { isStockTrailPhoto } from '../functions/stock-photos'
  import { routeTypeLabel, trailHighlight } from '../functions/trail-features'
  import {
    createTrailMap,
    drawTrailMarker,
    drawTrailRoute,
    runWhenMapReady,
    trailDifficultyColor,
    type TrailMapHandle,
  } from '../composables/useTrailMap'


  const wl = useStore('wl')
  const { onToggleSave } = useSavedTrails(wl)

  const search = state('')
  const difficulty = state<string>('all')
  const routeType = state<string>('all')
  const lengthBucket = state('any')
  const elevationBucket = state('any')
  const minRating = state(0)
  const dogsOnly = state(false)
  const accessibleOnly = state(false)
  const nationalOnly = state(false)
  /** The filter chip whose panel is open, or '' for none. Only ever one. */
  const openFilter = state('')
  /** An explicitly chosen ordering, which outranks the page's own default. */
  const sortChoice = state('')
  const activeState = state('')
  const selectedTrailId = state<number | null>(null)

  // Bound to locals: the template resolves names declared in this script, and
  // an imported binding read straight from the markup comes back empty.
  const difficultyOptions = DIFFICULTY_OPTIONS
  const lengthBuckets = LENGTH_BUCKETS
  const elevationBuckets = ELEVATION_BUCKETS
  const routeOptions = ROUTE_TYPE_OPTIONS
  const ratingOptions = RATING_OPTIONS
  const sortOptions = SORT_OPTIONS

  /** Every filter as one value, which is what the query builder takes. */
  const filters = derived(() => ({
    difficulty: difficulty(),
    length: lengthBucket(),
    elevation: elevationBucket(),
    routeType: routeType(),
    rating: minRating(),
    dogsAllowed: dogsOnly(),
    accessible: accessibleOnly(),
    nationalTrail: nationalOnly(),
  }))

  const filterCount = derived(() => activeFilterCount(filters()))

  // A chip reads as what it is set to, so the current filters can be seen
  // without opening anything.
  const difficultyLabel = derived(() => (difficulty() === 'all'
    ? 'Difficulty'
    : difficultyOptions.find(option => option.id === difficulty())?.label ?? 'Difficulty'))
  const lengthLabel = derived(() => bucketChipLabel(lengthBuckets, lengthBucket(), 'Length'))
  const elevationLabel = derived(() => bucketChipLabel(elevationBuckets, elevationBucket(), 'Elevation gain'))
  const routeLabel = derived(() => (routeType() === 'all'
    ? 'Route type'
    : routeOptions.find(option => option.id === routeType())?.label ?? 'Route type'))
  const ratingLabel = derived(() => (minRating() > 0 ? `${minRating()}+ stars` : 'Rating'))

  /**
   * The rows of whichever panel is open.
   *
   * One panel driven by data rather than five near-identical blocks of markup:
   * every chip opens the same single-select list, and only its contents differ.
   */
  const panelOptions = derived(() => {
    switch (openFilter()) {
      case 'difficulty':
        return difficultyOptions.map(option => ({ id: String(option.id), label: option.label, active: difficulty() === option.id }))
      case 'length':
        return lengthBuckets.map(bucket => ({ id: bucket.id, label: bucket.label, active: lengthBucket() === bucket.id }))
      case 'elevation':
        return elevationBuckets.map(bucket => ({ id: bucket.id, label: bucket.label, active: elevationBucket() === bucket.id }))
      case 'route':
        return routeOptions.map(option => ({ id: String(option.id), label: option.label, active: routeType() === option.id }))
      case 'rating':
        return ratingOptions.map(option => ({ id: String(option.id), label: option.label, active: minRating() === option.id }))
      default:
        return []
    }
  })

  function togglePanel(id: string) {
    openFilter.set(openFilter() === id ? '' : id)
  }

  function closePanel() {
    openFilter.set('')
  }

  /** Apply a row from whichever panel is open, then close it and re-search. */
  function choosePanelOption(id: string) {
    switch (openFilter()) {
      case 'difficulty':
        difficulty.set(id)
        break
      case 'length':
        lengthBucket.set(id)
        break
      case 'elevation':
        elevationBucket.set(id)
        break
      case 'route':
        routeType.set(id)
        break
      case 'rating':
        minRating.set(Number(id))
        break
    }
    closePanel()
    runSearch()
  }

  function toggleDogsOnly() {
    dogsOnly.set(!dogsOnly())
    runSearch()
  }

  function toggleAccessibleOnly() {
    accessibleOnly.set(!accessibleOnly())
    runSearch()
  }

  function toggleNationalOnly() {
    nationalOnly.set(!nationalOnly())
    runSearch()
  }

  function chooseSort(id: string) {
    sortChoice.set(id)
    runSearch()
  }

  function clearFilters() {
    // The ordering goes back with the filters: both are reached through the
    // same panel, and "Clear all" that leaves the list sorted by rating is not
    // the default list anybody remembers setting.
    sortChoice.set('')
    difficulty.set('all')
    routeType.set('all')
    lengthBucket.set('any')
    elevationBucket.set('any')
    minRating.set(0)
    dogsOnly.set(false)
    accessibleOnly.set(false)
    nationalOnly.set(false)
    closePanel()
    runSearch()
  }

  function clearSearchText() {
    search.set('')
    runSearch()
  }

  // Offline state, mirrored through locals: the template resolves names from
  // this script, and an imported signal read straight from the markup is empty.
  const downloadedIds = derived(() => downloadedTrailIds())
  const downloadNote = derived(() => downloadMessage())

  function isDownloaded(id: number) {
    return downloadedIds().includes(id)
  }

  function isDownloading(id: number) {
    return downloadingTrailId() === id
  }

  /** Save a card's route for the field without opening the trail first. */
  function onDownload(trail: any) {
    void toggleDownload(trail, routes()[trail.id])
  }

  // Recent reviewers, mirrored through a local derived like the rest: an
  // imported signal read straight from the markup comes back empty.
  const reviewerSummaries = derived(() => trailReviewers())

  /** Faces for a card, newest reviewer first. Empty for a quiet trail. */
  function reviewerFaces(id: number) {
    return reviewerSummaries()[id]?.reviewers ?? []
  }

  function reviewerCountLabel(id: number) {
    return newReviewsLabel(reviewerSummaries()[id]?.recentCount ?? 0)
  }

  /** `+28` for the reviewers behind the three faces shown. */
  function reviewerOverflow(id: number) {
    const summary = reviewerSummaries()[id]
    return summary ? overflowLabel(summary.recentCount, summary.reviewers.length) : ''
  }

  function faceInitial(name: string) {
    return avatarInitial(name)
  }

  function faceTint(reviewer: any) {
    return avatarTint(reviewer?.id ?? reviewer?.name)
  }

  /**
   * The badge on a card's photo: the single attribute somebody picks this
   * trail by. Empty when the catalog knows nothing worth saying.
   */
  function highlightLabel(trail: any) {
    return trailHighlight(trail)?.label ?? ''
  }

  function highlightIcon(trail: any) {
    return trailHighlight(trail)?.icon || 'i-lucide-sparkles'
  }

  function routeLabelFor(trail: any) {
    return routeTypeLabel(trail.routeType)
  }

  /**
   * The route's shape as a small SVG, the way a map chip on a card shows it.
   *
   * Cached by id: the grid re-renders on every keystroke and the line does not
   * change, so rebuilding it each time is work with no output.
   */
  const thumbnails = new Map<number, string>()

  function routeThumb(id: number) {
    const cached = thumbnails.get(id)
    if (cached)
      return cached

    const coords = routes()[id]
    if (!coords || coords.length < 2)
      return ''

    // Only a drawn line is cached. A miss must stay a miss: the cards render
    // from `results` and the geometry lands in `routes` a statement later, so
    // caching the empty answer froze every card's chip out for the session.
    const uri = routePreviewDataUri(coords) || ''
    if (uri)
      thumbnails.set(id, uri)
    return uri
  }

  /**
   * The route drawn big, as the cover of a card that has no photo.
   *
   * Most of the catalog publishes no pictures, so this is what most cards
   * actually show. The line is fitted to the cover's own proportions and drawn
   * in the page's colours, which is what the square data-URI chip above
   * cannot do. Cached like the chip, and only once there is a line.
   */
  const NO_SHAPE = { points: '', startX: 0, startY: 0, endX: 0, endY: 0, loop: true }
  const coverShapes = new Map<number, typeof NO_SHAPE>()

  function coverRoute(id: number) {
    const cached = coverShapes.get(id)
    if (cached)
      return cached
    const shape = routeShapeFor(routes()[id], 160, 120, 18)
    if (!shape)
      return NO_SHAPE
    coverShapes.set(id, shape)
    return shape
  }

  /** One of four contour layouts, so a grid of photo-less cards is not one card repeated. */
  function coverClass(trail: any) {
    return `wl-topo wl-topo-${Math.abs(Number(trail?.id) || 0) % 4}`
  }

  /**
   * Whether the catalog is scoped to where the visitor is.
   *
   * On by default, because "popular trails near me" is what somebody opening a
   * trail catalog actually wants — a national list sorted by length is a fact
   * about the database, not an answer to their question. It turns itself off
   * the moment a filter says otherwise: picking a region or a country is an
   * explicit statement about where to look, and quietly intersecting that with
   * the visitor's own coordinates would return nothing and blame the region.
   */
  const useNearMe = state(true)
  /** An explicit `?sort=` from a link, which outranks the page's own choice. */
  const urlSort = state('')
  /** The radius the API actually answered at, which may be wider than asked. */
  const nearRadius = state(0)

  // Results come from the API, not from filtering the store. The store holds a
  // couple of hundred featured trails; the catalog holds tens of thousands, and
  // the only honest way to search it is server-side.
  const results = state<any[]>([])
  const routes = state<Record<number, [number, number][]>>({})
  const matchCount = state(0)
  const searching = state(false)
  const searchFailed = state(false)

  // How much the catalog holds, and where.
  const coverage = state(EMPTY_COVERAGE)
  /**
   * The country the visitor picked. Three values, not two:
   *
   * - `''` — nothing picked, so the API answers for wherever the request looks
   *   like it came from. What the guess landed on comes back with the results
   *   and lights that country's chip, so the page never claims a scope it does
   *   not have.
   * - `'all'` — "Everywhere", asked for out loud. An absent country cannot mean
   *   this: that is what turns the guess on.
   * - a code — that country, and nothing else.
   */
  const activeCountry = state('')
  /** The country the last answer was scoped to, picked or guessed. */
  const answeredCountry = state('')
  /** Whether an answer has come back yet, so no chip lights up on a guess. */
  const answered = state(false)

  /**
   * A card's photo, and whether it is a picture of that trail.
   *
   * Cards used to fall back to one hardcoded forest, so a catalog whose
   * sources publish no photos — which is most of it — rendered as the same
   * picture 25 times, each reading as this trail. A trail with no photo now
   * says so, and a stock cover is labelled the way the trail page labels it.
   */
  function cardPhoto(trail: any): string {
    return typeof trail?.image === 'string' ? trail.image.trim() : ''
  }

  function cardPhotoIllustrative(trail: any): boolean {
    return isStockTrailPhoto(cardPhoto(trail))
  }

  /** Countries read as names, not ISO codes, everywhere they are shown. */
  const COUNTRY_NAMES: Record<string, string> = {
    US: 'United States',
    DE: 'Germany',
    AT: 'Austria',
    CH: 'Switzerland',
  }

  function countryName(code: string): string {
    return COUNTRY_NAMES[code] ?? code
  }

  const countries = derived(() => coverage().countries)

  /** Which chip is lit: what was picked, or what the API answered for. */
  // Declared above the chips because they read it, and a `derived` body that
  // reaches a `const` further down the script is a reference error.
  const nearMeActive = derived(() => useNearMe() && !!nearby() && !activeState() && !activeCountry())

  /*
   * Somewhere else: a town somebody searched for, to plan a trip there.
   * It outranks "near me" while it is set — the question is "what is good
   * near San Diego", not near wherever this phone happens to be — and a
   * state or country filter outranks it, as it does near-me.
   */
  const placeOrigin = state<{ lat: number, lng: number, label: string } | null>(null)
  const placeActive = derived(() => !!placeOrigin() && !activeState() && !activeCountry())
  const placeLabel = derived(() => placeOrigin()?.label ?? '')
  const placeSearch = usePlaceSearch({ limit: 5 })
  const placeResults = placeSearch.results
  const placeQuery = placeSearch.query

  function onPlaceInput(event: any): void {
    placeSearch.onInput(String(event?.target?.value ?? ''))
  }

  function choosePlace(place: PlaceResult): void {
    placeSearch.clear()
    placeOrigin.set({ lat: place.lat, lng: place.lng, label: place.name })
    activeState.set('')
    activeCountry.set('')
    runSearch()
  }

  function clearPlace(): void {
    placeOrigin.set(null)
    runSearch()
  }

  /** The plans page, opened on this place with the planner ready. */
  function planHereUrl(): string {
    const place = placeOrigin()
    return place ? `/plans?lat=${place.lat}&lng=${place.lng}&place=${encodeURIComponent(place.label)}` : '/plans'
  }

  const chipCountry = derived(() => {
    if (activeCountry())
      return activeCountry()
    if (answeredCountry())
      return answeredCountry()
    // Nothing picked and nothing filtered: the list really is the whole
    // catalog, which is what the Everywhere chip says. Not while a radius is
    // doing the scoping, and not before the first answer, when lighting a chip
    // would be a guess at what comes back.
    return answered() && !nearMeActive() ? 'all' : ''
  })

  /** The country the list is actually showing, empty for the whole catalog. */
  const countryInView = derived(() => (chipCountry() === 'all' ? '' : chipCountry()))

  /**
   * Regions for the country in view. With no country picked this is the
   * biggest regions anywhere, which is how the page used to behave when the
   * catalog was US-only.
   */
  const topStates = derived(() => {
    const country = countryInView()
    const all = coverage().states
    return (country ? all.filter((s: any) => s.country === country) : all).slice(0, 12)
  })

  // Read through `derived` rather than reaching into `nearby()` from the
  // template. The template's expression scope resolves the local declarations
  // in this script; an imported signal is callable from the script but its
  // *properties* came back empty when read inline in the markup, which is how
  // the location bar ended up announcing a radius with no place attached.
  const nearbyLabel = derived(() => nearby()?.label ?? '')
  const nearbyIsCoarse = derived(() => nearby()?.source === 'edge')
  const nearbyBusy = derived(() => locating())
  const nearbyMessage = derived(() => nearbyError())

  const heading = derived(() => {
    const code = activeState()
    if (code) {
      const match = coverage().states.find((s: any) => s.code === code)
      if (match)
        return `Trails in ${match.name}`
    }

    const country = countryInView()
    if (country)
      return `Every trail in ${countryName(country)}`

    const searched = placeActive() ? placeOrigin() : null
    if (searched)
      return `Popular trails near ${searched.label}`

    const place = nearMeActive() ? nearby() : null
    if (place)
      return place.source === 'gps' ? 'Popular trails near you' : `Popular trails near ${place.label}`

    return 'Every trail we know'
  })

  let exploreMap: TrailMapHandle | null = null
  let searchToken = 0
  let debounce: ReturnType<typeof setTimeout> | null = null

  async function runSearch() {
    const token = ++searchToken
    searching.set(true)
    searchFailed.set(false)

    try {
      let near: { lat: number, lng: number } | null = placeActive() ? placeOrigin() : nearMeActive() ? nearby() : null

      const query = {
        q: search(),
        country: activeCountry(),
        state: activeState(),
        ...filtersToQuery(filters()),
        // Near me sorts by rating: within a radius somebody can drive, "which
        // of these is good" is the remaining question. Nationally there is no
        // such thing as near, so length is what makes the list impressive
        // rather than arbitrary.
        sort: sortChoice() || urlSort() || (search() ? 'featured' : near ? 'rating' : 'longest'),
        ...(near ? { lat: near.lat, lng: near.lng, radius: 25 } : {}),
        limit: 60,
      }
      let res = await queryTrails(query)

      // Wildloop does not yet have catalog coverage everywhere. Do not strand
      // a visitor whose edge or device location is outside it on an empty
      // result: a location-only empty answer becomes a global browse instead.
      if (shouldFallbackToCatalog(query, res)) {
        res = await queryTrails({ ...query, sort: 'longest', lat: undefined, lng: undefined, radius: undefined })
        near = null
        useNearMe.set(false)
        placeOrigin.set(null)
      }

      // A slower earlier request must not overwrite a newer result.
      if (token !== searchToken)
        return

      // Geometry first: the cards read it as they render, and setting the rows
      // first draws one frame of every card with no route chip.
      routes.set(res.geometryById)
      results.set(res.trails)
      // Faces last, and not awaited: the list is already on screen, and who
      // reviewed a trail last month is not worth holding it for.
      void loadReviewers(res.trails.map((trail: any) => trail.id))
      matchCount.set(res.total)
      nearRadius.set(near ? (res.radius ?? 25) : 0)
      // Nothing picked means the API chose the scope. Say which one it chose.
      answeredCountry.set(res.country ?? '')
      answered.set(true)
    }
    catch {
      if (token !== searchToken)
        return
      const fallback = offlineResults()
      searchFailed.set(true)
      routes.set(wl?.trailRoutes() ?? {})
      results.set(fallback)
      matchCount.set(fallback.length)
      catalogError.set('Live trail search is unavailable offline.')
    }
    finally {
      if (token === searchToken)
        searching.set(false)
    }
  }

  /**
   * Typing fires a request per keystroke without the debounce.
   *
   * A named handler rather than a block-bodied arrow in the template: stx
   * parses `@input` expressions, and a multi-statement arrow body silently
   * did not update the signal, so typing changed nothing.
   */
  function onSearchInput(value: string) {
    search.set(value)
    if (debounce)
      clearTimeout(debounce)
    debounce = setTimeout(() => runSearch(), 250)
  }

  /**
   * Keep discovery useful when the native shell has fallen back offline.
   *
   * The same filters as the API applies, against whatever the store holds: a
   * chip that silently stops meaning anything once the connection drops is
   * worse than a short list.
   */
  function offlineResults() {
    const term = search().trim().toLowerCase()
    const query = filtersToQuery(filters())

    return (wl?.trails() ?? []).filter((trail: any) => {
      if (term && !`${trail.name} ${trail.location}`.toLowerCase().includes(term))
        return false
      if (query.difficulty && trail.difficulty !== query.difficulty)
        return false
      if (query.routeType && trail.routeType !== query.routeType)
        return false
      if (query.minDistance !== undefined && !(trail.distance >= query.minDistance))
        return false
      if (query.maxDistance !== undefined && !(trail.distance <= query.maxDistance))
        return false
      if (query.minElevation !== undefined && !(trail.elevation >= query.minElevation))
        return false
      if (query.maxElevation !== undefined && !(trail.elevation <= query.maxElevation))
        return false
      if (query.minRating !== undefined && !(trail.rating >= query.minRating))
        return false
      if (query.nationalTrail && !trail.nationalTrail)
        return false
      return true
    })
  }

  function selectState(code: string) {
    activeState.set(activeState() === code ? '' : code)
    runSearch()
  }

  /**
   * Picking a country clears the region: `DE-BY` inside "Switzerland" would
   * return nothing, and an empty list with two filters lit is a dead end the
   * user has to reason their way out of.
   */
  function selectCountry(code: string) {
    // Tapping the lit chip steps back to the whole catalog rather than to the
    // guess, which is what a second tap on "United States" plainly means.
    const next = chipCountry() === code ? 'all' : code
    activeCountry.set(next)
    activeState.set('')
    runSearch()
  }

  // `createTrailMap` is async, so two overlapping refreshes both see a live
  // container and the second throws "Map container is already initialized".
  // Results change on every keystroke, so overlap is the normal case.
  let mapBusy = false
  let mapDirty = false

  async function refreshExploreMap() {
    if (mapBusy) {
      mapDirty = true
      return
    }
    mapBusy = true

    try {
      await drawExploreMap()
    }
    finally {
      mapBusy = false
      if (mapDirty) {
        mapDirty = false
        refreshExploreMap()
      }
    }
  }

  async function drawExploreMap() {
    exploreMap?.destroy()
    exploreMap = null
    exploreMap = await createTrailMap('trails-explore-map', { scrollWheelZoom: true, zoom: 4 })
    if (!exploreMap)
      return

    const { map } = exploreMap
    const bounds: [number, number][] = []
    const geometry = routes()

    // Only the first 40 routes are drawn. Beyond that the map is an unreadable
    // thicket and every extra polyline costs a frame.
    for (const trail of results().slice(0, 40)) {
      const coords = geometry[trail.id]
      const color = trailDifficultyColor(trail.difficulty)

      if (coords && coords.length > 1) {
        await drawTrailRoute(map, coords, { color, weight: 3, opacity: 0.8 })
        bounds.push(...coords)
      }

      await drawTrailMarker(map, trail.lat, trail.lng, {
        difficulty: trail.difficulty,
        popupHtml: `<b>${trail.name}</b><br>${trail.location}<br>${trail.distance} mi · ${trail.difficulty}`,
        onClick: () => selectedTrailId.set(trail.id),
      })
      bounds.push([trail.lat, trail.lng])
    }

    if (bounds.length)
      exploreMap.fitPoints(bounds, [48, 48])
  }

  /**
   * Arrive from a "Trails Near Me" link — the Spotlight shortcut, the home
   * screen, or a shared URL.
   *
   * The coarse fix is tried first because it needs no permission: somebody who
   * asked for what is nearby should see it, not a prompt. Only when nothing is
   * known at all is the browser asked, and a refusal still leaves a list —
   * the national catalog is the honest answer when there is no location, but
   * it is the last resort rather than the first.
   */
  async function openNearMeFromLink() {
    placeOrigin.set(null)
    useNearMe.set(true)
    activeState.set('')
    activeCountry.set('')

    const known = await resolveNearby()
    if (!known)
      await locatePrecisely()

    runSearch()
  }

  /** Turn "near me" on, asking for a precise fix if there is nothing yet. */
  async function enableNearMe() {
    placeOrigin.set(null)
    useNearMe.set(true)
    activeState.set('')
    activeCountry.set('')

    if (!nearby())
      await locatePrecisely()

    runSearch()
  }

  function disableNearMe() {
    useNearMe.set(false)
    runSearch()
  }

  /** Replace a coarse IP fix with the real thing. */
  async function refineLocation() {
    await locatePrecisely()
    runSearch()
  }

  function forgetLocation() {
    clearNearby()
    useNearMe.set(false)
    runSearch()
  }

  /**
   * Arrive where a link pointed. The home search sends `?q=`, its region and
   * country shortcuts send `?state=` and `?country=`, "Top trails" sends
   * `?sort=rating`, and all of them used to land on the default list.
   *
   * Any of them turns near-me off. A search for "Yosemite" from Berlin is not
   * a search for Yosemite within 25 miles of Berlin, and that intersection
   * returns nothing without ever widening.
   */
  function applyUrlQuery(): boolean {
    const query = useRoute().query ?? {}
    const text = (value: unknown) => (typeof value === 'string' ? value.trim() : '')
    const q = text(query.q)
    const code = text(query.state)
    // `?country=all` is the "Everywhere" chip, and the only value here that is
    // not an ISO code.
    const rawCountry = text(query.country)
    const country = /^all$/i.test(rawCountry) ? 'all' : rawCountry.toUpperCase()
    const sort = text(query.sort)
    // `?near=me` is what the Trails Near Me shortcut opens, from the home
    // screen or Spotlight. It is the one parameter that turns near-me ON
    // rather than off: the link is a request for somewhere specific — here —
    // and it outranks the page's own default either way.
    const near = text(query.near).toLowerCase()
    const knownSort = ['featured', 'rating', 'longest', 'distance', 'name'].includes(sort)

    // A link can carry the filters too, so a shared list opens as the list
    // somebody was actually looking at rather than the default catalog.
    const linked = filtersFromQuery(query as Record<string, unknown>)
    difficulty.set(linked.difficulty)
    routeType.set(linked.routeType)
    lengthBucket.set(linked.length)
    elevationBucket.set(linked.elevation)
    minRating.set(linked.rating)
    dogsOnly.set(linked.dogsAllowed)
    accessibleOnly.set(linked.accessible)
    nationalOnly.set(linked.nationalTrail)

    if (q)
      search.set(q)
    if (knownSort)
      urlSort.set(sort)
    if (code)
      activeState.set(code)
    if (country)
      activeCountry.set(country)
    if (q || code || country || knownSort || activeFilterCount(linked) > 0)
      useNearMe.set(false)

    // `?near=San Diego&lat=..&lng=..` — trails near a town somebody searched
    // for, from the plans page or a shared link.
    const lat = Number(query.lat)
    const lng = Number(query.lng)
    if (near && near !== 'me' && query.lat !== undefined && Number.isFinite(lat) && Number.isFinite(lng) && Math.abs(lat) <= 90 && Math.abs(lng) <= 180)
      placeOrigin.set({ lat, lng, label: text(query.near) })

    // Answered in onMount by the same path the button takes, because turning
    // the flag on here is not enough: with no fix resolved yet, `nearMeActive`
    // stays false and the shortcut quietly lands on the national list.
    return near === 'me'
  }

  onMount(() => {
    const askedForNearMe = applyUrlQuery()
    void refreshDownloads()

    if (askedForNearMe) {
      void openNearMeFromLink()
    }
    else {
      // Resolve first, then search: opening the national catalog and swapping
      // it for a local one a beat later is two answers to one question.
      resolveNearby().finally(() => runSearch())
    }
    fetchCoverage().then(value => coverage.set(value))
    const cancelMap = runWhenMapReady('trails-explore-map', () => refreshExploreMap())
    const stop = effect(() => {
      results()
      refreshExploreMap()
    })
    return () => {
      cancelMap()
      stop()
    }
  })

  onDestroy(() => {
    if (debounce)
      clearTimeout(debounce)
    exploreMap?.destroy()
    exploreMap = null
  })
</script>

  <div class="mx-auto px-4 py-8 sm:px-6 lg:px-8 max-w-7xl">
    <!-- Catalog header. The count is the product: it is what tells someone
         this is a national database rather than a demo list. -->
    <div class="mb-6">
      <h1 class="font-display text-3xl font-bold leading-tight tracking-[-0.03em] text-slate-900 dark:text-white md:text-4xl">{{ heading() }}</h1>
      <p class="mt-2 max-w-[65ch] text-slate-600 dark:text-slate-400">
        <span :if="coverage().total > 0" class="font-semibold text-slate-900 dark:text-white tabular-nums">{{ coverage().total.toLocaleString() }}</span>
        <span :if="coverage().total > 0"> trails across {{ coverage().states.length }} regions in {{ countries().length }} countries, from OpenStreetMap, the Forest Service and the Park Service.</span>
        <span :if="coverage().total === 0">Trail search across the US, Germany, Austria and Switzerland.</span>
      </p>
    </div>

    <!-- Location bar. The catalog's whole job is to answer "where should I go
         this weekend", and that question is meaningless without a where. This
         is the control that states the answer it is using and lets it be
         corrected — in one line, above the filters, because it changes what
         every filter below it means. -->
    <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-2xl border border-slate-200 bg-white px-3 py-2.5 shadow-sm dark:border-slate-700 dark:bg-slate-800/60 dark:shadow-none">
      <span class="flex min-w-0 items-center gap-2.5 text-sm text-slate-600 dark:text-slate-300">
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400" aria-hidden="true">
          <i class="i-lucide-map-pin h-4 w-4"></i>
        </span>
        <span :if="placeActive()">
          <span class="font-semibold text-slate-900 dark:text-white">{{ 'Near ' + placeLabel() }}</span>
          <span :if="nearRadius() > 0" class="text-slate-500 dark:text-slate-400">{{ ' · within ' + nearRadius() + ' mi' }}</span>
        </span>
        <span :if="!placeActive() && nearMeActive()">
          <span class="font-semibold text-slate-900 dark:text-white">{{ nearbyLabel() }}</span>
          <span :if="nearRadius() > 0" class="text-slate-500 dark:text-slate-400">{{ ' · within ' + nearRadius() + ' mi' }}</span>
        </span>
        <span :if="!placeActive() && !nearMeActive() && nearbyBusy()">Finding you…</span>
        <!-- Naming the country matters most when nobody picked it: the list is
             scoped to wherever the request came from, and "the whole catalog"
             was the page describing a scope it did not have. -->
        <span :if="!placeActive() && !nearMeActive() && !nearbyBusy()">{{ countryInView() ? 'Showing trails in ' + countryName(countryInView()) : 'Showing the whole catalog' }}</span>
      </span>

      <div class="ml-auto flex flex-wrap items-center gap-2">
        <!-- Browsing somewhere else: plan it, or go back to here. -->
        <StxLink :if="placeActive()" x-to="planHereUrl()" class="inline-flex min-h-9 items-center gap-1.5 rounded-full bg-emerald-600 px-4 text-xs font-semibold text-white shadow-sm transition hover:bg-emerald-700 active:scale-[0.98]">
          <i class="i-lucide-calendar-plus h-3.5 w-3.5" aria-hidden="true"></i>
          Plan a run here
        </StxLink>
        <button :if="placeActive()" @click="clearPlace()" class="min-h-9 rounded-full px-3 text-xs font-semibold text-slate-500 transition hover:bg-slate-100 hover:text-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60 dark:hover:text-white">
          Clear
        </button>

        <!-- A coarse fix came from the request's network, so it can be a city
             off. Offering to improve it is more useful than pretending it is
             exact. -->
        <button
          :if="!placeActive() && nearMeActive() && nearbyIsCoarse()"
          @click="refineLocation()"
          x-disabled="nearbyBusy()"
          class="min-h-9 rounded-full border border-slate-300 px-3.5 text-xs font-semibold text-slate-700 transition hover:border-emerald-400 hover:text-emerald-700 active:scale-[0.98] disabled:opacity-60 dark:border-slate-600 dark:text-slate-300">
          {{ nearbyBusy() ? 'Locating…' : 'Use my exact location' }}
        </button>

        <button
          :if="!placeActive() && nearMeActive()"
          @click="forgetLocation()"
          class="min-h-9 rounded-full px-3 text-xs font-semibold text-slate-500 transition hover:bg-slate-100 hover:text-slate-800 dark:text-slate-400 dark:hover:bg-slate-700/60 dark:hover:text-white">
          Browse everywhere
        </button>

        <button
          :if="!placeActive() && !nearMeActive()"
          @click="enableNearMe()"
          x-disabled="nearbyBusy()"
          class="inline-flex min-h-9 items-center gap-1.5 rounded-full bg-emerald-600 px-4 text-xs font-semibold text-white shadow-sm transition hover:bg-emerald-700 active:scale-[0.98] disabled:opacity-60">
          <i class="i-lucide-locate-fixed h-3.5 w-3.5" aria-hidden="true"></i>
          {{ nearbyBusy() ? 'Locating…' : 'Trails near me' }}
        </button>
      </div>

      <p :if="nearbyMessage()" class="w-full text-xs text-amber-600 dark:text-amber-400">{{ nearbyMessage() }}</p>

      <!-- Anywhere else: a town or city, for planning a trip there. -->
      <div class="relative w-full">
        <label for="trails-place" class="sr-only">Trails near a town or city</label>
        <div class="flex items-center gap-2 rounded-xl bg-slate-50 px-3 dark:bg-slate-900/50">
          <i class="i-lucide-search h-3.5 w-3.5 shrink-0 text-slate-400" aria-hidden="true"></i>
          <input id="trails-place" type="search" autocomplete="off" placeholder="Trails near a town or city…" x-value="placeQuery()" @input="onPlaceInput($event)" class="min-h-10 w-full min-w-0 bg-transparent text-base text-slate-900 placeholder:text-slate-400 focus:outline-none sm:text-sm dark:text-white" />
        </div>
        <ul :if="placeResults().length > 0" class="absolute inset-x-0 top-full z-30 mt-1 divide-y divide-slate-100 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl dark:divide-slate-700/70 dark:border-slate-700 dark:bg-slate-800">
          <template :for="place in placeResults()">
            <li>
              <button type="button" @click="choosePlace(place)" class="flex min-h-11 w-full items-center gap-3 px-3 py-2 text-left transition hover:bg-slate-50 dark:hover:bg-slate-700/60">
                <i class="i-lucide-map-pin h-4 w-4 shrink-0 text-emerald-600" aria-hidden="true"></i>
                <span class="min-w-0">
                  <span class="block truncate text-sm font-semibold text-slate-900 dark:text-white">{{ place.name }}</span>
                  <span class="block truncate text-xs text-slate-500 dark:text-slate-400">{{ place.detail }}</span>
                </span>
              </button>
            </li>
          </template>
        </ul>
      </div>
    </div>

    <!-- Browse by country. Shown only once there is more than one: a single
         pill reading "United States" is a control that cannot do anything. -->
    <div :if="countries().length > 1" class="wl-scroll-row -mx-4 mb-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:px-0">
      <button
        @click="selectCountry('all')"
        x-class="chipCountry === 'all' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900' : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700'"
        class="min-h-10 shrink-0 rounded-full px-4 text-sm font-medium transition active:scale-[0.98]">
        Everywhere
      </button>
      <template :for="c in countries">
        <button
          @click="selectCountry(c.code)"
          x-class="chipCountry === c.code ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900' : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700'"
          class="min-h-10 shrink-0 rounded-full px-4 text-sm font-medium transition active:scale-[0.98]">
          {{ countryName(c.code) }}
          <span class="ml-1.5 text-xs opacity-60 tabular-nums">{{ c.count.toLocaleString() }}</span>
        </button>
      </template>
    </div>

    <!-- Search + filters.

         One search field and a row of chips that each say what they are set
         to, because a bar of controls all reading "Length" gives no way to see
         how the list in front of you was narrowed. Every chip opens the same
         single-select panel; only its rows differ. -->
    <div class="relative mb-6">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center">
        <div class="relative flex-1">
          <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">
            <Icon name="search" size="18" />
          </span>
          <input
            type="search"
            x-value="search"
            @input="onSearchInput($event.target.value)"
            placeholder="Search trails by name, park, forest or Land"
            class="h-12 w-full rounded-full border border-slate-200 bg-white pl-11 pr-11 text-base text-slate-900 shadow-sm transition placeholder:text-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-700 dark:bg-slate-800 dark:text-white dark:shadow-none"
          />
          <!-- Clearing a search by selecting the text and deleting it is work
               nobody should have to do on a phone. -->
          <button
            :if="search().length > 0"
            @click="clearSearchText()"
            aria-label="Clear search"
            class="absolute right-1.5 top-1/2 grid h-9 w-9 -translate-y-1/2 place-items-center rounded-full text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-700 dark:hover:text-white">
            <i class="i-lucide-x h-4 w-4" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <div class="wl-scroll-row -mx-4 mt-3 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:px-0">
        <button
          @click="togglePanel('all')"
          x-class="openFilter === 'all' || filterCount() > 0 ? 'border-emerald-500 bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300' : 'border-slate-200 bg-white text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300'"
          class="flex min-h-10 shrink-0 items-center gap-1.5 rounded-full border px-4 text-sm font-medium transition hover:border-slate-300 active:scale-[0.98] dark:hover:border-slate-600">
          <i class="i-lucide-sliders-horizontal h-4 w-4" aria-hidden="true"></i>
          <span>All filters</span>
          <span :if="filterCount() > 0" class="grid h-5 min-w-5 place-items-center rounded-full bg-emerald-600 px-1 text-[11px] font-bold text-white tabular-nums">{{ filterCount() }}</span>
        </button>

        <button
          @click="togglePanel('difficulty')"
          x-class="difficulty !== 'all' ? 'border-emerald-500 bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300' : 'border-slate-200 bg-white text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300'"
          class="flex min-h-10 shrink-0 items-center gap-1.5 rounded-full border px-4 text-sm font-medium transition hover:border-slate-300 active:scale-[0.98] dark:hover:border-slate-600">
          <span>{{ difficultyLabel() }}</span>
          <i class="i-lucide-chevron-down h-3.5 w-3.5 opacity-60" aria-hidden="true"></i>
        </button>

        <button
          @click="togglePanel('length')"
          x-class="lengthBucket !== 'any' ? 'border-emerald-500 bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300' : 'border-slate-200 bg-white text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300'"
          class="flex min-h-10 shrink-0 items-center gap-1.5 rounded-full border px-4 text-sm font-medium transition hover:border-slate-300 active:scale-[0.98] dark:hover:border-slate-600">
          <span>{{ lengthLabel() }}</span>
          <i class="i-lucide-chevron-down h-3.5 w-3.5 opacity-60" aria-hidden="true"></i>
        </button>

        <button
          @click="togglePanel('elevation')"
          x-class="elevationBucket !== 'any' ? 'border-emerald-500 bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300' : 'border-slate-200 bg-white text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300'"
          class="flex min-h-10 shrink-0 items-center gap-1.5 rounded-full border px-4 text-sm font-medium transition hover:border-slate-300 active:scale-[0.98] dark:hover:border-slate-600">
          <span>{{ elevationLabel() }}</span>
          <i class="i-lucide-chevron-down h-3.5 w-3.5 opacity-60" aria-hidden="true"></i>
        </button>

        <button
          @click="togglePanel('route')"
          x-class="routeType !== 'all' ? 'border-emerald-500 bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300' : 'border-slate-200 bg-white text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300'"
          class="flex min-h-10 shrink-0 items-center gap-1.5 rounded-full border px-4 text-sm font-medium transition hover:border-slate-300 active:scale-[0.98] dark:hover:border-slate-600">
          <span>{{ routeLabel() }}</span>
          <i class="i-lucide-chevron-down h-3.5 w-3.5 opacity-60" aria-hidden="true"></i>
        </button>

        <button
          @click="togglePanel('rating')"
          x-class="minRating > 0 ? 'border-emerald-500 bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300' : 'border-slate-200 bg-white text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300'"
          class="flex min-h-10 shrink-0 items-center gap-1.5 rounded-full border px-4 text-sm font-medium transition hover:border-slate-300 active:scale-[0.98] dark:hover:border-slate-600">
          <span>{{ ratingLabel() }}</span>
          <i class="i-lucide-chevron-down h-3.5 w-3.5 opacity-60" aria-hidden="true"></i>
        </button>

        <button
          :if="filterCount() > 0"
          @click="clearFilters()"
          class="min-h-10 shrink-0 rounded-full px-3 text-sm font-semibold text-slate-500 underline-offset-2 transition hover:text-slate-900 hover:underline dark:text-slate-400 dark:hover:text-white">
          Clear
        </button>
      </div>

      <!-- A tap anywhere else closes the open panel, without a document
           listener the page would then have to remember to remove. -->
      <div :if="openFilter() !== ''" @click="closePanel()" class="fixed inset-0 z-30" aria-hidden="true"></div>

      <div :if="panelOptions().length > 0" class="absolute left-0 top-full z-40 mt-2 max-h-80 w-64 overflow-y-auto rounded-2xl border border-slate-200 bg-white p-1.5 shadow-xl dark:border-slate-700 dark:bg-slate-800">
        <template :for="option in panelOptions">
          <button
            @click="choosePanelOption(option.id)"
            x-class="option.active ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300' : 'text-slate-600 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700/60'"
            class="flex min-h-11 w-full items-center justify-between rounded-xl px-3 text-left text-sm font-medium transition">
            <span>{{ option.label }}</span>
            <i x-class="option.active ? 'i-lucide-check h-4 w-4' : 'hidden'" aria-hidden="true"></i>
          </button>
        </template>
      </div>

      <!-- Everything that is not a single choice: the suitability toggles and
           the ordering, plus the one control that undoes all of it. -->
      <div :if="openFilter() === 'all'" class="absolute left-0 top-full z-40 mt-2 w-full max-w-sm rounded-2xl border border-slate-200 bg-white p-4 shadow-xl dark:border-slate-700 dark:bg-slate-800">
        <p class="metric-label mb-2">Suitability</p>
        <div class="flex flex-wrap gap-2">
          <button
            @click="toggleDogsOnly()"
            x-class="dogsOnly ? 'border-emerald-500 bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300' : 'border-slate-200 text-slate-600 dark:border-slate-600 dark:text-slate-300'"
            class="flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm font-medium transition">
            <i class="i-lucide-dog h-4 w-4" aria-hidden="true"></i>Dogs allowed
          </button>
          <button
            @click="toggleAccessibleOnly()"
            x-class="accessibleOnly ? 'border-emerald-500 bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300' : 'border-slate-200 text-slate-600 dark:border-slate-600 dark:text-slate-300'"
            class="flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm font-medium transition">
            <i class="i-lucide-accessibility h-4 w-4" aria-hidden="true"></i>Accessible
          </button>
          <button
            @click="toggleNationalOnly()"
            x-class="nationalOnly ? 'border-emerald-500 bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300' : 'border-slate-200 text-slate-600 dark:border-slate-600 dark:text-slate-300'"
            class="flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm font-medium transition">
            <i class="i-lucide-landmark h-4 w-4" aria-hidden="true"></i>National Trails
          </button>
        </div>

        <p class="metric-label mb-2 mt-4">Sort by</p>
        <div class="flex flex-wrap gap-2">
          <template :for="option in sortOptions">
            <button
              @click="chooseSort(option.id)"
              x-class="sortChoice === option.id ? 'border-emerald-500 bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300' : 'border-slate-200 text-slate-600 dark:border-slate-600 dark:text-slate-300'"
              class="rounded-full border px-3 py-1.5 text-sm font-medium transition">
              {{ option.label }}
            </button>
          </template>
        </div>

        <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3 dark:border-slate-700">
          <button @click="clearFilters()" class="text-sm font-semibold text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">Clear all</button>
          <button @click="closePanel()" class="rounded-full bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98]">Show results</button>
        </div>
      </div>
    </div>

    <!-- Browse by region. Horizontal pills rather than a long list: the
         catalog covers every state and Land, and a dropdown hides that fact.
         Scoped to the country in view once one is picked. -->
    <div :if="topStates().length > 0" class="wl-scroll-row -mx-4 mb-8 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:px-0">
      <button
        @click="activeState.set(''); runSearch()"
        x-class="activeState === '' ? 'border-emerald-500 bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-300' : 'border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400'"
        class="min-h-10 shrink-0 rounded-full border px-4 text-sm font-medium transition hover:border-emerald-400">
        All regions
      </button>
      <template :for="s in topStates">
        <button
          @click="selectState(s.code)"
          x-class="activeState === s.code ? 'border-emerald-500 bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-300' : 'border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400'"
          class="min-h-10 shrink-0 rounded-full border px-4 text-sm font-medium transition hover:border-emerald-400">
          <span>{{ s.name }}</span>
          <span class="ml-1.5 text-xs tabular-nums opacity-60">{{ s.count.toLocaleString() }}</span>
        </button>
      </template>
    </div>

    <div :if="catalogError()" class="mb-4 text-sm text-amber-600 dark:text-amber-400">{{ 'Using demo trails. ' + catalogError() }}</div>

    <!-- What the last download did. A button that saves half a gigabyte of
         tiles silently is a button people press twice. -->
    <div :if="downloadNote()" class="mb-4 flex items-center gap-2 rounded-xl bg-emerald-50 px-4 py-2.5 text-sm text-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-300">
      <i class="i-lucide-hard-drive-download h-4 w-4 shrink-0" aria-hidden="true"></i>
      <span>{{ downloadNote() }}</span>
    </div>

    <!-- How many matched. Above the split because the list it used to sit in
         is desktop-only, and the count is the one part of that list a phone
         still needs. -->
    <p class="mb-3 flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
      <i :if="searching()" class="i-lucide-loader-circle h-4 w-4 animate-spin text-emerald-600" aria-hidden="true"></i>
      <span :if="searching()">Searching…</span>
      <span :if="!searching()" class="font-semibold text-slate-700 tabular-nums dark:text-slate-200">{{ matchCount().toLocaleString() + (matchCount() === 1 ? ' trail' : ' trails') }}</span>
      <span :if="!searching() && matchCount() > results().length">{{ '· showing first ' + results().length }}</span>
    </p>

    <!-- Split: result list + map.

         The list is the map's other half: it exists to be read beside the pins
         and to highlight one. Below `lg` the two stack, and it became a second
         copy of every card further down the page — 21 trails rendered as 42
         entries to scroll past. So on a phone the map keeps the row to itself
         and the cards are the only list. -->
    <div class="grid gap-6 mb-8 lg:grid-cols-5">
      <div class="hidden lg:block lg:col-span-2 space-y-3 max-h-[28rem] overflow-y-auto pr-1">

        <!-- Skeletons match the row shape so the list does not jump. -->
        <template :if="searching() && results().length === 0">
          <div class="space-y-3">
            <div class="flex animate-pulse items-center gap-3 rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-800"><div class="h-14 w-14 shrink-0 rounded-lg bg-slate-200 dark:bg-slate-700"></div><div class="flex-1 space-y-2"><div class="h-3 w-2/3 rounded bg-slate-200 dark:bg-slate-700"></div><div class="h-3 w-1/2 rounded bg-slate-200 dark:bg-slate-700"></div></div></div>
            <div class="flex animate-pulse items-center gap-3 rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-800"><div class="h-14 w-14 shrink-0 rounded-lg bg-slate-200 dark:bg-slate-700"></div><div class="flex-1 space-y-2"><div class="h-3 w-1/2 rounded bg-slate-200 dark:bg-slate-700"></div><div class="h-3 w-2/3 rounded bg-slate-200 dark:bg-slate-700"></div></div></div>
            <div class="flex animate-pulse items-center gap-3 rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-800"><div class="h-14 w-14 shrink-0 rounded-lg bg-slate-200 dark:bg-slate-700"></div><div class="flex-1 space-y-2"><div class="h-3 w-3/5 rounded bg-slate-200 dark:bg-slate-700"></div><div class="h-3 w-2/5 rounded bg-slate-200 dark:bg-slate-700"></div></div></div>
          </div>
        </template>

        <template :for="trail in results">
          <StxLink
            x-to="'/trail/' + trail.id"
            @click="selectedTrailId.set(trail.id)"
            x-class="selectedTrailId === trail.id ? 'border-emerald-500 ring-2 ring-emerald-500/40 bg-emerald-50 dark:bg-emerald-900/20' : 'border-slate-200 bg-white hover:border-emerald-300 dark:border-slate-700 dark:bg-slate-800'"
            class="flex items-center gap-3 rounded-2xl border p-2.5 pr-3 transition hover:shadow-md dark:hover:border-emerald-700"
          >
            <div class="relative h-14 w-14 shrink-0 overflow-hidden rounded-xl bg-slate-100 dark:bg-slate-800">
              <Image :if="cardPhoto(trail) !== ''" x-src="cardPhoto(trail)" x-alt="trail.name" width="56" height="56" sizes="56px" placeholder="blur" class="object-cover h-full w-full" />
              <span :if="cardPhoto(trail) === ''" x-class="coverClass(trail)" class="absolute inset-0 grid place-items-center text-emerald-700/40 dark:text-emerald-300/30" aria-hidden="true">
                <svg :if="coverRoute(trail.id).points !== ''" viewBox="0 0 160 120" class="h-full w-full">
                  <polyline x-points="coverRoute(trail.id).points" class="wl-route-casing" />
                  <polyline x-points="coverRoute(trail.id).points" class="wl-route-line" />
                </svg>
                <i :if="coverRoute(trail.id).points === ''" class="i-lucide-mountain h-5 w-5"></i>
              </span>
            </div>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">{{ trail.name }}</p>
              <p class="truncate text-xs text-slate-500 dark:text-slate-400">{{ trail.location }}</p>
              <p class="mt-1 flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
                <span x-class="'rounded-md px-1.5 py-px text-[10px] font-bold uppercase tracking-wide difficulty-' + trail.difficulty">{{ trail.difficulty }}</span>
                <span class="tabular-nums">{{ trail.distance + ' mi' }}</span>
                <span :if="trail.rating > 0" class="inline-flex items-center gap-0.5 tabular-nums"><i class="i-lucide-star h-3 w-3 text-amber-500" aria-hidden="true"></i>{{ trail.rating.toFixed(1) }}</span>
              </p>
            </div>
            <i class="i-lucide-chevron-right h-4 w-4 shrink-0 text-slate-300 dark:text-slate-600" aria-hidden="true"></i>
          </StxLink>
        </template>

        <div :if="!searching() && results().length === 0" class="grid h-full place-items-center rounded-2xl border border-dashed border-slate-200 px-6 py-10 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
          No trails match your filters.
        </div>
      </div>

      <!-- Not `card`: its padding framed the map in a white border. -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-sm lg:col-span-3 dark:border-slate-700 dark:bg-slate-800 dark:shadow-none">
        <div id="trails-explore-map" data-stx-ignore class="trail-map-panel ts-map-container"></div>
      </div>
    </div>

    <!-- Trail cards.

         Photo first and unobstructed: it is the thing someone actually reads a
         trail card by, and every chip laid over it was covering the picture to
         repeat something the line underneath already says. So the image carries
         one control — the save button — and the facts sit below it on a single
         line, in the order a decision gets made: how good, how hard, how far,
         how long. -->
    <div class="grid gap-x-5 gap-y-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <!-- Card-shaped skeletons while the first answer is on its way, so the
           grid arrives into space already held for it. -->
      <template :if="searching() && results().length === 0">
        <div class="animate-pulse"><div class="h-48 rounded-2xl bg-slate-200 sm:h-52 dark:bg-slate-800"></div><div class="mt-3 h-4 w-3/4 rounded bg-slate-200 dark:bg-slate-800"></div><div class="mt-2 h-3 w-1/2 rounded bg-slate-200 dark:bg-slate-800"></div><div class="mt-2 h-3 w-2/3 rounded bg-slate-200 dark:bg-slate-800"></div></div>
        <div class="animate-pulse"><div class="h-48 rounded-2xl bg-slate-200 sm:h-52 dark:bg-slate-800"></div><div class="mt-3 h-4 w-2/3 rounded bg-slate-200 dark:bg-slate-800"></div><div class="mt-2 h-3 w-2/5 rounded bg-slate-200 dark:bg-slate-800"></div><div class="mt-2 h-3 w-1/2 rounded bg-slate-200 dark:bg-slate-800"></div></div>
        <div class="hidden animate-pulse sm:block"><div class="h-48 rounded-2xl bg-slate-200 sm:h-52 dark:bg-slate-800"></div><div class="mt-3 h-4 w-4/5 rounded bg-slate-200 dark:bg-slate-800"></div><div class="mt-2 h-3 w-1/2 rounded bg-slate-200 dark:bg-slate-800"></div><div class="mt-2 h-3 w-3/5 rounded bg-slate-200 dark:bg-slate-800"></div></div>
        <div class="hidden animate-pulse xl:block"><div class="h-48 rounded-2xl bg-slate-200 sm:h-52 dark:bg-slate-800"></div><div class="mt-3 h-4 w-3/5 rounded bg-slate-200 dark:bg-slate-800"></div><div class="mt-2 h-3 w-2/5 rounded bg-slate-200 dark:bg-slate-800"></div><div class="mt-2 h-3 w-1/2 rounded bg-slate-200 dark:bg-slate-800"></div></div>
      </template>

      <template :for="trail in results">
        <article class="group">
          <div class="relative overflow-hidden rounded-2xl bg-slate-100 ring-1 ring-slate-900/5 dark:bg-slate-800 dark:ring-white/5">
            <StxLink x-to="'/trail/' + trail.id" @click="selectedTrailId.set(trail.id)" class="block h-48 sm:h-52">
              <Image :if="cardPhoto(trail) !== ''" x-src="cardPhoto(trail)" x-alt="cardPhotoIllustrative(trail) ? 'Illustrative landscape' : trail.coverScope === 'area' ? 'Photo of ' + trail.coverPlace + ' area' : trail.name" width="800" height="600" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw" placeholder="blur" class="h-full w-full object-cover duration-500 transition-transform group-hover:scale-[1.03]" />
              <!-- No photo published for this trail. A neutral frame says that
                   much; the stand-in forest that used to sit here said this is
                   what the trail looks like, for every trail alike. -->
              <!-- When the catalog does hold the line, the line is the picture:
                   it is the one thing on the card that is actually this trail. -->
              <span :if="cardPhoto(trail) === ''" x-class="coverClass(trail)" class="relative grid h-full w-full place-items-center text-emerald-800/25 transition-transform duration-500 group-hover:scale-[1.03] dark:text-emerald-200/20" aria-hidden="true">
                <svg :if="coverRoute(trail.id).points !== ''" viewBox="0 0 160 120" class="absolute inset-0 h-full w-full">
                  <polyline x-points="coverRoute(trail.id).points" class="wl-route-casing" />
                  <polyline x-points="coverRoute(trail.id).points" class="wl-route-line" />
                  <circle x-cx="coverRoute(trail.id).endX" x-cy="coverRoute(trail.id).endY" r="3" x-class="coverRoute(trail.id).loop ? 'hidden' : 'wl-route-end'" />
                  <circle x-cx="coverRoute(trail.id).startX" x-cy="coverRoute(trail.id).startY" r="3" class="wl-route-start" />
                </svg>
                <i :if="coverRoute(trail.id).points === ''" class="i-lucide-mountain h-12 w-12"></i>
              </span>
            </StxLink>

            <!-- A licensed landscape, not this trail. Said on the card for the
                 same reason the trail page says it under the hero. -->
            <span :if="cardPhotoIllustrative(trail)" class="absolute bottom-3 right-3 rounded-full bg-slate-900/65 px-2 py-0.5 text-[10px] font-medium text-white/85 backdrop-blur-sm">Illustrative</span>
            <span :if="trail.coverScope === 'area'" class="absolute bottom-3 right-3 rounded-full bg-slate-900/65 px-2 py-0.5 text-[10px] font-medium text-white/85 backdrop-blur-sm">Area photo</span>
            <span :if="trail.coverCredit" class="absolute bottom-3 left-3 max-w-[80%] truncate rounded-full bg-slate-900/65 px-2 py-0.5 text-[10px] font-medium text-white/85 backdrop-blur-sm">{{ 'Photo by ' + trail.coverCredit }}</span>

            <!-- What this trail is, in one word, where a photo has room for
                 it. Only ever from a tag the catalog actually carries. -->
            <span :if="highlightLabel(trail) !== ''" class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-slate-900/75 px-2.5 py-1 text-[11px] font-semibold text-white backdrop-blur-sm">
              <i x-class="highlightIcon(trail) + ' h-3.5 w-3.5'" aria-hidden="true"></i>
              {{ highlightLabel(trail) }}
            </span>

            <div class="absolute right-3 top-3 flex gap-1.5">
              <!-- Take it offline from the list. Planning a weekend used to
                   mean opening each trail in turn to press the same button. -->
              <button
                @click.stop.prevent="onDownload(trail)"
                x-class="isDownloaded(trail.id) ? 'text-emerald-600 dark:text-emerald-400' : 'text-slate-700 hover:text-emerald-600 dark:text-slate-200 dark:hover:text-emerald-400'"
                class="grid h-11 w-11 place-items-center rounded-full bg-white/95 shadow-md backdrop-blur-sm transition hover:scale-105 active:scale-95 disabled:opacity-60 sm:h-9 sm:w-9 dark:bg-slate-900/85"
                x-disabled="isDownloading(trail.id)"
                x-aria-label="isDownloaded(trail.id) ? 'Remove offline copy' : 'Download for offline use'">
                <i x-class="isDownloading(trail.id) ? 'i-lucide-loader-circle h-4 w-4 animate-spin' : (isDownloaded(trail.id) ? 'i-lucide-circle-check-big h-4 w-4' : 'i-lucide-circle-arrow-down h-4 w-4')" aria-hidden="true"></i>
              </button>

              <!-- Inline SVG rather than <Icon>: the heart has to FILL when the
                   trail is saved, and the Icon component hardcodes fill="none"
                   on the svg it renders, so an outline was the only state it
                   could ever show. -->
              <button
                @click.stop.prevent="onToggleSave(trail.id)"
                x-class="wl.isTrailSaved(trail.id) ? 'text-rose-500' : 'text-slate-700 hover:text-rose-500 dark:text-slate-200'"
                class="grid h-11 w-11 place-items-center rounded-full bg-white/95 shadow-md backdrop-blur-sm transition hover:scale-105 active:scale-95 sm:h-9 sm:w-9 dark:bg-slate-900/85"
                x-aria-label="wl.isTrailSaved(trail.id) ? 'Remove from saved trails' : 'Save this trail'">
                <svg width="17" height="17" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" x-fill="wl.isTrailSaved(trail.id) ? 'currentColor' : 'none'" aria-hidden="true">
                  <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                </svg>
              </button>
            </div>

            <!-- The route's own shape, which is what tells a loop from an out
                 and back at a glance. Drawn from the geometry the search
                 already returned, so it costs no request. -->
            <span :if="cardPhoto(trail) !== '' && routeThumb(trail.id) !== ''" class="absolute bottom-3 right-3 h-14 w-14 overflow-hidden rounded-xl border-2 border-white bg-white shadow-md">
              <Image x-src="routeThumb(trail.id)" x-alt="'Route shape for ' + trail.name" width="56" height="56" sizes="56px" class="h-full w-full object-cover" />
            </span>
          </div>

          <div class="pt-3">
            <StxLink x-to="'/trail/' + trail.id" @click="selectedTrailId.set(trail.id)" class="block">
              <h3 class="font-semibold text-slate-900 dark:text-white line-clamp-1 group-hover:underline">{{ trail.name }}</h3>
            </StxLink>
            <p class="mt-0.5 text-sm text-slate-500 dark:text-slate-400 line-clamp-1">{{ trail.location }}</p>

            <!-- One meta line, dot-separated. Difficulty is a colour swatch
                 plus the word: the swatch is what makes a grid of cards
                 scannable, the word is what makes it readable to anyone who
                 does not know the colour code yet. -->
            <p class="mt-1.5 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-slate-600 dark:text-slate-300">
              <span :if="trail.rating > 0" class="inline-flex items-center gap-1">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="text-slate-900 dark:text-white" aria-hidden="true">
                  <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2Z" />
                </svg>
                <span class="tabular-nums">{{ trail.rating.toFixed(1) }}</span>
                <!-- How many people that average is built on, which is what
                     makes a 4.8 mean something. -->
                <span :if="trail.reviewCount > 0" class="text-slate-400 tabular-nums dark:text-slate-500">{{ '(' + trail.reviewCount.toLocaleString() + ')' }}</span>
              </span>
              <span :if="trail.rating > 0" class="inline-flex items-center gap-x-1.5 whitespace-nowrap">
                <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
                <span x-class="'h-2.5 w-2.5 rounded-[3px] difficulty-' + trail.difficulty" aria-hidden="true"></span>
                <span class="capitalize">{{ trail.difficulty }}</span>
              </span>

              <span :if="trail.rating === 0" class="inline-flex items-center gap-1.5">
                <span x-class="'h-2.5 w-2.5 rounded-[3px] difficulty-' + trail.difficulty" aria-hidden="true"></span>
                <span class="capitalize">{{ trail.difficulty }}</span>
              </span>

              <!-- Separator and value travel together, so a wrap never leaves
                   a dot hanging at the end of a line. -->
              <span class="inline-flex items-center gap-x-1.5 whitespace-nowrap">
                <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
                <span class="tabular-nums">{{ trail.distance.toLocaleString() + ' mi' }}</span>
              </span>

              <span :if="trail.estimatedTime" class="inline-flex items-center gap-x-1.5 whitespace-nowrap">
                <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
                <span class="tabular-nums">{{ 'Est. ' + trail.estimatedTime }}</span>
              </span>
            </p>

            <!-- Who has been up there lately.

                 A rating and a lifetime count say how a trail has been judged
                 over years; three faces and a month's count say whether anyone
                 has walked it since the last storm — which is the question a
                 weekend is planned on. Absent entirely for a quiet trail
                 rather than shown as a zero. -->
            <p :if="reviewerCountLabel(trail.id) !== ''" class="mt-2 flex items-center gap-2">
              <span class="flex -space-x-1.5">
                <template :for="reviewer in reviewerFaces(trail.id)">
                  <span
                    x-class="'grid h-6 w-6 place-items-center rounded-full text-[11px] font-bold ring-2 ring-white dark:ring-slate-900 ' + faceTint(reviewer)"
                    x-title="reviewer.name"
                    aria-hidden="true">{{ faceInitial(reviewer.name) }}</span>
                </template>
                <span
                  :if="reviewerOverflow(trail.id) !== ''"
                  class="grid h-6 min-w-6 place-items-center rounded-full bg-slate-200 px-1 text-[10px] font-bold text-slate-600 ring-2 ring-white tabular-nums dark:bg-slate-700 dark:text-slate-200 dark:ring-slate-900"
                  aria-hidden="true">{{ reviewerOverflow(trail.id) }}</span>
              </span>
              <span class="text-sm text-slate-500 dark:text-slate-400">{{ reviewerCountLabel(trail.id) }}</span>
            </p>

            <p :if="trail.nationalTrail || routeLabelFor(trail) !== ''" class="mt-1.5 flex flex-wrap gap-1.5">
              <span :if="trail.nationalTrail" class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300">
                <i class="i-lucide-landmark h-3 w-3" aria-hidden="true"></i>National Trail
              </span>
              <!-- Every shape, not just loops: whether you finish where you
                   started decides whether a second car is needed. -->
              <span :if="routeLabelFor(trail) !== ''" class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600 dark:bg-slate-700 dark:text-slate-300">
                <i class="i-lucide-route h-3 w-3" aria-hidden="true"></i>{{ routeLabelFor(trail) }}
              </span>
            </p>
          </div>
        </article>
      </template>
    </div>

    <!-- The map is below the list on a phone, which is where it belongs while
         reading results and exactly wrong when the question is "where are
         these". A plain in-page anchor gets there: no script, no second view
         to keep in step with the list. -->
    <a
      href="#trails-explore-map"
      class="fixed bottom-24 left-1/2 z-40 flex -translate-x-1/2 items-center gap-2 rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-lg transition active:scale-[0.98] lg:hidden dark:bg-white dark:text-slate-900">
      <i class="i-lucide-map h-4 w-4" aria-hidden="true"></i>
      Map
    </a>

    <div :if="!searching() && results().length === 0" class="py-16 text-center sm:py-20">
      <div class="wl-topo wl-topo-1 mx-auto mb-6 grid h-20 w-20 place-items-center rounded-3xl ring-1 ring-emerald-900/5 dark:ring-white/5">
        <i class="i-lucide-mountain h-9 w-9 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
      </div>
      <h3 class="mb-2 font-display text-xl font-bold tracking-tight text-slate-900 dark:text-white">No trails found</h3>
      <p class="mx-auto mb-6 max-w-sm text-slate-500 dark:text-slate-400">Try a wider search, or clear the filters to browse the whole catalog.</p>
      <button @click="search.set(''); activeState.set(''); clearFilters()" class="inline-flex min-h-11 items-center gap-2 rounded-full bg-emerald-600 px-6 text-sm font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98]">
        <i class="i-lucide-rotate-ccw h-4 w-4" aria-hidden="true"></i>
        Clear filters
      </button>
    </div>
  </div>
<style>
  /* Chip rows scroll sideways on a phone; the scrollbar under them read as a
     stray grey rule rather than as a hint. */
  .wl-scroll-row { scrollbar-width: none; }
  .wl-scroll-row::-webkit-scrollbar { display: none; }

  /* The field draws its own clear button; the native one doubled it. */
  input[type='search']::-webkit-search-cancel-button { -webkit-appearance: none; }

  /* Contour-tinted ground for a card with no photo. Four layouts, picked by
     id, so a grid of them reads as different places rather than one tile. */
  .wl-topo {
    --topo-x: 78%;
    --topo-y: 28%;

    background-color: #eef3ef;
    background-image:
      radial-gradient(90% 120% at 12% 115%, rgb(16 185 129 / 0.12), transparent 60%),
      repeating-radial-gradient(ellipse 150% 110% at var(--topo-x) var(--topo-y), transparent 0 15px, rgb(15 70 45 / 0.08) 15px 16px),
      repeating-radial-gradient(ellipse 80% 60% at calc(100% - var(--topo-x)) calc(100% - var(--topo-y)), transparent 0 23px, rgb(15 70 45 / 0.045) 23px 24px);
  }

  .wl-topo-1 { --topo-x: 22%; --topo-y: 30%; }
  .wl-topo-2 { --topo-x: 60%; --topo-y: 85%; }
  .wl-topo-3 { --topo-x: 95%; --topo-y: 65%; }

  .dark .wl-topo {
    background-color: #0f1a16;
    background-image:
      radial-gradient(90% 120% at 12% 115%, rgb(16 185 129 / 0.14), transparent 60%),
      repeating-radial-gradient(ellipse 150% 110% at var(--topo-x) var(--topo-y), transparent 0 15px, rgb(167 243 208 / 0.065) 15px 16px),
      repeating-radial-gradient(ellipse 80% 60% at calc(100% - var(--topo-x)) calc(100% - var(--topo-y)), transparent 0 23px, rgb(167 243 208 / 0.035) 23px 24px);
  }

  .wl-route-casing,
  .wl-route-line {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .wl-route-casing { stroke: #fff; stroke-width: 6; }
  .wl-route-line { stroke: #059669; stroke-width: 3; }
  .wl-route-start { fill: #10b981; stroke: #fff; stroke-width: 2; }
  .wl-route-end { fill: #0f172a; stroke: #fff; stroke-width: 2; }

  .dark .wl-route-casing { stroke: #0b1411; }
  .dark .wl-route-line { stroke: #34d399; }
  .dark .wl-route-start { stroke: #0b1411; }
  .dark .wl-route-end { fill: #e2e8f0; stroke: #0b1411; }
</style>
@endsection
