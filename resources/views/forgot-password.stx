@extends('layouts/default')

@section('title', 'Reset Password - WildLoop')

@section('content')
<script server>
  /*
   * Page metadata, in `<script server>` so it is in the HTML a crawler is
   * served rather than something only hydration produces. See athletes.stx for
   * the full reasoning; the short version is that `useSeoMeta` is the only one
   * of the head helpers that reaches the composed document head from a page,
   * and it has to be written inline because the engine injects it into the
   * page's own scope and not into a module it imports.
   */
  useSeoMeta({
    title: 'Reset Your Password — WildLoop',
    description: 'Reset the password on your WildLoop account.',
    robots: 'noindex, nofollow',
  })
</script>

<script client>
  useHead({ title: 'Reset Your Password — WildLoop' })

  const email = state('')
  const loading = state(false)
  const error = state('')
  const sent = state(false)

  async function handleSubmit(e) {
    e.preventDefault()
    error.set('')
    if (!email().trim()) {
      error.set('Please enter your email address.')
      return
    }
    loading.set(true)
    try {
      const res = await fetch('/api/password/forgot', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email().trim() }),
      })
      if (res.status === 429) {
        error.set('Too many reset attempts. Please try again in a few minutes.')
        loading.set(false)
        return
      }
      // Generic confirmation regardless of whether the address exists, so the
      // form can't be used to probe which emails are registered.
      sent.set(true)
    }
    catch {
      error.set('Could not reach the server. Check your connection and try again.')
    }
    loading.set(false)
  }
</script>

  <div class="flex items-center justify-center px-4 py-12 min-h-screen bg-gray-50 dark:bg-slate-900">
    <div class="max-w-md w-full">
      <div class="p-8 bg-white dark:bg-slate-800 border border-gray-100 rounded-2xl dark:border-slate-700 shadow-xl">
        <div class="mb-8 text-center">
          <StxLink to="/" class="inline-flex items-center mb-6 font-bold text-emerald-600 text-xl">
            <BrandMark size="lg" /> WildLoop
          </StxLink>
          <h1 class="mb-2 font-bold text-3xl text-gray-900 dark:text-white">Reset your password</h1>
          <p class="text-gray-500 dark:text-slate-400">Enter your email and we'll send you a reset link.</p>
        </div>

        <!-- Sent confirmation -->
        <div :if="sent" class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 bg-emerald-100 dark:bg-emerald-900/20 rounded-2xl flex items-center justify-center">
            <Icon name="mail" size="32" class="text-emerald-500" />
          </div>
          <h2 class="font-semibold text-lg text-gray-900 dark:text-white mb-1">Check your inbox</h2>
          <p class="text-sm text-gray-500 dark:text-slate-400 mb-6">If an account exists for <span class="font-medium text-gray-700 dark:text-slate-300">{{ email }}</span>, a password reset link is on its way.</p>
          <StxLink to="/login" class="inline-block px-5 py-2.5 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Back to sign in</StxLink>
        </div>

        <!-- Request form -->
        <div :if="!sent">
          <div :if="error" role="alert" aria-live="assertive" class="flex gap-3 items-start mb-6 p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/40 border border-red-200 rounded-xl dark:border-red-900"><i class="i-hugeicons-alert-circle h-5 w-5 shrink-0 mt-px" aria-hidden="true"></i><span>{{ error }}</span></div>

          <form @submit="handleSubmit" class="space-y-5">
            <div>
              <label for="email" class="block mb-2 font-medium text-gray-700 text-sm dark:text-slate-300">Email</label>
              <input
                type="email"
                id="email"
                x-value="email"
                @input="e => email.set(e.target.value)"
                required
                class="px-4 py-3 w-full text-gray-900 dark:text-white bg-white dark:bg-slate-700 border border-gray-200 rounded-xl dark:border-slate-600 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500 transition"
                placeholder="you@example.com"
              />
            </div>

            <button
              type="submit"
              x-disabled="loading()"
              class="px-4 py-3 w-full font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 disabled:opacity-50 transition"
            >
              <span :if="!loading">Send reset link</span>
              <span :if="loading" class="inline-flex items-center">
                <svg class="-ml-1 mr-2 h-4 w-4 text-white animate-spin" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Sending...
              </span>
            </button>
          </form>

          <p class="mt-8 text-center text-gray-500 text-sm dark:text-slate-400">
            Remembered it?
            <StxLink to="/login" class="font-semibold text-emerald-600 hover:text-emerald-700">Back to sign in</StxLink>
          </p>
        </div>
      </div>
    </div>
  </div>
@endsection
