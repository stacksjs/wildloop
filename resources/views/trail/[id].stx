@extends('layouts/default')

@section('title', 'Trail Details - WildLoop')

@section('content')
<script client>
  import { createTrailMap, drawTrailRoute, runWhenMapReady, type TrailMapHandle } from '../../composables/useTrailMap'
  import { readRouteParam } from '../../composables/useRouteParam'
  import { useSavedTrails } from '../../composables/useSavedTrails'
  import { REVIEW_CONDITION_OPTIONS, useTrailReviews } from '../../composables/useTrailReviews'
  import { normalizeTrailsPayload } from '../../assets/scripts/trail-data'
  import { isTrailOffline, offlineTrail, removeOfflineTrail, saveTrailOffline } from '../../assets/scripts/offline-trails'
  import { useRecordSubmission, useTrailRecords, CATEGORY_LABELS, STATUS_LABELS, STYLE_LABELS } from '../../composables/useRouteRecords'
  import { recordTitle, setPageSeo } from '../../composables/usePageSeo'

  // The served shell's title. Replaced with the trail's own once it loads —
  // see the effect below, and usePageSeo for why that happens on the client.
  useHead({ title: 'Trail Details - WildLoop' })

  const wl = useStore('wl')
  const { onToggleSave } = useSavedTrails(wl)
  const reviewTab = state<'reviews' | 'conditions'>('reviews')
  const conditionOptions = REVIEW_CONDITION_OPTIONS
  let detailMap: TrailMapHandle | null = null
  const loadingTrail = state(true)
  const trailLoadError = state(false)
  const downloaded = state(false)
  const offlineMessage = state<string | null>(null)

  // -1 is a deliberate no-match sentinel: if the route param can't be
  // resolved we render a real "not found" instead of silently loading a
  // valid-but-wrong trail (#987).
  const trailId = derived(() => readRouteParam('id') ?? -1)

  const trail = derived(() => wl ? wl.trails().find((t: any) => t.id === trailId()) ?? null : null)
  const saved = derived(() => !!(wl && wl.isTrailSaved(trailId())))
  const {
    reviews, formRating, formContent, formConditions,
    submittingReview, reviewError, reviewSaved, submitReview,
  } = useTrailReviews(wl, trailId)
  const segments = derived(() => wl ? wl.segments().filter((s: any) => s.trail_id === trailId()) : [])

  // The route's fastest-known-time board. Read once at mount from the same
  // resolved param the rest of the page uses; the board changes on the scale
  // of weeks, so there is nothing here worth polling for.
  const { recordBoard, recordsLoading, recordsRankable } = useTrailRecords(readRouteParam('id') ?? -1)
  const {
    claimOpen, claimSubmitting, claimError, claimFieldErrors,
    isAnnouncement, fStyle, fCategory, fDirection, fStartedAt, fFinishedAt,
    fEvidenceUrl, fTrackerUrl, fTripReport,
    openClaim, closeClaim, submitClaim,
  } = useRecordSubmission({ trailId: readRouteParam('id') ?? undefined })

  async function fileClaim() {
    const filed = await submitClaim()
    if (filed)
      navigate('/effort/' + filed.id)
  }

  /** First on a board is the record; everything under it is a placing. */
  function rankTone(rank: number) {
    return rank === 1 ? 'text-yellow-500' : 'text-gray-400 dark:text-slate-500'
  }

  function styleLabel(style: string) {
    return STYLE_LABELS[style] ?? style
  }

  function categoryLabel(category: string) {
    return CATEGORY_LABELS[category] ?? category
  }

  function recordStatusLabel(status: string) {
    return STATUS_LABELS[status] ?? status
  }

  function recordDate(iso: string) {
    const date = new Date(iso)
    return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })
  }

  // Two things ask for the map — `runWhenMapReady` once the container exists,
  // and an effect on every change to `trail()` — and both are async. Without a
  // gate they interleave: the second call reaches `createTrailMap` before the
  // first has assigned `detailMap`, so the `destroy()` above it is a no-op and
  // Leaflet refuses the container it already owns ("Map container is already
  // initialized", four times on a normal page load).
  //
  // The gate is the in-flight promise itself: a caller that arrives mid-mount
  // waits for it and then re-runs, so the last request still wins and the
  // container is only ever built by one of them at a time.
  let detailMapMount: Promise<void> | null = null

  async function mountDetailMap(): Promise<void> {
    while (detailMapMount)
      await detailMapMount.catch(() => undefined)

    const run = (async () => {
      const t = trail()
      if (!t || !wl) return
      detailMap?.destroy()
      detailMap = null
      detailMap = await createTrailMap('trail-map', {
        center: [t.lat, t.lng],
        zoom: 13,
        scrollWheelZoom: false,
      })
      if (!detailMap) return
      const coords = wl.trailRoutes()[t.id]
      if (coords && coords.length > 1) {
        await drawTrailRoute(detailMap.map, coords, { color: '#059669', weight: 4, opacity: 0.9 })
        detailMap.fitPoints(coords, [30, 30])
      }
      else {
        detailMap.map.setView([t.lat, t.lng], 14)
      }
    })()

    detailMapMount = run.finally(() => { detailMapMount = null })
    return detailMapMount
  }

  onMount(() => {
    const loadTrail = async () => {
      if (trail()) {
        loadingTrail.set(false)
        return
      }
      try {
        const res = await fetch(`/api/trails/${trailId()}`)
        const payload = await res.json().catch(() => null)
        if (!res.ok || !payload?.trail) {
          trailLoadError.set(true)
          loadingTrail.set(false)
          return
        }
        const normalized = normalizeTrailsPayload({ trails: [payload.trail] })
        const found = normalized.trails[0]
        if (found && wl)
          wl.upsertTrailFromApi(found, normalized.geometryById[found.id])
      }
      catch {
        const savedTrail = await offlineTrail(trailId())
        if (savedTrail && wl)
          wl.upsertTrailFromApi(savedTrail.trail, savedTrail.route)
        else
          trailLoadError.set(true)
      }
      loadingTrail.set(false)
    }
    void loadTrail()
    void isTrailOffline(trailId()).then(value => downloaded.set(value))
    const cancelMap = runWhenMapReady('trail-map', mountDetailMap)
    const stop = effect(() => {
      trail()
      void mountDetailMap()
    })

    // Give the page the trail's own identity.
    //
    // Every trail page served the same title and description, so ~600k URLs in
    // the sitemap looked like one page repeated — which is how a catalog gets
    // dropped as thin or duplicate content rather than ranked.
    const stopSeo = effect(() => {
      const current = trail()
      if (!current)
        return

      setPageSeo({
        title: recordTitle(current.name, current.location),
        description: trailDescription(current),
        canonical: `/trail/${current.id}`,
      })
    })

    return () => {
      cancelMap()
      stop()
      stopSeo()
    }
  })

  /**
   * A sentence a search result can stand on, built from what makes this trail
   * different from the next one: where it is, how long, how hard, how steep.
   */
  function trailDescription(current: any): string {
    const parts: string[] = []

    if (current.difficulty)
      parts.push(`${String(current.difficulty).charAt(0).toUpperCase()}${String(current.difficulty).slice(1)}`)
    if (typeof current.distance === 'number' && current.distance > 0)
      parts.push(`${current.distance.toFixed(1)} mi`)
    if (typeof current.elevation === 'number' && current.elevation > 0)
      parts.push(`${Math.round(current.elevation).toLocaleString()} ft elevation gain`)

    const facts = parts.join(' · ')
    const where = current.location ? ` in ${current.location}` : ''

    return facts
      ? `${current.name}${where}. ${facts}. Route map, records and recent conditions on WildLoop.`
      : `${current.name}${where}. Route map, records and recent conditions on WildLoop.`
  }

  async function toggleOfflineDownload() {
    const current = trail()
    if (!current || !wl) return
    try {
      if (downloaded()) {
        await removeOfflineTrail(current.id)
        downloaded.set(false)
        offlineMessage.set('Offline download removed.')
      }
      else {
        await saveTrailOffline(current, wl.trailRoutes()[current.id] ?? [])
        downloaded.set(true)
        offlineMessage.set('Trail route saved for offline use.')
      }
    }
    catch (error) {
      offlineMessage.set(error instanceof Error ? error.message : 'Could not save this trail offline')
    }
  }

  onDestroy(() => {
    detailMap?.destroy()
    detailMap = null
  })
</script>

  <div :if="trail">
    <!-- Hero -->
    <section class="relative h-72 sm:h-96 bg-gradient-to-br from-emerald-700 to-teal-800 overflow-hidden">
      <Image x-src="trail.image || 'https://images.unsplash.com/photo-1551632811-561732d1e306?w=1600&h=900&fit=crop'" x-alt="trail.name" width="1600" height="900" sizes="100vw" placeholder="blur" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/40 to-black/20"></div>
      <div class="relative h-full flex items-end px-4 mx-auto max-w-7xl sm:px-6 lg:px-8 pb-8">
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-3">
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold capitalize" x-class="'difficulty-' + trail.difficulty">{{ trail.difficulty }}</span>
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-white/20 text-white">{{ trail.distance + ' mi' }}</span>
          </div>
          <h1 class="font-display text-3xl md:text-4xl font-bold text-white mb-2">{{ trail.name }}</h1>
          <p class="text-white/70">{{ trail.location }}</p>
        </div>
        <div class="flex gap-2">
          <button @click="onToggleSave(trailId())" class="p-3 rounded-xl backdrop-blur-sm transition" x-class="saved ? 'bg-red-500 text-white' : 'bg-white/20 text-white hover:bg-white/30'" x-aria-label="saved ? 'Unsave trail' : 'Save trail'">
            <Icon name="heart" size="20" />
          </button>
          <button @click="toggleOfflineDownload()" class="p-3 rounded-xl backdrop-blur-sm transition" x-class="downloaded ? 'bg-emerald-500 text-white' : 'bg-white/20 text-white hover:bg-white/30'" x-aria-label="downloaded ? 'Remove offline trail' : 'Download trail offline'">
            <Icon name="download" size="20" />
          </button>
          <StxLink to="/record" class="px-5 py-3 bg-emerald-600 text-white font-semibold rounded-xl hover:bg-emerald-700 transition">Start</StxLink>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <p :if="offlineMessage" class="mb-4 px-4 py-3 text-sm text-emerald-700 bg-emerald-50 dark:bg-emerald-900/20 rounded-xl">{{ offlineMessage }}</p>
      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">
          <!-- Stats -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="card text-center">
              <p class="text-2xl font-bold text-emerald-600">{{ trail.distance }}</p>
              <p class="metric-label">Miles</p>
            </div>
            <div class="card text-center">
              <p class="text-2xl font-bold text-blue-600">{{ trail.elevation.toLocaleString() }}</p>
              <p class="metric-label">Elev (ft)</p>
            </div>
            <div class="card text-center">
              <p class="text-2xl font-bold text-orange-600">{{ trail.estimatedTime }}</p>
              <p class="metric-label">Est. Time</p>
            </div>
            <div class="card text-center">
              <p class="text-2xl font-bold">{{ trail.rating || '-' }}</p>
              <p class="metric-label">{{ trail.reviewCount + ' reviews' }}</p>
            </div>
          </div>

          <!-- Description -->
          <div class="card">
            <h2 class="font-bold text-lg dark:text-white mb-3">About This Trail</h2>
            <p class="text-gray-600 dark:text-slate-400 leading-relaxed">{{ trail.description }}</p>
            <div class="flex flex-wrap gap-2 mt-4">
              <template :for="tag in trail.tags">
                <span class="px-2.5 py-1 bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 text-xs font-medium rounded-full">{{ tag }}</span>
              </template>
            </div>
          </div>

          <!-- Map -->
          <div class="card p-0 overflow-hidden">
            <div id="trail-map" data-stx-ignore class="trail-map-panel ts-map-container"></div>
          </div>

          <!-- Records -->
          <!-- The route's fastest known times. Split into the buckets that
               make two times comparable at all — direction, category, style,
               solo or team — because a crewed time and an unsupported one on
               the same board is a comparison nobody asked for. -->
          <div :if="!recordsLoading &amp;&amp; recordsRankable">
            <div class="mb-4 flex items-end justify-between gap-4">
              <div>
                <h2 class="font-bold text-lg dark:text-white">Records</h2>
                <p class="mt-0.5 text-xs text-gray-500 dark:text-slate-400">Elapsed time from the trailhead. Stops count.</p>
              </div>
              <button @click="openClaim()" class="shrink-0 rounded-full bg-emerald-600 px-4 py-2 text-xs font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98]">Claim a time</button>
            </div>

            <!-- The outright fastest, ignoring style and category. This is
                 what "the FKT" means when it is said without qualification. -->
            <StxLink :if="recordBoard &amp;&amp; recordBoard.outright" x-to="'/effort/' + recordBoard.outright.id" class="mb-4 flex items-center gap-4 rounded-2xl border border-yellow-300 bg-yellow-50 px-4 py-3.5 transition hover:border-yellow-400 dark:border-yellow-800/60 dark:bg-yellow-900/15">
              <span class="text-2xl leading-none" aria-hidden="true">👑</span>
              <div class="min-w-0 flex-1">
                <p class="text-[11px] font-semibold uppercase tracking-wide text-yellow-700 dark:text-yellow-500">Fastest known time</p>
                <p class="truncate text-sm font-semibold dark:text-white">{{ recordBoard.outright.userName }}</p>
              </div>
              <div class="shrink-0 text-right">
                <p class="text-sm font-bold text-yellow-700 dark:text-yellow-400">{{ recordBoard.outright.elapsedLabel }}</p>
                <p class="text-xs text-gray-500 dark:text-slate-400">{{ styleLabel(recordBoard.outright.style) }}</p>
              </div>
            </StxLink>

            <!-- Attempts out on the route right now. Announced before the
                 start, so they exist here before there is any time to rank. -->
            <div :if="recordBoard &amp;&amp; recordBoard.inProgress.length > 0" class="mb-4 space-y-2">
              <template :for="attempt in recordBoard.inProgress">
                <div class="flex items-center gap-3 rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 dark:border-red-900/40 dark:bg-red-900/15">
                  <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-400 opacity-75"></span>
                    <span class="relative inline-flex h-2 w-2 rounded-full bg-red-500"></span>
                  </span>
                  <StxLink x-to="'/effort/' + attempt.id" class="min-w-0 flex-1 truncate text-sm font-medium text-red-700 hover:underline dark:text-red-300">
                    {{ attempt.userName + ' is on the route — started ' + recordDate(attempt.startedAt) }}
                  </StxLink>
                </div>
              </template>
            </div>

            <div :if="recordBoard &amp;&amp; recordBoard.boards.length > 0" class="space-y-5">
              <template :for="group in recordBoard.boards">
                <div class="card p-0 overflow-hidden">
                  <div class="border-b border-gray-100 px-4 py-2.5 dark:border-slate-700">
                    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-slate-400">{{ group.label }}</p>
                  </div>
                  <div class="divide-y divide-gray-100 dark:divide-slate-700">
                    <template :for="entry in group.entries">
                      <StxLink x-to="'/effort/' + entry.id" class="flex items-center gap-4 px-4 py-3 transition hover:bg-gray-50 dark:hover:bg-slate-700/40">
                        <span class="w-6 shrink-0 text-center text-sm font-bold" x-class="rankTone(entry.rank)">{{ entry.rank }}</span>
                        <div class="min-w-0 flex-1">
                          <p class="truncate text-sm font-semibold dark:text-white">{{ entry.userName }}</p>
                          <p class="text-xs text-gray-500 dark:text-slate-400">{{ recordDate(entry.finishedAt || entry.startedAt) + ' · ' + entry.paceLabel }}</p>
                        </div>
                        <!-- Said out loud rather than implied: a time nobody
                             has checked yet is on the board, but it is not
                             the same thing as a verified one. -->
                        <span :if="entry.status === 'pending'" class="hidden shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-700 sm:inline dark:bg-amber-900/30 dark:text-amber-400">{{ recordStatusLabel(entry.status) }}</span>
                        <p class="shrink-0 text-sm font-bold text-emerald-600">{{ entry.elapsedLabel }}</p>
                      </StxLink>
                    </template>
                  </div>
                </div>
              </template>
            </div>

            <div :if="recordBoard &amp;&amp; recordBoard.boards.length === 0 &amp;&amp; recordBoard.inProgress.length === 0" class="card text-center py-8">
              <p class="text-sm text-gray-500 dark:text-slate-400">No times filed on this route yet.</p>
              <button @click="openClaim()" class="mt-3 text-sm font-semibold text-emerald-600 hover:underline">Be the first</button>
            </div>
          </div>

          <!-- A route too short or too flat to race says so, rather than
               offering a board that would be decided by GPS rounding. -->
          <div :if="!recordsLoading &amp;&amp; !recordsRankable &amp;&amp; recordBoard" class="card">
            <h2 class="mb-1 font-bold text-lg dark:text-white">Records</h2>
            <p class="text-sm text-gray-500 dark:text-slate-400">{{ recordBoard.rankableReason }}</p>
          </div>

          <!-- Claim form. One shape for two things, because they are the same
               claim at different times: an attempt announced before the start
               (tracker link, no finish) and a finished one (a time and its
               evidence). Which one is filed follows from whether a finish was
               entered — there is no mode switch to find. -->
          <div :show="claimOpen()" x-cloak class="card">
            <h3 class="mb-1 font-bold text-lg dark:text-white">{{ isAnnouncement ? 'Announce an attempt' : 'File a time' }}</h3>
            <p class="mb-4 text-xs text-gray-500 dark:text-slate-400">
              {{ isAnnouncement
                ? 'Leave the finish empty to announce a run you have not made yet. It appears on the tracking board with your tracker link until you close it out.'
                : 'Elapsed time from the trailhead, not moving time. A finished claim needs a GPS trace before a reviewer can accept it.' }}
            </p>

            <div class="grid gap-3 sm:grid-cols-2">
              <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-slate-400" for="claim-style">Style</label>
                <select id="claim-style" @change="fStyle.set($event.target.value)" class="mt-1.5 w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-700 dark:text-white">
                  <option value="unsupported" x-selected="fStyle === 'unsupported'">Unsupported — carried everything</option>
                  <option value="self_supported" x-selected="fStyle === 'self_supported'">Self-supported — public resources only</option>
                  <option value="supported" x-selected="fStyle === 'supported'">Supported — crew, pacers, drops</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-slate-400" for="claim-category">Category</label>
                <select id="claim-category" @change="fCategory.set($event.target.value)" class="mt-1.5 w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-700 dark:text-white">
                  <option value="womens" x-selected="fCategory === 'womens'">Women's</option>
                  <option value="mens" x-selected="fCategory === 'mens'">Men's</option>
                  <option value="nonbinary" x-selected="fCategory === 'nonbinary'">Non-binary</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-slate-400" for="claim-direction">Direction</label>
                <select id="claim-direction" @change="fDirection.set($event.target.value)" class="mt-1.5 w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-700 dark:text-white">
                  <option value="standard" x-selected="fDirection === 'standard'">Standard</option>
                  <option value="reverse" x-selected="fDirection === 'reverse'">Reverse</option>
                  <option value="yo_yo" x-selected="fDirection === 'yo_yo'">Yo-yo (out and back)</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-slate-400" for="claim-started">Start</label>
                <input id="claim-started" type="datetime-local" x-model="fStartedAt" class="mt-1.5 w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-700 dark:text-white" />
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-600 dark:text-slate-400" for="claim-finished">Finish <span class="text-gray-400">(leave empty if still to run)</span></label>
                <input id="claim-finished" type="datetime-local" x-model="fFinishedAt" class="mt-1.5 w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-700 dark:text-white" />
              </div>
              <div :if="isAnnouncement">
                <label class="block text-xs font-medium text-gray-600 dark:text-slate-400" for="claim-tracker">Live tracker link</label>
                <input id="claim-tracker" type="url" placeholder="https://…" x-model="fTrackerUrl" class="mt-1.5 w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-700 dark:text-white" />
              </div>
              <div :if="!isAnnouncement">
                <label class="block text-xs font-medium text-gray-600 dark:text-slate-400" for="claim-evidence">Recording link</label>
                <input id="claim-evidence" type="url" placeholder="https://strava.com/activities/…" x-model="fEvidenceUrl" class="mt-1.5 w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-700 dark:text-white" />
                <p :if="claimFieldErrors.evidence_url" class="mt-1 text-xs text-red-500">{{ claimFieldErrors.evidence_url }}</p>
              </div>
            </div>

            <div class="mt-3">
              <label class="block text-xs font-medium text-gray-600 dark:text-slate-400" for="claim-report">Trip report</label>
              <textarea id="claim-report" rows="4" placeholder="What the day was actually like. Not evidence on its own, but it is what makes this page worth reading in a year." x-model="fTripReport" class="mt-1.5 w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-700 dark:text-white"></textarea>
            </div>

            <p :if="claimError" class="mt-3 text-sm text-red-500">{{ claimError }}</p>

            <div class="mt-4 flex items-center gap-3">
              <button @click="fileClaim()" x-disabled="claimSubmitting" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700 disabled:opacity-50">
                {{ claimSubmitting ? 'Filing…' : (isAnnouncement ? 'Announce it' : 'Submit for review') }}
              </button>
              <button @click="closeClaim()" class="text-sm font-medium text-gray-500 transition hover:text-gray-900 dark:hover:text-white">Cancel</button>
            </div>
          </div>

          <!-- Segments -->
          <div :if="segments.length > 0">
            <h2 class="font-bold text-lg dark:text-white mb-4">Segments</h2>
            <div class="space-y-3">
              <template :for="seg in segments">
                <div class="card flex items-center gap-4">
                  <div class="flex-1 min-w-0">
                    <p class="font-semibold text-sm dark:text-white">{{ seg.name }}</p>
                    <p class="text-xs text-gray-500 dark:text-slate-400">{{ seg.distance + ' mi · ' + Math.abs(seg.elevation) + ' ft' }}</p>
                  </div>
                  <div class="text-right">
                    <p class="text-sm font-bold dark:text-white">{{ seg.yourTime || '-' }}</p>
                    <p class="text-xs text-gray-500">{{ seg.yourRank ? '#' + seg.yourRank : 'Not attempted' }}</p>
                  </div>
                  <div class="text-right">
                    <p class="text-xs text-yellow-600 font-medium">CR</p>
                    <p class="text-xs text-gray-500">{{ seg.leaderTime + ' · ' + seg.leaderName }}</p>
                  </div>
                </div>
              </template>
            </div>
          </div>

          <!-- Reviews -->
          <div>
            <div class="flex gap-1 mb-4 border-b border-gray-200 dark:border-slate-700">
              <button @click="reviewTab.set('reviews')" x-class="reviewTab === 'reviews' ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500'" class="px-4 py-3 text-sm font-medium border-b-2 transition">{{ 'Reviews (' + reviews.length + ')' }}</button>
              <button @click="reviewTab.set('conditions')" x-class="reviewTab === 'conditions' ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500'" class="px-4 py-3 text-sm font-medium border-b-2 transition">Conditions</button>
            </div>

            <div :if="reviewTab === 'reviews'" class="space-y-4">
              <!-- Review form (#981) - one review per user per trail, resubmitting updates it -->
              <div class="card">
                <h3 class="font-semibold text-sm dark:text-white mb-3">Rate this trail</h3>
                <div class="flex items-center gap-1 mb-3">
                  <template :for="star in [1, 2, 3, 4, 5]">
                    <button
                      @click="formRating.set(star)"
                      class="text-2xl leading-none transition"
                      x-class="star <= formRating ? 'text-yellow-400' : 'text-gray-300 dark:text-slate-600 hover:text-yellow-300'"
                      x-aria-label="'Rate ' + star + ' stars'">★</button>
                  </template>
                  <span :if="formRating > 0" class="ml-2 text-xs text-gray-500">{{ formRating + '/5' }}</span>
                </div>
                <div class="flex flex-col sm:flex-row gap-3 mb-3">
                  <textarea
                    rows="2"
                    placeholder="How was the trail? (10+ characters)"
                    x-value="formContent"
                    @input="formContent.set($event.target.value)"
                    class="flex-1 px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm focus:ring-2 focus:ring-emerald-500 transition"></textarea>
                  <select @change="formConditions.set($event.target.value)" class="sm:w-40 px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm h-fit">
                    <option value="">Conditions…</option>
                    <template :for="opt in conditionOptions">
                      <option x-value="opt" x-selected="opt === formConditions" :text="opt"></option>
                    </template>
                  </select>
                </div>
                <p :if="reviewError" class="text-sm text-red-500 mb-2">{{ reviewError }}</p>
                <div class="flex items-center gap-3">
                  <button @click="submitReview()" class="px-4 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">{{ submittingReview ? 'Saving…' : 'Post review' }}</button>
                  <span :if="reviewSaved" class="text-sm text-emerald-600 font-medium">Saved, thanks!</span>
                </div>
              </div>

              <template :for="review in reviews">
                <div class="card">
                  <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-3">
                      <div class="w-9 h-9 rounded-full bg-emerald-100 dark:bg-emerald-900/20 flex items-center justify-center text-emerald-600 text-sm font-bold">{{ review.userName.charAt(0) }}</div>
                      <div>
                        <p class="font-semibold text-sm dark:text-white">{{ review.userName }}</p>
                        <p class="text-xs text-gray-500">{{ wl.timeAgo(review.created_at) }}</p>
                      </div>
                    </div>
                    <span class="text-yellow-400">{{ '★'.repeat(review.rating) }}</span>
                  </div>
                  <p class="text-sm text-gray-600 dark:text-slate-400">{{ review.text }}</p>
                  <p :if="review.conditions" class="mt-2 text-xs text-gray-400 capitalize">{{ 'Conditions: ' + review.conditions }}</p>
                </div>
              </template>
              <div :if="reviews.length === 0" class="text-center py-6 text-gray-400 text-sm">
                <p>No reviews yet. Be the first!</p>
              </div>
            </div>

            <div :if="reviewTab === 'conditions'" class="card">
              <h3 class="font-semibold text-sm dark:text-white mb-2">Current Conditions</h3>
              <p class="text-sm text-gray-600 dark:text-slate-400">{{ trail.conditions }}</p>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <div class="card">
            <h3 class="font-bold text-lg dark:text-white mb-4">Trail Info</h3>
            <div class="space-y-3">
              <div class="flex justify-between"><span class="text-sm text-gray-500">Difficulty</span><span class="text-sm font-medium capitalize" x-class="'difficulty-' + trail.difficulty">{{ trail.difficulty }}</span></div>
              <div class="flex justify-between"><span class="text-sm text-gray-500">Distance</span><span class="text-sm font-medium dark:text-white">{{ trail.distance + ' mi' }}</span></div>
              <div class="flex justify-between"><span class="text-sm text-gray-500">Elevation</span><span class="text-sm font-medium dark:text-white">{{ trail.elevation.toLocaleString() + ' ft' }}</span></div>
              <div class="flex justify-between"><span class="text-sm text-gray-500">Time</span><span class="text-sm font-medium dark:text-white">{{ trail.estimatedTime }}</span></div>
            </div>
          </div>

          <div class="card">
            <h3 class="font-bold text-lg dark:text-white mb-4">Weather</h3>
            <div class="text-center py-4">
              <Icon name="sun" size="40" class="mx-auto mb-2 text-yellow-500" />
              <p class="text-2xl font-bold dark:text-white">72°F</p>
              <p class="text-sm text-gray-500">Clear skies</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div :if="loadingTrail" class="text-center py-32 text-gray-500">Loading trail…</div>
  <div :if="!loadingTrail && !trail" class="text-center py-32">
    <p class="text-gray-500 font-medium">{{ trailLoadError ? 'Trail could not be loaded' : 'Trail not found' }}</p>
    <StxLink to="/trails" class="inline-block mt-4 px-6 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Browse Trails</StxLink>
  </div>
@endsection
