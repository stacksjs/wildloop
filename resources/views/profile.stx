@extends('layouts/default')

@section('title', 'Profile - WildLoop')

@section('content')
<script server>
  /*
   * Page metadata, in `<script server>` so it is in the HTML a crawler is
   * served rather than something only hydration produces. See athletes.stx for
   * the full reasoning; the short version is that `useSeoMeta` is the only one
   * of the head helpers that reaches the composed document head from a page,
   * and it has to be written inline because the engine injects it into the
   * page's own scope and not into a module it imports.
   */
  useSeoMeta({
    title: 'Your Profile — WildLoop',
    description: 'Your WildLoop profile, stats and recent activity.',
    robots: 'noindex, nofollow',
  })
</script>

<script client>
  import { fetchFollows } from '../assets/scripts/game-api'
  import { useAchievementCatalog } from '../composables/useAchievementCatalog'
  import { useSavedTrails } from '../composables/useSavedTrails'

  useHead({ title: 'Profile - WildLoop' })

  const wl = useStore('wl')
  useAchievementCatalog(wl)
  const { onToggleSave } = useSavedTrails(wl)
  const activeTab = state<'activities' | 'achievements' | 'saved'>('activities')
  const followerCount = state(0)

  const currentUser = derived(() => wl?.currentUser())
  const userStats = derived(() => wl?.userStats())
  const currentUserId = derived(() => wl?.currentUserId())
  const followingCount = derived(() => wl ? wl.following().length : 0)
  const myActivities = derived(() => wl ? wl.activities().filter((a: any) => a.user_id === wl.currentUserId()) : [])
  const achievements = derived(() => wl ? wl.achievements() : [])
  const savedTrails = derived(() => wl ? wl.trails().filter((t: any) => wl.isTrailSaved(t.id)) : [])

  onMount(async () => {
    if (!wl) return
    try {
      const data = await fetchFollows(wl.currentUserId())
      if (data) {
        followerCount.set(data.followerCount)
        wl.hydrateFollowing(data.followingIds) // keep store in sync
      }
    }
    catch {
      // Follower data is non-critical - leave the seeded counts in place
      // rather than letting an unhandled rejection break the page.
    }
  })
</script>

  <div class="mx-auto px-4 py-6 sm:px-6 lg:px-8 max-w-4xl">
    <!-- Profile header -->
    <div class="mb-6 card">
      <div class="flex flex-col gap-6 items-center sm:flex-row">
        <div class="flex items-center justify-center h-24 w-24 font-bold text-3xl text-emerald-600 bg-emerald-100 dark:bg-emerald-900/30 rounded-full">{{ (currentUser?.name || 'U').charAt(0) }}</div>
        <div class="flex-1 text-center sm:text-left">
          <h1 class="font-bold text-2xl dark:text-white">{{ currentUser?.name || 'Athlete' }}</h1>
          <p class="mt-1 text-gray-500 text-sm dark:text-slate-400">{{ currentUser?.email || '' }}</p>
          <div class="flex flex-wrap gap-4 justify-center sm:justify-start mt-3">
            <div class="text-center">
              <p class="text-lg font-bold text-emerald-600">{{ userStats?.totalDistance.toFixed(1) || '0' }}</p>
              <p class="metric-label">Miles</p>
            </div>
            <div class="text-center">
              <p class="text-lg font-bold text-emerald-600">{{ userStats?.trailsCompleted || 0 }}</p>
              <p class="metric-label">Trails</p>
            </div>
            <div class="text-center">
              <p class="text-lg font-bold text-emerald-600">{{ (userStats?.totalElevation || 0).toLocaleString() }}</p>
              <p class="metric-label">Elev (ft)</p>
            </div>
            <div class="text-center">
              <p class="text-lg font-bold text-emerald-600">{{ userStats?.currentStreak || 0 }}</p>
              <p class="metric-label">Streak</p>
            </div>
            <div class="text-center">
              <p class="text-lg font-bold text-emerald-600">{{ followerCount }}</p>
              <p class="metric-label">Followers</p>
            </div>
            <div class="text-center">
              <p class="text-lg font-bold text-emerald-600">{{ followingCount }}</p>
              <p class="metric-label">Following</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabs -->
    <div class="flex gap-1 mb-6 border-b border-gray-200 dark:border-slate-700">
      <button @click="activeTab.set('activities')" x-class="activeTab === 'activities' ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-4 py-3 font-medium text-sm border-b-2 transition">Activities</button>
      <button @click="activeTab.set('achievements')" x-class="activeTab === 'achievements' ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-4 py-3 font-medium text-sm border-b-2 transition">Achievements</button>
      <button @click="activeTab.set('saved')" x-class="activeTab === 'saved' ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-4 py-3 font-medium text-sm border-b-2 transition">Saved Trails</button>
    </div>

    <!-- Activities -->
    <div :if="activeTab === 'activities'" class="space-y-4">
      <template :for="activity in myActivities">
        <StxLink x-to="'/activity/' + activity.id" class="card flex gap-4 items-center hover:shadow-md transition block">
          <div class="flex items-center justify-center shrink-0 h-12 w-12 bg-emerald-50 dark:bg-emerald-900/20 rounded-xl">
            <Icon name="zap" size="24" class="text-emerald-600" />
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-semibold text-sm truncate dark:text-white">{{ activity.title }}</p>
            <p class="text-gray-500 text-xs dark:text-slate-400">{{ activity.activityType + ' · ' + wl.timeAgo(activity.created_at) }}</p>
          </div>
          <div class="flex gap-4 shrink-0 text-right">
            <div>
              <p class="font-bold text-sm dark:text-white">{{ activity.distance.toFixed(1) + ' mi' }}</p>
              <p class="metric-label">Distance</p>
            </div>
            <div>
              <p class="font-bold text-sm dark:text-white">{{ activity.duration }}</p>
              <p class="metric-label">Time</p>
            </div>
          </div>
        </StxLink>
      </template>

      <div :if="myActivities.length === 0" class="py-16 text-center">
        <div class="w-16 h-16 mx-auto mb-4 bg-emerald-100 dark:bg-emerald-900/20 rounded-2xl flex items-center justify-center">
          <Icon name="zap" size="32" class="text-emerald-400" />
        </div>
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">No activities yet</h3>
        <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Record your first run, hike, or walk.</p>
        <StxLink to="/record" class="px-5 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Record Activity</StxLink>
      </div>
    </div>

    <!-- Achievements -->
    <div :if="activeTab === 'achievements' && achievements.length > 0" class="grid gap-4 grid-cols-1 sm:grid-cols-2">
      <template :for="achievement in achievements">
        <div class="flex gap-4 items-center card">
          <span class="text-3xl">{{ achievement.icon }}</span>
          <div class="flex-1">
            <p class="font-semibold text-sm dark:text-white">{{ achievement.name }}</p>
            <p class="text-gray-500 text-xs dark:text-slate-400">{{ achievement.description }}</p>
            <div class="overflow-hidden mt-2 h-1.5 bg-gray-200 dark:bg-slate-600 rounded-full">
              <div class="h-full bg-emerald-500 rounded-full" x-style="'width: ' + (achievement.progress / achievement.total * 100) + '%'"></div>
            </div>
          </div>
          <p class="shrink-0 text-gray-400 text-xs dark:text-slate-500">{{ achievement.progress + '/' + achievement.total }}</p>
        </div>
      </template>
    </div>

    <div :if="activeTab === 'achievements' && achievements.length === 0" class="py-16 text-center">
      <div class="w-16 h-16 mx-auto mb-4 bg-emerald-100 dark:bg-emerald-900/20 rounded-2xl flex items-center justify-center">
        <Icon name="award" size="32" class="text-emerald-400" />
      </div>
      <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">No achievements yet</h3>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Record runs and conquer territory to start unlocking badges.</p>
      <StxLink to="/record" class="px-5 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Get moving</StxLink>
    </div>

    <!-- Saved -->
    <div :if="activeTab === 'saved' && savedTrails.length > 0" class="grid gap-4 grid-cols-1 sm:grid-cols-2">
      <template :for="trail in savedTrails">
        <div class="card flex items-center gap-4 hover:shadow-lg transition">
          <StxLink x-to="'/trail/' + trail.id" class="flex-1 min-w-0 group">
            <h3 class="font-bold text-gray-900 dark:text-white group-hover:text-emerald-600 transition truncate">{{ trail.name }}</h3>
            <p class="text-sm text-gray-500 dark:text-slate-400 truncate">{{ trail.location }}</p>
            <div class="flex gap-3 items-center mt-2 text-xs text-gray-500 dark:text-slate-400">
              <span class="capitalize" x-class="'px-2 py-0.5 font-semibold rounded-full difficulty-' + trail.difficulty">{{ trail.difficulty }}</span>
              <span>{{ trail.distance + ' mi' }}</span>
              <span class="flex items-center gap-1">
                <Icon name="star" size="12" class="text-yellow-400" />
                <span>{{ trail.rating || '-' }}</span>
              </span>
            </div>
          </StxLink>
          <button @click="onToggleSave(trail.id)" class="p-2.5 rounded-xl bg-red-500 text-white transition hover:bg-red-600 shrink-0" aria-label="Unsave trail">
            <Icon name="heart" size="16" />
          </button>
        </div>
      </template>
    </div>

    <div :if="activeTab === 'saved' && savedTrails.length === 0" class="py-16 text-center">
      <div class="w-16 h-16 mx-auto mb-4 bg-red-100 dark:bg-red-900/20 rounded-2xl flex items-center justify-center">
        <Icon name="heart" size="32" class="text-red-400" />
      </div>
      <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">No saved trails</h3>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Tap the heart on any trail to save it.</p>
      <StxLink to="/trails" class="px-5 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Explore Trails</StxLink>
    </div>
  </div>
@endsection
