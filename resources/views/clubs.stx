@extends('layouts/default')

@section('title', 'Clubs - WildLoop')

@section('content')
<script server>
  /*
   * SEO for this page.
   *
   * `<script server>` because a crawler reads the HTML it is served and never
   * runs the client script — tags set after hydration are tags nobody indexes.
   * `useSeoMeta` rather than `useHead` because only the former reaches the
   * composed document head from a page. And written out here rather than
   * wrapped in a composable: the engine injects `useSeoMeta` into a page's own
   * script scope and not into a module it imports, where it is simply
   * undefined and the call fails without a word.
   *
   * URLs are absolute. A crawler resolves `og:image` against nothing, so a
   * relative path is dropped and the link previews as a bare URL.
   */
  useSeoMeta({
    title: 'Clubs — WildLoop',
    description: 'Find a running or hiking crew near you, see what they covered this week, and join — or start the club you were looking for.',
    canonical: 'https://wildloop.org/clubs',
    robots: 'index, follow, max-image-preview:large',
    ogTitle: 'Clubs — WildLoop',
    ogDescription: 'Find a running or hiking crew near you, see what they covered this week, and join — or start the club you were looking for.',
    ogType: 'website',
    ogUrl: 'https://wildloop.org/clubs',
    ogImage: 'https://wildloop.org/images/social/og-clubs.jpg',
    ogSiteName: 'WildLoop',
    ogLocale: 'en_US',
    twitterCard: 'summary_large_image',
    twitterTitle: 'Clubs — WildLoop',
    twitterDescription: 'Find a running or hiking crew near you, see what they covered this week, and join — or start the club you were looking for.',
    twitterImage: 'https://wildloop.org/images/social/og-clubs.jpg',
  })
</script>

<script client>
  import { useClubs } from '../composables/useClubs'


  const wl = useStore('wl')
  const filter = state<'all' | 'mine' | 'Running' | 'Hiking' | 'Territory Game'>('all')

  const {
    createOpen, submitting, createError,
    fName, fType, fLocation, fDescription, fPrivate, fJoinPolicy,
    isMember, onToggleMembership, openCreate, closeCreate, submitCreate,
  } = useClubs(wl)

  const filtered = derived(() => {
    if (!wl) return []
    const f = filter()
    if (f === 'all') return wl.clubs()
    if (f === 'mine') return wl.clubs().filter((c: any) => isMember(c))
    return wl.clubs().filter((c: any) => c.type === f)
  })
</script>

  <div class="mx-auto max-w-5xl px-4 pb-12 pt-6 sm:px-6 lg:px-8">
    <header class="mb-5 flex items-start justify-between gap-4">
      <div class="min-w-0">
        <h1 class="font-display text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Clubs</h1>
        <p class="mt-1 max-w-[52ch] text-slate-600 dark:text-slate-400">
          <span :if="filtered.length > 0">{{ filtered.length === 1 ? 'One crew' : filtered.length + ' crews' }} training together — join one, or start your own.</span>
          <span :if="filtered.length === 0">Find a crew to train with, or start your own.</span>
        </p>
      </div>
      <button @click="openCreate()" aria-label="Create a club" class="inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-full bg-emerald-600 pl-4 pr-5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 active:scale-[0.98]">
        <i class="i-lucide-plus h-4 w-4" aria-hidden="true"></i>
        <span>New<span class="hidden sm:inline"> club</span></span>
      </button>
    </header>

    <!-- Filter chips. They bleed to the screen edge on phones and scroll
         without a visible scrollbar, the way a native chip row does. -->
    <div class="-mx-4 mb-6 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] sm:mx-0 sm:px-0">
      <button @click="filter.set('all')" x-class="filter === 'all' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900' : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'" class="min-h-10 shrink-0 rounded-full px-4 text-sm font-semibold transition active:scale-[0.98]">All clubs</button>
      <button @click="filter.set('mine')" x-class="filter === 'mine' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900' : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'" class="min-h-10 shrink-0 rounded-full px-4 text-sm font-semibold transition active:scale-[0.98]">My clubs</button>
      <button @click="filter.set('Running')" x-class="filter === 'Running' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900' : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'" class="min-h-10 shrink-0 rounded-full px-4 text-sm font-semibold transition active:scale-[0.98]">Running</button>
      <button @click="filter.set('Hiking')" x-class="filter === 'Hiking' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900' : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'" class="min-h-10 shrink-0 rounded-full px-4 text-sm font-semibold transition active:scale-[0.98]">Hiking</button>
      <button @click="filter.set('Territory Game')" x-class="filter === 'Territory Game' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900' : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'" class="min-h-10 shrink-0 rounded-full px-4 text-sm font-semibold transition active:scale-[0.98]">Territory</button>
    </div>

    <!-- A grid, not a stack of full-width rows. A directory is scanned, and
         two columns of equal cards is what lets somebody compare four crews at
         once instead of scrolling past them one at a time. -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <template :for="club in filtered">
        <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-slate-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-800 dark:shadow-none dark:hover:border-slate-600">
          <div class="flex items-start gap-4">
            <div
              class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl font-display text-lg font-bold"
              x-class="club.type === 'Running' ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300' : club.type === 'Hiking' ? 'bg-sky-100 text-sky-700 dark:bg-sky-500/15 dark:text-sky-300' : club.type === 'Territory Game' ? 'bg-orange-100 text-orange-700 dark:bg-orange-500/15 dark:text-orange-300' : 'bg-violet-100 text-violet-700 dark:bg-violet-500/15 dark:text-violet-300'"
              aria-hidden="true">{{ club.name.charAt(0) }}</div>

            <div class="min-w-0 flex-1">
              <StxLink x-to="'/club/' + club.id" class="block font-display text-lg font-semibold leading-snug text-slate-900 transition hover:text-emerald-700 dark:text-white dark:hover:text-emerald-400 line-clamp-1">{{ club.name }}</StxLink>
              <p class="mt-0.5 flex flex-wrap items-center gap-x-1.5 text-sm text-slate-500 dark:text-slate-400">
                <span :if="club.location">{{ club.location }}</span>
                <span :if="club.location" aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
                <span>{{ club.type }}</span>
                <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
                <span class="tabular-nums">{{ club.memberCount === 1 ? '1 member' : club.memberCount + ' members' }}</span>
              </p>
            </div>
          </div>

          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400 line-clamp-3">{{ club.description }}</p>

          <!-- Badges say what kind of door this club has. The Join control
               below states the same thing as an action, so the badge is only
               shown where the two are not the same sentence. -->
          <div :if="club.isPrivate || club.joinPolicy !== 'open'" class="mt-3 flex flex-wrap gap-1.5">
            <span :if="club.joinPolicy === 'invite_only'" class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600 dark:bg-slate-700 dark:text-slate-300">
              <i class="i-lucide-lock h-3 w-3" aria-hidden="true"></i>Invite only
            </span>
            <span :if="club.joinPolicy === 'request'" class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-700 dark:bg-amber-500/10 dark:text-amber-300">
              <i class="i-lucide-hand h-3 w-3" aria-hidden="true"></i>Ask to join
            </span>
            <span :if="club.isPrivate" class="inline-flex items-center gap-1 rounded-full bg-violet-50 px-2 py-0.5 text-[11px] font-semibold text-violet-700 dark:bg-violet-500/10 dark:text-violet-300">
              <i class="i-lucide-eye-off h-3 w-3" aria-hidden="true"></i>Members only
            </span>
          </div>

          <div class="mt-auto pt-4"><div class="flex items-end justify-between gap-4 border-t border-slate-100 pt-4 dark:border-slate-700/70">
            <!-- Real numbers, aggregated from members' activities in the last
                 seven days. A club with a quiet week says so. -->
            <dl class="flex gap-6">
              <div>
                <dd class="font-semibold text-slate-900 dark:text-white tabular-nums">{{ club.weeklyDistance.toLocaleString() }}<span class="ml-0.5 font-normal text-slate-400">mi</span></dd>
                <dt class="metric-label">This week</dt>
              </div>
              <div>
                <dd class="font-semibold text-slate-900 dark:text-white tabular-nums">{{ club.activitiesThisWeek }}</dd>
                <dt class="metric-label">Activities</dt>
              </div>
            </dl>

            <StxLink :if="club.joinPolicy === 'invite_only' && !isMember(club)" x-to="'/club/' + club.id" class="inline-flex min-h-10 shrink-0 items-center rounded-full border border-slate-300 px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 active:scale-[0.98] dark:border-slate-600 dark:text-slate-300 dark:hover:bg-slate-700">View</StxLink>
            <button
              :if="club.joinPolicy !== 'invite_only' || isMember(club)"
              @click="onToggleMembership(club)"
              x-class="isMember(club) ? 'bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-700 dark:text-slate-200 dark:hover:bg-slate-600' : 'bg-emerald-600 text-white hover:bg-emerald-700'"
              class="min-h-10 shrink-0 rounded-full px-4 text-sm font-semibold transition active:scale-[0.98]"
            >{{ isMember(club) ? 'Joined' : club.joinPolicy === 'request' ? 'Ask to join' : 'Join' }}</button>
          </div></div>
        </article>
      </template>
    </div>

    <div :if="filtered.length === 0" class="rounded-2xl border border-dashed border-slate-300 px-6 py-16 text-center dark:border-slate-700">
      <div class="mx-auto mb-5 grid h-16 w-16 place-items-center rounded-2xl bg-emerald-50 dark:bg-emerald-500/10">
        <Icon name="users" size="30" class="text-emerald-600 dark:text-emerald-400" />
      </div>
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{{ filter === 'mine' ? 'You have not joined a club yet' : 'No clubs here yet' }}</h3>
      <p class="mx-auto mt-1 max-w-sm text-slate-500 dark:text-slate-400">{{ filter === 'mine' ? 'Join a crew from the full list, or start your own.' : 'Nothing matches this filter. Try another, or start the crew you were looking for.' }}</p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <button @click="openCreate()" class="min-h-11 rounded-full bg-emerald-600 px-6 text-sm font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98]">Create a club</button>
        <button :if="filter !== 'all'" @click="filter.set('all')" class="min-h-11 rounded-full px-5 text-sm font-semibold text-slate-600 transition hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800">Show all clubs</button>
      </div>
    </div>
  </div>

  <!-- Create-club modal (#964). A bottom sheet on phones, where the thumb
       is, and a centred dialog from `sm` up. -->
  <div :if="createOpen" class="fixed inset-0 z-50 flex items-end justify-center sm:items-center sm:p-4" role="dialog" aria-modal="true" aria-labelledby="create-club-title">
    <div @click="closeCreate()" class="absolute inset-0 bg-slate-950/50 backdrop-blur-[2px]"></div>
    <div class="relative max-h-[90dvh] w-full max-w-md overflow-y-auto rounded-t-3xl border border-slate-200 bg-white px-5 pb-8 pt-3 shadow-2xl sm:rounded-3xl sm:p-6 dark:border-slate-700 dark:bg-slate-800">
      <div class="mx-auto mb-3 h-1.5 w-10 rounded-full bg-slate-200 sm:hidden dark:bg-slate-600" aria-hidden="true"></div>
      <div class="mb-5 flex items-center justify-between gap-4">
        <h2 id="create-club-title" class="font-display text-xl font-bold text-slate-900 dark:text-white">Create a club</h2>
        <button @click="closeCreate()" aria-label="Close" class="-mr-2 grid h-11 w-11 place-items-center rounded-full text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-700 dark:hover:text-slate-200">
          <i class="i-lucide-x h-5 w-5" aria-hidden="true"></i>
        </button>
      </div>
      <div class="space-y-4">
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">Name</span>
          <input type="text" placeholder="Trail Crushers" x-value="fName" @input="fName.set($event.target.value)" class="min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-600 dark:bg-slate-900 dark:text-white" />
        </label>
        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">Type</span>
            <select x-value="fType" @change="fType.set($event.target.value)" class="min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-600 dark:bg-slate-900 dark:text-white">
              <option value="Running">Running</option>
              <option value="Hiking">Hiking</option>
              <option value="Mixed">Mixed</option>
              <option value="Territory Game">Territory Game</option>
            </select>
          </label>
          <label class="block">
            <span class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">Location</span>
            <input type="text" placeholder="Bay Area, CA" x-value="fLocation" @input="fLocation.set($event.target.value)" class="min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-600 dark:bg-slate-900 dark:text-white" />
          </label>
        </div>
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">Description</span>
          <textarea rows="3" placeholder="What's your club about?" x-value="fDescription" @input="fDescription.set($event.target.value)" class="min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-600 dark:bg-slate-900 dark:text-white py-2.5"></textarea>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">Who can join</span>
          <select x-value="fJoinPolicy" @change="fJoinPolicy.set($event.target.value)" class="min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-600 dark:bg-slate-900 dark:text-white">
            <option value="open">Anyone can join</option>
            <option value="invite_only">Invite only</option>
          </select>
        </label>
        <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-xl bg-slate-50 px-3 text-sm text-slate-700 dark:bg-slate-900/60 dark:text-slate-300">
          <input type="checkbox" x-checked="fPrivate" @change="fPrivate.set($event.target.checked)" class="h-5 w-5 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" />
          Private (only members can see it)
        </label>
        <p :if="createError" role="alert" class="rounded-xl bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-500/10 dark:text-red-300">{{ createError }}</p>
        <div class="flex flex-col-reverse gap-2 pt-1 sm:flex-row">
          <button @click="closeCreate()" class="min-h-11 rounded-full px-5 text-sm font-semibold text-slate-600 transition hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-700">Cancel</button>
          <button @click="submitCreate()" x-disabled="submitting" class="min-h-11 flex-1 rounded-full bg-emerald-600 px-5 text-sm font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98] disabled:opacity-60">{{ submitting ? 'Creating…' : 'Create club' }}</button>
        </div>
      </div>
    </div>
  </div>
@endsection
