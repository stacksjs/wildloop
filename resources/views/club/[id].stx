@extends('layouts/default')

@section('title', 'Club - WildLoop')

@section('content')
<script client>
  import { deleteClub, fetchClubDetail, toggleClubMembership } from '../../assets/scripts/game-api'
  import { fetchClubInvites, inviteToClub, redeemClubInvite } from '../../assets/scripts/events-api'
  import { readRouteParam } from '../../composables/useRouteParam'
  import { recordTitle, setPageSeo } from '../../composables/usePageSeo'

  useHead({ title: 'Club - WildLoop' })

  const wl = useStore('wl')
  const clubId = readRouteParam('id') ?? -1
  const club = state<any>(null)
  const loading = state(true)
  const loadError = state(false)
  const busy = state(false)

  async function loadClub() {
    loading.set(true)
    loadError.set(false)
    try {
      club.set(await fetchClubDetail(clubId))
    }
    catch {
      loadError.set(true)
    }
    loading.set(false)
  }

  onMount(() => { void loadClub() })

  // A closed club answers a Join with a 403 and an explanation. Surfacing that
  // sentence is the whole difference between "nothing happened" and "ask a
  // member for a code".
  const joinError = state<string | null>(null)

  async function onToggle() {
    if (!club() || busy()) return
    busy.set(true)
    joinError.set(null)
    const res = await toggleClubMembership(clubId)
    busy.set(false)
    if (res && res.success) {
      club.set({ ...club(), isMember: !!res.joined, memberCount: res.memberCount ?? club().memberCount })
      return
    }
    joinError.set(res?.error ?? 'Could not update your membership.')
  }

  /* ── Invites ─────────────────────────────────────────────────────────── */

  const inviteOpen = state(false)
  const inviteEmail = state('')
  const inviteNote = state('')
  const inviteError = state<string | null>(null)
  const inviteWorking = state(false)
  const invites = state<any[]>([])
  const copiedCode = state<string | null>(null)

  const isInviteOnly = derived(() => club()?.joinPolicy === 'invite_only')
  const canInvite = derived(() => {
    const current = club()
    if (!current || !wl) return false
    const me = (current.members ?? []).find((m: any) => m.userId === wl.currentUserId())
    return me?.role === 'owner' || me?.role === 'admin'
  })

  async function loadInvites() {
    if (!canInvite()) return
    const list = await fetchClubInvites(clubId)
    if (list) invites.set(list)
  }

  function openInvite() {
    inviteEmail.set('')
    inviteNote.set('')
    inviteError.set(null)
    inviteOpen.set(true)
    void loadInvites()
  }

  async function sendInvite() {
    if (inviteWorking()) return
    const email = inviteEmail().trim()
    if (!email) {
      inviteError.set('Enter the email address to invite.')
      return
    }
    inviteWorking.set(true)
    inviteError.set(null)
    const res = await inviteToClub(clubId, { email, note: inviteNote().trim() || undefined })
    inviteWorking.set(false)
    if (res?.success) {
      inviteEmail.set('')
      inviteNote.set('')
      await loadInvites()
      return
    }
    inviteError.set(res?.fields ? Object.values(res.fields)[0] as string : (res?.error ?? 'Could not create the invite.'))
  }

  async function copyInvite(code) {
    if (typeof navigator === 'undefined') return
    await navigator.clipboard?.writeText(code).catch(() => {})
    copiedCode.set(code)
    setTimeout(() => copiedCode.set(null), 2000)
  }

  /* ── Redeeming ───────────────────────────────────────────────────────── */

  const redeemCode = state('')
  const redeemError = state<string | null>(null)
  const redeemWorking = state(false)

  async function submitRedeem() {
    if (redeemWorking()) return
    const code = redeemCode().trim()
    if (code.length < 8) {
      redeemError.set('Enter the invite code you were sent.')
      return
    }
    redeemWorking.set(true)
    redeemError.set(null)
    const res = await redeemClubInvite(code)
    redeemWorking.set(false)
    if (res?.success) {
      redeemCode.set('')
      await loadClub()
      return
    }
    redeemError.set(res?.error ?? 'That code did not work.')
  }

  const isOwner = derived(() => !!(wl && club() && club().creatorId === wl.currentUserId()))

  async function onDelete() {
    if (!club() || busy()) return
    busy.set(true)
    const ok = await deleteClub(clubId)
    busy.set(false)
    if (ok) navigate('/clubs')
  }

  // The record's own identity, once it loads. Without it every club page
  // serves one title and no canonical. Applied on the client rather than in
  // a `<script server>` block — see usePageSeo for why that is forced.
  effect(() => {
    const record = club()
    if (!record)
      return

    // No id, no canonical. A canonical naming the wrong URL is worse than
    // none: it tells a crawler this page is a copy of something else.
    if (!record.id)
      return

    const name = String(record.name ?? 'Club')
    const where = record.location ? String(record.location) : null
    const members = record.memberCount === 1 ? '1 member' : `${record.memberCount ?? 0} members`
    const blurb = typeof record.description === 'string' ? record.description.trim() : ''

    setPageSeo({
      title: recordTitle(name, where),
      description: `${blurb ? `${blurb} ` : ''}${name} is a ${String(record.type ?? 'running').toLowerCase()} club on WildLoop with ${members}.`.slice(0, 200),
      canonical: `/club/${record.id}`,
    })
  })
</script>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div :if="loading" class="py-20 text-center text-gray-400">Loading club…</div>

    <div :if="!loading && loadError" class="py-20 text-center">
      <div class="w-16 h-16 mx-auto mb-4 bg-red-100 dark:bg-red-900/20 rounded-2xl flex items-center justify-center">
        <Icon name="alert-triangle" size="28" class="text-red-400" />
      </div>
      <h3 class="mb-1 font-semibold text-gray-900 text-lg dark:text-white">Couldn't load this club</h3>
      <button @click="loadClub()" class="mt-2 px-5 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Try again</button>
    </div>

    <div :if="!loading && !loadError && !club" class="py-20 text-center">
      <h3 class="mb-2 font-semibold text-gray-900 text-lg dark:text-white">Club not found</h3>
      <StxLink to="/clubs" class="text-emerald-600 text-sm font-semibold">← Back to clubs</StxLink>
    </div>

    <template :if="!loading && !loadError && club">
      <!-- Header -->
      <div class="card mb-6">
        <div class="flex flex-col sm:flex-row gap-6">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-2xl font-bold shrink-0 bg-emerald-100 dark:bg-emerald-900/20 text-emerald-600">{{ club.name.charAt(0) }}</div>
          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h1 class="text-2xl font-bold dark:text-white">{{ club.name }}</h1>
                <div class="flex flex-wrap items-center gap-3 text-xs text-gray-500 dark:text-slate-400 mt-1">
                  <span>{{ club.location || 'Worldwide' }}</span>
                  <span>{{ club.memberCount + ' members' }}</span>
                  <span class="px-1.5 py-0.5 rounded bg-gray-100 dark:bg-slate-700 font-medium">{{ club.type }}</span>
                  <span :if="club.isPrivate" class="px-1.5 py-0.5 rounded bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400 font-medium">Private</span>
                  <span :if="club.joinPolicy === 'invite_only'" class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-medium">
                    <i class="i-lucide-lock h-3 w-3" aria-hidden="true"></i>Invite only
                  </span>
                  <a :if="club.website" x-href="club.website" rel="noopener" class="text-emerald-700 dark:text-emerald-400 font-medium underline underline-offset-2">{{ club.website.replace(/^https?:\/\//, '') }}</a>
                </div>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <button :if="canInvite" @click="openInvite()" class="px-4 py-2 text-sm font-semibold rounded-lg border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/20 transition">Invite</button>
                <!-- A closed club shows no Join button at all. Offering one that
                     is guaranteed to be refused is worse than not offering it. -->
                <button :if="!isOwner && (!isInviteOnly || club.isMember)" @click="onToggle()" x-disabled="busy" class="px-4 py-2 text-sm font-semibold rounded-lg transition disabled:opacity-60" x-class="club.isMember ? 'bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-300' : 'bg-emerald-600 text-white hover:bg-emerald-700'">{{ club.isMember ? 'Joined' : 'Join' }}</button>
                <button :if="isOwner" @click="onDelete()" x-disabled="busy" class="px-4 py-2 text-sm font-semibold rounded-lg border border-gray-200 dark:border-slate-600 text-red-500 hover:border-red-400 transition disabled:opacity-60">Delete club</button>
              </div>
            </div>
            <p class="text-sm text-gray-600 dark:text-slate-400 mt-3">{{ club.description }}</p>
            <p :if="joinError" role="alert" class="mt-3 rounded-lg bg-amber-50 dark:bg-amber-900/20 px-3 py-2 text-sm text-amber-800 dark:text-amber-300">{{ joinError }}</p>

            <!-- The way in to a closed club: a code from somebody already inside. -->
            <div :if="isInviteOnly && !club.isMember" class="mt-4 rounded-xl border border-slate-200 dark:border-slate-700 p-4">
              <p class="text-sm font-semibold dark:text-white">This team is invite only</p>
              <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">A member has to invite you. Already have a code? Redeem it here.</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <input
                  type="text"
                  placeholder="ABCDE-FGHIJ-KLMNO-PQRST"
                  x-value="redeemCode"
                  @input="e => redeemCode.set(e.target.value)"
                  class="min-w-0 flex-1 rounded-lg border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 px-3 py-2 font-mono text-sm uppercase tracking-wide"
                />
                <button @click="submitRedeem()" x-disabled="redeemWorking()" class="rounded-lg bg-slate-900 dark:bg-white px-4 py-2 text-sm font-semibold text-white dark:text-slate-900 transition disabled:opacity-60">{{ redeemWorking ? 'Checking…' : 'Redeem' }}</button>
              </div>
              <p :if="redeemError" role="alert" class="mt-2 text-sm text-red-500">{{ redeemError }}</p>
            </div>
            <div class="flex items-center gap-6 pt-3 mt-3 border-t border-gray-100 dark:border-slate-700 text-sm">
              <div><span class="font-semibold dark:text-white">{{ club.weeklyDistance + ' mi' }}</span> <span class="text-gray-500 dark:text-slate-400">this week</span></div>
              <div><span class="font-semibold dark:text-white">{{ club.activitiesThisWeek }}</span> <span class="text-gray-500 dark:text-slate-400">activities</span></div>
            </div>
          </div>
        </div>
      </div>

      <div class="grid lg:grid-cols-3 gap-6">
        <!-- Recent feed -->
        <div class="lg:col-span-2 space-y-4">
          <h2 class="font-bold text-lg dark:text-white">Recent activity</h2>
          <template :for="a in club.recentFeed">
            <StxLink x-to="'/activity/' + a.id" class="card flex items-center gap-4 hover:shadow-md transition block">
              <div class="w-10 h-10 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 font-bold shrink-0">{{ a.userName.charAt(0) }}</div>
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-sm dark:text-white truncate">{{ a.userName + ' · ' + a.activityType }}</p>
                <p class="text-xs text-gray-500 dark:text-slate-400">{{ wl.timeAgo(a.completedAt) }}</p>
              </div>
              <div class="text-right shrink-0">
                <p class="font-bold text-sm dark:text-white">{{ (a.distance || 0).toFixed(1) + ' mi' }}</p>
                <p class="metric-label">{{ a.duration }}</p>
              </div>
            </StxLink>
          </template>
          <div :if="club.recentFeed.length === 0" class="card text-center py-10 text-sm text-gray-500 dark:text-slate-400">
            No activity from members yet.
          </div>
        </div>

        <!-- Leaderboard + members -->
        <div class="space-y-6">
          <div class="card">
            <h3 class="flex items-center gap-2 font-bold dark:text-white mb-3">
              <Icon name="trophy" size="16" class="text-yellow-500" />
              This week
            </h3>
            <div class="space-y-2">
              <template :for="row in club.leaderboard">
                <div class="flex items-center gap-3 text-sm">
                  <span class="w-5 text-center font-bold" x-class="row.rank <= 3 ? 'text-yellow-500' : 'text-gray-400'">{{ row.rank }}</span>
                  <StxLink x-to="'/athlete/' + row.userId" class="flex-1 truncate dark:text-white hover:text-emerald-600 transition">{{ row.name }}</StxLink>
                  <span class="text-gray-500 dark:text-slate-400">{{ row.weeklyDistance + ' mi' }}</span>
                </div>
              </template>
              <div :if="club.leaderboard.length === 0" class="text-center py-4 text-sm text-gray-500 dark:text-slate-400">No members yet.</div>
            </div>
          </div>

          <div class="card">
            <h3 class="font-bold dark:text-white mb-3">{{ 'Members (' + club.memberCount + ')' }}</h3>
            <div class="space-y-2">
              <template :for="m in club.members">
                <div class="flex items-center gap-3 text-sm">
                  <StxLink x-to="'/athlete/' + m.userId" class="flex-1 truncate dark:text-white hover:text-emerald-600 transition">{{ m.name }}</StxLink>
                  <span :if="m.role !== 'member'" class="px-1.5 py-0.5 rounded bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 text-xs font-medium capitalize">{{ m.role }}</span>
                </div>
              </template>
            </div>
          </div>
        </div>
      </div>
    </template>
  </div>

  <!-- Invite somebody in. Owners and admins only; the endpoint re-checks. -->
  <div :if="inviteOpen" class="fixed inset-0 z-50 flex items-center justify-center p-4">
    <div @click="inviteOpen.set(false)" class="absolute inset-0 bg-black/40"></div>
    <div class="card relative max-h-[85vh] w-full max-w-lg overflow-y-auto">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-bold dark:text-white">Invite to the team</h2>
        <button @click="inviteOpen.set(false)" aria-label="Close" class="text-xl leading-none text-gray-400 hover:text-gray-600 dark:hover:text-slate-200">×</button>
      </div>

      <div class="space-y-3">
        <div>
          <label class="mb-1 block text-xs font-medium text-gray-500 dark:text-slate-400">Email</label>
          <input type="email" placeholder="runner@example.com" x-value="inviteEmail" @input="e => inviteEmail.set(e.target.value)" class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-700" />
          <p class="mt-1 text-xs text-gray-400 dark:text-slate-500">If they already have a WildLoop account, the invite is addressed to it.</p>
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium text-gray-500 dark:text-slate-400">Note (optional)</label>
          <input type="text" placeholder="Tuesday sessions start at 6." x-value="inviteNote" @input="e => inviteNote.set(e.target.value)" class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm dark:border-slate-600 dark:bg-slate-700" />
        </div>
        <p :if="inviteError" class="text-sm text-red-500">{{ inviteError }}</p>
        <button @click="sendInvite()" x-disabled="inviteWorking()" class="w-full rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-700 disabled:opacity-60">{{ inviteWorking ? 'Creating…' : 'Create invite' }}</button>
      </div>

      <div class="mt-6 border-t border-gray-100 pt-4 dark:border-slate-700">
        <h3 class="mb-3 text-xs font-bold uppercase tracking-[0.12em] text-gray-400 dark:text-slate-500">Invites</h3>
        <div class="space-y-2">
          <template :for="invite in invites">
            <div class="flex items-center gap-3 rounded-lg border border-gray-100 px-3 py-2 dark:border-slate-700">
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-medium dark:text-white">{{ invite.invitedName || invite.invitedEmail || 'Open invite' }}</p>
                <p class="truncate font-mono text-xs text-gray-400">{{ invite.code }}</p>
              </div>
              <span
                class="shrink-0 rounded-full px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-wide"
                x-class="invite.status === 'accepted' ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300' : invite.status === 'pending' ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300' : 'bg-gray-100 text-gray-500 dark:bg-slate-700 dark:text-slate-400'"
              >{{ invite.status }}</span>
              <button :if="invite.status === 'pending'" @click="copyInvite(invite.code)" class="shrink-0 text-xs font-semibold text-emerald-700 dark:text-emerald-400">
                {{ copiedCode === invite.code ? 'Copied' : 'Copy' }}
              </button>
            </div>
          </template>
          <p :if="invites().length === 0" class="py-6 text-center text-sm text-gray-400">No invites yet.</p>
        </div>
      </div>
    </div>
  </div>
@endsection
