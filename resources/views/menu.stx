@extends('layouts/default')

@section('title', 'Menu - WildLoop')

@section('content')
<script server>
  useSeoMeta({
    title: 'Menu — WildLoop',
    description: 'Everything in WildLoop in one place.',
    robots: 'noindex, nofollow',
  })
</script>

<script client>
  import { openAuthGate } from '../composables/useAuthGate'

  useHead({ title: 'Menu — WildLoop' })

  // The tab bar holds the three places people go every day; everything else
  // lives here, the way Facebook's Menu does. Most of these screens had no
  // way in from the app at all: its site header, which linked them, is
  // hidden in the native shell.
  const wl = useStore('wl')
  const account = derived(() => (wl && wl.currentUserId() > 0 ? wl.currentUser() : null))
  const accountInitial = derived(() => (account()?.name || 'W').charAt(0).toUpperCase())
  const isAdmin = derived(() => Boolean(account()?.roles?.includes('admin')))
  const unreadCount = derived(() => (account() ? wl.unreadCount() : 0))

  const GROUPS = [
    {
      title: 'You',
      items: [
        { label: 'Achievements', href: '/achievements', icon: 'i-lucide-trophy' },
        { label: 'Stats', href: '/stats', icon: 'i-lucide-chart-column' },
        { label: 'Saved trails', href: '/profile?tab=saved', icon: 'i-lucide-bookmark' },
      ],
    },
    {
      title: 'Compete',
      items: [
        { label: 'Territory', href: '/territories', icon: 'i-lucide-flag' },
        { label: 'Leaderboard', href: '/leaderboard', icon: 'i-lucide-crown' },
        { label: 'Battles', href: '/battles', icon: 'i-lucide-swords' },
        { label: 'Conquests', href: '/conquests', icon: 'i-lucide-target' },
        { label: 'Challenges', href: '/challenges', icon: 'i-lucide-medal' },
        { label: 'Records', href: '/records', icon: 'i-lucide-timer' },
      ],
    },
    {
      title: 'People',
      items: [
        { label: 'Find athletes', href: '/athletes', icon: 'i-lucide-user-search' },
        { label: 'Clubs', href: '/clubs', icon: 'i-lucide-users' },
        { label: 'Events', href: '/events', icon: 'i-lucide-calendar-days' },
      ],
    },
  ]

  function openLogin(): void {
    openAuthGate('Sign in to keep your runs, trails and territory.', 'login')
  }
</script>

<div class="mx-auto max-w-2xl px-4 pb-10 pt-6">
  <h1 class="mb-5 font-display text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Menu</h1>

  <!-- Who you are, first, as Facebook's Menu opens on your profile. -->
  <StxLink :if="account" to="/profile" class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 transition active:scale-[0.99] dark:border-slate-700 dark:bg-slate-800">
    <span class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-emerald-100 text-xl font-bold text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">{{ accountInitial }}</span>
    <span class="min-w-0 flex-1">
      <span class="block truncate font-semibold text-slate-900 dark:text-white">{{ account()?.name || 'Your profile' }}</span>
      <span class="block text-sm text-slate-500 dark:text-slate-400">See your profile</span>
    </span>
    <i class="i-lucide-chevron-right h-5 w-5 shrink-0 text-slate-400" aria-hidden="true"></i>
  </StxLink>
  <div :if="!account" class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800">
    <p class="font-semibold text-slate-900 dark:text-white">Your runs, trails and territory, on every device.</p>
    <button type="button" @click="openLogin()" class="mt-4 min-h-11 w-full rounded-full bg-emerald-600 px-6 text-sm font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98]">Log in or create an account</button>
  </div>

  <template :for="group in GROUPS">
    <section class="mt-7">
      <h2 class="mb-2 px-1 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">{{ group.title }}</h2>
      <div class="grid grid-cols-2 gap-3">
        <template :for="item in group.items">
          <StxLink x-to="item.href" class="flex min-h-[5.5rem] flex-col justify-between rounded-2xl border border-slate-200 bg-white p-4 transition active:scale-[0.98] dark:border-slate-700 dark:bg-slate-800">
            <i x-class="item.icon" class="h-6 w-6 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
            <span class="mt-3 font-semibold text-slate-900 dark:text-white">{{ item.label }}</span>
          </StxLink>
        </template>
      </div>
    </section>
  </template>

  <section class="mt-7 overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800">
    <StxLink to="/notifications" class="flex min-h-14 items-center gap-3 px-4 transition active:bg-slate-50 dark:active:bg-slate-700/50">
      <i class="i-lucide-bell h-5 w-5 text-slate-500 dark:text-slate-400" aria-hidden="true"></i>
      <span class="flex-1 font-medium text-slate-900 dark:text-white">Notifications</span>
      <span :if="unreadCount() > 0" class="rounded-full bg-emerald-600 px-2 py-0.5 text-xs font-semibold text-white">{{ unreadCount() }}</span>
      <i class="i-lucide-chevron-right h-5 w-5 text-slate-400" aria-hidden="true"></i>
    </StxLink>
    <StxLink to="/settings" class="flex min-h-14 items-center gap-3 border-t border-slate-100 px-4 transition active:bg-slate-50 dark:border-slate-700 dark:active:bg-slate-700/50">
      <i class="i-lucide-settings h-5 w-5 text-slate-500 dark:text-slate-400" aria-hidden="true"></i>
      <span class="flex-1 font-medium text-slate-900 dark:text-white">Settings</span>
      <i class="i-lucide-chevron-right h-5 w-5 text-slate-400" aria-hidden="true"></i>
    </StxLink>
    <StxLink :if="isAdmin" to="/admin" class="flex min-h-14 items-center gap-3 border-t border-slate-100 px-4 transition active:bg-slate-50 dark:border-slate-700 dark:active:bg-slate-700/50">
      <i class="i-lucide-shield-check h-5 w-5 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
      <span class="flex-1 font-medium text-slate-900 dark:text-white">Admin</span>
      <i class="i-lucide-chevron-right h-5 w-5 text-slate-400" aria-hidden="true"></i>
    </StxLink>
  </section>
</div>
@endsection
