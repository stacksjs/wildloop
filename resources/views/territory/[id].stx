@extends('layouts/default')

@section('title', 'Territory Details - WildLoop')

@section('content')
<script client>
  import { createTrailMap, drawTerritoryPolygon, runWhenMapReady, type TrailMapHandle } from '../../composables/useTrailMap'
  import { recordTitle, setPageSeo } from '../../composables/usePageSeo'
  import { readRouteParam } from '../../composables/useRouteParam'

  useHead({ title: 'Territory Details - WildLoop' })

  const wl = useStore('wl')
  // -1 is a no-match sentinel so an unresolved param renders "not found"
  // rather than silently loading territory 1 (#987).
  const territoryId = readRouteParam('id') ?? -1

  const territory = derived(() => wl ? wl.findTerritory(territoryId) : null)
  const owner = derived(() => {
    const t = territory()
    return wl && t ? wl.findUser(t.user_id) : null
  })
  const history = derived(() => wl ? wl.territoryConquests(territoryId) : [])
  const isMine = derived(() => {
    const t = territory()
    return wl && t ? t.user_id === wl.currentUserId() : false
  })

  let detailMap: TrailMapHandle | null = null

  async function mountTerritoryDetailMap() {
    if (!wl) return
    const poly = wl.territoryPolygons()[territoryId]
    if (!poly) return
    detailMap?.destroy()
    detailMap = await createTrailMap('territory-detail-map', { scrollWheelZoom: false })
    if (!detailMap) return
    const polygon = await drawTerritoryPolygon(detailMap.map, poly, {
      color: '#059669',
      fillOpacity: 0.3,
      weight: 3,
    })
    detailMap.map.fitBounds(polygon.getBounds(), { padding: [30, 30] })
  }

  onMount(() => runWhenMapReady('territory-detail-map', mountTerritoryDetailMap))

  onDestroy(() => {
    detailMap?.destroy()
    detailMap = null
  })

  // The record's own identity, once it loads. Without it every territory page
  // serves one title and no canonical. Applied on the client rather than in
  // a `<script server>` block — see usePageSeo for why that is forced.
  effect(() => {
    const seoTerritory = territory()
    if (!seoTerritory?.id)
      return

    const seoName = String(seoTerritory.name ?? 'Territory')
    const seoHolder = seoTerritory.ownerName ? `Held by ${seoTerritory.ownerName}.` : 'Unclaimed.'
    const seoArea = typeof seoTerritory.areaSize === 'number' ? (seoTerritory.areaSize / 1000000).toFixed(2) : null

    setPageSeo({
      title: recordTitle(seoName),
      description: `${seoName} on WildLoop. ${seoHolder}${seoArea ? ` ${seoArea} km² of ground.` : ''} Its holder, and how it changed hands.`,
      canonical: `/territory/${seoTerritory.id}`,
    })
  })
</script>

  <div :if="territory">
    <section class="relative pt-24 pb-16 bg-gradient-to-br from-emerald-600 via-teal-600 to-emerald-700 overflow-hidden">
      <div class="relative mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <div class="flex gap-3 items-center mb-3">
              <span class="px-3 py-1 font-semibold text-sm rounded-full" x-class="isMine ? 'bg-white/20 text-white' : 'bg-orange-500 text-white'">{{ isMine ? 'Your Territory' : 'Enemy Territory' }}</span>
              <span class="px-3 py-1 font-semibold text-sm rounded-full" x-class="territory.status === 'contested' ? 'bg-red-500 text-white' : 'bg-emerald-300/30 text-white'">{{ territory.status === 'contested' ? 'Contested' : 'Secure' }}</span>
            </div>
            <h1 class="font-bold font-display text-3xl md:text-4xl text-white mb-2">{{ territory.name }}</h1>
            <p class="text-lg text-white/70">Owned by <span class="font-semibold text-white">{{ isMine ? 'You' : (owner?.name || 'Unknown') }}</span></p>
          </div>
          <StxLink to="/record" class="px-6 py-3 font-semibold text-sm rounded-xl transition" x-class="isMine ? 'bg-white/20 text-white hover:bg-white/30' : 'bg-white text-orange-700 hover:bg-gray-100 shadow-lg'">{{ isMine ? 'Defend' : 'Conquer This' }}</StxLink>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">
          <div class="card p-0 overflow-hidden">
            <div id="territory-detail-map" data-stx-ignore class="h-80"></div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="card text-center">
              <p class="text-2xl font-bold text-emerald-600">{{ (territory.areaSize / 1000).toFixed(1) }}</p>
              <p class="metric-label">km²</p>
            </div>
            <div class="card text-center">
              <p class="text-2xl font-bold text-blue-600">{{ territory.conquestCount }}</p>
              <p class="metric-label">Times Conquered</p>
            </div>
            <div class="card text-center">
              <p class="text-2xl font-bold text-orange-600">{{ territory.defendCount }}</p>
              <p class="metric-label">Defenses</p>
            </div>
            <div class="card text-center">
              <p class="text-2xl font-bold text-purple-600">{{ territory.totalRunners }}</p>
              <p class="metric-label">Runners</p>
            </div>
          </div>

          <div>
            <h2 class="font-bold text-xl dark:text-white mb-4">Conquest History</h2>
            <div class="space-y-3">
              <template :for="event in history">
                <div class="card flex items-center gap-4">
                  <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 font-bold" x-class="event.status === 'conquered' ? 'bg-orange-100 dark:bg-orange-900/20 text-orange-600' : 'bg-emerald-100 dark:bg-emerald-900/20 text-emerald-600'">{{ event.attackerName.charAt(0) }}</div>
                  <div class="flex-1">
                    <p class="text-sm font-semibold dark:text-white">
                      <span>{{ event.attackerName }}</span>
                      <span>{{ event.status === 'conquered' ? ' conquered this' : ' failed to conquer' }}</span>
                    </p>
                    <p class="text-xs text-gray-500">{{ wl.timeAgo(event.created_at) }}</p>
                  </div>
                  <span class="text-xs px-2 py-1 rounded-full font-medium" x-class="event.status === 'conquered' ? 'bg-orange-100 text-orange-700' : 'bg-emerald-100 text-emerald-700'">{{ event.status === 'conquered' ? 'Conquered' : 'Defended' }}</span>
                </div>
              </template>
              <div :if="history.length === 0" class="text-center py-8 text-gray-400 text-sm">
                <p>No conquest attempts yet.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <div class="card">
            <h3 class="font-bold text-lg dark:text-white mb-4">Current Owner</h3>
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 text-xl font-bold">{{ (owner?.name || 'U').charAt(0) }}</div>
              <div>
                <p class="font-bold dark:text-white">{{ isMine ? 'You' : (owner?.name || 'Unknown') }}</p>
                <p class="text-sm text-gray-500">{{ 'Claimed ' + wl.timeAgo(territory.claimedAt) }}</p>
              </div>
            </div>
          </div>

          <div class="card">
            <h3 class="font-bold text-lg dark:text-white mb-4">How to Conquer</h3>
            <div class="space-y-3 text-sm">
              <div class="flex gap-2"><span class="font-bold text-orange-600">1.</span><span class="dark:text-slate-300">Run through the territory boundary</span></div>
              <div class="flex gap-2"><span class="font-bold text-orange-600">2.</span><span class="dark:text-slate-300">Close your loop</span></div>
              <div class="flex gap-2"><span class="font-bold text-orange-600">3.</span><span class="dark:text-slate-300">The carved area becomes yours</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div :if="!territory" class="text-center py-32">
    <p class="text-gray-500 font-medium">Territory not found</p>
    <StxLink to="/territories" class="inline-block mt-4 px-6 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Back to Territories</StxLink>
  </div>
@endsection
