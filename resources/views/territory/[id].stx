@extends('layouts/default')

@section('title', 'Territory Details - Wildloop')

@section('content')
<script server>
  /*
   * This territory's own metadata in the HTML — see `trail/[id].stx` for the
   * mechanism and `club/[id].stx` for the visibility rule.
   *
   * The one page in the set with no single-record endpoint behind it: the
   * client resolves a territory out of the bulk `/territories/map` payload
   * through the game store, and there is no `/territories/{id}`. So this reads
   * the model directly, which a server block can do and the client cannot.
   *
   * Territories carry no visibility column, and the game's reads — the map, the
   * leaderboard, the battle list — are all public by design, so naming a
   * territory's holder here says nothing the leaderboard does not already say.
   * Two neighbouring settings are deliberately *not* relied on and not needed:
   * `show_precise_territories` governs geometry, and no geometry is rendered
   * below; `exclude_home_from_game` keeps home ground out of the game
   * altogether, so a territory is by construction not somebody's home.
   */
  const ssrTerritoryId = Number(params?.id)
  let ssrTerritory: { name?: string, user_id?: number, area_size?: number, status?: string } | null = null
  let ssrTerritoryLookupFailed = false

  if (Number.isFinite(ssrTerritoryId) && ssrTerritoryId > 0) {
    try {
      ssrTerritory = (await Territory.find(ssrTerritoryId) ?? null) as any
    }
    catch {
      ssrTerritory = null
      ssrTerritoryLookupFailed = true
    }
  }

  /*
   * No such record, as opposed to no answer from the database.
   *
   * One `null` stood for both, and they want opposite handling: a record
   * that does not exist should say so, while a lookup that failed must leave
   * the client's branch alone, so a database hiccup does not replace a page
   * that still loads with a denial. A row that exists but is withheld is
   * neither — it answers 200 with the generic shell, as it did before, so
   * nothing here changes what a private record discloses.
   */
  const ssrTerritoryMissing = !ssrTerritoryLookupFailed && ssrTerritory === null

  // A not-found body under a 200 tells a crawler, a cache and an uptime check
  // that the URL is a real page. `notFound()` records the status without
  // stopping the render, so the markup still explains itself.
  if (ssrTerritoryMissing)
    notFound()

  const ssrTerritoryName = String(ssrTerritory?.name ?? '').trim()

  // The row carries `user_id`, not a name — the same resolution the client does
  // through `owner()`. Without it every held territory describes itself as
  // unclaimed, which is the defect the client-side comment warns about.
  let ssrTerritoryHolder = ''
  const ssrTerritoryUserId = Number(ssrTerritory?.user_id ?? 0)
  if (ssrTerritoryName && Number.isFinite(ssrTerritoryUserId) && ssrTerritoryUserId > 0) {
    try {
      const ssrHolder = await User.find(ssrTerritoryUserId) as any
      ssrTerritoryHolder = String(ssrHolder?.name ?? '').trim()
    }
    catch {
      ssrTerritoryHolder = ''
    }
  }

  // Stored in square metres; km² is the unit the page itself shows.
  const ssrTerritoryArea = Number(ssrTerritory?.area_size ?? 0)
  const ssrTerritoryAreaText = ssrTerritoryArea > 0 ? `${(ssrTerritoryArea / 1_000_000).toFixed(2)} km²` : ''

  /*
   * `recordTitle(name, context)` — the same shape the page's own `setPageSeo`
   * uses, so the served title and the one the client sets after hydration are
   * the same string. They were not: this said `${name} — Wildloop` while the
   * client said `${name} — ${context} | Wildloop`, so a shared link previewed
   * with one title and opened with another.
   */
  const ssrTitle = ssrTerritoryName ? `${ssrTerritoryName} | Wildloop` : 'Territory - Wildloop'

  const ssrDescription = ssrTerritoryName
    ? `${ssrTerritoryName} on Wildloop. ${ssrTerritoryHolder ? `Held by ${ssrTerritoryHolder}.` : 'Unclaimed.'}${ssrTerritoryAreaText ? ` ${ssrTerritoryAreaText} of ground.` : ''} Its holder, and how it changed hands.`
    : 'Claim ground by running it — territories, holders and battles on Wildloop.'

  const ssrCanonical = ssrTerritoryName ? `https://wildloop.org/territory/${ssrTerritoryId}` : 'https://wildloop.org/territories'

  useSeoMeta({
    title: ssrTitle,
    description: ssrDescription,
    canonical: ssrCanonical,
    robots: ssrTerritoryName ? 'index, follow, max-image-preview:large' : 'noindex, follow',
    ogTitle: ssrTitle,
    ogDescription: ssrDescription,
    ogType: 'website',
    ogUrl: ssrCanonical,
    ogImage: 'https://wildloop.org/images/social/og-default.jpg',
    ogSiteName: 'Wildloop',
    ogLocale: 'en_US',
    twitterCard: 'summary_large_image',
    twitterTitle: ssrTitle,
    twitterDescription: ssrDescription,
  })
</script>

<script client>
  import { createTrailMap, drawTerritoryPolygon, runWhenMapReady, type TrailMapHandle } from '../../composables/useTrailMap'
  import { recordTitle, setPageSeo } from '../../composables/usePageSeo'
  import { readRouteParam } from '../../composables/useRouteParam'
  import { formatTerritoryArea } from '../../functions/territory-style'
  import { avatarUrl } from '../../functions/avatars'

  useHead({ title: 'Territory Details - Wildloop' })

  const wl = useStore('wl')
  // -1 is a no-match sentinel so an unresolved param renders "not found"
  // rather than silently loading territory 1 (#987).
  const territoryId = readRouteParam('id') ?? -1

  const territory = derived(() => wl ? wl.findTerritory(territoryId) : null)
  const owner = derived(() => {
    const t = territory()
    return wl && t ? wl.findUser(t.user_id) : null
  })
  const history = derived(() => wl ? wl.territoryConquests(territoryId) : [])
  const isMine = derived(() => {
    const t = territory()
    return wl && t ? t.user_id === wl.currentUserId() : false
  })

  /**
   * `areaSize` is square metres. The stat tile used to divide by a thousand
   * and call it km², overstating every zone a thousandfold; the shared
   * formatter picks m², ha or km² for the magnitude. Wrapped locally because
   * the template cannot call an import.
   */
  function areaText(squareMetres: number): string {
    return formatTerritoryArea(Number(squareMetres) || 0)
  }

  function photoOf(avatar: string | null | undefined): string {
    return avatarUrl(avatar ?? null)
  }

  function initialOf(name: string | null | undefined): string {
    return String(name || '?').charAt(0).toUpperCase()
  }

  let detailMap: TrailMapHandle | null = null

  async function mountTerritoryDetailMap() {
    if (!wl) return
    const poly = wl.territoryPolygons()[territoryId]
    if (!poly) return
    detailMap?.destroy()
    detailMap = await createTrailMap('territory-detail-map')
    if (!detailMap) return
    const polygon = await drawTerritoryPolygon(detailMap.map, poly, {
      color: '#059669',
      fillOpacity: 0.3,
      weight: 3,
    })
    detailMap.map.fitBounds(polygon.getBounds(), { padding: [30, 30] })
  }

  onMount(() => runWhenMapReady('territory-detail-map', mountTerritoryDetailMap))

  onDestroy(() => {
    detailMap?.destroy()
    detailMap = null
  })

  // The record's own identity, once it loads. Without it every territory page
  // serves one title and no canonical. The `<script server>` block above
  // carries the same identity for crawlers; this one re-applies it for the
  // viewer, who may be allowed to see a record the anonymous render had to
  // withhold.
  effect(() => {
    const seoTerritory = territory()
    if (!seoTerritory?.id)
      return

    const seoName = String(seoTerritory.name ?? 'Territory')
    // The store's territory carries `user_id`, not a name — the page resolves
    // the holder through `owner()` and so must this, or every owned territory
    // describes itself as unclaimed.
    const seoHolder = owner()?.name ? `Held by ${owner()?.name}.` : 'Unclaimed.'
    const seoArea = typeof seoTerritory.areaSize === 'number' ? (seoTerritory.areaSize / 1000000).toFixed(2) : null

    setPageSeo({
      title: recordTitle(seoName),
      description: `${seoName} on Wildloop. ${seoHolder}${seoArea ? ` ${seoArea} km² of ground.` : ''} Its holder, and how it changed hands.`,
      canonical: `/territory/${seoTerritory.id}`,
    })
  })
</script>

  <!--
    The page's heading, served. `:if` is evaluated on the client, so stx sends
    that branch with `x-cloak` — `display: none !important` until hydration —
    and anything inside it is absent from the accessibility tree of the served
    document. The heading below therefore sits outside it, holding the name the
    server block already resolved. `sr-only` keeps it out of the picture but in
    the accessibility tree, because the painted title says the same words; that
    title becomes a paragraph here so the page has one heading. The not-found
    card keeps its own heading only when the server resolved nothing, since
    both branches are served and otherwise there would be two. See
    `trail/[id].stx`, where this is spelled out in full.
  -->
  @if (ssrTerritoryName)
  <h1 class="sr-only">{{ ssrTerritoryName }}</h1>
  @endif
  <div :if="territory">
    <section class="relative overflow-hidden bg-gradient-to-br from-emerald-700 via-emerald-600 to-teal-600">
      <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-7xl px-4 pb-10 pt-4 sm:px-6 sm:pb-12 lg:px-8">
        <StxLink to="/territories" class="-ml-2 mb-4 inline-flex min-h-11 items-center gap-1 rounded-full px-2 text-sm font-medium text-white/80 transition hover:text-white">
          <i class="i-lucide-chevron-left h-4 w-4" aria-hidden="true"></i>
          Territory map
        </StxLink>
        <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
          <div class="min-w-0">
            <div class="mb-3 flex flex-wrap items-center gap-2">
              <span class="rounded-full px-3 py-1 text-xs font-semibold" x-class="isMine ? 'bg-white/20 text-white' : 'bg-orange-500 text-white'">{{ isMine ? 'Your territory' : 'Enemy territory' }}</span>
              <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold" x-class="territory.status === 'contested' ? 'bg-red-500 text-white' : 'bg-white/15 text-white'">
                <i x-class="territory.status === 'contested' ? 'i-lucide-swords' : 'i-lucide-shield-check'" class="h-3.5 w-3.5" aria-hidden="true"></i>
                {{ territory.status === 'contested' ? 'Contested' : 'Secure' }}
              </span>
            </div>
            @if (ssrTerritoryName || ssrTerritoryMissing)
            <p class="font-display text-3xl font-bold tracking-tight text-white md:text-4xl">{{ territory.name }}</p>
@else
            <h1 class="font-display text-3xl font-bold tracking-tight text-white md:text-4xl">{{ territory.name }}</h1>
@endif
            <p class="mt-2 text-white/75">Held by <span class="font-semibold text-white">{{ isMine ? 'you' : (owner?.name || 'nobody yet') }}</span></p>
          </div>
          <StxLink to="/record" class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full px-6 text-sm font-semibold transition active:scale-[0.98]" x-class="isMine ? 'bg-white/20 text-white ring-1 ring-white/30 hover:bg-white/30' : 'bg-white text-orange-700 shadow-lg hover:bg-orange-50'">
            <i x-class="isMine ? 'i-lucide-shield' : 'i-lucide-swords'" class="h-4 w-4" aria-hidden="true"></i>
            {{ isMine ? 'Defend it' : 'Conquer this' }}
          </StxLink>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-7xl px-4 pb-12 pt-6 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3 lg:gap-8">
        <div class="space-y-6 lg:col-span-2">
          <!-- A framed surface rather than `.card`, whose padding outranks p-0. -->
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-sm dark:border-slate-700 dark:bg-slate-800">
            <div id="territory-detail-map" data-stx-ignore class="h-80"></div>
          </div>

          <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
              <dt class="metric-label">Area</dt>
              <dd class="mt-1 font-display text-2xl font-bold tabular-nums text-emerald-700 dark:text-emerald-400">{{ areaText(territory.areaSize) }}</dd>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
              <dt class="metric-label">Times taken</dt>
              <dd class="mt-1 font-display text-2xl font-bold tabular-nums text-slate-900 dark:text-white">{{ territory.conquestCount }}</dd>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
              <dt class="metric-label">Defenses</dt>
              <dd class="mt-1 font-display text-2xl font-bold tabular-nums text-slate-900 dark:text-white">{{ territory.defendCount }}</dd>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
              <dt class="metric-label">Runners</dt>
              <dd class="mt-1 font-display text-2xl font-bold tabular-nums text-slate-900 dark:text-white">{{ territory.totalRunners }}</dd>
            </div>
          </dl>

          <section>
            <h2 class="mb-3 font-display text-xl font-bold text-slate-900 dark:text-white">Conquest history</h2>
            <ol :if="history.length > 0" class="divide-y divide-slate-100 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:divide-slate-700/70 dark:border-slate-700 dark:bg-slate-800 dark:shadow-none">
              <template :for="event in history">
                <li class="flex min-h-16 items-center gap-3 px-4 py-3">
                  <Image :if="photoOf(event.attackerAvatar)" x-src="photoOf(event.attackerAvatar)" x-alt="event.attackerName" width="40" height="40" sizes="40px" loading="lazy" class="h-10 w-10 shrink-0 rounded-full object-cover" />
                  <div :if="!photoOf(event.attackerAvatar)" class="grid h-10 w-10 shrink-0 place-items-center rounded-full text-sm font-bold" x-class="event.status === 'conquered' ? 'bg-orange-50 text-orange-700 dark:bg-orange-500/15 dark:text-orange-300' : 'bg-emerald-50 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300'" aria-hidden="true">{{ initialOf(event.attackerName) }}</div>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm text-slate-900 dark:text-white">
                      <span class="font-semibold">{{ event.attackerName }}</span>
                      <span class="text-slate-600 dark:text-slate-300">{{ event.status === 'conquered' ? ' took it' : ' tried and failed' }}</span>
                    </p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">{{ wl.timeAgo(event.created_at) }}</p>
                  </div>
                  <span class="shrink-0 rounded-full px-2 py-0.5 text-[11px] font-semibold" x-class="event.status === 'conquered' ? 'bg-orange-100 text-orange-700 dark:bg-orange-500/15 dark:text-orange-300' : 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300'">{{ event.status === 'conquered' ? 'Conquered' : 'Defended' }}</span>
                </li>
              </template>
            </ol>
            <div :if="history.length === 0" class="rounded-2xl border border-dashed border-slate-300 px-6 py-10 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
              No conquest attempts yet. It has never changed hands.
            </div>
          </section>
        </div>

        <aside class="space-y-6">
          <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:shadow-none">
            <h3 class="metric-label mb-3">Current holder</h3>
            <div class="flex items-center gap-4">
              <Image :if="photoOf(owner?.avatar)" x-src="photoOf(owner?.avatar)" x-alt="owner?.name || 'Owner'" width="56" height="56" sizes="56px" loading="lazy" class="h-14 w-14 shrink-0 rounded-full object-cover" />
              <div :if="!photoOf(owner?.avatar)" class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-emerald-100 font-display text-xl font-bold text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300" aria-hidden="true">{{ initialOf(owner?.name) }}</div>
              <div class="min-w-0">
                <StxLink :if="owner && !isMine" x-to="'/athlete/' + owner.id" class="block truncate font-semibold text-slate-900 transition hover:text-emerald-700 dark:text-white dark:hover:text-emerald-400">{{ owner?.name }}</StxLink>
                <p :if="isMine || !owner" class="truncate font-semibold text-slate-900 dark:text-white">{{ isMine ? 'You' : 'Unclaimed' }}</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">{{ 'Claimed ' + wl.timeAgo(territory.claimedAt) }}</p>
              </div>
            </div>
          </section>

          <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:shadow-none">
            <h3 class="mb-4 font-semibold text-slate-900 dark:text-white">How to conquer</h3>
            <ol class="space-y-3 text-sm">
              <li class="flex gap-3"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-emerald-50 text-xs font-bold text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300">1</span><span class="pt-0.5 text-slate-600 dark:text-slate-300">Run through the territory boundary</span></li>
              <li class="flex gap-3"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-emerald-50 text-xs font-bold text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300">2</span><span class="pt-0.5 text-slate-600 dark:text-slate-300">Close your loop</span></li>
              <li class="flex gap-3"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-emerald-50 text-xs font-bold text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300">3</span><span class="pt-0.5 text-slate-600 dark:text-slate-300">The carved area becomes yours</span></li>
            </ol>
          </section>
        </aside>
      </div>
    </div>
  </div>

@if (ssrTerritoryMissing)
  <!--
    The not-found state, served rather than left for the client to reveal. The
    gated copy below is `:if`-conditioned, which stx serves `x-cloak`ed — so a
    request for a record that does not exist answered 200 with its explanation
    hidden. This copy carries no client directive, and its heading is the page's
    `h1` because here it is what the page is. The two are mutually exclusive, so
    there is one card and one heading either way. See `trail/[id].stx`.
  -->
  <div class="px-4 py-24 text-center">
    <div class="mx-auto mb-5 grid h-16 w-16 place-items-center rounded-2xl bg-slate-100 dark:bg-slate-800">
      <i class="i-lucide-flag-off h-7 w-7 text-slate-400" aria-hidden="true"></i>
    </div>
    <h1 class="text-lg font-semibold text-slate-900 dark:text-white">Territory not found</h1>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">It may have been dissolved, or the link is wrong.</p>
    <StxLink to="/territories" class="mt-6 inline-flex min-h-11 items-center rounded-full bg-emerald-600 px-6 text-sm font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98]">Back to the map</StxLink>
  </div>
@else
  <div :if="!territory" class="px-4 py-24 text-center">
    <div class="mx-auto mb-5 grid h-16 w-16 place-items-center rounded-2xl bg-slate-100 dark:bg-slate-800">
      <i class="i-lucide-flag-off h-7 w-7 text-slate-400" aria-hidden="true"></i>
    </div>
    @if (ssrTerritoryName)
    <p class="text-lg font-semibold text-slate-900 dark:text-white">Territory not found</p>
@else
    <h1 class="text-lg font-semibold text-slate-900 dark:text-white">Territory not found</h1>
@endif
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">It may have been dissolved, or the link is wrong.</p>
    <StxLink to="/territories" class="mt-6 inline-flex min-h-11 items-center rounded-full bg-emerald-600 px-6 text-sm font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98]">Back to the map</StxLink>
  </div>
@endif
@endsection
