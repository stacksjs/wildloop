@extends('layouts/default')

@section('title', 'Notifications - WildLoop')

@section('content')
<script server>
  /*
   * Page metadata, in `<script server>` so it is in the HTML a crawler is
   * served rather than something only hydration produces. See athletes.stx for
   * the full reasoning; the short version is that `useSeoMeta` is the only one
   * of the head helpers that reaches the composed document head from a page,
   * and it has to be written inline because the engine injects it into the
   * page's own scope and not into a module it imports.
   */
  useSeoMeta({
    title: 'Notifications — WildLoop',
    description: 'Your WildLoop notifications.',
    robots: 'noindex, nofollow',
  })
</script>

<script client>
  import { markNotificationsRead } from '../assets/scripts/game-api'

  useHead({ title: 'Notifications - WildLoop' })

  const wl = useStore('wl')
  const filter = state<'all' | 'unread' | 'conquest' | 'kudos' | 'challenge'>('all')

  const unreadCount = derived(() => wl ? wl.unreadCount() : 0)

  function markAll() {
    if (!wl) return
    wl.markAllNotificationsRead() // optimistic
    markNotificationsRead() // persist
  }

  function markOne(id: number) {
    if (!wl) return
    wl.markNotificationRead(id)
    markNotificationsRead(id)
  }

  const filtered = derived(() => {
    if (!wl) return []
    const f = filter()
    if (f === 'all') return wl.notifications()
    if (f === 'unread') return wl.notifications().filter((n: any) => !n.read)
    if (f === 'conquest') return wl.notifications().filter((n: any) => n.type.startsWith('conquest'))
    return wl.notifications().filter((n: any) => n.type === f)
  })

  const groupedByDay = derived(() => {
    const now = Date.now()
    const dayMs = 86400000
    const buckets: { label: string, items: any[] }[] = [
      { label: 'Today', items: [] },
      { label: 'Yesterday', items: [] },
      { label: 'Earlier', items: [] },
    ]
    for (const n of filtered()) {
      const age = now - new Date(n.created_at).getTime()
      if (age < dayMs) buckets[0].items.push(n)
      else if (age < dayMs * 2) buckets[1].items.push(n)
      else buckets[2].items.push(n)
    }
    return buckets.filter(b => b.items.length > 0)
  })


  const iconTheme = (type: string): string => {
    if (type === 'kudos') return 'bg-red-100 dark:bg-red-900/20 text-red-500'
    if (type === 'comment') return 'bg-blue-100 dark:bg-blue-900/20 text-blue-500'
    if (type === 'conquest_attack') return 'bg-orange-100 dark:bg-orange-900/20 text-orange-500'
    if (type === 'conquest_defend') return 'bg-emerald-100 dark:bg-emerald-900/20 text-emerald-500'
    if (type === 'conquest_win' || type === 'achievement') return 'bg-yellow-100 dark:bg-yellow-900/20 text-yellow-500'
    if (type === 'challenge') return 'bg-purple-100 dark:bg-purple-900/20 text-purple-500'
    if (type === 'club') return 'bg-indigo-100 dark:bg-indigo-900/20 text-indigo-500'
    // A reviewer's decision on a record claim - the one notification an
    // athlete is actually waiting for, so it gets the stopwatch, not a
    // generic bell.
    if (type === 'record') return 'bg-emerald-100 dark:bg-emerald-900/20 text-emerald-600'
    return 'bg-gray-100 dark:bg-slate-700 text-gray-500'
  }

  const filterCount = (f: string): number => {
    if (!wl) return 0
    if (f === 'all') return wl.notifications().length
    if (f === 'unread') return wl.notifications().filter((n: any) => !n.read).length
    if (f === 'conquest') return wl.notifications().filter((n: any) => n.type.startsWith('conquest')).length
    return wl.notifications().filter((n: any) => n.type === f).length
  }
</script>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold dark:text-white">Notifications</h1>
        <span :if="unreadCount > 0" class="px-2 py-0.5 rounded-full text-xs font-semibold bg-red-500 text-white">{{ unreadCount }}</span>
      </div>
      <button :if="unreadCount > 0" @click="markAll()" class="text-sm text-emerald-600 hover:text-emerald-700 font-medium transition flex items-center gap-1.5">
        <Icon name="check-check" size="16" />
        Mark all read
      </button>
    </div>

    <!-- Filter tabs with counts -->
    <div class="flex gap-2 mb-6 overflow-x-auto pb-2 -mx-4 px-4 sm:mx-0 sm:px-0">
      <button @click="filter.set('all')" x-class="filter === 'all' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-slate-300 hover:bg-gray-200 dark:hover:bg-slate-700'" class="px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap transition flex items-center gap-1.5">
        All
        <span x-class="filter === 'all' ? 'bg-white/20' : 'bg-gray-200 dark:bg-slate-700'" class="px-1.5 py-0.5 text-xs rounded-full min-w-[1.5rem] text-center">{{ filterCount('all') }}</span>
      </button>
      <button @click="filter.set('unread')" x-class="filter === 'unread' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-slate-300 hover:bg-gray-200 dark:hover:bg-slate-700'" class="px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap transition flex items-center gap-1.5">
        Unread
        <span x-class="filter === 'unread' ? 'bg-white/20' : 'bg-gray-200 dark:bg-slate-700'" class="px-1.5 py-0.5 text-xs rounded-full min-w-[1.5rem] text-center">{{ filterCount('unread') }}</span>
      </button>
      <button @click="filter.set('conquest')" x-class="filter === 'conquest' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-slate-300 hover:bg-gray-200 dark:hover:bg-slate-700'" class="px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap transition flex items-center gap-1.5">
        Conquests
        <span x-class="filter === 'conquest' ? 'bg-white/20' : 'bg-gray-200 dark:bg-slate-700'" class="px-1.5 py-0.5 text-xs rounded-full min-w-[1.5rem] text-center">{{ filterCount('conquest') }}</span>
      </button>
      <button @click="filter.set('kudos')" x-class="filter === 'kudos' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-slate-300 hover:bg-gray-200 dark:hover:bg-slate-700'" class="px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap transition flex items-center gap-1.5">
        Kudos
        <span x-class="filter === 'kudos' ? 'bg-white/20' : 'bg-gray-200 dark:bg-slate-700'" class="px-1.5 py-0.5 text-xs rounded-full min-w-[1.5rem] text-center">{{ filterCount('kudos') }}</span>
      </button>
      <button @click="filter.set('challenge')" x-class="filter === 'challenge' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-slate-300 hover:bg-gray-200 dark:hover:bg-slate-700'" class="px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap transition flex items-center gap-1.5">
        Challenges
        <span x-class="filter === 'challenge' ? 'bg-white/20' : 'bg-gray-200 dark:bg-slate-700'" class="px-1.5 py-0.5 text-xs rounded-full min-w-[1.5rem] text-center">{{ filterCount('challenge') }}</span>
      </button>
    </div>

    <!-- Notification groups -->
    <div :if="filtered.length > 0" class="space-y-8">
      <template :for="group in groupedByDay">
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-slate-500 mb-3 px-1">{{ group.label }}</h2>
          <div class="space-y-2">
            <template :for="notif in group.items">
              <StxLink x-to="notif.link || '#'" @click="markOne(notif.id)" class="group relative flex items-start gap-4 p-4 rounded-xl border transition-all block" x-class="!notif.read ? 'bg-emerald-50/50 dark:bg-emerald-900/10 border-emerald-200 dark:border-emerald-800/40 hover:border-emerald-300 dark:hover:border-emerald-700/60' : 'bg-white dark:bg-slate-800/50 border-gray-200 dark:border-slate-700/50 hover:bg-gray-50 dark:hover:bg-slate-800 hover:border-gray-300 dark:hover:border-slate-600'">
                <!-- Unread indicator (left bar) -->
                <div :if="!notif.read" class="absolute left-0 top-4 bottom-4 w-1 rounded-r bg-emerald-500"></div>

                <!-- Type icon -->
                <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0" x-class="iconTheme(notif.type)">
                  <Icon :if="notif.type === 'kudos'" name="heart" size="18" />
                  <Icon :if="notif.type === 'comment'" name="message-circle" size="18" />
                  <Icon :if="notif.type === 'conquest_attack'" name="swords" size="18" />
                  <Icon :if="notif.type === 'conquest_defend'" name="shield" size="18" />
                  <Icon :if="notif.type === 'conquest_win'" name="trophy" size="18" />
                  <Icon :if="notif.type === 'challenge'" name="flag" size="18" />
                  <Icon :if="notif.type === 'achievement'" name="award" size="18" />
                  <Icon :if="notif.type === 'club'" name="users" size="18" />
                  <Icon :if="notif.type === 'record'" name="timer" size="18" />
                </div>

                <!-- Body -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-start justify-between gap-3">
                    <p class="text-sm font-semibold text-gray-900 dark:text-white leading-tight">{{ notif.title }}</p>
                    <p class="text-xs text-gray-400 dark:text-slate-500 whitespace-nowrap shrink-0 mt-0.5">{{ wl.timeAgo(notif.created_at) }}</p>
                  </div>
                  <p class="text-sm text-gray-600 dark:text-slate-400 mt-1">{{ notif.message }}</p>
                </div>

                <!-- Chevron on hover -->
                <div class="flex items-center text-gray-300 dark:text-slate-600 opacity-0 group-hover:opacity-100 transition -mr-1 shrink-0 self-center">
                  <Icon name="chevron-right" size="18" />
                </div>
              </StxLink>
            </template>
          </div>
        </div>
      </template>
    </div>

    <!-- Empty state -->
    <div :if="filtered.length === 0" class="py-20 text-center">
      <div class="w-20 h-20 mx-auto mb-6 bg-emerald-100 dark:bg-emerald-900/20 rounded-2xl flex items-center justify-center">
        <Icon name="check-circle" size="40" class="text-emerald-500" />
      </div>
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{{ filter === 'unread' ? 'All caught up!' : filter === 'all' ? 'No notifications yet' : 'Nothing here' }}</h3>
      <p class="text-gray-500 dark:text-slate-400 max-w-sm mx-auto">{{ filter === 'unread' ? 'You\'ve read everything. Nice work.' : filter === 'all' ? 'When people give kudos, challenge you, or conquer your territory, it\'ll show up here.' : 'Try a different filter above.' }}</p>
    </div>
  </div>
@endsection
