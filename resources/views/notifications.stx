@extends('layouts/default')

@section('title', 'Notifications - WildLoop')

@section('content')
<script server>
  /*
   * Page metadata, in `<script server>` so it is in the HTML a crawler is
   * served rather than something only hydration produces. See athletes.stx for
   * the full reasoning; the short version is that `useSeoMeta` is the only one
   * of the head helpers that reaches the composed document head from a page,
   * and it has to be written inline because the engine injects it into the
   * page's own scope and not into a module it imports.
   */
  useSeoMeta({
    title: 'Notifications — WildLoop',
    description: 'Your WildLoop notifications.',
    robots: 'noindex, nofollow',
  })
</script>

<script client>
  import { markNotificationsRead } from '../assets/scripts/game-api'
  import { openAuthGate } from '../composables/useAuthGate'

  useHead({ title: 'Notifications — WildLoop' })

  const wl = useStore('wl')
  const filter = state<'all' | 'unread' | 'conquest' | 'kudos' | 'challenge'>('all')

  const unreadCount = derived(() => wl ? wl.unreadCount() : 0)
  const signedIn = derived(() => Boolean(wl && wl.currentUserId() > 0))

  const FILTERS = [
    { key: 'all', label: 'All' },
    { key: 'unread', label: 'Unread' },
    { key: 'conquest', label: 'Conquests' },
    { key: 'kudos', label: 'Kudos' },
    { key: 'challenge', label: 'Challenges' },
  ] as const

  function openLogin(): void {
    openAuthGate('Sign in to see your notifications.', 'login')
  }

  function markAll() {
    if (!wl) return
    wl.markAllNotificationsRead() // optimistic
    markNotificationsRead() // persist
  }

  function markOne(id: number) {
    if (!wl) return
    wl.markNotificationRead(id)
    markNotificationsRead(id)
  }

  const filtered = derived(() => {
    if (!wl) return []
    const f = filter()
    if (f === 'all') return wl.notifications()
    if (f === 'unread') return wl.notifications().filter((n: any) => !n.read)
    if (f === 'conquest') return wl.notifications().filter((n: any) => n.type.startsWith('conquest'))
    return wl.notifications().filter((n: any) => n.type === f)
  })

  const groupedByDay = derived(() => {
    const now = Date.now()
    const dayMs = 86400000
    const buckets: { label: string, items: any[] }[] = [
      { label: 'Today', items: [] },
      { label: 'Yesterday', items: [] },
      { label: 'Earlier', items: [] },
    ]
    for (const n of filtered()) {
      const age = now - new Date(n.created_at).getTime()
      if (age < dayMs) buckets[0].items.push(n)
      else if (age < dayMs * 2) buckets[1].items.push(n)
      else buckets[2].items.push(n)
    }
    return buckets.filter(b => b.items.length > 0)
  })


  const iconTheme = (type: string): string => {
    if (type === 'kudos') return 'bg-red-100 dark:bg-red-500/15 text-red-500'
    if (type === 'comment') return 'bg-blue-100 dark:bg-blue-500/15 text-blue-500'
    if (type === 'conquest_attack') return 'bg-orange-100 dark:bg-orange-500/15 text-orange-500'
    if (type === 'conquest_defend') return 'bg-emerald-100 dark:bg-emerald-500/15 text-emerald-500'
    if (type === 'conquest_win' || type === 'achievement') return 'bg-amber-100 dark:bg-amber-500/15 text-amber-500'
    if (type === 'challenge') return 'bg-violet-100 dark:bg-violet-500/15 text-violet-500'
    if (type === 'club') return 'bg-sky-100 dark:bg-sky-500/15 text-sky-500'
    // A reviewer's decision on a record claim - the one notification an
    // athlete is actually waiting for, so it gets the stopwatch, not a
    // generic bell.
    if (type === 'record') return 'bg-emerald-100 dark:bg-emerald-500/15 text-emerald-600'
    return 'bg-slate-100 dark:bg-slate-700 text-slate-500'
  }

  const filterCount = (f: string): number => {
    if (!wl) return 0
    if (f === 'all') return wl.notifications().length
    if (f === 'unread') return wl.notifications().filter((n: any) => !n.read).length
    if (f === 'conquest') return wl.notifications().filter((n: any) => n.type.startsWith('conquest')).length
    return wl.notifications().filter((n: any) => n.type === f).length
  }
</script>

  <div class="mx-auto max-w-2xl px-4 pb-12 pt-6 sm:px-6 lg:px-8">
    <!-- Header -->
    <header class="mb-5 flex items-center justify-between gap-4">
      <div class="flex min-w-0 items-center gap-2.5">
        <h1 class="font-display text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Notifications</h1>
        <span :if="unreadCount > 0" class="rounded-full bg-emerald-600 px-2 py-0.5 text-xs font-semibold tabular-nums text-white">{{ unreadCount }}</span>
      </div>
      <button :if="unreadCount > 0" @click="markAll()" class="-mr-2 inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-full px-3 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-50 dark:text-emerald-400 dark:hover:bg-emerald-500/10">
        <Icon name="check-check" size="16" />
        <span>Mark all read</span>
      </button>
    </header>

    <!-- Filter chips with counts. Bleed to the edge on phones, no scrollbar. -->
    <div :if="signedIn" class="-mx-4 mb-6 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] sm:mx-0 sm:px-0">
      <template :for="chip in FILTERS">
        <button @click="filter.set(chip.key)" x-class="filter === chip.key ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900' : 'bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'" class="inline-flex min-h-10 shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full pl-4 pr-2 text-sm font-semibold transition active:scale-[0.98]">
          {{ chip.label }}
          <span x-class="filter === chip.key ? 'bg-white/20 dark:bg-slate-900/15' : 'bg-white text-slate-500 dark:bg-slate-700 dark:text-slate-400'" class="min-w-[1.5rem] rounded-full px-1.5 py-0.5 text-center text-xs tabular-nums">{{ filterCount(chip.key) }}</span>
        </button>
      </template>
    </div>

    <!-- Notification groups: one grouped surface per day, the way a native
         inbox reads. Unread rows carry a dot and a faint tint. -->
    <div :if="filtered.length > 0" class="space-y-6">
      <template :for="group in groupedByDay">
        <section>
          <h2 class="metric-label mb-2 px-1">{{ group.label }}</h2>
          <div class="divide-y divide-slate-100 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:divide-slate-700/70 dark:border-slate-700 dark:bg-slate-800 dark:shadow-none">
            <template :for="notif in group.items">
              <StxLink x-to="notif.link || '#'" @click="markOne(notif.id)" class="group relative flex items-start gap-3 px-4 py-3.5 transition hover:bg-slate-50 active:bg-slate-100 dark:hover:bg-slate-700/40" x-class="!notif.read ? 'bg-emerald-50/50 dark:bg-emerald-500/5' : ''">
                <!-- Type icon -->
                <div class="relative mt-0.5 grid h-10 w-10 shrink-0 place-items-center rounded-full" x-class="iconTheme(notif.type)">
                  <Icon :if="notif.type === 'kudos'" name="heart" size="18" />
                  <Icon :if="notif.type === 'comment'" name="message-circle" size="18" />
                  <Icon :if="notif.type === 'conquest_attack'" name="swords" size="18" />
                  <Icon :if="notif.type === 'conquest_defend'" name="shield" size="18" />
                  <Icon :if="notif.type === 'conquest_win'" name="trophy" size="18" />
                  <Icon :if="notif.type === 'challenge'" name="flag" size="18" />
                  <Icon :if="notif.type === 'achievement'" name="award" size="18" />
                  <Icon :if="notif.type === 'club'" name="users" size="18" />
                  <Icon :if="notif.type === 'record'" name="timer" size="18" />
                </div>

                <!-- Body -->
                <div class="min-w-0 flex-1">
                  <div class="flex items-start justify-between gap-3">
                    <p class="text-sm leading-snug text-slate-900 dark:text-white" x-class="!notif.read ? 'font-semibold' : 'font-medium'">{{ notif.title }}</p>
                    <span class="mt-0.5 flex shrink-0 items-center gap-1.5">
                      <span class="whitespace-nowrap text-xs text-slate-400 dark:text-slate-500">{{ wl.timeAgo(notif.created_at) }}</span>
                      <span :if="!notif.read" class="h-2 w-2 rounded-full bg-emerald-500" aria-label="Unread"></span>
                    </span>
                  </div>
                  <p class="mt-0.5 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{{ notif.message }}</p>
                </div>

                <i class="i-lucide-chevron-right mt-2.5 h-4 w-4 shrink-0 text-slate-300 transition group-hover:translate-x-0.5 group-hover:text-slate-400 dark:text-slate-600" aria-hidden="true"></i>
              </StxLink>
            </template>
          </div>
        </section>
      </template>
    </div>

    <!-- Signed out -->
    <div :if="!signedIn" class="rounded-2xl border border-dashed border-slate-300 px-6 py-16 text-center dark:border-slate-700">
      <div class="mx-auto mb-5 grid h-16 w-16 place-items-center rounded-2xl bg-emerald-50 dark:bg-emerald-500/10">
        <i class="i-lucide-bell h-7 w-7 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
      </div>
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Kudos, challenges and captures</h3>
      <p class="mx-auto mt-1 max-w-sm text-slate-500 dark:text-slate-400">Sign in to hear when somebody gives you kudos, challenges you, or takes your ground.</p>
      <button type="button" @click="openLogin()" class="mt-6 min-h-11 rounded-full bg-emerald-600 px-6 text-sm font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98]">Log in</button>
    </div>

    <!-- Empty state -->
    <div :if="signedIn && filtered.length === 0" class="rounded-2xl border border-dashed border-slate-300 px-6 py-16 text-center dark:border-slate-700">
      <div class="mx-auto mb-5 grid h-16 w-16 place-items-center rounded-2xl bg-emerald-50 dark:bg-emerald-500/10">
        <Icon name="check-circle" size="30" class="text-emerald-600 dark:text-emerald-400" />
      </div>
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{{ filter === 'unread' ? 'All caught up' : filter === 'all' ? 'No notifications yet' : 'Nothing here' }}</h3>
      <p class="mx-auto mt-1 max-w-sm text-slate-500 dark:text-slate-400">{{ filter === 'unread' ? 'You\'ve read everything.' : filter === 'all' ? 'When people give kudos, challenge you, or conquer your territory, it\'ll show up here.' : 'Try a different filter above.' }}</p>
      <button :if="filter !== 'all'" @click="filter.set('all')" class="mt-5 min-h-11 rounded-full px-5 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-50 dark:text-emerald-400 dark:hover:bg-emerald-500/10">Show everything</button>
    </div>
  </div>
@endsection
