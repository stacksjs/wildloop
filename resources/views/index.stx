@extends('layouts/default')

@section('title', 'WildLoop - Find your next adventure')

@section('content')
<script server>
  /*
   * SEO for this page.
   *
   * `<script server>` because a crawler reads the HTML it is served and never
   * runs the client script — tags set after hydration are tags nobody indexes.
   * `useSeoMeta` rather than `useHead` because only the former reaches the
   * composed document head from a page. And written out here rather than
   * wrapped in a composable: the engine injects `useSeoMeta` into a page's own
   * script scope and not into a module it imports, where it is simply
   * undefined and the call fails without a word.
   *
   * URLs are absolute. A crawler resolves `og:image` against nothing, so a
   * relative path is dropped and the link previews as a bare URL.
   */
  useSeoMeta({
    title: 'Find your next adventure — WildLoop',
    description: 'Half a million trails, live GPS tracking, segments and a social feed — and every closed loop you run claims territory somebody else can take back.',
    canonical: 'https://wildloop.org/',
    robots: 'index, follow, max-image-preview:large',
    ogTitle: 'Find your next adventure — WildLoop',
    ogDescription: 'Half a million trails, live GPS tracking, segments and a social feed — and every closed loop you run claims territory somebody else can take back.',
    ogType: 'website',
    ogUrl: 'https://wildloop.org/',
    ogImage: 'https://wildloop.org/images/social/og-default.jpg',
    ogSiteName: 'WildLoop',
    ogLocale: 'en_US',
    twitterCard: 'summary_large_image',
    twitterTitle: 'Find your next adventure — WildLoop',
    twitterDescription: 'Half a million trails, live GPS tracking, segments and a social feed — and every closed loop you run claims territory somebody else can take back.',
    twitterImage: 'https://wildloop.org/images/social/og-default.jpg',
  })
</script>

<script server>
  import { qrBrandedMarkup } from '../functions/qr'

  // Built once at render time. The address never changes, so there is nothing
  // for the browser to compute and no encoder to ship to it.
  const appQr = qrBrandedMarkup('https://wildloop.org/app', { title: 'Scan to get WildLoop on your phone' })
</script>

<script client>
  import { fetchCoverage, queryTrails } from '../composables/useTrailCatalog'
  import { useAppInstall } from '../composables/useAppInstall'
  import { locatePrecisely, locating as nearbyLocating, resolveNearby } from '../composables/useNearby'
  import { activitySharePreview } from '../functions/activity-share'


  const { canPrompt, installed, platform, promptInstall } = useAppInstall()

  // Last known production snapshot: render useful proof immediately, then
  // replace it with the minute-cached live catalog response. A cold API used
  // to leave three anonymous skeleton bars in the marketing page for 1s+.
  const coverage = state({
    total: 593188,
    countries: [
      { code: 'US', count: 302768 },
      { code: 'DE', count: 202955 },
      { code: 'CH', count: 53440 },
      { code: 'AT', count: 34025 },
    ],
    states: [],
    sources: [],
  })

  /**
   * Mirrored through `derived` because the template's expression scope only
   * resolves declarations made in this script — an imported signal called
   * straight from the markup never evaluates.
   *
   * The name matters. A local that collides with an imported binding is
   * renamed when the page is bundled (`locating` became `locating2`), and the
   * markup keeps asking for the original — so the expression resolves to
   * nothing and the button silently loses its label.
   */
  const findingMe = derived(() => nearbyLocating())

  const search = state('')
  const featured = state([])
  const featuredLabel = state('Popular right now')
  const featuredLoading = state(true)
  const topTrails = state([])

  const trailCount = derived(() => coverage().total)
  const regionCount = derived(() => coverage().states.length || 102)
  const countryCount = derived(() => coverage().countries.length)

  const COUNTRY_NAMES = {
    AT: 'Austria', AU: 'Australia', CA: 'Canada', CH: 'Switzerland', DE: 'Germany',
    ES: 'Spain', FR: 'France', GB: 'United Kingdom', IT: 'Italy', NO: 'Norway',
    NZ: 'New Zealand', SE: 'Sweden', US: 'United States',
  }

  function countryName(code) {
    return COUNTRY_NAMES[code] ?? code
  }

  const topCountries = derived(() => coverage().countries.slice(0, 12))
  const topRegions = derived(() => coverage().states.slice(0, 16))

  function submitSearch(event) {
    event.preventDefault()
    const term = search().trim()
    navigate(term ? `/trails?q=${encodeURIComponent(term)}` : '/trails')
  }

  async function loadFeatured(query, label) {
    featuredLoading.set(true)
    try {
      const result = await queryTrails({ sort: 'featured', limit: 4, ...query })
      featured.set(result.trails)
      featuredLabel.set(label)
    }
    catch {
      // The homepage is not the place to shout about a catalog hiccup. An
      // empty shelf simply does not render; every other section still works.
      featured.set([])
    }
    featuredLoading.set(false)
  }

  /** Load the shelf for a place, however that place was arrived at. */
  function loadFeaturedNear(place) {
    return loadFeatured(
      { lat: place.lat, lng: place.lng, radius: 40, sort: 'rating' },
      place.source === 'gps' ? 'Local favorites near you' : `Local favorites near ${place.label}`,
    )
  }

  // A precise position costs a permission prompt, so it is only ever asked for
  // when somebody presses the button. The coarse fix behind `resolveNearby`
  // needs no prompt and is resolved on mount, which is why the shelf is
  // usually already local before anyone clicks anything.
  async function findNearMe() {
    const place = await locatePrecisely()
    if (place)
      await loadFeaturedNear(place)
  }

  const sampleActivity = {
    activityType: 'Trail Run',
    created_at: '2026-08-12T13:18:00.000Z',
    distance: 9.84,
    duration: '1:28:04',
    elevation_gain: 1842,
    moving_time: '1:26:18',
    pace: '8:46 /mi',
    title: 'Headlands Ridge Loop',
    userName: 'Maya Chen',
  }

  const sampleRoute = [
    { lat: 37.832, lng: -122.532 },
    { lat: 37.838, lng: -122.521 },
    { lat: 37.835, lng: -122.506 },
    { lat: 37.825, lng: -122.497 },
    { lat: 37.814, lng: -122.505 },
    { lat: 37.808, lng: -122.519 },
    { lat: 37.817, lng: -122.531 },
    { lat: 37.832, lng: -122.532 },
  ]

  const sampleSquare = activitySharePreview(sampleActivity, sampleRoute, 'square')
  const sampleStory = activitySharePreview(sampleActivity, sampleRoute, 'story')

  onMount(() => {
    // Resolve where the visitor is before choosing what to put on the shelf.
    // A remembered or edge-derived fix costs no prompt, so the first thing
    // most people see is already their own area rather than a national list
    // they then have to narrow by hand.
    void resolveNearby().then((place) => {
      return place ? loadFeaturedNear(place) : loadFeatured({}, 'Popular right now')
    })

    // Keep the catalog refresh behind the hero/runtime critical path. The
    // snapshot above is already useful and the live value is supplementary.
    setTimeout(() => {
      void fetchCoverage().then((value) => {
        if (value.total > 0)
          coverage.set(value)
      })
      void queryTrails({ sort: 'rating', limit: 14 })
        .then(result => topTrails.set(result.trails))
        .catch(() => {})
    }, 600)
  })
</script>

<div class="marketing-page overflow-hidden">

  <!-- ── Above the fold ─────────────────────────────────────────────────────
       One photograph, one promise, one search box. Everything else on this
       page is below the fold on purpose: the first thing a visitor wants is
       somewhere to go this weekend, not a feature list. -->
  <section class="hero-stage">
    <Image
      src="/images/marketing/wildloop-ridge-runner.jpg"
      alt=""
      width="1440"
      height="960"
      sizes="100vw"
      priority
      decorative
      class="hero-photo"
    />

    <div class="hero-inner">
      <h1 class="hero-title">Find your next adventure</h1>

      <form @submit="submitSearch" class="hero-search" role="search">
        <label for="hero-search-input" class="sr-only">Search by city, park, or trail name</label>
        <span class="hero-search-icon" aria-hidden="true"><i class="i-lucide-search h-5 w-5"></i></span>
        <input
          id="hero-search-input"
          type="search"
          x-value="search"
          @input="e => search.set(e.target.value)"
          placeholder="Search by city, park, or trail name"
          autocomplete="off"
        />
        <button type="submit" class="hero-search-go">Search</button>
      </form>

      <div class="hero-links">
        <button type="button" @click="findNearMe()" x-disabled="findingMe()">
          {{ findingMe() ? 'Finding you…' : 'Explore nearby trails' }}
        </button>
        <StxLink to="/routes">Create a route</StxLink>
      </div>
    </div>
  </section>

  <!-- ── Local favorites ──────────────────────────────────────────────────── -->
  <section class="section-paper">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-16">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="font-display text-2xl font-bold tracking-[-0.03em] sm:text-3xl">{{ featuredLabel }}</h2>
        <StxLink to="/trails" class="text-sm font-semibold text-emerald-700 underline underline-offset-4 dark:text-emerald-400">See all trails</StxLink>
      </div>

      <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <template :if="featuredLoading() && featured().length === 0">
          <div class="trail-tile animate-pulse"><div class="trail-tile-photo bg-slate-200 dark:bg-slate-700"></div><div class="mt-3 h-4 w-3/4 rounded bg-slate-200 dark:bg-slate-700"></div><div class="mt-2 h-3 w-1/2 rounded bg-slate-200 dark:bg-slate-700"></div></div>
          <div class="trail-tile animate-pulse"><div class="trail-tile-photo bg-slate-200 dark:bg-slate-700"></div><div class="mt-3 h-4 w-2/3 rounded bg-slate-200 dark:bg-slate-700"></div><div class="mt-2 h-3 w-2/5 rounded bg-slate-200 dark:bg-slate-700"></div></div>
          <div class="trail-tile animate-pulse"><div class="trail-tile-photo bg-slate-200 dark:bg-slate-700"></div><div class="mt-3 h-4 w-4/5 rounded bg-slate-200 dark:bg-slate-700"></div><div class="mt-2 h-3 w-1/2 rounded bg-slate-200 dark:bg-slate-700"></div></div>
          <div class="trail-tile animate-pulse"><div class="trail-tile-photo bg-slate-200 dark:bg-slate-700"></div><div class="mt-3 h-4 w-3/5 rounded bg-slate-200 dark:bg-slate-700"></div><div class="mt-2 h-3 w-2/5 rounded bg-slate-200 dark:bg-slate-700"></div></div>
        </template>

        <template :for="trail in featured">
          <StxLink x-to="'/trail/' + trail.id" class="trail-tile group">
            <div class="trail-tile-photo">
              <Image :if="trail.image" x-src="trail.image" x-alt="trail.name" width="640" height="480" sizes="(max-width: 768px) 100vw, 33vw" placeholder="blur" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]" />
              <div :if="!trail.image" class="trail-tile-blank" aria-hidden="true">
                <i class="i-lucide-mountain h-8 w-8"></i>
              </div>
            </div>
            <h3 class="mt-3 truncate font-semibold">{{ trail.name }}</h3>
            <p class="mt-0.5 truncate text-sm text-current/55">{{ trail.location || trail.managedBy || '—' }}</p>
            <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-current/70">
              <span class="inline-flex items-center gap-1 font-semibold">
                <i class="i-lucide-star h-3.5 w-3.5 text-amber-500" aria-hidden="true"></i>{{ trail.rating ? trail.rating.toFixed(1) : '—' }}
              </span>
              <span aria-hidden="true">·</span>
              <span class="capitalize">{{ trail.difficulty }}</span>
              <span aria-hidden="true">·</span>
              <span class="tabular-nums">{{ trail.distance.toFixed(1) + ' mi' }}</span>
            </p>
          </StxLink>
        </template>

        <p :if="!featuredLoading() && featured().length === 0" class="text-sm text-current/60">
          The catalog is not reachable right now.
          <StxLink to="/trails" class="underline underline-offset-2">Try the full trail search</StxLink>.
        </p>
      </div>
    </div>
  </section>

  <section class="data-ribbon border-y border-emerald-950/10 dark:border-white/10">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-9 px-4 py-10 sm:px-6 lg:grid-cols-[1.35fr_1fr_1fr_1.35fr] lg:px-8">
      <div>
        <p class="font-display text-3xl font-bold tabular-nums tracking-tight">{{ trailCount().toLocaleString() }}</p>
        <p class="mt-1 text-sm text-current/60">Trails ready to explore</p>
      </div>
      <div>
        <p class="font-display text-3xl font-bold tabular-nums tracking-tight">{{ countryCount() }}</p>
        <p class="mt-1 text-sm text-current/60">Countries covered</p>
      </div>
      <div>
        <p class="font-display text-3xl font-bold tabular-nums tracking-tight">{{ regionCount() }}</p>
        <p class="mt-1 text-sm text-current/60">States and regions</p>
      </div>
      <div class="col-span-2 lg:col-span-1">
        <p class="font-display text-xl font-bold tracking-tight">One map. Three reasons to move.</p>
        <p class="mt-1 text-sm leading-relaxed text-current/60">Train for yourself, hold the terrain around you, then go after the clock.</p>
      </div>
    </div>
  </section>

  <!-- ── Territory ──────────────────────────────────────────────────────── -->
  <section class="section-paper">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[0.78fr_1.22fr] lg:items-center lg:gap-20 lg:px-8 lg:py-28">
      <div class="section-rise">
        <p class="section-kicker">Territory changes everything</p>
        <h2 class="mt-4 max-w-[12ch] font-display text-4xl font-bold leading-[0.98] tracking-[-0.045em] sm:text-5xl">Your route is the border.</h2>
        <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-current/65">Close the loop and the land inside becomes yours. Keep moving to hold it, or take ground from somebody else.</p>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
          <div class="feature-rule">
            <i class="i-lucide-scan-line h-5 w-5 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
            <div>
              <h3 class="font-bold">GPS drawn</h3>
              <p class="mt-1 text-sm leading-relaxed text-current/60">No arbitrary hexes. The line you travel determines what you capture.</p>
            </div>
          </div>
          <div class="feature-rule">
            <i class="i-lucide-shield-check h-5 w-5 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
            <div>
              <h3 class="font-bold">Effort verified</h3>
              <p class="mt-1 text-sm leading-relaxed text-current/60">Impossible speeds, teleporting tracks, and open routes do not score.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="territory-plot section-rise" role="img" aria-label="A closed running route enclosing captured territory">
        <svg viewBox="0 0 760 620" aria-hidden="true">
          <g class="plot-contours" fill="none" stroke="currentColor">
            <path d="M-40 154 C112 18 238 230 390 102 S696 54 820 168" />
            <path d="M-70 250 C114 112 264 330 420 202 S690 138 826 250" />
            <path d="M-24 440 C122 302 294 530 454 386 S708 318 820 424" />
            <path d="M-36 532 C120 406 282 604 450 496 S706 422 820 518" />
          </g>
          <path class="territory-fill" d="M167 393 C109 306 152 184 269 151 C382 120 540 184 589 279 C635 369 554 482 420 503 C304 522 217 469 167 393 Z" />
          <path class="territory-route-shadow" d="M167 393 C109 306 152 184 269 151 C382 120 540 184 589 279 C635 369 554 482 420 503 C304 522 217 469 167 393 Z" />
          <path class="territory-route" d="M167 393 C109 306 152 184 269 151 C382 120 540 184 589 279 C635 369 554 482 420 503 C304 522 217 469 167 393 Z" />
          <circle cx="167" cy="393" r="13" class="territory-start" />
        </svg>
        <div class="plot-caption">
          <span>Closed loop</span>
          <strong>2.7 km² captured</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Records ──────────────────────────────────────────────────────────── -->
  <section class="section-muted">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1.02fr_0.98fr] lg:items-center lg:gap-20 lg:px-8 lg:py-28">
      <div class="section-rise">
        <p class="section-kicker">Fastest known times</p>
        <h2 class="mt-4 max-w-[13ch] font-display text-4xl font-bold leading-[0.98] tracking-[-0.045em] sm:text-5xl">Every route keeps a record.</h2>
        <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-current/65">
          Not who ran the most miles this week — who covered <em>this</em> route fastest. Elapsed time from the trailhead,
          filed under the rules it was run by, and checked against the GPS trace before it stands.
        </p>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
          <div class="feature-rule">
            <i class="i-lucide-backpack h-5 w-5 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
            <div>
              <h3 class="font-bold">Three styles, three boards</h3>
              <p class="mt-1 text-sm leading-relaxed text-current/60">Supported, self-supported, unsupported. A crewed time never sits next to one somebody carried.</p>
            </div>
          </div>
          <div class="feature-rule">
            <i class="i-lucide-file-check h-5 w-5 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
            <div>
              <h3 class="font-bold">Verified by a person</h3>
              <p class="mt-1 text-sm leading-relaxed text-current/60">Every claim needs a trace, and a human reads it. Nothing is accepted automatically.</p>
            </div>
          </div>
          <div class="feature-rule">
            <i class="i-lucide-radio-tower h-5 w-5 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
            <div>
              <h3 class="font-bold">Watch it happen</h3>
              <p class="mt-1 text-sm leading-relaxed text-current/60">Announce an attempt before you start and it goes on the tracking board, tracker link and all.</p>
            </div>
          </div>
          <div class="feature-rule">
            <i class="i-lucide-notebook-pen h-5 w-5 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
            <div>
              <h3 class="font-bold">The story too</h3>
              <p class="mt-1 text-sm leading-relaxed text-current/60">A trip report sits with the time, so the route page is still worth reading a year later.</p>
            </div>
          </div>
        </div>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <StxLink to="/records" class="inline-flex items-center justify-center gap-2 rounded-full bg-emerald-600 px-7 py-3.5 text-sm font-bold text-white transition hover:bg-emerald-700 active:scale-[0.98]">
            Browse the records
            <i class="i-lucide-arrow-right h-4 w-4" aria-hidden="true"></i>
          </StxLink>
          <StxLink to="/trails" class="inline-flex items-center justify-center gap-2 rounded-full border border-current/20 px-7 py-3.5 text-sm font-bold transition hover:border-emerald-500 hover:text-emerald-700 active:scale-[0.98] dark:hover:text-emerald-300">
            Claim one
          </StxLink>
        </div>
      </div>

      <div class="record-board section-rise" aria-hidden="true">
        <div class="record-board-head">
          <div>
            <p class="record-route">Lost Coast Traverse</p>
            <p class="record-meta">24.6 mi · 3,100 ft · point to point</p>
          </div>
          <span class="record-crown"><i class="i-lucide-crown h-3.5 w-3.5"></i>FKT</span>
        </div>

        <p class="record-group">Men's · Unsupported</p>
        <div class="record-row"><span class="record-rank">1</span><span class="record-name">Harvey Lewis</span><span class="record-note">verified</span><span class="record-time">7h 24m</span></div>
        <div class="record-row"><span class="record-rank">2</span><span class="record-name">Pawel Dregan</span><span class="record-note">verified</span><span class="record-time">8h 06m</span></div>

        <p class="record-group">Women's · Unsupported</p>
        <div class="record-row"><span class="record-rank">1</span><span class="record-name">Kim Gottwald</span><span class="record-note">verified</span><span class="record-time">8h 36m</span></div>

        <p class="record-group">Men's · Supported</p>
        <div class="record-row"><span class="record-rank">1</span><span class="record-name">Mark Dowdle</span><span class="record-note record-pending">pending review</span><span class="record-time">6h 54m</span></div>

        <p class="record-live"><span></span>Ana Ferreira is on the route — started 4h 12m ago</p>
      </div>
    </div>
  </section>

  <!-- ── Live events ──────────────────────────────────────────────────────── -->
  <section class="live-stage">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-20 lg:px-8 lg:py-28">
      <div class="section-rise">
        <p class="section-kicker text-emerald-300">Live from the yard</p>
        <h2 class="mt-4 max-w-[14ch] font-display text-4xl font-bold leading-[0.98] tracking-[-0.045em] text-[#eff6f2] sm:text-5xl">Backyard ultras, lap by lap.</h2>
        <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-[#a9bab2]">
          A yard every hour until one runner is left. WildLoop runs the corral clock, records each lap as it lands, and publishes
          the standings live — so anyone with the link can watch the field shrink from wherever they are.
        </p>
        <ul class="mt-8 space-y-4 text-sm font-semibold text-[#dce7e1]">
          <li class="flex items-center gap-3"><i class="i-lucide-timer h-4 w-4 text-emerald-400" aria-hidden="true"></i> Corral clock counts down to every start</li>
          <li class="flex items-center gap-3"><i class="i-lucide-radio h-4 w-4 text-emerald-400" aria-hidden="true"></i> Laps report themselves straight from the recorder</li>
          <li class="flex items-center gap-3"><i class="i-lucide-users h-4 w-4 text-emerald-400" aria-hidden="true"></i> Crew and spectators follow without an account</li>
        </ul>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <StxLink to="/events" class="inline-flex items-center justify-center gap-2 rounded-full bg-emerald-500 px-7 py-3.5 text-sm font-bold text-[#07110f] transition hover:bg-emerald-400 active:scale-[0.98]">
            Watch a live event
            <i class="i-lucide-arrow-right h-4 w-4" aria-hidden="true"></i>
          </StxLink>
          <StxLink to="/events" class="inline-flex items-center justify-center gap-2 rounded-full border border-[#7d9188]/45 px-7 py-3.5 text-sm font-bold text-[#eef4f0] transition hover:border-emerald-400 hover:text-emerald-300 active:scale-[0.98]">
            Host your own
          </StxLink>
        </div>
      </div>

      <div class="yard-board section-rise" aria-hidden="true">
        <div class="yard-board-head">
          <span class="yard-live"><span></span>LIVE</span>
          <span class="yard-clock">Yard 14 · 41:08 to go</span>
        </div>
        <div class="yard-row"><span class="yard-rank">1</span><span class="yard-name">Dana Whitfield</span><span class="yard-yards">14 yards</span><span class="yard-state yard-in">In</span></div>
        <div class="yard-row"><span class="yard-rank">2</span><span class="yard-name">Ade Okonjo</span><span class="yard-yards">14 yards</span><span class="yard-state yard-in">In</span></div>
        <div class="yard-row"><span class="yard-rank">3</span><span class="yard-name">Marta Ferrán</span><span class="yard-yards">14 yards</span><span class="yard-state yard-in">In</span></div>
        <div class="yard-row"><span class="yard-rank">4</span><span class="yard-name">Sam Petersen</span><span class="yard-yards">13 yards</span><span class="yard-state yard-out">Timed out</span></div>
        <div class="yard-row"><span class="yard-rank">5</span><span class="yard-name">Iris Lindqvist</span><span class="yard-yards">11 yards</span><span class="yard-state yard-out">Timed out</span></div>
        <p class="yard-foot">58.3 mi covered · 3 of 24 still in</p>
      </div>
    </div>
  </section>

  <!-- ── Product ──────────────────────────────────────────────────────────── -->
  <section class="section-muted">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div class="grid gap-5 md:auto-rows-[190px] md:grid-cols-12">
        <div class="bento-copy md:col-span-7 md:row-span-2">
          <i class="i-lucide-map h-7 w-7 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
          <div>
            <h2 class="max-w-[13ch] font-display text-4xl font-bold leading-none tracking-[-0.04em] sm:text-5xl">A trail app that keeps up.</h2>
            <p class="mt-5 max-w-[34rem] text-base leading-relaxed text-current/65">Search by place, surface, distance, and route shape. Save the trail, head outside, and let live GPS handle the rest.</p>
          </div>
        </div>
        <div class="bento-image md:col-span-5 md:row-span-3">
          <Image src="/images/marketing/wildloop-forest-trail.jpg" alt="Two hikers following an S-shaped trail through dense green forest" width="960" height="1200" sizes="(max-width: 768px) 100vw, 42vw" class="h-full w-full object-cover" />
        </div>
        <div class="bento-small md:col-span-4">
          <i class="i-lucide-route h-5 w-5 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
          <h3 class="mt-auto font-display text-xl font-bold">Plan the way through</h3>
          <p class="mt-2 text-sm leading-relaxed text-current/60">Trace a route, inspect the climb, and keep it available offline.</p>
        </div>
        <div class="bento-small md:col-span-3">
          <i class="i-lucide-heart-pulse h-5 w-5 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
          <h3 class="mt-auto font-display text-xl font-bold">Bring your watch</h3>
          <p class="mt-2 text-sm leading-relaxed text-current/60">Import FIT, GPX, and TCX activities with health metrics intact.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="share-stage">
    <div class="mx-auto grid max-w-7xl gap-14 px-4 py-20 sm:px-6 lg:grid-cols-[1.08fr_0.92fr] lg:items-center lg:gap-20 lg:px-8 lg:py-28">
      <div class="share-cards section-rise" aria-label="WildLoop activity image examples">
        <Image x-src="sampleSquare" alt="Square WildLoop activity image with a route trace and activity metrics" width="1080" height="1080" sizes="(max-width: 1024px) 80vw, 42vw" placeholder="blur" class="share-square" />
        <Image x-src="sampleStory" alt="Vertical WildLoop story image with a route trace and activity metrics" width="1080" height="1920" sizes="(max-width: 1024px) 45vw, 24vw" placeholder="blur" class="share-story" />
      </div>
      <div class="section-rise">
        <p class="section-kicker text-emerald-300">Built to leave the feed</p>
        <h2 class="mt-4 max-w-[11ch] font-display text-4xl font-bold leading-[0.98] tracking-[-0.045em] text-[#eff6f2] sm:text-5xl">Your best effort deserves better than a screenshot.</h2>
        <p class="mt-6 max-w-[32rem] text-lg leading-relaxed text-[#a9bab2]">Every activity becomes a polished image with the real trail, distance, time, pace, and climb already in place.</p>
        <ul class="mt-8 space-y-4 text-sm font-semibold text-[#dce7e1]">
          <li class="flex items-center gap-3"><i class="i-lucide-share-2 h-4 w-4 text-emerald-400" aria-hidden="true"></i> Open the native share sheet in one tap</li>
          <li class="flex items-center gap-3"><i class="i-lucide-layout-template h-4 w-4 text-emerald-400" aria-hidden="true"></i> Switch between post, story, and link formats</li>
          <li class="flex items-center gap-3"><i class="i-lucide-download h-4 w-4 text-emerald-400" aria-hidden="true"></i> Download a full-resolution PNG anytime</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Get the app ──────────────────────────────────────────────────────── -->
  <section class="section-paper" id="get-the-app">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_0.85fr] lg:items-center lg:gap-20 lg:px-8 lg:py-24">
      <div>
        <p class="section-kicker">Take it with you</p>
        <h2 class="mt-4 max-w-[16ch] font-display text-4xl font-bold leading-[0.99] tracking-[-0.04em] sm:text-5xl">Put WildLoop on your phone.</h2>
        <p class="mt-6 max-w-[36rem] text-lg leading-relaxed text-current/65">
          Live GPS, offline maps, and lap reporting in your pocket. It installs straight from this page — no store account,
          no download queue, and it updates itself.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <p :if="installed" class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-5 py-3 text-sm font-bold text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
            <i class="i-lucide-check h-4 w-4" aria-hidden="true"></i>
            Installed — open it from your home screen
          </p>

          <button
            :if="!installed && canPrompt"
            @click="promptInstall()"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-emerald-600 px-7 py-3.5 text-sm font-bold text-white transition hover:bg-emerald-700 active:scale-[0.98]"
          >
            <i class="i-lucide-download h-4 w-4" aria-hidden="true"></i>
            Install WildLoop
          </button>

          <StxLink :if="!installed" to="/app" class="inline-flex items-center justify-center gap-2 rounded-full border border-current/20 px-7 py-3.5 text-sm font-bold transition hover:border-emerald-500 hover:text-emerald-700 active:scale-[0.98] dark:hover:text-emerald-300">
            How it works on my phone
            <i class="i-lucide-arrow-up-right h-4 w-4" aria-hidden="true"></i>
          </StxLink>
        </div>

        <!-- iOS has no programmatic install, so name the two taps instead of
             offering a button that cannot do anything. -->
        <p :if="!installed && !canPrompt && platform === 'ios'" class="mt-5 max-w-[36rem] rounded-2xl border border-current/12 px-5 py-4 text-sm leading-relaxed text-current/70">
          <span class="font-semibold">On iPhone and iPad:</span> open this page in Safari, tap
          <span class="font-semibold">Share</span> <i class="i-lucide-share h-3.5 w-3.5 align-[-2px]" aria-hidden="true"></i>, then
          <span class="font-semibold">Add to Home Screen</span>. WildLoop then opens full screen, with its own icon.
        </p>
        <p :if="!installed && !canPrompt && platform === 'desktop'" class="mt-5 max-w-[36rem] text-sm leading-relaxed text-current/60">
          On a computer your browser may offer the install button in the address bar. The phone is where WildLoop earns its keep, though —
          open <span class="font-semibold">wildloop.org</span> there and install it in two taps.
        </p>
      </div>

      <div class="app-visual">
        <!-- The desktop-to-phone handoff. Hidden on small screens: somebody
             already holding a phone cannot scan a code on it. -->
        <div class="qr-card">
          <div class="qr-frame">{!! appQr !!}</div>
          <p class="qr-caption">Scan to open it on your phone</p>
        </div>

      <div class="phone-frame" aria-hidden="true">
        <div class="phone-screen">
          <div class="phone-status"><span>9:41</span><span class="phone-status-icons"><i class="i-lucide-signal h-3 w-3"></i><i class="i-lucide-wifi h-3 w-3"></i><i class="i-lucide-battery-full h-3.5 w-3.5"></i></span></div>
          <p class="phone-eyebrow">Recording</p>
          <p class="phone-metric">4.17<span>mi</span></p>
          <p class="phone-sub">Yard 14 · 41:08 to the next start</p>
          <div class="phone-map">
            <svg viewBox="0 0 240 180">
              <path class="phone-route-casing" d="M28 140 C40 84 92 60 132 74 C176 90 196 44 214 36" />
              <path class="phone-route" d="M28 140 C40 84 92 60 132 74 C176 90 196 44 214 36" />
              <circle cx="28" cy="140" r="6" class="phone-dot" />
            </svg>
          </div>
          <div class="phone-tabs"><span class="phone-tab-on"></span><span></span><span></span><span></span></div>
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- ── Adventure anywhere ───────────────────────────────────────────────── -->
  <section class="section-muted">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <h2 class="font-display text-4xl font-bold leading-none tracking-[-0.04em] sm:text-5xl">Adventure anywhere</h2>

      <div class="mt-12 grid gap-x-10 gap-y-12 lg:grid-cols-2">
        <div>
          <h3 class="directory-heading">Top regions</h3>
          <div class="directory-columns">
            <template :for="region in topRegions">
              <StxLink x-to="'/trails?state=' + region.code" class="directory-link">{{ region.name }}</StxLink>
            </template>
            <p :if="topRegions().length === 0" class="text-sm text-current/50">Loading regions…</p>
          </div>
          <StxLink to="/trails" class="directory-more">Show more</StxLink>
        </div>

        <div>
          <h3 class="directory-heading">Top countries</h3>
          <div class="directory-columns">
            <template :for="country in topCountries">
              <StxLink x-to="'/trails?country=' + country.code" class="directory-link">{{ countryName(country.code) }}</StxLink>
            </template>
            <p :if="topCountries().length === 0" class="text-sm text-current/50">Loading countries…</p>
          </div>
          <StxLink to="/trails" class="directory-more">Show more</StxLink>
        </div>

        <div>
          <h3 class="directory-heading">Top trails</h3>
          <div class="directory-columns">
            <template :for="trail in topTrails">
              <StxLink x-to="'/trail/' + trail.id" class="directory-link">{{ trail.name }}</StxLink>
            </template>
            <p :if="topTrails().length === 0" class="text-sm text-current/50">Loading trails…</p>
          </div>
          <StxLink to="/trails?sort=rating" class="directory-more">Show more</StxLink>
        </div>

        <div>
          <h3 class="directory-heading">Ways to play</h3>
          <div class="directory-columns">
            <StxLink to="/territories" class="directory-link">Territory map</StxLink>
            <StxLink to="/events" class="directory-link">Live events</StxLink>
            <StxLink to="/events?type=backyard" class="directory-link">Backyard ultras</StxLink>
            <StxLink to="/records" class="directory-link">Fastest known times</StxLink>
            <StxLink to="/battles" class="directory-link">Territory battles</StxLink>
            <StxLink to="/conquests" class="directory-link">Conquest feed</StxLink>
            <StxLink to="/challenges" class="directory-link">Challenges</StxLink>
            <StxLink to="/leaderboard" class="directory-link">Leaderboard</StxLink>
            <StxLink to="/clubs" class="directory-link">Clubs</StxLink>
            <StxLink to="/athletes" class="directory-link">Athletes</StxLink>
            <StxLink to="/routes" class="directory-link">Route planner</StxLink>
            <StxLink to="/record" class="directory-link">Record a run</StxLink>
            <StxLink to="/stats" class="directory-link">Your stats</StxLink>
          </div>
          <StxLink to="/feed" class="directory-more">Show more</StxLink>
        </div>
      </div>
    </div>
  </section>

  <section class="closing-field">
    <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8 lg:py-28">
      <i class="i-lucide-mountain-snow mx-auto h-8 w-8 text-emerald-400" aria-hidden="true"></i>
      <h2 class="mt-6 font-display text-4xl font-bold leading-none tracking-[-0.045em] text-[#eff6f2] sm:text-6xl">The map is wide open.</h2>
      <p class="mx-auto mt-5 max-w-[32rem] text-lg leading-relaxed text-[#a9bab2]">Find a line worth following. Close it. Make it yours.</p>
      <StxLink to="/register" class="mt-9 inline-flex items-center justify-center gap-2 rounded-full bg-emerald-500 px-8 py-4 text-sm font-bold text-[#07110f] transition hover:bg-emerald-400 active:scale-[0.98]">
        Create your free account
        <i class="i-lucide-arrow-right h-4 w-4" aria-hidden="true"></i>
      </StxLink>
    </div>
  </section>
</div>

<style>
  .marketing-page {
    --page-paper: #f3f5f1;
    --page-muted: #e8eee9;
    --page-ink: #102019;
    color: var(--page-ink);
    background: var(--page-paper);
  }

  .dark .marketing-page {
    --page-paper: #0c1512;
    --page-muted: #111e19;
    --page-ink: #e8f0eb;
  }

  /* ── Hero ───────────────────────────────────────────────────────────── */

  .hero-stage {
    position: relative;
    display: grid;
    place-items: center;
    /* Tall enough that the photograph is the page, short enough that the row
       of trails below it still peeks in and invites the scroll. */
    min-height: min(78vh, 44rem);
    overflow: hidden;
    background: #07110f;
    isolation: isolate;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  /* The scrim exists for the text, not the mood: white type over a bright sky
     is the single most common way a hero like this becomes unreadable. */
  .hero-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(6 17 14 / 55%) 0%, rgb(6 17 14 / 18%) 38%, rgb(6 17 14 / 62%) 100%),
      radial-gradient(120% 80% at 50% 50%, transparent 35%, rgb(6 17 14 / 45%) 100%);
  }

  .hero-inner {
    width: 100%;
    max-width: 46rem;
    padding: 5rem 1.25rem 4rem;
    text-align: center;
  }

  .hero-title {
    color: #fff;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: clamp(2.5rem, 6.2vw, 5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-shadow: 0 2px 24px rgb(4 12 10 / 45%);
  }

  .hero-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.25rem;
    padding: 0.4rem 0.4rem 0.4rem 1.25rem;
    background: #fff;
    border-radius: 9999px;
    box-shadow: 0 18px 48px -12px rgb(4 12 10 / 45%);
  }

  .hero-search-icon {
    display: grid;
    flex: none;
    place-items: center;
    color: #64748b;
  }

  .hero-search input {
    flex: 1;
    min-width: 0;
    padding: 0.85rem 0.25rem;
    color: #0f172a;
    font-size: 1rem;
    background: transparent;
    border: 0;
  }

  .hero-search input::placeholder { color: #7c8a95; }
  .hero-search input:focus { outline: none; }
  .hero-search input::-webkit-search-cancel-button { -webkit-appearance: none; }

  .hero-search-go {
    flex: none;
    padding: 0.85rem 1.6rem;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
    background: #059669;
    border-radius: 9999px;
    transition: background 0.2s ease, transform 0.12s ease;
  }

  .hero-search-go:hover { background: #047857; }
  .hero-search-go:active { transform: scale(0.98); }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    justify-content: center;
    margin-top: 1.75rem;
  }

  .hero-links button,
  .hero-links a {
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-shadow: 0 1px 14px rgb(4 12 10 / 50%);
    transition: color 0.2s ease;
  }

  .hero-links button:hover,
  .hero-links a:hover { color: #6ee7b7; }
  .hero-links button:disabled { opacity: 0.7; }

  @media (max-width: 640px) {
    .hero-search {
      flex-wrap: wrap;
      padding: 0.75rem 1rem;
      border-radius: 1.5rem;
    }

    .hero-search input { padding: 0.5rem 0.25rem; }

    .hero-search-go {
      width: 100%;
      margin-top: 0.25rem;
    }
  }

  /* ── Trail shelf ────────────────────────────────────────────────────── */

  .trail-tile { display: block; }

  .trail-tile-photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 1rem;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .trail-tile-blank {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: color-mix(in srgb, currentColor 35%, transparent);
    background: color-mix(in srgb, currentColor 6%, transparent);
  }

  /* ── Shared section furniture ───────────────────────────────────────── */

  .data-ribbon {
    color: var(--page-ink);
    background: #d9e8df;
  }

  .dark .data-ribbon { background: #10251e; }

  .section-paper { background: var(--page-paper); }
  .section-muted { background: var(--page-muted); }

  .section-kicker {
    color: #08784c;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .dark .section-kicker { color: #6ee7b7; }

  .feature-rule {
    display: flex;
    gap: 0.85rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, currentColor 16%, transparent);
  }

  /* An icon is a flex item sitting next to a text block that wants all the
     room, so it needs to be told not to give any of it up — otherwise every
     feature rule and checklist here renders its glyph as a smear.
     The SIZE is not set here: each icon carries its own `h-5 w-5` (or
     `h-4 w-4`), and crosswind ranks icon utilities below sizing ones, so
     those win over the icon's default `1em` on their own. */
  .feature-rule > i,
  .live-stage li > i,
  .share-stage li > i {
    flex: none;
  }

  .territory-plot {
    position: relative;
    overflow: hidden;
    min-height: 32rem;
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 4.5rem 1.5rem 1.5rem 1.5rem;
    color: #315d4b;
    background: #dce9e1;
  }

  .dark .territory-plot {
    color: #335d4d;
    background: #0f1c18;
  }

  .territory-plot svg {
    width: 100%;
    height: 100%;
    min-height: 32rem;
  }

  .plot-contours {
    opacity: 0.3;
    stroke-width: 2;
  }

  .territory-fill {
    fill: #10b981;
    opacity: 0.15;
  }

  .territory-route-shadow {
    fill: none;
    stroke: #06120f;
    stroke-width: 22;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.35;
  }

  .territory-route {
    fill: none;
    stroke: #10b981;
    stroke-width: 11;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .territory-start {
    fill: #edf7f1;
    stroke: #0b1b15;
    stroke-width: 7;
  }

  .plot-caption {
    position: absolute;
    right: 2rem;
    bottom: 2rem;
    padding-left: 1rem;
    border-left: 3px solid #10b981;
  }

  .plot-caption span,
  .plot-caption strong { display: block; }

  .plot-caption span {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .plot-caption strong {
    margin-top: 0.2rem;
    color: var(--page-ink);
    font-size: 1.15rem;
  }

  /* ── Records board ──────────────────────────────────────────────────── */

  /* Deliberately the light-surface twin of `.yard-board` below: same card
     geometry and row rhythm, repainted for a paper section so the two boards
     read as one product rather than two designs. */
  .record-board {
    padding: 1.5rem;
    border: 1px solid color-mix(in srgb, currentColor 11%, transparent);
    border-radius: 1.5rem;
    background: var(--page-paper);
    box-shadow: 0 24px 60px rgb(6 32 24 / 8%);
  }

  .dark .record-board { box-shadow: 0 28px 80px rgb(0 0 0 / 40%); }

  .record-board-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent);
  }

  .record-route {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .record-meta {
    margin-top: 0.2rem;
    color: color-mix(in srgb, currentColor 55%, transparent);
    font-size: 0.78rem;
  }

  .record-crown {
    display: inline-flex;
    flex-shrink: 0;
    gap: 0.35rem;
    align-items: center;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    background: rgb(245 158 11 / 15%);
    color: #b45309;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .dark .record-crown { color: #fbbf24; }

  .record-group {
    margin-top: 1.1rem;
    color: color-mix(in srgb, currentColor 50%, transparent);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .record-row {
    display: grid;
    grid-template-columns: 1.25rem 1fr auto auto;
    gap: 0.85rem;
    align-items: center;
    padding: 0.7rem 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 7%, transparent);
  }

  .record-rank {
    color: color-mix(in srgb, currentColor 45%, transparent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
  }

  .record-name {
    font-size: 0.9rem;
    font-weight: 600;
  }

  /* A time nobody has checked yet still shows, and still says so. That
     honesty is the whole reason the verified ones are worth anything. */
  .record-note {
    color: #059669;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .dark .record-note { color: #34d399; }

  .record-pending { color: #b45309; }

  .dark .record-pending { color: #fbbf24; }

  .record-time {
    font-weight: 700;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }

  .record-live {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 1.15rem;
    color: color-mix(in srgb, currentColor 60%, transparent);
    font-size: 0.75rem;
  }

  .record-live span {
    width: 0.5rem;
    height: 0.5rem;
    flex-shrink: 0;
    background: #ef4444;
    border-radius: 9999px;
  }

  /* ── Live event board ───────────────────────────────────────────────── */

  .live-stage { background: #07110f; }

  .yard-board {
    padding: 1.5rem;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 1.5rem;
    background: linear-gradient(180deg, #0d1c17 0%, #0a1512 100%);
    box-shadow: 0 28px 80px rgb(0 0 0 / 46%);
  }

  .yard-board-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 8%);
  }

  .yard-live {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    color: #fca5a5;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .yard-live span {
    width: 0.5rem;
    height: 0.5rem;
    background: #ef4444;
    border-radius: 9999px;
  }

  .yard-clock {
    color: #9fb3aa;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
  }

  .yard-row {
    display: grid;
    grid-template-columns: 1.5rem 1fr auto auto;
    gap: 0.85rem;
    align-items: center;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
  }

  .yard-rank {
    color: #6b8479;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
  }

  .yard-name {
    color: #e7efeb;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .yard-yards {
    color: #9fb3aa;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }

  .yard-state {
    padding: 0.18rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .yard-in {
    color: #6ee7b7;
    background: rgb(16 185 129 / 14%);
  }

  .yard-out {
    color: #cbb9a4;
    background: rgb(255 255 255 / 6%);
  }

  .yard-foot {
    margin-top: 1rem;
    color: #7f948b;
    font-size: 0.75rem;
  }

  /* ── Bento + share ──────────────────────────────────────────────────── */

  .bento-copy,
  .bento-small {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border: 1px solid color-mix(in srgb, currentColor 11%, transparent);
    border-radius: 1.5rem;
    background: var(--page-paper);
  }

  .bento-copy { justify-content: space-between; }

  .bento-image {
    overflow: hidden;
    min-height: 34rem;
    border-radius: 1.5rem 4.5rem 1.5rem 1.5rem;
  }

  .share-stage { background: #07110f; }

  .share-cards {
    position: relative;
    min-height: 38rem;
  }

  .share-square,
  .share-story {
    position: absolute;
    object-fit: contain;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 1.25rem;
    box-shadow: 0 28px 80px rgb(0 0 0 / 46%);
  }

  .share-square {
    bottom: 0;
    left: 0;
    width: 74%;
  }

  .share-story {
    top: 0;
    right: 0;
    width: 42%;
  }

  /* ── Phone ──────────────────────────────────────────────────────────── */

  .app-visual {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    align-items: center;
  }

  .qr-card {
    display: none;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
    padding: 1rem 1rem 0.85rem;
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 1.25rem;
    background: var(--page-paper);
  }

  /* A QR is only useful to someone holding a DIFFERENT device. */
  @media (min-width: 1024px) {
    .qr-card { display: flex; }
  }

  /* The code paints its own white field and plate; this just sizes it. */
  .qr-frame {
    width: 8.5rem;
    height: 8.5rem;
  }

  .qr-frame svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .qr-caption {
    font-size: 0.75rem;
    font-weight: 600;
    text-align: center;
    color: color-mix(in srgb, currentColor 60%, transparent);
  }

  .phone-frame {
    justify-self: center;
    width: min(20rem, 84vw);
    padding: 0.7rem;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 2.75rem;
    background: #0b1512;
    box-shadow: 0 34px 80px -24px rgb(6 18 14 / 55%);
  }

  .phone-screen {
    padding: 1.15rem 1.15rem 1rem;
    color: #e7efeb;
    border-radius: 2.15rem;
    background: linear-gradient(180deg, #10221c 0%, #0a1512 100%);
  }

  .phone-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #8ea79c;
    font-size: 0.68rem;
    font-weight: 600;
  }

  .phone-status-icons {
    display: inline-flex;
    gap: 0.3rem;
    align-items: center;
  }

  .phone-eyebrow {
    margin-top: 1.5rem;
    color: #6ee7b7;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .phone-metric {
    margin-top: 0.15rem;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .phone-metric span {
    margin-left: 0.35rem;
    color: #8ea79c;
    font-size: 1rem;
    font-weight: 600;
  }

  .phone-sub {
    margin-top: 0.4rem;
    color: #8ea79c;
    font-size: 0.78rem;
  }

  .phone-map {
    margin-top: 1.1rem;
    overflow: hidden;
    border-radius: 1.25rem;
    background: #14251f;
  }

  .phone-map svg {
    display: block;
    width: 100%;
  }

  .phone-route-casing {
    fill: none;
    stroke: #061310;
    stroke-width: 9;
    stroke-linecap: round;
  }

  .phone-route {
    fill: none;
    stroke: #10b981;
    stroke-width: 5;
    stroke-linecap: round;
  }

  .phone-dot {
    fill: #eafff6;
    stroke: #0b1b15;
    stroke-width: 3;
  }

  .phone-tabs {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 1.1rem;
  }

  .phone-tabs span {
    width: 1.6rem;
    height: 0.25rem;
    background: rgb(255 255 255 / 12%);
    border-radius: 9999px;
  }

  .phone-tab-on { background: #10b981 !important; }

  /* ── Directory ──────────────────────────────────────────────────────── */

  .directory-heading {
    padding-bottom: 0.9rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    font-size: 1rem;
    font-weight: 700;
  }

  .directory-columns {
    columns: 2;
    column-gap: 2.5rem;
    margin-top: 1.1rem;
  }

  .directory-link {
    display: block;
    padding: 0.28rem 0;
    color: color-mix(in srgb, currentColor 72%, transparent);
    font-size: 0.95rem;
    line-height: 1.5;
    break-inside: avoid;
    transition: color 0.15s ease;
  }

  .directory-link:hover {
    color: #047857;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .dark .directory-link:hover { color: #6ee7b7; }

  .directory-more {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .closing-field { background: #07110f; }

  @media (max-width: 767px) {
    .territory-plot {
      min-height: 24rem;
      border-radius: 3rem 1.25rem 1.25rem;
    }

    .territory-plot svg { min-height: 24rem; }
    .share-cards { min-height: 31rem; }
    .directory-columns { columns: 1; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-inner {
      animation: hero-arrive 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .section-rise {
      animation: section-rise linear both;
      animation-timeline: view();
      animation-range: entry 8% cover 32%;
    }
  }

  @keyframes hero-arrive {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes section-rise {
    from { opacity: 0.45; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
</style>
@endsection
