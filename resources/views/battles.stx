@extends('layouts/default')

@section('title', 'Live Battles - Wildloop')

@section('content')
<script server>
  /*
   * Page metadata, in `<script server>` so it is in the HTML a crawler is
   * served rather than something only hydration produces. See athletes.stx for
   * the full reasoning; the short version is that `useSeoMeta` is the only one
   * of the head helpers that reaches the composed document head from a page,
   * and it has to be written inline because the engine injects it into the
   * page's own scope and not into a module it imports.
   */
  useSeoMeta({
    title: 'Live Battles — Wildloop',
    description: 'Territory changing hands in real time — every capture, defence and contested claim as it happens.',
    canonical: 'https://wildloop.org/battles',
    robots: 'index, follow, max-image-preview:large',
    ogTitle: 'Live Battles — Wildloop',
    ogDescription: 'Territory changing hands in real time — every capture, defence and contested claim as it happens.',
    ogType: 'website',
    ogUrl: 'https://wildloop.org/battles',
    ogImage: 'https://wildloop.org/images/social/og-default.jpg',
    ogSiteName: 'Wildloop',
    ogLocale: 'en_US',
    twitterCard: 'summary_large_image',
    twitterTitle: 'Live Battles — Wildloop',
    twitterDescription: 'Territory changing hands in real time — every capture, defence and contested claim as it happens.',
    twitterImage: 'https://wildloop.org/images/social/og-default.jpg',
  })
</script>

<script client>
  import { formatTerritoryArea } from '../functions/territory-style'
  import { avatarUrl } from '../functions/avatars'
  import { mapBoundsAround, type MapBounds } from '../functions/map-area'
  import {
    countByStatus,
    feedBadge,
    feedVerb,
    filterBattlesByArea,
    filterBattlesByPeriod,
    liveBattles as liveOnly,
  } from '../functions/battles'
  import { resolveNearby } from '../composables/useNearby'

  useHead({ title: 'Live Battles — Wildloop' })

  /**
   * A local wrapper, because the template cannot call the import directly.
   *
   * stx resolves template expressions against the script's own declarations —
   * an imported binding referenced from markup evaluates to nothing, and the
   * value simply vanishes from the page rather than erroring. Declaring it
   * here is what every other view does with a formatter (see `areaKm2` in
   * athletes.stx).
   */
  function battleArea(squareMetres: number): string {
    return formatTerritoryArea(squareMetres)
  }

  function photoOf(avatar: string | null | undefined): string {
    return avatarUrl(avatar ?? null)
  }

  function initialOf(name: string | null | undefined): string {
    return String(name || '?').charAt(0).toUpperCase()
  }

  const wl = useStore('wl')
  const period = state<'today' | 'week' | 'all'>('today')

  /*
   * Battles near the player, or everywhere.
   *
   * The feed is the whole game, so a player in Los Angeles was shown fights
   * in Utah and Colorado as "Live battles". With a location (remembered or
   * guessed from the connection, never prompted for), the page opens on the
   * ones within reach and offers everywhere as the other half of the switch.
   */
  const NEARBY_KM = 40
  const area = state<MapBounds | null>(null)
  const areaLabel = state('')
  const scope = state<'near' | 'all'>('all')
  const scopeChoices = derived(() => [{ value: 'near', label: 'Near ' + areaLabel() }, { value: 'all', label: 'Everywhere' }])
  const PERIOD_CHOICES = [{ value: 'today', label: 'Today' }, { value: 'week', label: 'This week' }, { value: 'all', label: 'All time' }]

  onMount(async () => {
    const place = await resolveNearby().catch(() => null)
    if (!place)
      return
    area.set(mapBoundsAround(place, NEARBY_KM))
    areaLabel.set(place.label)
    scope.set('near')
  })

  /*
   * The reading is shared with the native screen (functions/battles.ts), which
   * tells the same rows in the same third person. The two used to carry a
   * `battleBadge` each, and they disagreed: the battle the feed called
   * "Conquered" was "Lost" on /conquests, with nothing saying which was meant.
   */
  const inScope = derived(() => {
    if (!wl) return []
    return filterBattlesByArea(wl.conquests(), scope() === 'near' ? area() : null)
  })

  const liveBattles = derived(() => liveOnly(inScope()))
  const filteredBattles = derived(() => filterBattlesByPeriod(inScope(), period()))
  const conqueredCount = derived(() => countByStatus(inScope(), 'conquered'))
  const defendedCount = derived(() => countByStatus(inScope(), 'defended'))

  /*
   * Local wrappers, because the template cannot call an import directly — an
   * imported binding referenced from markup evaluates to nothing and the value
   * vanishes from the page rather than erroring.
   */
  function battleVerb(battle: any): string {
    return feedVerb(battle)
  }

  function battleBadge(battle: any): string {
    return feedBadge(battle)
  }
</script>

  <div class="mx-auto max-w-6xl px-4 pb-12 pt-6 sm:px-6 lg:px-8">
    <header class="mb-6">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <h1 class="font-display text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Live battles</h1>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-red-50 px-2.5 py-1 text-xs font-semibold text-red-600 dark:bg-red-500/10 dark:text-red-400">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-red-500"></span>
          15s updates
        </span>
      </div>
      <p class="mt-1 text-slate-600 dark:text-slate-400">Persisted battle events refresh automatically every 15 seconds.</p>
    </header>

    {{-- Battle stats. Up top on phones, where a sidebar would land below a
         long log; still a summary strip on desktop. --}}
    <dl class="mb-6 grid grid-cols-2 gap-3 sm:max-w-md">
      <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
        <dt class="flex items-center gap-1.5 metric-label"><i class="i-lucide-swords h-3.5 w-3.5 text-orange-500" aria-hidden="true"></i>Conquests</dt>
        <dd class="mt-1 font-display text-2xl font-bold tabular-nums text-slate-900 dark:text-white">{{ conqueredCount }}</dd>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
        <dt class="flex items-center gap-1.5 metric-label"><i class="i-lucide-shield h-3.5 w-3.5 text-emerald-500" aria-hidden="true"></i>Defenses</dt>
        <dd class="mt-1 font-display text-2xl font-bold tabular-nums text-slate-900 dark:text-white">{{ defendedCount }}</dd>
      </div>
    </dl>

    {{-- Live battles --}}
    <section :if="liveBattles.length > 0" class="mb-8">
      <h2 class="mb-3 flex items-center gap-2 font-display text-xl font-bold text-slate-900 dark:text-white">
        <span class="h-2 w-2 animate-pulse rounded-full bg-red-500"></span>
        Happening now
      </h2>
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
        <template :for="battle in liveBattles">
          <div class="rounded-2xl border border-orange-200 bg-orange-50/60 p-4 dark:border-orange-500/30 dark:bg-orange-500/5">
            <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3">
              <div class="flex min-w-0 items-center gap-2">
                <Image :if="photoOf(battle.attackerAvatar)" x-src="photoOf(battle.attackerAvatar)" x-alt="battle.attackerName" width="40" height="40" sizes="40px" loading="lazy" class="h-10 w-10 shrink-0 rounded-full object-cover" />
                <div :if="!photoOf(battle.attackerAvatar)" class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-orange-100 text-sm font-bold text-orange-700 dark:bg-orange-500/20 dark:text-orange-300" aria-hidden="true">{{ initialOf(battle.attackerName) }}</div>
                <div class="min-w-0">
                  <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">{{ battle.attackerName }}</p>
                  <p class="text-xs text-orange-600 dark:text-orange-400">Attacking</p>
                </div>
              </div>
              <div class="grid h-8 w-8 animate-pulse place-items-center rounded-full bg-orange-500 text-white">
                <Icon name="zap" size="16" />
              </div>
              <div class="flex min-w-0 items-center justify-end gap-2 text-right">
                <div class="min-w-0">
                  <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">{{ battle.defenderName }}</p>
                  <p class="text-xs text-emerald-600 dark:text-emerald-400">Defending</p>
                </div>
                <Image :if="photoOf(battle.defenderAvatar)" x-src="photoOf(battle.defenderAvatar)" x-alt="battle.defenderName" width="40" height="40" sizes="40px" loading="lazy" class="h-10 w-10 shrink-0 rounded-full object-cover" />
                <div :if="!photoOf(battle.defenderAvatar)" class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-emerald-100 text-sm font-bold text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-300" aria-hidden="true">{{ initialOf(battle.defenderName) }}</div>
              </div>
            </div>
            <StxLink x-to="'/territory/' + battle.territory_id" class="mt-3 flex min-h-10 items-center justify-center gap-1.5 rounded-xl bg-white/70 text-sm font-semibold text-slate-800 transition hover:bg-white dark:bg-slate-900/50 dark:text-slate-100 dark:hover:bg-slate-900">
              <i class="i-lucide-flag h-3.5 w-3.5 text-slate-400" aria-hidden="true"></i>
              {{ battle.territoryName }}
            </StxLink>
          </div>
        </template>
      </div>
    </section>

    {{-- Period filter --}}
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <h2 class="font-display text-xl font-bold text-slate-900 dark:text-white">Recent battles</h2>
      <div :if="area">
        <SegmentedControl label="Where" size="sm" v-model:value="scope" :options="scopeChoices()" />
      </div>
      <SegmentedControl label="Period" size="sm" v-model:value="period" :options="PERIOD_CHOICES" />
    </div>

    <ol :if="filteredBattles.length > 0" class="divide-y divide-slate-100 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:divide-slate-700/70 dark:border-slate-700 dark:bg-slate-800 dark:shadow-none">
      <template :for="battle in filteredBattles">
        <li class="flex items-start gap-3 px-4 py-3.5">
          <div class="mt-0.5 grid h-10 w-10 shrink-0 place-items-center rounded-full" x-class="battle.status === 'conquered' ? 'bg-orange-50 text-orange-600 dark:bg-orange-500/15 dark:text-orange-400' : 'bg-emerald-50 text-emerald-600 dark:bg-emerald-500/15 dark:text-emerald-400'">
            <Icon :if="battle.status === 'conquered'" name="swords" size="18" />
            <Icon :if="battle.status !== 'conquered'" name="shield" size="18" />
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm leading-snug text-slate-700 dark:text-slate-300">
              <span class="font-semibold text-slate-900 dark:text-white">{{ battle.attackerName }}</span>
              <span>{{ battleVerb(battle) }}</span>
              <StxLink x-to="'/territory/' + battle.territory_id" class="font-semibold text-emerald-700 hover:underline dark:text-emerald-400">{{ battle.territoryName }}</StxLink>
              <span> from </span>
              <span class="font-semibold text-slate-900 dark:text-white">{{ battle.defenderName }}</span>
            </p>
            <p class="mt-1 flex flex-wrap items-center gap-x-1.5 text-xs text-slate-500 dark:text-slate-400">
              <span>{{ wl.timeAgo(battle.created_at) }}</span>
              <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
              <span class="tabular-nums">{{ battleArea(battle.areaCaptured) }}</span>
            </p>
          </div>
          <span class="shrink-0 rounded-full px-2 py-0.5 text-[11px] font-semibold" x-class="battle.status === 'conquered' || battle.status === 'active' ? 'bg-orange-100 text-orange-700 dark:bg-orange-500/15 dark:text-orange-300' : 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300'">{{ battleBadge(battle) }}</span>
        </li>
      </template>
    </ol>

    <div :if="filteredBattles.length === 0" class="rounded-2xl border border-dashed border-slate-300 px-6 py-14 text-center dark:border-slate-700">
      <div class="mx-auto mb-5 grid h-16 w-16 place-items-center rounded-2xl bg-slate-100 dark:bg-slate-800">
        <Icon name="zap" size="30" class="text-slate-400" />
      </div>
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{{ scope === 'near' ? 'No battles near ' + areaLabel + ' in this period' : 'No battles in this period' }}</h3>
      <p class="mx-auto mt-1 max-w-sm text-slate-500 dark:text-slate-400">{{ scope === 'near' ? 'Claim a loop here and you will be the one they come for.' : 'The battlefield is quiet... for now.' }}</p>
      <button :if="period !== 'all'" @click="period.set('all')" class="mt-5 min-h-11 rounded-full px-5 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-50 dark:text-emerald-400 dark:hover:bg-emerald-500/10">Show all time</button>
      <button :if="scope === 'near'" @click="scope.set('all')" class="mt-5 min-h-11 rounded-full px-5 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-50 dark:text-emerald-400 dark:hover:bg-emerald-500/10">Show everywhere</button>
    </div>
  </div>
@endsection
