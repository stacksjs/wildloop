@extends('layouts/default')

@section('title', 'Live Battles - WildLoop')

@section('content')
<script server>
  /*
   * Page metadata, in `<script server>` so it is in the HTML a crawler is
   * served rather than something only hydration produces. See athletes.stx for
   * the full reasoning; the short version is that `useSeoMeta` is the only one
   * of the head helpers that reaches the composed document head from a page,
   * and it has to be written inline because the engine injects it into the
   * page's own scope and not into a module it imports.
   */
  useSeoMeta({
    title: 'Live Battles — WildLoop',
    description: 'Territory changing hands in real time — every capture, defence and contested claim as it happens.',
    canonical: 'https://wildloop.org/battles',
    robots: 'index, follow, max-image-preview:large',
    ogTitle: 'Live Battles — WildLoop',
    ogDescription: 'Territory changing hands in real time — every capture, defence and contested claim as it happens.',
    ogType: 'website',
    ogUrl: 'https://wildloop.org/battles',
    ogImage: 'https://wildloop.org/images/social/og-default.jpg',
    ogSiteName: 'WildLoop',
    ogLocale: 'en_US',
    twitterCard: 'summary_large_image',
    twitterTitle: 'Live Battles — WildLoop',
    twitterDescription: 'Territory changing hands in real time — every capture, defence and contested claim as it happens.',
    twitterImage: 'https://wildloop.org/images/social/og-default.jpg',
  })
</script>

<script client>
  useHead({ title: 'Live Battles - WildLoop' })

  const wl = useStore('wl')
  const period = state<'today' | 'week' | 'all'>('today')

  const liveBattles = derived(() => wl ? wl.conquests().filter((c: any) => c.status === 'active') : [])

  const filteredBattles = derived(() => {
    if (!wl) return []
    const p = period()
    const now = Date.now()
    if (p === 'today') {
      const start = new Date().setHours(0, 0, 0, 0)
      return wl.conquests().filter((b: any) => new Date(b.created_at).getTime() >= start)
    }
    if (p === 'week') {
      const weekAgo = now - 7 * 86400000
      return wl.conquests().filter((b: any) => new Date(b.created_at).getTime() >= weekAgo)
    }
    return wl.conquests()
  })

  const conqueredCount = derived(() => wl ? wl.conquests().filter((b: any) => b.status === 'conquered').length : 0)
  const defendedCount = derived(() => wl ? wl.conquests().filter((b: any) => b.status === 'defended').length : 0)
</script>

  <div class="mx-auto px-4 py-6 sm:px-6 lg:px-8 max-w-7xl">
    <div class="mb-6">
      <h1 class="flex gap-2 items-center font-bold text-2xl dark:text-white">
        Live Battles
        <span class="flex gap-1 items-center px-2 py-1 font-medium text-red-600 text-xs bg-red-50 dark:bg-red-900/20 rounded-full">
          <span class="h-1.5 w-1.5 bg-red-500 rounded-full animate-pulse"></span>
          15s updates
        </span>
      </h1>
      <p class="mt-1 text-gray-500 text-sm dark:text-slate-400">Persisted battle events refresh automatically every 15 seconds.</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <!-- Live battles -->
        <div :if="liveBattles.length > 0" class="mb-8">
          <h2 class="flex gap-2 items-center mb-4 font-bold text-gray-900 text-lg dark:text-white">
            <span class="h-2 w-2 bg-red-500 rounded-full animate-pulse"></span>
            Happening Now
          </h2>
          <div class="space-y-4">
            <template :for="battle in liveBattles">
              <div class="bg-orange-50/50 dark:bg-orange-900/5 border-2 border-orange-200 dark:border-orange-800/50 card">
                <div class="flex gap-4 items-center">
                  <div class="flex flex-1 gap-2 items-center">
                    <div class="flex items-center justify-center h-10 w-10 font-bold text-orange-600 text-sm bg-orange-100 dark:bg-orange-900/30 rounded-full">{{ battle.attackerName.charAt(0) }}</div>
                    <div>
                      <p class="font-semibold text-sm dark:text-white">{{ battle.attackerName }}</p>
                      <p class="text-orange-600 text-xs">Attacking</p>
                    </div>
                  </div>
                  <div class="shrink-0 w-8 h-8 bg-orange-500 rounded-full animate-pulse flex items-center justify-center text-white">
                    <Icon name="zap" size="16" />
                  </div>
                  <div class="flex flex-1 gap-2 items-center justify-end text-right">
                    <div>
                      <p class="font-semibold text-sm dark:text-white">{{ battle.defenderName }}</p>
                      <p class="text-blue-600 text-xs">Defending</p>
                    </div>
                    <div class="flex items-center justify-center h-10 w-10 font-bold text-blue-600 text-sm bg-blue-100 dark:bg-blue-900/30 rounded-full">{{ battle.defenderName.charAt(0) }}</div>
                  </div>
                </div>
                <div class="mt-3 text-xs text-center">
                  <StxLink x-to="'/territory/' + battle.territory_id" class="text-emerald-600 hover:underline font-medium">{{ battle.territoryName }}</StxLink>
                </div>
              </div>
            </template>
          </div>
        </div>

        <!-- Period filter -->
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-bold text-gray-900 text-lg dark:text-white">Recent Battles</h2>
          <div class="flex gap-2">
            <button @click="period.set('today')" x-class="period === 'today' ? 'bg-gray-900 text-white dark:bg-white dark:text-slate-900' : 'bg-gray-100 text-gray-600 dark:bg-slate-800 dark:text-slate-400'" class="px-3 py-1.5 font-medium text-xs rounded-lg transition">Today</button>
            <button @click="period.set('week')" x-class="period === 'week' ? 'bg-gray-900 text-white dark:bg-white dark:text-slate-900' : 'bg-gray-100 text-gray-600 dark:bg-slate-800 dark:text-slate-400'" class="px-3 py-1.5 font-medium text-xs rounded-lg transition">This Week</button>
            <button @click="period.set('all')" x-class="period === 'all' ? 'bg-gray-900 text-white dark:bg-white dark:text-slate-900' : 'bg-gray-100 text-gray-600 dark:bg-slate-800 dark:text-slate-400'" class="px-3 py-1.5 font-medium text-xs rounded-lg transition">All Time</button>
          </div>
        </div>

        <div class="space-y-3">
          <template :for="battle in filteredBattles">
            <div class="flex gap-4 items-center card">
              <div class="flex items-center justify-center shrink-0 h-10 w-10 rounded-full" x-class="battle.status === 'conquered' ? 'bg-orange-100 dark:bg-orange-900/20 text-orange-600' : 'bg-emerald-100 dark:bg-emerald-900/20 text-emerald-600'">
                <Icon :if="battle.status === 'conquered'" name="swords" size="18" />
                <Icon :if="battle.status !== 'conquered'" name="shield" size="18" />
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-gray-900 dark:text-white">
                  <span class="font-semibold">{{ battle.attackerName }}</span>
                  <span>{{ battle.status === 'conquered' ? ' conquered ' : ' failed to conquer ' }}</span>
                  <StxLink x-to="'/territory/' + battle.territory_id" class="font-semibold text-emerald-600 hover:underline">{{ battle.territoryName }}</StxLink>
                  <span> from </span>
                  <span class="font-semibold">{{ battle.defenderName }}</span>
                </p>
                <div class="flex gap-3 mt-1 text-xs text-gray-500 dark:text-slate-400">
                  <span>{{ wl.timeAgo(battle.created_at) }}</span>
                  <span>{{ battle.areaCaptured.toLocaleString() + ' m²' }}</span>
                </div>
              </div>
              <span class="shrink-0 text-xs px-2 py-1 rounded-full font-medium" x-class="battle.status === 'conquered' ? 'bg-orange-100 text-orange-700' : 'bg-emerald-100 text-emerald-700'">{{ battle.status === 'conquered' ? 'Conquered' : 'Defended' }}</span>
            </div>
          </template>

          <div :if="filteredBattles.length === 0" class="py-20 text-center">
            <div class="w-20 h-20 mx-auto mb-6 bg-red-100 dark:bg-red-900/20 rounded-2xl flex items-center justify-center">
              <Icon name="zap" size="40" class="text-red-400" />
            </div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">No battles in this period</h3>
            <p class="text-gray-500 dark:text-slate-400 max-w-sm mx-auto">The battlefield is quiet... for now.</p>
          </div>
        </div>
      </div>

      <!-- Sidebar stats -->
      <div class="space-y-6">
        <div class="card">
          <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-4">Battle Stats</h3>
          <div class="grid grid-cols-2 gap-3">
            <div class="text-center p-3 bg-orange-50 dark:bg-orange-900/10 rounded-xl">
              <p class="text-xl font-bold text-orange-600">{{ conqueredCount }}</p>
              <p class="text-xs text-gray-500 dark:text-slate-400">Conquests</p>
            </div>
            <div class="text-center p-3 bg-emerald-50 dark:bg-emerald-900/10 rounded-xl">
              <p class="text-xl font-bold text-emerald-600">{{ defendedCount }}</p>
              <p class="text-xs text-gray-500 dark:text-slate-400">Defenses</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
@endsection
