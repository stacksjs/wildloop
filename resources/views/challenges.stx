@extends('layouts/default')

@section('title', 'Challenges - WildLoop')

@section('content')
<script server>
  /*
   * Page metadata, in `<script server>` so it is in the HTML a crawler is
   * served rather than something only hydration produces. See athletes.stx for
   * the full reasoning; the short version is that `useSeoMeta` is the only one
   * of the head helpers that reaches the composed document head from a page,
   * and it has to be written inline because the engine injects it into the
   * page's own scope and not into a module it imports.
   */
  useSeoMeta({
    title: 'Challenges — WildLoop',
    description: 'Challenge other athletes for the ground they hold, and see which territories are contested right now.',
    canonical: 'https://wildloop.org/challenges',
    robots: 'index, follow, max-image-preview:large',
    ogTitle: 'Challenges — WildLoop',
    ogDescription: 'Challenge other athletes for the ground they hold, and see which territories are contested right now.',
    ogType: 'website',
    ogUrl: 'https://wildloop.org/challenges',
    ogImage: 'https://wildloop.org/images/social/og-default.jpg',
    ogSiteName: 'WildLoop',
    ogLocale: 'en_US',
    twitterCard: 'summary_large_image',
    twitterTitle: 'Challenges — WildLoop',
    twitterDescription: 'Challenge other athletes for the ground they hold, and see which territories are contested right now.',
    twitterImage: 'https://wildloop.org/images/social/og-default.jpg',
  })
</script>

<script client>
  import { useChallenges } from '../composables/useChallenges'

  useHead({ title: 'Challenges - WildLoop' })

  const wl = useStore('wl')
  const tab = state<'active' | 'sent' | 'received' | 'completed'>('active')

  const currentUserId = derived(() => wl?.currentUserId())

  const {
    createOpen, submitting, createError, targetTerritoryId, busyId,
    rivalTerritories, openCreate, closeCreate, submitCreate, respond,
  } = useChallenges(wl)

  const filtered = derived(() => {
    if (!wl) return []
    const t = tab()
    const uid = wl.currentUserId()
    if (t === 'active') return wl.challenges().filter((c: any) => c.status === 'active' || c.status === 'pending')
    if (t === 'sent') return wl.challenges().filter((c: any) => c.challenger_id === uid)
    if (t === 'received') return wl.challenges().filter((c: any) => c.challenged_id === uid)
    return wl.challenges().filter((c: any) => c.status === 'completed')
  })
</script>

  <div class="mx-auto px-4 py-6 sm:px-6 lg:px-8 max-w-4xl">
    <div class="flex flex-col gap-4 items-start justify-between sm:flex-row sm:items-center mb-6">
      <div>
        <h1 class="font-bold text-2xl dark:text-white">Challenges</h1>
        <p class="mt-1 text-gray-500 text-sm dark:text-slate-400">Challenge other athletes for the ground they hold</p>
      </div>
      <button @click="openCreate()" class="flex items-center px-4 py-2 font-semibold text-sm text-white bg-orange-600 hover:bg-orange-700 rounded-lg transition">+ New Challenge</button>
    </div>

    <div class="flex gap-1 mb-6 border-b border-gray-200 dark:border-slate-700">
      <button @click="tab.set('active')" x-class="tab === 'active' ? 'border-orange-600 text-orange-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-4 py-3 font-medium text-sm border-b-2 transition">Active</button>
      <button @click="tab.set('sent')" x-class="tab === 'sent' ? 'border-orange-600 text-orange-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-4 py-3 font-medium text-sm border-b-2 transition">Sent</button>
      <button @click="tab.set('received')" x-class="tab === 'received' ? 'border-orange-600 text-orange-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-4 py-3 font-medium text-sm border-b-2 transition">Received</button>
      <button @click="tab.set('completed')" x-class="tab === 'completed' ? 'border-orange-600 text-orange-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-4 py-3 font-medium text-sm border-b-2 transition">Completed</button>
    </div>

    <div class="space-y-4">
      <template :for="challenge in filtered">
        <div class="card">
          <div class="flex items-center justify-between mb-4">
            <span class="px-2 py-0.5 font-semibold text-xs rounded-full" x-class="challenge.status === 'active' ? 'bg-orange-100 text-orange-700' : challenge.status === 'pending' ? 'bg-yellow-100 text-yellow-700' : challenge.status === 'declined' ? 'bg-gray-100 text-gray-600 dark:bg-slate-700 dark:text-slate-300' : challenge.winner_id === currentUserId ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700'">{{ challenge.status === 'active' ? 'IN PROGRESS' : challenge.status === 'pending' ? 'PENDING' : challenge.status === 'declined' ? 'DECLINED' : challenge.winner_id === currentUserId ? 'WON' : 'LOST' }}</span>
            <span class="text-gray-500 text-xs dark:text-slate-400">{{ wl.timeAgo(challenge.created_at) }}</span>
          </div>

          <div class="flex items-center justify-between gap-4">
            <div class="flex items-center gap-3 flex-1">
              <div class="flex items-center justify-center h-12 w-12 font-bold text-orange-600 bg-orange-100 dark:bg-orange-900/20 rounded-full">{{ challenge.challengerName.charAt(0) }}</div>
              <div>
                <p class="font-semibold text-sm text-gray-900 dark:text-white">{{ challenge.challenger_id === currentUserId ? 'You' : challenge.challengerName }}</p>
                <p class="text-xs text-gray-500 dark:text-slate-400">Challenger</p>
              </div>
            </div>
            <div class="shrink-0 w-10 h-10 rounded-full bg-gray-100 dark:bg-slate-700 flex items-center justify-center text-xs font-bold text-gray-500 dark:text-slate-400">VS</div>
            <div class="flex items-center gap-3 flex-1 justify-end text-right">
              <div>
                <p class="font-semibold text-sm text-gray-900 dark:text-white">{{ challenge.challenged_id === currentUserId ? 'You' : challenge.challengedName }}</p>
                <p class="text-xs text-gray-500 dark:text-slate-400">Defender</p>
              </div>
              <div class="flex items-center justify-center h-12 w-12 font-bold text-blue-600 bg-blue-100 dark:bg-blue-900/20 rounded-full">{{ challenge.challengedName.charAt(0) }}</div>
            </div>
          </div>

          <div class="mt-4 p-3 bg-gray-50 dark:bg-slate-700/50 rounded-xl flex items-center justify-between">
            <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-slate-300">
              Territory:
              <StxLink x-to="'/territory/' + challenge.territory_id" class="font-medium text-emerald-600 hover:underline">{{ challenge.territoryName }}</StxLink>
            </div>
            <span class="text-xs text-gray-500 dark:text-slate-400">{{ (challenge.areaAtStake / 1000).toFixed(1) + ' km²' }}</span>
          </div>

          <!-- Accept / decline (received + pending only) (#965) -->
          <div :if="challenge.challenged_id === currentUserId && challenge.status === 'pending'" class="flex gap-2 mt-3">
            <button @click="respond(challenge, 'accept')" x-disabled="busyId === challenge.id" class="flex-1 px-4 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition disabled:opacity-60">Accept</button>
            <button @click="respond(challenge, 'decline')" x-disabled="busyId === challenge.id" class="flex-1 px-4 py-2 border border-gray-200 dark:border-slate-600 text-gray-600 dark:text-slate-300 text-sm font-semibold rounded-lg hover:border-red-400 hover:text-red-500 transition disabled:opacity-60">Decline</button>
          </div>
          <p :if="challenge.challenger_id === currentUserId && challenge.status === 'pending'" class="mt-3 text-xs text-gray-400 text-center">Waiting for <span>{{ challenge.challengedName }}</span> to respond…</p>
        </div>
      </template>

      <div :if="filtered.length === 0" class="py-20 text-center">
        <div class="w-20 h-20 mx-auto mb-6 bg-purple-100 dark:bg-purple-900/20 rounded-2xl flex items-center justify-center">
          <Icon name="flag" size="40" class="text-purple-400" />
        </div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">No challenges yet</h3>
        <p class="text-gray-500 dark:text-slate-400 max-w-sm mx-auto mb-6">Pick a territory someone else holds and challenge them for it.</p>
        <button @click="openCreate()" class="px-6 py-2.5 bg-orange-600 text-white text-sm font-semibold rounded-lg hover:bg-orange-700 transition">New Challenge</button>
      </div>
    </div>
  </div>

  <!-- New-challenge modal (#965) -->
  <div :if="createOpen" class="fixed inset-0 z-50 flex items-center justify-center p-4">
    <div @click="closeCreate()" class="absolute inset-0 bg-black/40"></div>
    <div class="relative w-full max-w-md card">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-lg dark:text-white">Challenge a rival</h2>
        <button @click="closeCreate()" class="text-gray-400 hover:text-gray-600 dark:hover:text-slate-200 text-xl leading-none">×</button>
      </div>
      <div :if="rivalTerritories().length > 0" class="space-y-3">
        <div>
          <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Territory to challenge for</label>
          <select @change="targetTerritoryId.set($event.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm">
            <template :for="t in rivalTerritories()">
              <option x-value="t.id" x-selected="String(t.id) === targetTerritoryId" :text="t.name + ' (' + (t.areaSize / 1000).toFixed(1) + ' km²)'"></option>
            </template>
          </select>
        </div>
        <p class="text-xs text-gray-400">You'll challenge whoever currently holds it. The territory's area is what's at stake.</p>
        <p :if="createError" class="text-sm text-red-500">{{ createError }}</p>
        <div class="flex gap-2 pt-1">
          <button @click="submitCreate()" class="flex-1 px-4 py-2.5 bg-orange-600 text-white text-sm font-semibold rounded-lg hover:bg-orange-700 transition">{{ submitting ? 'Sending…' : 'Throw down' }}</button>
          <button @click="closeCreate()" class="px-4 py-2.5 text-sm font-medium text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-slate-200 transition">Cancel</button>
        </div>
      </div>
      <div :if="rivalTerritories().length === 0" class="text-center py-6">
        <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">No rival territories to challenge right now. They're all yours, or the map is still loading.</p>
        <StxLink to="/territories" class="inline-block px-5 py-2 bg-orange-600 text-white text-sm font-semibold rounded-lg hover:bg-orange-700 transition">Open the map</StxLink>
      </div>
    </div>
  </div>
@endsection
