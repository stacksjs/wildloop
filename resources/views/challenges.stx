@extends('layouts/default')

@section('title', 'Challenges - Wildloop')

@section('content')
<script server>
  /*
   * Page metadata, in `<script server>` so it is in the HTML a crawler is
   * served rather than something only hydration produces. See athletes.stx for
   * the full reasoning; the short version is that `useSeoMeta` is the only one
   * of the head helpers that reaches the composed document head from a page,
   * and it has to be written inline because the engine injects it into the
   * page's own scope and not into a module it imports.
   */
  useSeoMeta({
    title: 'Challenges — Wildloop',
    description: 'Challenge other athletes for the ground they hold, and see which territories are contested right now.',
    canonical: 'https://wildloop.org/challenges',
    robots: 'index, follow, max-image-preview:large',
    ogTitle: 'Challenges — Wildloop',
    ogDescription: 'Challenge other athletes for the ground they hold, and see which territories are contested right now.',
    ogType: 'website',
    ogUrl: 'https://wildloop.org/challenges',
    ogImage: 'https://wildloop.org/images/social/og-default.jpg',
    ogSiteName: 'Wildloop',
    ogLocale: 'en_US',
    twitterCard: 'summary_large_image',
    twitterTitle: 'Challenges — Wildloop',
    twitterDescription: 'Challenge other athletes for the ground they hold, and see which territories are contested right now.',
    twitterImage: 'https://wildloop.org/images/social/og-default.jpg',
  })
</script>

<script client>
  import { useChallenges } from '../composables/useChallenges'
  import { formatTerritoryArea } from '../functions/territory-style'

  useHead({ title: 'Challenges — Wildloop' })

  const wl = useStore('wl')
  const tab = state<'active' | 'sent' | 'received' | 'completed'>('active')

  const currentUserId = derived(() => wl?.currentUserId())

  const {
    createOpen, submitting, createError, targetTerritoryId, busyId,
    rivalTerritories, openCreate, closeCreate, submitCreate, respond,
  } = useChallenges(wl)

  const filtered = derived(() => {
    if (!wl) return []
    const t = tab()
    const uid = wl.currentUserId()
    if (t === 'active') return wl.challenges().filter((c: any) => c.status === 'active' || c.status === 'pending')
    if (t === 'sent') return wl.challenges().filter((c: any) => c.challenger_id === uid)
    if (t === 'received') return wl.challenges().filter((c: any) => c.challenged_id === uid)
    return wl.challenges().filter((c: any) => c.status === 'completed')
  })

  /**
   * Area at stake is square metres (it is copied from the territory). It was
   * shown as `/ 1000` km², a thousandfold overstatement; the shared formatter
   * picks the unit for the magnitude. Local, because markup cannot call an
   * import.
   */
  function areaText(squareMetres: number): string {
    return formatTerritoryArea(Number(squareMetres) || 0)
  }

  function initialOf(name: string | null | undefined): string {
    return String(name || '?').charAt(0).toUpperCase()
  }

  function statusText(challenge: any): string {
    if (challenge.status === 'active') return 'In progress'
    if (challenge.status === 'pending') return 'Pending'
    if (challenge.status === 'declined') return 'Declined'
    return challenge.winner_id === currentUserId() ? 'Won' : 'Lost'
  }

  function statusClass(challenge: any): string {
    if (challenge.status === 'active') return 'bg-orange-100 text-orange-700 dark:bg-orange-500/15 dark:text-orange-300'
    if (challenge.status === 'pending') return 'bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300'
    if (challenge.status === 'declined') return 'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300'
    return challenge.winner_id === currentUserId()
      ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300'
      : 'bg-red-100 text-red-700 dark:bg-red-500/15 dark:text-red-300'
  }
</script>

  <div class="mx-auto max-w-3xl px-4 pb-12 pt-6 sm:px-6 lg:px-8">
    <header class="mb-5 flex items-start justify-between gap-4">
      <div class="min-w-0">
        <h1 class="font-display text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Challenges</h1>
        <p class="mt-1 text-slate-600 dark:text-slate-400">Challenge other athletes for the ground they hold.</p>
      </div>
      <button @click="openCreate()" aria-label="New challenge" class="inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-full bg-emerald-600 pl-4 pr-5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 active:scale-[0.98]">
        <i class="i-lucide-plus h-4 w-4" aria-hidden="true"></i>
        <span>New<span class="hidden sm:inline"> challenge</span></span>
      </button>
    </header>

    <div class="-mx-4 mb-6 flex overflow-x-auto border-b border-slate-200 px-4 [scrollbar-width:none] sm:mx-0 sm:px-0 dark:border-slate-700">
        <button @click="tab.set('active')" x-class="tab === 'active' ? 'border-emerald-600 text-emerald-700 dark:border-emerald-400 dark:text-emerald-400' : 'border-transparent text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200'" class="min-h-11 shrink-0 border-b-2 px-4 text-sm font-semibold transition">Active</button>
        <button @click="tab.set('sent')" x-class="tab === 'sent' ? 'border-emerald-600 text-emerald-700 dark:border-emerald-400 dark:text-emerald-400' : 'border-transparent text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200'" class="min-h-11 shrink-0 border-b-2 px-4 text-sm font-semibold transition">Sent</button>
        <button @click="tab.set('received')" x-class="tab === 'received' ? 'border-emerald-600 text-emerald-700 dark:border-emerald-400 dark:text-emerald-400' : 'border-transparent text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200'" class="min-h-11 shrink-0 border-b-2 px-4 text-sm font-semibold transition">Received</button>
        <button @click="tab.set('completed')" x-class="tab === 'completed' ? 'border-emerald-600 text-emerald-700 dark:border-emerald-400 dark:text-emerald-400' : 'border-transparent text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200'" class="min-h-11 shrink-0 border-b-2 px-4 text-sm font-semibold transition">Completed</button>
    </div>

    <div class="space-y-4">
      <template :for="challenge in filtered">
        <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5 dark:border-slate-700 dark:bg-slate-800 dark:shadow-none">
          <div class="mb-4 flex items-center justify-between gap-3">
            <span class="rounded-full px-2.5 py-0.5 text-[11px] font-semibold" x-class="statusClass(challenge)">{{ statusText(challenge) }}</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">{{ wl.timeAgo(challenge.created_at) }}</span>
          </div>

          <!-- Challenger vs defender, mirrored around the VS mark. -->
          <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3">
            <div class="flex min-w-0 items-center gap-3">
              <div class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-orange-50 font-display font-bold text-orange-700 dark:bg-orange-500/15 dark:text-orange-300" aria-hidden="true">{{ initialOf(challenge.challengerName) }}</div>
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">{{ challenge.challenger_id === currentUserId ? 'You' : challenge.challengerName }}</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">Challenger</p>
              </div>
            </div>
            <div class="grid h-8 w-8 place-items-center rounded-full bg-slate-100 text-[10px] font-bold tracking-wide text-slate-500 dark:bg-slate-700 dark:text-slate-400">VS</div>
            <div class="flex min-w-0 items-center justify-end gap-3 text-right">
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">{{ challenge.challenged_id === currentUserId ? 'You' : challenge.challengedName }}</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">Defender</p>
              </div>
              <div class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-emerald-50 font-display font-bold text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300" aria-hidden="true">{{ initialOf(challenge.challengedName) }}</div>
            </div>
          </div>

          <StxLink x-to="'/territory/' + challenge.territory_id" class="group mt-4 flex min-h-11 items-center justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2 transition hover:bg-slate-100 dark:bg-slate-900/60 dark:hover:bg-slate-900">
            <span class="flex min-w-0 items-center gap-2 text-sm">
              <i class="i-lucide-flag h-4 w-4 shrink-0 text-slate-400" aria-hidden="true"></i>
              <span class="truncate font-medium text-slate-900 group-hover:text-emerald-700 dark:text-white dark:group-hover:text-emerald-400">{{ challenge.territoryName }}</span>
            </span>
            <span class="shrink-0 text-xs font-semibold tabular-nums text-slate-500 dark:text-slate-400">{{ areaText(challenge.areaAtStake) + ' at stake' }}</span>
          </StxLink>

          <!-- Accept / decline (received + pending only) (#965) -->
          <div :if="challenge.challenged_id === currentUserId && challenge.status === 'pending'" class="mt-3 grid grid-cols-2 gap-2">
            <button @click="respond(challenge, 'decline')" x-disabled="busyId === challenge.id" class="min-h-11 rounded-full border border-slate-200 text-sm font-semibold text-slate-600 transition hover:border-red-300 hover:text-red-600 disabled:opacity-60 dark:border-slate-600 dark:text-slate-300">Decline</button>
            <button @click="respond(challenge, 'accept')" x-disabled="busyId === challenge.id" class="min-h-11 rounded-full bg-emerald-600 text-sm font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98] disabled:opacity-60">Accept</button>
          </div>
          <p :if="challenge.challenger_id === currentUserId && challenge.status === 'pending'" class="mt-3 text-center text-xs text-slate-400">Waiting for <span>{{ challenge.challengedName }}</span> to respond…</p>
        </article>
      </template>

      <div :if="filtered.length === 0" class="rounded-2xl border border-dashed border-slate-300 px-6 py-14 text-center dark:border-slate-700">
        <div class="mx-auto mb-5 grid h-16 w-16 place-items-center rounded-2xl bg-emerald-50 dark:bg-emerald-500/10">
          <Icon name="flag" size="30" class="text-emerald-600 dark:text-emerald-400" />
        </div>
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{{ tab === 'active' ? 'No active challenges' : tab === 'sent' ? 'You have not sent any' : tab === 'received' ? 'Nobody has challenged you' : 'No finished challenges yet' }}</h3>
        <p class="mx-auto mt-1 max-w-sm text-slate-500 dark:text-slate-400">Pick a territory someone else holds and challenge them for it.</p>
        <button @click="openCreate()" class="mt-6 min-h-11 rounded-full bg-emerald-600 px-6 text-sm font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98]">New challenge</button>
      </div>
    </div>
  </div>

  <!-- New-challenge modal (#965). Bottom sheet on phones. -->
  <div :if="createOpen" class="fixed inset-0 z-50 flex items-end justify-center sm:items-center sm:p-4" role="dialog" aria-modal="true" aria-labelledby="new-challenge-title">
    <div @click="closeCreate()" class="absolute inset-0 bg-slate-950/50 backdrop-blur-[2px]"></div>
    <div class="relative max-h-[90dvh] w-full max-w-md overflow-y-auto rounded-t-3xl border border-slate-200 bg-white px-5 pb-8 pt-3 shadow-2xl sm:rounded-3xl sm:p-6 dark:border-slate-700 dark:bg-slate-800">
      <div class="mx-auto mb-3 h-1.5 w-10 rounded-full bg-slate-200 sm:hidden dark:bg-slate-600" aria-hidden="true"></div>
      <div class="mb-5 flex items-center justify-between gap-4">
        <h2 id="new-challenge-title" class="font-display text-xl font-bold text-slate-900 dark:text-white">Challenge a rival</h2>
        <button @click="closeCreate()" aria-label="Close" class="-mr-2 grid h-11 w-11 place-items-center rounded-full text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-700 dark:hover:text-slate-200">
          <i class="i-lucide-x h-5 w-5" aria-hidden="true"></i>
        </button>
      </div>
      <div :if="rivalTerritories().length > 0" class="space-y-4">
        <label class="block">
          <span class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">Territory to challenge for</span>
          <select @change="targetTerritoryId.set($event.target.value)" class="min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-600 dark:bg-slate-900 dark:text-white">
            <template :for="t in rivalTerritories()">
              <option x-value="t.id" x-selected="String(t.id) === targetTerritoryId" :text="t.name + ' (' + areaText(t.areaSize) + ')'"></option>
            </template>
          </select>
        </label>
        <p class="text-sm text-slate-500 dark:text-slate-400">You'll challenge whoever currently holds it. The territory's area is what's at stake.</p>
        <p :if="createError" role="alert" class="rounded-xl bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-500/10 dark:text-red-300">{{ createError }}</p>
        <div class="flex flex-col-reverse gap-2 pt-1 sm:flex-row">
          <button @click="closeCreate()" class="min-h-11 rounded-full px-5 text-sm font-semibold text-slate-600 transition hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-700">Cancel</button>
          <button @click="submitCreate()" x-disabled="submitting" class="min-h-11 flex-1 rounded-full bg-emerald-600 px-5 text-sm font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98] disabled:opacity-60">{{ submitting ? 'Sending…' : 'Throw down' }}</button>
        </div>
      </div>
      <div :if="rivalTerritories().length === 0" class="py-4 text-center">
        <p class="mb-5 text-sm text-slate-500 dark:text-slate-400">No rival territories to challenge right now. They're all yours, or the map is still loading.</p>
        <StxLink to="/territories" class="inline-flex min-h-11 items-center rounded-full bg-emerald-600 px-6 text-sm font-semibold text-white transition hover:bg-emerald-700">Open the map</StxLink>
      </div>
    </div>
  </div>
@endsection
