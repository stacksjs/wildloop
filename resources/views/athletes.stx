@extends('layouts/default')

@section('title', 'Find Athletes - WildLoop')

@section('content')
<script server>
  /*
   * SEO for this page.
   *
   * `<script server>` because a crawler reads the HTML it is served and never
   * runs the client script — tags set after hydration are tags nobody indexes.
   * `useSeoMeta` rather than `useHead` because only the former reaches the
   * composed document head from a page. And written out here rather than
   * wrapped in a composable: the engine injects `useSeoMeta` into a page's own
   * script scope and not into a module it imports, where it is simply
   * undefined and the call fails without a word.
   *
   * URLs are absolute. A crawler resolves `og:image` against nothing, so a
   * relative path is dropped and the link previews as a bare URL.
   */
  useSeoMeta({
    title: 'Athletes — WildLoop',
    description: 'Search WildLoop athletes by name, or browse the people covering the most ground and holding the most territory right now.',
    canonical: 'https://wildloop.org/athletes',
    robots: 'index, follow, max-image-preview:large',
    ogTitle: 'Athletes — WildLoop',
    ogDescription: 'Search WildLoop athletes by name, or browse the people covering the most ground and holding the most territory right now.',
    ogType: 'website',
    ogUrl: 'https://wildloop.org/athletes',
    ogImage: 'https://wildloop.org/images/social/og-default.jpg',
    ogSiteName: 'WildLoop',
    ogLocale: 'en_US',
    twitterCard: 'summary_large_image',
    twitterTitle: 'Athletes — WildLoop',
    twitterDescription: 'Search WildLoop athletes by name, or browse the people covering the most ground and holding the most territory right now.',
    twitterImage: 'https://wildloop.org/images/social/og-default.jpg',
  })
</script>

<script client>
  import { searchAthletes } from '../assets/scripts/game-api'
  import { followAthlete } from '../composables/useSocialActions'


  const wl = useStore('wl')
  const query = state('')
  const athletes = state<any[]>([])
  const searching = state(false)
  const searched = state(false)
  const error = state('')

  let debounceTimer: ReturnType<typeof setTimeout> | null = null

  async function runSearch(q: string) {
    searching.set(true)
    error.set('')
    const results = await searchAthletes(q)
    searching.set(false)
    searched.set(true)
    // null = request failed (vs [] = genuinely no matches) - keep the two
    // distinct so a network error doesn't read as "no athletes found".
    if (results === null) {
      error.set('Could not load athletes. Check your connection and try again.')
      athletes.set([])
    }
    else {
      athletes.set(results)
    }
  }

  function retrySearch() {
    void runSearch(query().trim())
  }

  function onQueryInput(value: string) {
    query.set(value)
    if (debounceTimer) clearTimeout(debounceTimer)
    debounceTimer = setTimeout(() => { void runSearch(query().trim()) }, 250)
  }

  // Load the discover list (most active athletes) on first visit.
  onMount(() => { void runSearch('') })

  // Shared with the feed, so a Follow button behaves the same wherever it is
  // and a signed-out visitor gets the sign-in gate rather than a dead control.
  function onFollow(userId: number) {
    void followAthlete(wl, userId)
  }

  function areaKm2(m2: number): string {
    return (m2 / 1000000).toFixed(2)
  }
</script>

  <div class="mx-auto max-w-2xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-6">
      <h1 class="font-display text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Athletes</h1>
      <p class="mt-1 text-slate-600 dark:text-slate-400">
        <span :if="!query">The most active people on WildLoop right now.</span>
        <span :else>{{ athletes.length === 1 ? 'One match' : athletes.length + ' matches' }}{{ ' for “' + query + '”' }}</span>
      </p>
    </div>

    <div class="relative mb-6">
      <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">
        <i class="i-lucide-search h-4 w-4" aria-hidden="true"></i>
      </span>
      <input
        type="search"
        placeholder="Search by name"
        x-value="query"
        @input="onQueryInput($event.target.value)"
        class="w-full rounded-full border border-slate-200 bg-white py-3 pl-11 pr-4 text-sm text-slate-900 transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
      />
    </div>

    <!-- Loading. Row-shaped skeletons rather than a spinner, so the list does
         not jump when the results land. -->
    <div :if="searching" class="space-y-2">
      <div class="flex animate-pulse items-center gap-4 rounded-2xl border border-slate-200 p-4 dark:border-slate-700">
        <div class="h-11 w-11 shrink-0 rounded-full bg-slate-200 dark:bg-slate-700"></div>
        <div class="flex-1 space-y-2"><div class="h-3 w-1/3 rounded bg-slate-200 dark:bg-slate-700"></div><div class="h-3 w-1/2 rounded bg-slate-200 dark:bg-slate-700"></div></div>
      </div>
      <div class="flex animate-pulse items-center gap-4 rounded-2xl border border-slate-200 p-4 dark:border-slate-700">
        <div class="h-11 w-11 shrink-0 rounded-full bg-slate-200 dark:bg-slate-700"></div>
        <div class="flex-1 space-y-2"><div class="h-3 w-1/2 rounded bg-slate-200 dark:bg-slate-700"></div><div class="h-3 w-1/3 rounded bg-slate-200 dark:bg-slate-700"></div></div>
      </div>
      <div class="flex animate-pulse items-center gap-4 rounded-2xl border border-slate-200 p-4 dark:border-slate-700">
        <div class="h-11 w-11 shrink-0 rounded-full bg-slate-200 dark:bg-slate-700"></div>
        <div class="flex-1 space-y-2"><div class="h-3 w-2/5 rounded bg-slate-200 dark:bg-slate-700"></div><div class="h-3 w-3/5 rounded bg-slate-200 dark:bg-slate-700"></div></div>
      </div>
    </div>

    <!-- Error, kept distinct from empty: a network failure is not "no athletes
         found", and offering "try another name" to somebody who is offline
         sends them looking for a problem that is not theirs. -->
    <div :if="error && !searching" class="py-16 text-center">
      <div class="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-2xl bg-rose-50 dark:bg-rose-500/10">
        <Icon name="alert-triangle" size="26" class="text-rose-500" />
      </div>
      <h3 class="mb-1 text-base font-semibold text-slate-900 dark:text-white">Couldn't load athletes</h3>
      <p class="mx-auto mb-4 max-w-sm text-sm text-slate-500 dark:text-slate-400">{{ error }}</p>
      <button @click="retrySearch()" class="rounded-full bg-emerald-600 px-5 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98]">Try again</button>
    </div>

    <div :if="!searching && !error" class="space-y-2">
      <template :for="athlete in athletes">
        <div class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 transition hover:border-slate-300 hover:shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:hover:border-slate-600">
          <StxLink x-to="'/athlete/' + athlete.id" class="group flex min-w-0 flex-1 items-center gap-3">
            <div class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-emerald-100 text-base font-bold text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300" aria-hidden="true">{{ athlete.name.charAt(0) }}</div>
            <div class="min-w-0">
              <p class="truncate font-semibold text-slate-900 transition group-hover:text-emerald-600 dark:text-white">{{ athlete.name }}</p>
              <!-- Territory is the number that distinguishes this app from a
                   run tracker, so it earns a place on the row whenever the
                   athlete holds any. -->
              <p class="mt-0.5 flex flex-wrap items-center gap-x-1.5 text-xs text-slate-500 dark:text-slate-400">
                <span class="tabular-nums">{{ athlete.activityCount === 1 ? '1 activity' : athlete.activityCount + ' activities' }}</span>
                <span aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
                <span class="tabular-nums">{{ athlete.followerCount === 1 ? '1 follower' : athlete.followerCount + ' followers' }}</span>
                <span :if="athlete.territoriesOwned > 0" aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</span>
                <span :if="athlete.territoriesOwned > 0" class="inline-flex items-center gap-1 font-medium text-emerald-700 dark:text-emerald-400">
                  <i class="i-lucide-flag h-3 w-3" aria-hidden="true"></i>
                  {{ athlete.territoriesOwned + ' held · ' + areaKm2(athlete.totalAreaOwned) + ' km²' }}
                </span>
              </p>
            </div>
          </StxLink>

          <button
            :if="wl && athlete.id !== wl.currentUserId()"
            @click="onFollow(athlete.id)"
            x-class="wl.isFollowing(athlete.id) ? 'border-slate-300 text-slate-600 dark:border-slate-600 dark:text-slate-300' : 'border-emerald-600 bg-emerald-600 text-white hover:bg-emerald-700'"
            class="shrink-0 rounded-full border px-4 py-1.5 text-sm font-semibold transition active:scale-[0.98]"
          >{{ wl.isFollowing(athlete.id) ? 'Following' : 'Follow' }}</button>
          <span :if="wl && athlete.id === wl.currentUserId()" class="shrink-0 px-3 py-1.5 text-xs font-medium text-slate-400">You</span>
        </div>
      </template>

      <div :if="searched && athletes.length === 0" class="py-16 text-center">
        <div class="mx-auto mb-4 grid h-16 w-16 place-items-center rounded-2xl bg-emerald-50 dark:bg-emerald-500/10">
          <Icon name="search" size="26" class="text-emerald-500" />
        </div>
        <h3 class="mb-1 text-base font-semibold text-slate-900 dark:text-white">No athletes found</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">{{ 'Nothing matched “' + query + '”. Try another name.' }}</p>
      </div>
    </div>
  </div>
@endsection
