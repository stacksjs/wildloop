@extends('layouts/default')

@section('title', 'Admin overview - WildLoop')

@section('content')
<script server>
  /*
   * Page metadata, in `<script server>` so it is in the HTML a crawler is
   * served rather than something only hydration produces. See athletes.stx for
   * the full reasoning.
   *
   * robots.txt disallows /admin, but a Disallow only asks a crawler not to
   * FETCH a URL — it cannot retract one already reached from a link, and a
   * disallowed URL can still be listed from anchor text alone. The meta tag is
   * the half that says "do not index this", and it is the half that was
   * missing here while every other signed-in surface had it.
   */
  useSeoMeta({
    title: 'Admin — WildLoop',
    description: 'WildLoop administration.',
    robots: 'noindex, nofollow',
  })
</script>

<script client>
  import { isSignedIn, token } from '../assets/scripts/auth'
  import { fetchRecords, reviewEffort } from '../assets/scripts/records-api'
  import { describeResponseError, describeThrownError } from '../assets/scripts/request-error'
  import { CATEGORY_LABELS, STYLE_LABELS } from '../functions/route-records'

  useHead({ title: 'Admin — WildLoop' })

  const loading = state(true)
  const error = state('')
  const viewer = state(null)
  const counts = state({ users: 0, trails: 0, activities: 0, admins: 0, clients: 0, paid: 0, unassigned: 0 })
  const accounts = state([])
  const accountLimit = state(25)
  const accountQuery = state('')
  const roleFilter = state('all')

  const pendingRecords = state([])
  const queueLoading = state(true)
  const queueError = state('')
  const reviewNotes = state({})
  const reviewing = state(0)
  const reviewDecision = state('')
  const reviewError = state('')
  const reviewNotice = state('')

  const filteredAccounts = derived(() => {
    const query = accountQuery().trim().toLowerCase()
    const role = roleFilter()
    return accounts().filter((account) => {
      const haystack = `${account.name ?? ''} ${account.email ?? ''}`.toLowerCase()
      const matchesQuery = !query || haystack.includes(query)
      const matchesRole = role === 'all'
        || (role === 'unassigned' ? account.roles.length === 0 : account.roles.includes(role))
      return matchesQuery && matchesRole
    })
  })

  const hasAccountFilters = derived(() => accountQuery().trim().length > 0 || roleFilter() !== 'all')

  function initial(account) {
    const source = (account?.name || account?.email || '').trim()
    return source ? source.charAt(0).toUpperCase() : '·'
  }

  function viewerName() {
    return viewer()?.name || viewer()?.email || 'Administrator'
  }

  function roleLabel(role) {
    if (role === 'paid') return 'Paid'
    if (role === 'client') return 'Member'
    if (role === 'admin') return 'Admin'
    return role
  }

  function roleClasses(role) {
    if (role === 'admin')
      return 'bg-emerald-50 text-emerald-700 ring-emerald-600/15 dark:bg-emerald-950/40 dark:text-emerald-300 dark:ring-emerald-400/20'
    if (role === 'paid')
      return 'bg-amber-50 text-amber-700 ring-amber-600/15 dark:bg-amber-950/40 dark:text-amber-300 dark:ring-amber-400/20'
    return 'bg-slate-100 text-slate-600 ring-slate-500/10 dark:bg-slate-700 dark:text-slate-300 dark:ring-white/10'
  }

  function accountDate(account) {
    if (!account?.created_at) return 'Join date unavailable'
    const date = new Date(account.created_at)
    if (Number.isNaN(date.getTime())) return 'Join date unavailable'
    return `Joined ${new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' }).format(date)}`
  }

  function clearAccountFilters() {
    accountQuery.set('')
    roleFilter.set('all')
  }

  async function loadOverview() {
    loading.set(true)
    error.set('')
    try {
      const res = await fetch('/api/admin/overview', {
        headers: { Authorization: `Bearer ${token()}`, Accept: 'application/json' },
      })
      const payload = await res.json().catch(() => null)

      if (!res.ok) {
        const failure = describeResponseError(res.status, payload)
        if (failure.unexpected) console.error('[admin]', res.status, failure.cause)
        error.set(failure.message)
        return
      }

      viewer.set(payload.viewer)
      counts.set(payload.counts)
      accounts.set(payload.accounts)
      accountLimit.set(payload.accountLimit ?? 25)
    }
    catch (err) {
      const failure = describeThrownError(err)
      if (failure.unexpected) console.error('[admin]', failure.cause)
      error.set(failure.message)
    }
    finally {
      loading.set(false)
    }
  }

  async function loadPendingRecords() {
    queueLoading.set(true)
    queueError.set('')
    const result = await fetchRecords({ status: 'pending', limit: 50 })
    if (!result) {
      queueError.set('The review queue could not be loaded. No records were changed.')
      queueLoading.set(false)
      return
    }
    pendingRecords.set(result.efforts)
    queueLoading.set(false)
  }

  function noteFor(id) {
    return reviewNotes()[id] ?? ''
  }

  function setNote(id, value) {
    reviewNotes.set({ ...reviewNotes(), [id]: value })
  }

  async function decide(record, decision) {
    if (reviewing()) return
    const note = noteFor(record.id).trim()
    if (decision === 'reject' && !note) {
      reviewError.set('Add a note that tells the athlete what evidence is missing before rejecting the claim.')
      reviewNotice.set('')
      return
    }

    reviewing.set(record.id)
    reviewDecision.set(decision)
    reviewError.set('')
    reviewNotice.set('')
    const result = await reviewEffort(record.id, decision, note || undefined)
    reviewing.set(0)
    reviewDecision.set('')

    if (!result?.success) {
      reviewError.set(result?.error ?? 'That decision could not be saved. The claim is still in the queue.')
      return
    }

    const verb = decision === 'verify' ? 'Verified' : 'Rejected'
    reviewNotice.set(`${verb} ${record.userName}'s claim on ${record.trailName}.`)
    reviewNotes.set({ ...reviewNotes(), [record.id]: undefined })
    await loadPendingRecords()
  }

  function recordSummary(record) {
    const style = STYLE_LABELS[record.style] ?? record.style
    const category = CATEGORY_LABELS[record.category] ?? record.category
    return `${record.userName} · ${style} · ${category} · ${record.elapsedLabel}`
  }

  onMount(() => {
    if (!isSignedIn()) {
      navigate('/login')
      return
    }
    void Promise.all([loadOverview(), loadPendingRecords()])
  })
</script>

<div class="min-h-full bg-slate-50/70 dark:bg-slate-950">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <header class="mb-7 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="mb-2 text-sm font-semibold text-emerald-700 dark:text-emerald-400">Operations</p>
        <h1 class="font-display text-3xl font-bold tracking-[-0.035em] text-slate-950 sm:text-4xl dark:text-white">Admin overview</h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-400">
          Review record claims, watch the catalog, and find the accounts that need attention.
        </p>
      </div>
      <div :if="viewer" class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <span class="grid h-9 w-9 place-items-center rounded-full bg-emerald-600 text-sm font-bold text-white" aria-hidden="true">{{ initial(viewer()) }}</span>
        <div class="min-w-0">
          <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">{{ viewerName() }}</p>
          <p class="text-xs text-slate-500 dark:text-slate-400">Administrator</p>
        </div>
      </div>
    </header>

    <div :if="error" role="alert" aria-live="assertive" class="mb-7 flex flex-col gap-4 rounded-2xl border border-red-200 bg-red-50 p-5 text-red-800 sm:flex-row sm:items-center sm:justify-between dark:border-red-900 dark:bg-red-950/40 dark:text-red-200">
      <div class="flex items-start gap-3">
        <i class="i-lucide-triangle-alert mt-0.5 h-5 w-5 shrink-0" aria-hidden="true"></i>
        <div>
          <p class="font-semibold">The dashboard could not be loaded</p>
          <p class="mt-1 text-sm text-red-700 dark:text-red-300">{{ error }}</p>
        </div>
      </div>
      <button type="button" @click="loadOverview()" class="inline-flex min-h-11 items-center justify-center rounded-full border border-red-300 px-4 text-sm font-semibold transition hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:border-red-800 dark:hover:bg-red-900/40">Try again</button>
    </div>

    <div :if="loading" aria-label="Loading admin overview" class="mb-8 grid grid-cols-2 gap-3 lg:grid-cols-4">
      <div :for="index in [1, 2, 3, 4]" class="h-32 animate-pulse rounded-2xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
        <span class="sr-only">Loading metric {{ index }}</span>
      </div>
    </div>

    <div :if="!loading && !error">
      <section aria-label="Application summary" class="mb-8 grid grid-cols-2 gap-3 lg:grid-cols-4">
        <a href="#accounts" class="group rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 sm:p-5 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-emerald-700 dark:focus:ring-offset-slate-950">
          <div class="flex items-center justify-between gap-3">
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"><i class="i-lucide-users h-4.5 w-4.5" aria-hidden="true"></i></span>
            <i class="i-lucide-arrow-down h-4 w-4 text-slate-300 transition group-hover:translate-y-0.5 group-hover:text-emerald-600 dark:text-slate-700" aria-hidden="true"></i>
          </div>
          <p class="mt-4 font-display text-3xl font-bold tabular-nums text-slate-950 dark:text-white">{{ counts().users }}</p>
          <p class="mt-1 text-sm font-medium text-slate-600 dark:text-slate-400">Accounts</p>
        </a>

        <a href="#review-queue" class="group rounded-2xl border p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 sm:p-5 dark:focus:ring-offset-slate-950" :class="pendingRecords().length > 0 ? 'border-amber-200 bg-amber-50 dark:border-amber-900/70 dark:bg-amber-950/25' : 'border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900'">
          <div class="flex items-center justify-between gap-3">
            <span class="grid h-9 w-9 place-items-center rounded-xl" :class="pendingRecords().length > 0 ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/50 dark:text-amber-300' : 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300'"><i class="i-lucide-shield-check h-4.5 w-4.5" aria-hidden="true"></i></span>
            <span :if="pendingRecords().length > 0" class="rounded-full bg-amber-100 px-2 py-1 text-xs font-semibold text-amber-800 dark:bg-amber-900/50 dark:text-amber-200">Needs review</span>
          </div>
          <p class="mt-4 font-display text-3xl font-bold tabular-nums text-slate-950 dark:text-white">{{ queueLoading() ? '…' : pendingRecords().length }}</p>
          <p class="mt-1 text-sm font-medium text-slate-600 dark:text-slate-400">Pending claims</p>
        </a>

        <StxLink to="/trails" class="group rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 sm:p-5 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-emerald-700 dark:focus:ring-offset-slate-950">
          <div class="flex items-center justify-between gap-3">
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"><i class="i-lucide-map h-4.5 w-4.5" aria-hidden="true"></i></span>
            <i class="i-lucide-arrow-up-right h-4 w-4 text-slate-300 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-emerald-600 dark:text-slate-700" aria-hidden="true"></i>
          </div>
          <p class="mt-4 font-display text-3xl font-bold tabular-nums text-slate-950 dark:text-white">{{ counts().trails }}</p>
          <p class="mt-1 text-sm font-medium text-slate-600 dark:text-slate-400">Trails</p>
        </StxLink>

        <StxLink to="/feed" class="group rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 sm:p-5 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-emerald-700 dark:focus:ring-offset-slate-950">
          <div class="flex items-center justify-between gap-3">
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300"><i class="i-lucide-activity h-4.5 w-4.5" aria-hidden="true"></i></span>
            <i class="i-lucide-arrow-up-right h-4 w-4 text-slate-300 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-emerald-600 dark:text-slate-700" aria-hidden="true"></i>
          </div>
          <p class="mt-4 font-display text-3xl font-bold tabular-nums text-slate-950 dark:text-white">{{ counts().activities }}</p>
          <p class="mt-1 text-sm font-medium text-slate-600 dark:text-slate-400">Activities</p>
        </StxLink>
      </section>

      <div class="mb-8 grid gap-6 lg:grid-cols-[minmax(0,1.55fr)_minmax(18rem,0.65fr)]">
        <section id="review-queue" class="scroll-mt-24 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="flex flex-col gap-2 border-b border-slate-200 px-5 py-5 sm:flex-row sm:items-start sm:justify-between sm:px-6 dark:border-slate-800">
            <div>
              <div class="flex items-center gap-2">
                <h2 class="font-display text-xl font-bold tracking-[-0.02em] text-slate-950 dark:text-white">Record review</h2>
                <span :if="!queueLoading() && !queueError" class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold tabular-nums text-slate-600 dark:bg-slate-800 dark:text-slate-300">{{ pendingRecords().length }}</span>
              </div>
              <p class="mt-1 text-sm leading-6 text-slate-500 dark:text-slate-400">Claims stay off the record board until a person checks the trace.</p>
            </div>
            <StxLink to="/records" class="inline-flex min-h-11 items-center gap-1.5 self-start rounded-full px-3 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-emerald-400 dark:hover:bg-emerald-950/40">
              View records <i class="i-lucide-arrow-up-right h-4 w-4" aria-hidden="true"></i>
            </StxLink>
          </div>

          <div :if="reviewError" role="alert" class="m-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-300">{{ reviewError }}</div>
          <div :if="reviewNotice" role="status" aria-live="polite" class="m-5 flex items-start gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-200">
            <i class="i-lucide-circle-check mt-0.5 h-4 w-4 shrink-0" aria-hidden="true"></i>
            <span>{{ reviewNotice }}</span>
          </div>

          <div :if="queueLoading()" class="grid min-h-44 place-items-center px-5 py-10 text-center" aria-label="Loading record review queue">
            <div>
              <i class="i-lucide-loader-circle mx-auto h-6 w-6 animate-spin text-emerald-600" aria-hidden="true"></i>
              <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">Loading claims…</p>
            </div>
          </div>

          <div :if="!queueLoading() && queueError" role="alert" class="grid min-h-44 place-items-center px-5 py-10 text-center">
            <div class="max-w-sm">
              <i class="i-lucide-cloud-off mx-auto h-6 w-6 text-slate-400" aria-hidden="true"></i>
              <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">{{ queueError }}</p>
              <button type="button" @click="loadPendingRecords()" class="mt-4 inline-flex min-h-11 items-center justify-center rounded-full border border-slate-300 px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Retry queue</button>
            </div>
          </div>

          <div :if="!queueLoading() && !queueError && pendingRecords().length === 0" class="grid min-h-44 place-items-center px-5 py-10 text-center">
            <div>
              <span class="mx-auto grid h-11 w-11 place-items-center rounded-full bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400"><i class="i-lucide-check h-5 w-5" aria-hidden="true"></i></span>
              <p class="mt-3 font-semibold text-slate-900 dark:text-white">Queue clear</p>
              <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Every filed claim has a decision.</p>
            </div>
          </div>

          <ul :if="!queueLoading() && !queueError && pendingRecords().length > 0" class="divide-y divide-slate-200 dark:divide-slate-800">
            <li :for="record in pendingRecords()" class="px-5 py-5 sm:px-6">
              <div class="flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
                <div class="min-w-0">
                  <a x-href="'/effort/' + record.id" class="font-semibold text-slate-950 transition hover:text-emerald-600 dark:text-white dark:hover:text-emerald-400">{{ record.trailName }}</a>
                  <p class="mt-1 text-sm leading-5 text-slate-500 dark:text-slate-400">{{ recordSummary(record) }}</p>
                </div>
                <div class="flex flex-wrap gap-2 text-xs">
                  <a :if="record.evidenceUrl" x-href="record.evidenceUrl" target="_blank" rel="noopener noreferrer nofollow" class="inline-flex min-h-9 items-center gap-1.5 rounded-full border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-emerald-300 hover:text-emerald-700 dark:border-slate-700 dark:text-slate-300"><i class="i-lucide-video h-3.5 w-3.5" aria-hidden="true"></i>Recording</a>
                  <a :if="record.gpxUrl" x-href="record.gpxUrl" target="_blank" rel="noopener noreferrer nofollow" class="inline-flex min-h-9 items-center gap-1.5 rounded-full border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-emerald-300 hover:text-emerald-700 dark:border-slate-700 dark:text-slate-300"><i class="i-lucide-route h-3.5 w-3.5" aria-hidden="true"></i>GPS file</a>
                  <a :if="record.activityId" x-href="'/activity/' + record.activityId" class="inline-flex min-h-9 items-center gap-1.5 rounded-full border border-slate-200 px-3 font-semibold text-slate-600 transition hover:border-emerald-300 hover:text-emerald-700 dark:border-slate-700 dark:text-slate-300"><i class="i-lucide-activity h-3.5 w-3.5" aria-hidden="true"></i>Activity</a>
                  <span :if="!record.evidenceUrl && !record.gpxUrl && !record.activityId" class="inline-flex min-h-9 items-center gap-1.5 rounded-full bg-red-50 px-3 font-semibold text-red-700 dark:bg-red-950/40 dark:text-red-300"><i class="i-lucide-triangle-alert h-3.5 w-3.5" aria-hidden="true"></i>No trace</span>
                </div>
              </div>

              <div class="mt-4 grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
                <label class="min-w-0">
                  <span class="sr-only">Review note for {{ record.userName }} on {{ record.trailName }}</span>
                  <input
                    type="text"
                    placeholder="Review note (required to reject)"
                    x-value="noteFor(record.id)"
                    @input="setNote(record.id, $event.target.value)"
                    class="min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3.5 text-base text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 sm:text-sm dark:border-slate-700 dark:bg-slate-950 dark:text-white" />
                </label>
                <div class="grid grid-cols-2 gap-2">
                  <button type="button" @click="decide(record, 'reject')" x-disabled="reviewing() !== 0" class="inline-flex min-h-11 items-center justify-center rounded-xl border border-red-200 px-4 text-sm font-semibold text-red-700 transition hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-500 disabled:cursor-not-allowed disabled:opacity-50 dark:border-red-900 dark:text-red-300 dark:hover:bg-red-950/40">{{ reviewing() === record.id && reviewDecision() === 'reject' ? 'Saving…' : 'Reject' }}</button>
                  <button type="button" @click="decide(record, 'verify')" x-disabled="reviewing() !== 0" class="inline-flex min-h-11 items-center justify-center rounded-xl bg-emerald-600 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 dark:focus:ring-offset-slate-900">{{ reviewing() === record.id && reviewDecision() === 'verify' ? 'Saving…' : 'Verify' }}</button>
                </div>
              </div>
            </li>
          </ul>
        </section>

        <aside class="rounded-2xl border border-slate-200 bg-slate-950 p-5 text-white shadow-sm sm:p-6 dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center justify-between gap-3">
            <h2 class="font-display text-xl font-bold tracking-[-0.02em]">Account access</h2>
            <i class="i-lucide-key-round h-5 w-5 text-emerald-400" aria-hidden="true"></i>
          </div>
          <p class="mt-2 text-sm leading-6 text-slate-400">Role coverage across every account, not only the recent list below.</p>

          <dl class="mt-4 divide-y divide-white/10 border-y border-white/10">
            <div class="flex items-center justify-between gap-4 py-2.5">
              <dt class="text-sm text-slate-300">Administrators</dt>
              <dd class="font-display text-lg font-bold tabular-nums">{{ counts().admins }}</dd>
            </div>
            <div class="flex items-center justify-between gap-4 py-2.5">
              <dt class="text-sm text-slate-300">Members</dt>
              <dd class="font-display text-lg font-bold tabular-nums">{{ counts().clients }}</dd>
            </div>
            <div class="flex items-center justify-between gap-4 py-2.5">
              <dt class="text-sm text-slate-300">Paid access</dt>
              <dd class="font-display text-lg font-bold tabular-nums">{{ counts().paid }}</dd>
            </div>
            <div class="flex items-center justify-between gap-4 py-2.5">
              <dt class="text-sm text-slate-300">No role assigned</dt>
              <dd class="font-display text-lg font-bold tabular-nums" :class="counts().unassigned > 0 ? 'text-amber-300' : 'text-emerald-300'">{{ counts().unassigned }}</dd>
            </div>
          </dl>

          <div :if="counts().unassigned > 0" class="mt-4 flex items-start gap-2.5 rounded-xl bg-amber-400/10 p-3 text-sm leading-5 text-amber-100">
            <i class="i-lucide-info mt-0.5 h-4 w-4 shrink-0 text-amber-300" aria-hidden="true"></i>
            <p>{{ counts().unassigned }} {{ counts().unassigned === 1 ? 'account has' : 'accounts have' }} no assigned role. Use the account list to identify them.</p>
          </div>
          <div :if="counts().unassigned === 0" class="mt-4 flex items-start gap-2.5 rounded-xl bg-emerald-400/10 p-3 text-sm leading-5 text-emerald-100">
            <i class="i-lucide-circle-check mt-0.5 h-4 w-4 shrink-0 text-emerald-300" aria-hidden="true"></i>
            <p>Every account has an access role.</p>
          </div>
        </aside>
      </div>

      <section id="accounts" class="scroll-mt-24 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="border-b border-slate-200 px-5 py-5 sm:px-6 dark:border-slate-800">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <h2 class="font-display text-xl font-bold tracking-[-0.02em] text-slate-950 dark:text-white">Recent accounts</h2>
              <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Showing the newest {{ accounts().length }} of {{ counts().users }} accounts.</p>
            </div>
            <p :if="counts().users > accountLimit()" class="text-xs text-slate-400 dark:text-slate-500">Search covers this recent set.</p>
          </div>

          <div :if="accounts().length > 0" class="mt-5 grid gap-3 sm:grid-cols-[minmax(0,1fr)_12rem]">
            <label class="relative block">
              <span class="sr-only">Search recent accounts</span>
              <i class="i-lucide-search pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" aria-hidden="true"></i>
              <input x-model.trim="accountQuery" type="search" placeholder="Search by name or email" class="min-h-11 w-full rounded-xl border border-slate-300 bg-white pl-10 pr-4 text-base text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 sm:text-sm dark:border-slate-700 dark:bg-slate-950 dark:text-white" />
            </label>
            <label>
              <span class="sr-only">Filter accounts by role</span>
              <select x-model="roleFilter" class="min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3.5 text-base text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 sm:text-sm dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200">
                <option value="all">All roles</option>
                <option value="admin">Administrators</option>
                <option value="client">Members</option>
                <option value="paid">Paid</option>
                <option value="unassigned">No role</option>
              </select>
            </label>
          </div>
        </div>

        <div :if="accounts().length === 0" class="grid min-h-48 place-items-center px-5 py-10 text-center">
          <div>
            <i class="i-lucide-user-round-plus mx-auto h-7 w-7 text-slate-400" aria-hidden="true"></i>
            <p class="mt-3 font-semibold text-slate-900 dark:text-white">No accounts yet</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">New signups will appear here.</p>
          </div>
        </div>

        <div :if="accounts().length > 0 && filteredAccounts().length === 0" class="grid min-h-48 place-items-center px-5 py-10 text-center">
          <div>
            <i class="i-lucide-search-x mx-auto h-7 w-7 text-slate-400" aria-hidden="true"></i>
            <p class="mt-3 font-semibold text-slate-900 dark:text-white">No matching accounts</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Try another name, email, or role.</p>
            <button type="button" @click="clearAccountFilters()" class="mt-4 inline-flex min-h-11 items-center justify-center rounded-full border border-slate-300 px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">Clear filters</button>
          </div>
        </div>

        <ul :if="filteredAccounts().length > 0" class="divide-y divide-slate-200 dark:divide-slate-800" aria-live="polite">
          <li :for="account in filteredAccounts()" class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:px-6">
            <div class="flex min-w-0 flex-1 items-center gap-3.5">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-emerald-600 text-sm font-bold text-white shadow-sm" aria-hidden="true">{{ initial(account) }}</span>
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-slate-950 dark:text-white">{{ account.name || account.email }}</p>
                <p class="truncate text-sm text-slate-500 dark:text-slate-400">{{ account.email }}</p>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-2 pl-[3.375rem] sm:justify-end sm:pl-0">
              <span class="mr-1 text-xs text-slate-400 dark:text-slate-500">{{ accountDate(account) }}</span>
              <span :if="account.roles.length === 0" class="inline-flex rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 ring-1 ring-inset ring-amber-600/15 dark:bg-amber-950/40 dark:text-amber-300 dark:ring-amber-400/20">No role</span>
              <span :for="role in account.roles" class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset" :class="roleClasses(role)">{{ roleLabel(role) }}</span>
            </div>
          </li>
        </ul>

        <div :if="filteredAccounts().length > 0" class="border-t border-slate-200 bg-slate-50/70 px-5 py-3 text-xs text-slate-500 sm:px-6 dark:border-slate-800 dark:bg-slate-950/40 dark:text-slate-400">
          Showing {{ filteredAccounts().length }} {{ hasAccountFilters() ? 'matching' : 'recent' }} {{ filteredAccounts().length === 1 ? 'account' : 'accounts' }}
        </div>
      </section>
    </div>
  </div>
</div>
@endsection
