@extends('layouts/default')

@section('title', 'Record - WildLoop')

@section('content')
<script server>
  /*
   * Page metadata, in `<script server>` so it is in the HTML a crawler is
   * served rather than something only hydration produces. See athletes.stx for
   * the full reasoning; the short version is that `useSeoMeta` is the only one
   * of the head helpers that reaches the composed document head from a page,
   * and it has to be written inline because the engine injects it into the
   * page's own scope and not into a module it imports.
   */
  useSeoMeta({
    title: 'Record a Run — WildLoop',
    description: 'Record a run with live GPS, pace, splits and territory capture.',
    robots: 'noindex, nofollow',
  })
</script>

<script client>
  import { useRecorder } from '../composables/useRecorder'
  import { useActivityImport } from '../composables/useActivityImport'
  import { useMyLiveEvent } from '../composables/useMyLiveEvent'

  useHead({ title: 'Record a Run — WildLoop' })

  const wl = useStore('wl')
  const { importing, importMessage, importError, importFile } = useActivityImport(wl)
  const {
    recording,
    paused,
    activityType,
    visibility,
    mode,
    runMode,
    elapsed,
    distance,
    elevation,
    gpsStatus,
    selectedTrailId,
    targetTerritoryId,
    conqueredIds,
    captureProgress,
    sessionXp,
    conquestToast,
    saveStatus,
    saveMessage,
    wrongTurn,
    trailOptions,
    simulate,
    startManual,
    togglePause,
    stop,
    fmtDuration,
    mountRecordMap,
  } = useRecorder({ mapElId: 'record-map', wl })

  const { event: liveEvent, yard, countdown, yardsBanked, banking, bankError, bankYard } = useMyLiveEvent()

  onMount(() => mountRecordMap())

  // The pre-run setup is noise once the watch is running, and the only thing
  // that matters mid-run is the map and the numbers. `setupOpen` keeps the
  // options one tap away without letting them crowd the screen.
  const setupOpen = state(false)

  const attackable = derived(() => wl ? wl.attackableTerritories() : [])
  const targetZone = derived(() => {
    const id = targetTerritoryId()
    return id && wl ? wl.findTerritory(id) : null
  })

  const activeCaptures = derived(() => {
    const prog = captureProgress()
    return Object.entries(prog)
      .filter(([, pct]) => pct > 0 && pct < 100)
      .map(([id, pct]) => ({ id: Number(id), pct, name: wl?.findTerritory(Number(id))?.name ?? 'Zone' }))
  })

  const pace = derived(() => distance() > 0.01 ? fmtDuration(Math.round(elapsed() / distance())) : '--:--')

  const gpsLabel = derived(() => {
    if (gpsStatus() === 'active') return mode() === 'simulated' ? 'Simulating' : 'GPS locked'
    if (gpsStatus() === 'searching') return 'Finding satellites…'
    return 'GPS off'
  })
</script>

  <div class="record-page">
    <div class="mx-auto max-w-4xl px-4 pb-28 pt-6 sm:px-6 lg:px-8">

      <!-- ── Header ──────────────────────────────────────────────────────── -->
      <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h1 class="font-display text-2xl font-bold tracking-[-0.03em] dark:text-white">Record</h1>
          <p class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">
            <span :if="!recording">Close a loop and the ground inside it is yours.</span>
            <span :if="recording">{{ runMode === 'capture' ? 'Stay inside the highlighted zone to fill the capture meter.' : 'Free run — no territory capture.' }}</span>
          </p>
        </div>

        <div :if="!recording" class="flex flex-wrap items-center gap-2">
          <div class="mode-switch" role="group" aria-label="Run mode">
            <button @click="runMode.set('capture')" :aria-pressed="runMode === 'capture'" x-class="runMode === 'capture' ? 'mode-on' : ''">Capture</button>
            <button @click="runMode.set('free')" :aria-pressed="runMode === 'free'" x-class="runMode === 'free' ? 'mode-on' : ''">Free run</button>
          </div>
          <button @click="setupOpen.set(!setupOpen())" :aria-expanded="setupOpen" class="ghost-btn">
            <i class="i-lucide-sliders-horizontal h-4 w-4" aria-hidden="true"></i>
            Options
          </button>
        </div>
      </div>

      <!-- ── Live event ──────────────────────────────────────────────────── -->
      <div :if="liveEvent" class="yard-strip">
        <div class="min-w-0">
          <p class="yard-strip-label"><span class="live-pip" aria-hidden="true"></span>{{ 'Yard ' + yard() + ' · next start in ' + countdown() }}</p>
          <StxLink x-to="'/event/' + liveEvent.id" class="mt-0.5 block truncate font-bold text-white hover:underline">{{ liveEvent.name }}</StxLink>
          <p class="text-xs text-white/60">{{ yardsBanked() + ' banked · ' + liveEvent.stillIn + ' of ' + liveEvent.entrantCount + ' still in' }}</p>
        </div>
        <button @click="bankYard()" x-disabled="banking()" class="yard-bank">
          {{ banking ? 'Recording…' : 'Bank yard ' + yard() }}
        </button>
      </div>
      <p :if="bankError" role="alert" class="mb-4 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700 dark:bg-red-950/40 dark:text-red-300">{{ bankError }}</p>

      <!-- ── Options ─────────────────────────────────────────────────────── -->
      <div :show="setupOpen() && !recording" x-cloak class="mb-5 space-y-4 rounded-2xl border border-slate-200 p-5 dark:border-slate-700">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="record-visibility" class="field-label">Who can see it</label>
            <select id="record-visibility" x-value="visibility" @change="visibility.set($event.target.value)" class="field">
              <option value="public">Everyone</option>
              <option value="followers">Followers</option>
              <option value="private">Only me</option>
            </select>
          </div>
          <div>
            <label class="field-label">Plan ahead</label>
            <StxLink to="/routes" class="ghost-btn w-full justify-center">
              <i class="i-lucide-route h-4 w-4" aria-hidden="true"></i>
              Plan a route
            </StxLink>
          </div>
        </div>

        <!-- Target zone (capture mode) -->
        <div x-class="runMode === 'capture' ? '' : 'hidden'">
          <p class="field-label">Target a zone to attack</p>
          <div class="flex flex-wrap items-center gap-2">
            <button @click="targetTerritoryId.set(null)" :aria-pressed="targetTerritoryId === null" x-class="targetTerritoryId === null ? 'chip chip-on' : 'chip'">Any nearby</button>
            <template :for="zone in attackable">
              <button @click="targetTerritoryId.set(zone.id)" :aria-pressed="targetTerritoryId === zone.id" x-class="targetTerritoryId === zone.id ? 'chip chip-target' : 'chip'">{{ zone.name }}</button>
            </template>
            <span :if="attackable.length === 0" class="text-xs text-slate-500 dark:text-slate-400">No claimable zones in range yet. Head toward the orange areas on the map.</span>
          </div>
          <p :if="targetZone" class="mt-2 text-xs text-orange-600 dark:text-orange-400">Focus run: cross <span class="font-semibold">{{ targetZone.name }}</span> to fill the capture meter.</p>
        </div>

        <!-- Simulate -->
        <div class="border-t border-slate-100 pt-4 dark:border-slate-700">
          <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
            <p class="field-label mb-0">Preview a trail</p>
            <span class="text-xs text-slate-400 dark:text-slate-500">Saved as a simulation · never scores</span>
          </div>
          <div class="flex gap-2">
            <select @change="selectedTrailId.set(Number($event.target.value))" x-disabled="trailOptions.length === 0" class="field flex-1">
              <option :if="trailOptions.length === 0" disabled>No trails available yet</option>
              <template :for="opt in trailOptions">
                <option x-value="opt.id" x-selected="opt.id === selectedTrailId" :text="opt.name"></option>
              </template>
            </select>
            <button @click="simulate()" x-disabled="trailOptions.length === 0" class="ghost-btn shrink-0">Preview</button>
          </div>
        </div>

        <!-- Import -->
        <div class="border-t border-slate-100 pt-4 dark:border-slate-700">
          <p class="field-label">Import an activity</p>
          <p class="mb-2 text-xs text-slate-500 dark:text-slate-400">GPX, TCX, and checksum-validated FIT files import privately. Imported tracks cannot capture territory.</p>
          <label class="ghost-btn inline-flex cursor-pointer">
            <i class="i-lucide-upload h-4 w-4" aria-hidden="true"></i>
            {{ importing ? 'Importing…' : 'Choose a file' }}
            <input type="file" accept=".gpx,.tcx,.fit,application/gpx+xml,application/vnd.garmin.tcx+xml" @change="importFile($event)" class="sr-only" />
          </label>
          <p :if="importMessage" class="mt-2 text-sm text-emerald-600">{{ importMessage }}</p>
          <p :if="importError" class="mt-2 text-sm text-red-500">{{ importError }}</p>
        </div>
      </div>

      <!-- ── Map ─────────────────────────────────────────────────────────── -->
      <div class="map-frame">
        <div id="record-map" data-stx-ignore class="ts-map-container h-[24rem] w-full sm:h-[30rem]"></div>

        <div class="map-badge" x-class="gpsStatus === 'active' ? 'text-emerald-700' : gpsStatus === 'searching' ? 'text-amber-700' : 'text-slate-600'">
          <span class="map-dot" x-class="gpsStatus === 'active' ? 'bg-emerald-500 animate-pulse' : gpsStatus === 'searching' ? 'bg-amber-500 animate-pulse' : 'bg-slate-400'"></span>
          {{ gpsLabel() }}
        </div>

        <div class="map-legend">
          <span><i class="legend-swatch bg-emerald-500"></i>Yours</span>
          <span><i class="legend-swatch bg-amber-500"></i>Enemy</span>
          <span><i class="legend-swatch bg-purple-500"></i>Capturing</span>
          <span><i class="legend-swatch rounded-full bg-sky-500"></i>Route</span>
        </div>

        <div :if="conquestToast" class="capture-toast absolute left-1/2 top-3 z-[1000] -translate-x-1/2 rounded-full bg-emerald-600 px-5 py-2.5 font-bold text-white shadow-xl">{{ conquestToast }}</div>
      </div>

      <!-- ── Capture meters ──────────────────────────────────────────────── -->
      <div :if="recording && activeCaptures.length > 0" class="mt-4 space-y-2">
        <template :for="cap in activeCaptures">
          <div class="rounded-2xl border border-slate-200 px-4 py-3 dark:border-slate-700">
            <div class="mb-1.5 flex justify-between text-xs">
              <span class="font-semibold dark:text-white">{{ 'Capturing ' + cap.name }}</span>
              <span class="font-bold text-purple-600 tabular-nums">{{ cap.pct + '%' }}</span>
            </div>
            <div class="capture-bar"><div class="capture-bar-fill" :style="'width:' + cap.pct + '%'"></div></div>
          </div>
        </template>
      </div>

      <!-- ── Live numbers ────────────────────────────────────────────────── -->
      <div class="metrics">
        <div class="metric-hero">
          <p class="metric-clock">{{ fmtDuration(elapsed) }}</p>
          <p class="metric-caption">Elapsed</p>
        </div>

        <div class="metric-grid">
          <div class="metric">
            <p class="metric-value">{{ distance.toFixed(2) }}</p>
            <p class="metric-caption">Miles</p>
          </div>
          <div class="metric">
            <p class="metric-value">{{ pace() }}</p>
            <p class="metric-caption">Pace</p>
          </div>
          <div class="metric">
            <p class="metric-value">{{ elevation.toLocaleString() }}</p>
            <p class="metric-caption">Elev ft</p>
          </div>
          <div class="metric">
            <p class="metric-value text-emerald-600 dark:text-emerald-400">{{ conqueredIds.length }}</p>
            <p class="metric-caption">Captured</p>
          </div>
          <div class="metric">
            <p class="metric-value text-purple-600 dark:text-purple-400">{{ sessionXp }}</p>
            <p class="metric-caption">XP</p>
          </div>
        </div>
      </div>

      <div :if="saveMessage" class="mt-4 rounded-xl px-4 py-3 text-sm font-semibold" x-class="saveStatus === 'saved' ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-300' : saveStatus === 'queued' ? 'bg-amber-50 text-amber-700 dark:bg-amber-900/20 dark:text-amber-300' : saveStatus === 'error' ? 'bg-red-50 text-red-700 dark:bg-red-900/20 dark:text-red-300' : 'bg-sky-50 text-sky-700 dark:bg-sky-900/20 dark:text-sky-300'">
        {{ saveMessage }}
      </div>

      <div :if="wrongTurn && recording" role="alert" class="mt-4 rounded-xl bg-amber-100 px-4 py-3 text-sm font-semibold text-amber-800 dark:bg-amber-900/30 dark:text-amber-200">
        Wrong-turn alert: you are more than about 425 ft from the selected trail route.
      </div>
    </div>

    <!-- ── Controls ──────────────────────────────────────────────────────
         Docked, not inline. This is the one thing that gets pressed with
         cold hands halfway up a climb, so it stays reachable no matter how
         far the page has scrolled. -->
    <div class="control-dock">
      <div class="control-inner">
        <button @click="startManual()" aria-label="Start recording" x-class="recording ? 'hidden' : 'record-btn-start'">
          <i class="i-lucide-play h-8 w-8" aria-hidden="true"></i>
        </button>
        <button @click="togglePause()" :aria-label="paused ? 'Resume recording' : 'Pause recording'" x-class="!recording ? 'hidden' : paused ? 'record-btn-resume' : 'record-btn-pause'">
          <i x-class="paused ? 'i-lucide-play h-7 w-7' : 'i-lucide-pause h-7 w-7'" aria-hidden="true"></i>
        </button>
        <button @click="stop()" aria-label="Finish recording" x-class="recording ? 'record-btn-stop' : 'hidden'">
          <i class="i-lucide-square h-7 w-7" aria-hidden="true"></i>
        </button>
      </div>
      <p class="control-hint">
        <span :if="!recording">Tap to start GPS capture</span>
        <span :if="recording && !paused">Recording</span>
        <span :if="recording && paused">Paused</span>
      </p>
    </div>
  </div>

<style>
  .record-page { position: relative; }

  .field-label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 55%, transparent);
  }

  .field {
    width: 100%;
    padding: 0.6rem 0.75rem;
    font-size: 0.875rem;
    color: inherit;
    background: transparent;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 0.75rem;
  }

  .ghost-btn {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    padding: 0.6rem 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: inherit;
    border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    border-radius: 9999px;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .ghost-btn:hover {
    border-color: #10b981;
    background: color-mix(in srgb, #10b981 8%, transparent);
  }

  .mode-switch {
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    background: color-mix(in srgb, currentColor 8%, transparent);
    border-radius: 9999px;
  }

  .mode-switch button {
    padding: 0.5rem 1.1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: color-mix(in srgb, currentColor 65%, transparent);
    border-radius: 9999px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .mode-on {
    color: #fff !important;
    background: #059669;
  }

  .chip {
    padding: 0.4rem 0.8rem;
    font-size: 0.78rem;
    font-weight: 500;
    color: inherit;
    background: color-mix(in srgb, currentColor 8%, transparent);
    border-radius: 0.6rem;
    transition: box-shadow 0.15s ease;
  }

  .chip-on { box-shadow: 0 0 0 2px #10b981; }
  .chip-target { box-shadow: 0 0 0 2px #f97316; }

  /* ── Live event strip ─────────────────────────────────────────────── */

  .yard-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    padding: 1rem 1.25rem;
    border-radius: 1.25rem;
    background: linear-gradient(120deg, #06231b 0%, #0b3a2c 100%);
  }

  .yard-strip-label {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    color: #9fd6c0;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .yard-bank {
    flex: none;
    padding: 0.85rem 1.5rem;
    color: #06231b;
    font-size: 0.9rem;
    font-weight: 800;
    background: #6ee7b7;
    border-radius: 9999px;
    transition: background 0.15s ease, transform 0.12s ease;
  }

  .yard-bank:hover { background: #34d399; }
  .yard-bank:active { transform: scale(0.98); }
  .yard-bank:disabled { opacity: 0.55; }

  .live-pip {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    background: #ef4444;
    border-radius: 9999px;
    box-shadow: 0 0 0 0 rgb(239 68 68 / 60%);
    animation: live-pulse 1.8s ease-out infinite;
  }

  @keyframes live-pulse {
    to { box-shadow: 0 0 0 0.5rem rgb(239 68 68 / 0%); }
  }

  /* ── Map ──────────────────────────────────────────────────────────── */

  .map-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 1.5rem;
    box-shadow: 0 12px 40px -20px rgb(9 20 16 / 45%);
  }

  .map-badge {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    z-index: 1000;
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    background: rgb(255 255 255 / 92%);
    border-radius: 9999px;
    box-shadow: 0 2px 10px rgb(9 20 16 / 12%);
    backdrop-filter: blur(6px);
  }

  .map-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
  }

  .map-legend {
    position: absolute;
    bottom: 0.85rem;
    left: 0.85rem;
    z-index: 1000;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.5rem 0.8rem;
    color: #1e293b;
    font-size: 0.7rem;
    font-weight: 500;
    background: rgb(255 255 255 / 92%);
    border-radius: 0.75rem;
    box-shadow: 0 2px 10px rgb(9 20 16 / 12%);
    backdrop-filter: blur(6px);
  }

  .map-legend span {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }

  .legend-swatch {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 0.2rem;
  }

  /* ── Metrics ──────────────────────────────────────────────────────── */

  .metrics {
    margin-top: 1rem;
    padding: 1.75rem 1.5rem 1.5rem;
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 1.5rem;
  }

  .metric-hero { text-align: center; }

  .metric-clock {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: clamp(3rem, 12vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .metric-caption {
    margin-top: 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 50%, transparent);
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1.75rem;
    overflow: hidden;
    background: color-mix(in srgb, currentColor 12%, transparent);
    border-radius: 1rem;
  }

  @media (min-width: 640px) {
    .metric-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }

  .metric {
    padding: 1rem 0.5rem;
    text-align: center;
    background: var(--surface, #fff);
  }

  .dark .metric { background: #0f1b17; }

  .metric-value {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .metric .metric-caption { margin-top: 0.2rem; }

  /* ── Docked controls ──────────────────────────────────────────────── */

  .control-dock {
    position: sticky;
    bottom: 0;
    z-index: 20;
    padding: 1rem 1rem calc(1rem + env(safe-area-inset-bottom, 0px));
    text-align: center;
    background: linear-gradient(180deg, transparent 0%, var(--dock-bg, #fff) 45%);
  }

  .dark .control-dock { --dock-bg: #0b1512; }

  .control-inner {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: center;
  }

  .control-hint {
    margin-top: 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 45%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .live-pip { animation: none; }
  }
</style>
@endsection
