@extends('layouts/default')

@section('title', 'Route Planner - Wildloop')

@section('content')
<script server>
  /*
   * Page metadata, in `<script server>` so it is in the HTML a crawler is
   * served rather than something only hydration produces. See athletes.stx for
   * the full reasoning; the short version is that `useSeoMeta` is the only one
   * of the head helpers that reaches the composed document head from a page,
   * and it has to be written inline because the engine injects it into the
   * page's own scope and not into a module it imports.
   */
  useSeoMeta({
    title: 'Route Planner — Wildloop',
    description: 'Draw a running or hiking route anywhere by tapping the map, then drag it into shape — it follows real paths and trails — with distance and climb as you go. Save it and plan it for a day.',
    canonical: 'https://wildloop.org/routes',
    robots: 'index, follow, max-image-preview:large',
    ogTitle: 'Route Planner — Wildloop',
    ogDescription: 'Draw a running or hiking route anywhere by tapping the map, then drag it into shape — it follows real paths and trails — with distance and climb as you go. Save it and plan it for a day.',
    ogType: 'website',
    ogUrl: 'https://wildloop.org/routes',
    ogImage: 'https://wildloop.org/images/social/og-default.jpg',
    ogSiteName: 'Wildloop',
    ogLocale: 'en_US',
    twitterCard: 'summary_large_image',
    twitterTitle: 'Route Planner — Wildloop',
    twitterDescription: 'Draw a running or hiking route anywhere by tapping the map, then drag it into shape — it follows real paths and trails — with distance and climb as you go. Save it and plan it for a day.',
    twitterImage: 'https://wildloop.org/images/social/og-default.jpg',
  })
</script>

<script client>
  import type { LatLngLike, RouteBuilder as RouteBuilderType, SegmentRouter } from 'ts-maps/services'
  import type { PlaceResult } from '../composables/usePlaceSearch'
  import type { TrailMapHandle } from '../composables/useTrailMap'
  import { apiFetch, readyToken } from '../assets/scripts/auth'
  import { normalizeTrailsPayload } from '../assets/scripts/trail-data'
  import { requireAuth } from '../composables/useAuthGate'
  import { usePlaceSearch } from '../composables/usePlaceSearch'
  import { routeShapeFor } from '../composables/useRouteShape'
  import { createTrailMap, ensureTsMaps, runWhenMapReady } from '../composables/useTrailMap'
  import { encodePolyline } from '../functions/polyline'
  import { planDirections } from '../functions/trip-plans'

  useHead({ title: 'Route Planner — Wildloop' })
  const wl = useStore('wl')

  // ── Saved routes ────────────────────────────────────────────────────────
  const routes = state<any[]>([])
  /** Whether the list has answered once, so "no routes" is not said while loading. */
  const loaded = state(false)
  const signedIn = derived(() => Boolean(wl && wl.currentUserId() > 0))

  const NO_SHAPE = { points: '', startX: 0, startY: 0, endX: 0, endY: 0, loop: true }
  const shapes = new Map<number, typeof NO_SHAPE>()

  /** A saved route's line, fitted to its square thumbnail. */
  function routeShape(route: any) {
    const cached = shapes.get(route?.id)
    if (cached)
      return cached
    const shape = routeShapeFor(route?.route, 100, 100, 12)
    if (!shape)
      return NO_SHAPE
    shapes.set(route.id, shape)
    return shape
  }

  async function loadRoutes() {
    if (!(await readyToken())) {
      loaded.set(true)
      return
    }
    const res = await apiFetch('/api/custom-routes', {}).catch(() => null)
    const payload = await res?.json().catch(() => null)
    routes.set(res?.ok && Array.isArray(payload?.routes) ? payload.routes : [])
    loaded.set(true)
  }

  async function deleteRoute(id: number) {
    await apiFetch(`/api/custom-routes/${id}`, { method: 'DELETE' })
    if (savedRouteId() === id)
      savedRouteId.set(0)
    await loadRoutes()
  }

  function planRouteUrl(route: any): string {
    return `/plans?route=${route.id}`
  }

  function routeStartDirections(route: any): string {
    const start = Array.isArray(route?.route) ? route.route[0] : null
    return start ? planDirections({ latitude: start[0], longitude: start[1], activity_type: null })?.apple ?? '' : ''
  }

  // ── The builder ─────────────────────────────────────────────────────────
  // Everything the markup shows is a signal copied from the RouteBuilder on
  // each change; the builder itself lives outside the reactive graph.
  let builder: RouteBuilderType | null = null
  let builderMap: TrailMapHandle | null = null
  /** The map UI for the builder: the line, and the handles that reshape it. */
  let editor: any = null
  /** Room above and below a fitted route, so the stats pill never covers its start or end. */
  const FIT_PADDING: [number, number] = [32, 80]
  let climbTimer: ReturnType<typeof setTimeout> | null = null
  let climbToken = 0

  const followPaths = state(true)
  const pointCount = state(0)
  const distanceMi = state(0)
  const climbFt = state<number | null>(null)
  const climbing = state(false)
  const isLoop = state(false)
  /** Ends meet because the way back retraces the way out, not a loop. */
  const isOutAndBack = state(false)
  const pending = state(0)
  const canUndo = state(false)
  const hint = state<string | null>(null)
  const routeName = state('')
  const saving = state(false)
  const saveMessage = state<string | null>(null)
  const savedRouteId = state(0)
  /** The town the map was moved to, for a default route name. */
  const townName = state('')

  const hasRoute = derived(() => pointCount() >= 2)
  const statsLine = derived(() => {
    if (pointCount() === 0)
      return ''
    const miles = distanceMi() >= 10 ? distanceMi().toFixed(1) : distanceMi().toFixed(2)
    const climb = climbFt() === null ? (climbing() ? ' · climb…' : '') : ` · +${climbFt()!.toLocaleString()} ft`
    const shape = isOutAndBack() ? ' · out & back' : isLoop() ? ' · loop' : ''
    return `${miles} mi${climb}${shape}`
  })
  const defaultName = derived(() => {
    const miles = distanceMi().toFixed(1)
    const shape = isOutAndBack() ? 'out & back' : isLoop() ? 'loop' : 'route'
    return townName() ? `${miles} mi ${shape} in ${townName()}` : `${miles} mi ${shape}`
  })

  /** Each tapped leg along footpaths, through the server's router. */
  const pathRouter: SegmentRouter = async (from, to) => {
    const res = await fetch(`/api/geo/path?from=${from.lat},${from.lng}&to=${to.lat},${to.lng}`)
    const body = await res.json().catch(() => ({}))
    if (!res.ok || !body.routed || !Array.isArray(body.points))
      throw new Error(body.reason || 'No path between these points')
    return body.points.map(([lat, lng]: [number, number]) => ({ lat, lng }))
  }

  async function currentRouter(): Promise<SegmentRouter> {
    const { services } = await ensureTsMaps() as any
    return followPaths() ? pathRouter : services.straightRouter
  }

  /** Waypoints that read the same both ways: out, then back the same way. */
  function mirrors(points: LatLngLike[]): boolean {
    if (points.length < 3 || points.length % 2 === 0)
      return false
    for (let i = 0; i < points.length / 2; i++) {
      const a = points[i]
      const b = points[points.length - 1 - i]
      if (a.lat !== b.lat || a.lng !== b.lng)
        return false
    }
    return true
  }

  function toPairs(points: LatLngLike[]): [number, number][] {
    return points.map(p => [p.lat, p.lng])
  }

  /** Copy the builder's numbers into signals; the editor draws the line itself. */
  function redraw(): void {
    if (!builder)
      return
    pointCount.set(builder.waypoints.length)
    distanceMi.set(builder.distanceMeters / 1609.344)
    isLoop.set(builder.isLoop)
    isOutAndBack.set(mirrors(builder.waypoints))
    pending.set(builder.pending)
    canUndo.set(builder.canUndo)
    if (builder.lastError && followPaths())
      hint.set(`${builder.lastError} — drew that stretch straight.`)
    scheduleClimb()
  }

  /** The climb, a moment after drawing stops: one lookup per pause, not per tap. */
  function scheduleClimb(): void {
    if (climbTimer)
      clearTimeout(climbTimer)
    const token = ++climbToken
    if (!builder || builder.waypoints.length < 2) {
      climbFt.set(null)
      climbing.set(false)
      return
    }
    climbing.set(true)
    climbTimer = setTimeout(async () => {
      if (!builder || builder.pending > 0)
        return
      const { services } = await ensureTsMaps() as any
      const encoded = encodePolyline(toPairs(services.resamplePath(builder.path, 200)))
      try {
        const res = await fetch(`/api/geo/climb?path=${encodeURIComponent(encoded)}`)
        const body = await res.json()
        if (token === climbToken)
          climbFt.set(typeof body.gainFt === 'number' ? body.gainFt : null)
      }
      catch {
        if (token === climbToken)
          climbFt.set(null)
      }
      finally {
        if (token === climbToken)
          climbing.set(false)
      }
    }, 700)
  }

  async function mountBuilder(): Promise<void> {
    const maps = await ensureTsMaps() as any
    builderMap = await createTrailMap('route-builder-map', { chrome: 'compact', zoom: 4 })
    if (!builderMap)
      return
    builder = new maps.services.RouteBuilder({ router: await currentRouter() }) as RouteBuilderType
    builder.onChange(() => redraw())
    // Tap to add; drag a point, the line or a "+" to reshape; tap a point to drop it.
    editor = new maps.RouteEditor(builder, { color: '#10b981' }).addTo(builderMap.map)
    editor.on('dragstart', () => clearMessages())
    builderMap.map.on('click', () => clearMessages())
    await startFromQuery()
  }

  function clearMessages(): void {
    hint.set(null)
    saveMessage.set(null)
  }

  /**
   * Waypoints for a line that was not drawn here (a catalog trail, a saved
   * route): about a dozen along it, so dragging one reshapes that stretch
   * rather than rerouting the whole thing.
   */
  async function loadLine(path: [number, number][]): Promise<void> {
    if (!builder)
      return
    const { services } = await ensureTsMaps() as any
    const points = path.map(([lat, lng]) => ({ lat, lng }))
    const every = Math.min(3000, Math.max(300, services.pathLengthMeters(points) / 12))
    await builder.load(points, { waypointEveryMeters: every })
  }

  async function setFollowPaths(value: boolean): Promise<void> {
    followPaths.set(value)
    builder?.setRouter(await currentRouter())
  }

  function undo(): void {
    hint.set(null)
    void builder?.undo()
  }

  function clearRoute(): void {
    hint.set(null)
    saveMessage.set(null)
    savedRouteId.set(0)
    void builder?.clear()
  }

  function loopBack(): void {
    void builder?.closeLoop()
  }

  function outAndBack(): void {
    void builder?.outAndBack()
  }

  // ── Where to start ──────────────────────────────────────────────────────
  const place = usePlaceSearch({ limit: 5 })
  const placeResults = place.results
  const placeQuery = place.query

  function onPlaceInput(event: any): void {
    place.onInput(String(event?.target?.value ?? ''))
  }

  function goTo(result: PlaceResult): void {
    place.clear()
    townName.set(result.name)
    builderMap?.map.setView([result.lat, result.lng], 14)
    hint.set(`Tap the map in ${result.name} to set your start.`)
  }

  /**
   * `?via=lat,lng|lat,lng|…` draws a route through those stops in order —
   * a shareable draft ("our long run past the beaches"), each leg routed
   * like a tap. `name` and `town` are optional.
   */
  function readVia(raw: unknown): LatLngLike[] {
    if (typeof raw !== 'string')
      return []
    return raw.split('|').slice(0, 60).map((pair) => {
      const [lat, lng] = pair.split(',').map(Number)
      return Number.isFinite(lat) && Number.isFinite(lng) && Math.abs(lat) <= 90 && Math.abs(lng) <= 180 ? { lat, lng } : null
    }).filter((p): p is LatLngLike => p !== null)
  }

  /** `?trail=<id>` starts from a catalog trail; `?open=<id>` from a saved route; `?via=` from stops. */
  async function startFromQuery(): Promise<void> {
    const query = useRoute().query ?? {}
    const trailId = Number(query.trail)
    const openId = Number(query.open)
    const via = readVia(query.via)
    let path: [number, number][] = []
    let name = ''
    if (via.length >= 2 && builder && builderMap) {
      if (query.mode === 'straight')
        await setFollowPaths(false)
      routeName.set(typeof query.name === 'string' ? query.name.slice(0, 200) : '')
      townName.set(typeof query.town === 'string' ? query.town.slice(0, 80) : '')
      builderMap.fitPoints(via.map(p => [p.lat, p.lng]), FIT_PADDING)
      hint.set(`Drawing through ${via.length} stops along paths…`)
      for (const stop of via)
        void builder.add(stop)
      await builder.settled()
      builderMap.fitPoints(toPairs(builder.path), FIT_PADDING)
      hint.set(builder.lastError ? `${builder.lastError} — one stretch is drawn straight.` : 'Drawn through every stop. Drag any point or the line to reshape it, then save.')
      return
    }
    if (Number.isInteger(trailId) && trailId > 0) {
      const res = await apiFetch(`/api/trails/${trailId}`).catch(() => null)
      const payload = await res?.json().catch(() => null)
      if (payload) {
        const { trails, geometryById } = normalizeTrailsPayload(payload)
        path = (geometryById[trailId] ?? []) as [number, number][]
        name = trails[0]?.name ? `${trails[0].name} (my version)` : ''
        townName.set(trails[0]?.location?.split(',')[0] ?? '')
      }
    }
    else if (Number.isInteger(openId) && openId > 0) {
      await loadRoutes()
      const saved = routes().find((r: any) => r.id === openId)
      if (saved) {
        path = saved.route
        name = saved.name
        savedRouteId.set(saved.id)
      }
    }
    if (path.length >= 2 && builder && builderMap) {
      await loadLine(path)
      builderMap.fitPoints(path, FIT_PADDING)
      routeName.set(name)
      hint.set('Drag any point or the line to reshape it, or tap the map to extend it.')
    }
  }

  /** Open a saved route in the planner, to reshape and save over it. */
  async function editRoute(route: any): Promise<void> {
    if (!builder || !builderMap || !Array.isArray(route?.route) || route.route.length < 2)
      return
    clearMessages()
    await loadLine(route.route)
    builderMap.fitPoints(route.route, FIT_PADDING)
    routeName.set(route.name)
    savedRouteId.set(route.id)
    hint.set(`Editing “${route.name}”. Drag any point or the line to reshape it, then save.`)
  }

  // ── Saving, then planning ───────────────────────────────────────────────
  /**
   * Save the line. A route opened from the list (or saved once already) is
   * saved over itself; `asNew` keeps the original and saves a copy.
   */
  async function saveRoute(asNew = false): Promise<void> {
    if (!builder || builder.waypoints.length < 2 || saving())
      return
    if (!requireAuth('Sign in to save routes and plan them for a day.', () => void saveRoute(asNew)))
      return
    const updating = !asNew && savedRouteId() > 0
    saving.set(true)
    saveMessage.set(null)
    try {
      const { services } = await ensureTsMaps() as any
      // The API keeps up to 10,000 points; a routed line rarely needs 2,000.
      const path = builder.path.length > 2000 ? services.resamplePath(builder.path, 2000) : builder.path
      const res = await apiFetch(updating ? `/api/custom-routes/${savedRouteId()}` : '/api/custom-routes', {
        method: updating ? 'PATCH' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: routeName().trim() || defaultName(), route: toPairs(path), elevation: climbFt() ?? 0 }),
      })
      const payload = await res.json().catch(() => null)
      if (!res.ok || !payload?.route) {
        saveMessage.set(payload?.error || 'The route could not be saved')
        return
      }
      savedRouteId.set(payload.route.id)
      saveMessage.set(updating ? `Updated “${payload.route.name}”.` : `Saved “${payload.route.name}”.`)
      await loadRoutes()
    }
    finally {
      saving.set(false)
    }
  }

  function planSavedUrl(): string {
    return `/plans?route=${savedRouteId()}`
  }

  onMount(() => {
    void loadRoutes()
    const cancel = runWhenMapReady('route-builder-map', () => mountBuilder())
    return () => cancel()
  })

  onDestroy(() => {
    if (climbTimer)
      clearTimeout(climbTimer)
    builderMap?.destroy()
    editor = null
    builderMap = null
    builder = null
  })
</script>

<div class="mx-auto max-w-4xl px-4 py-6 sm:px-6 lg:px-8">
  <header class="mb-4">
    <p class="mb-2 inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.14em] text-emerald-700 dark:text-emerald-400">
      <i class="i-lucide-route h-3.5 w-3.5" aria-hidden="true"></i>
      Route planner
    </p>
    <h1 class="font-display text-3xl font-bold tracking-[-0.03em] text-slate-900 dark:text-white">Draw a route</h1>
    <p class="mt-1.5 max-w-[60ch] text-sm text-slate-600 dark:text-slate-400">Tap the map to add points — the line follows real paths and trails. Drag it into shape, save it, then plan it for a day.</p>
  </header>

  <!-- Start somewhere: any town. -->
  <div class="relative mb-3">
    <label for="route-place" class="sr-only">Start in a town or city</label>
    <div class="flex items-center gap-2 rounded-2xl border border-slate-200 bg-white px-3.5 shadow-sm focus-within:border-emerald-500 focus-within:ring-2 focus-within:ring-emerald-500/30 dark:border-slate-700 dark:bg-slate-800">
      <i class="i-lucide-search h-4 w-4 shrink-0 text-slate-400" aria-hidden="true"></i>
      <input id="route-place" type="search" autocomplete="off" placeholder="Start in… San Diego, Boulder, Chamonix" x-value="placeQuery()" @input="onPlaceInput($event)" class="min-h-12 w-full min-w-0 bg-transparent text-base text-slate-900 placeholder:text-slate-400 focus:outline-none sm:text-sm dark:text-white" />
    </div>
    <ul :if="placeResults().length > 0" class="absolute inset-x-0 top-full z-30 mt-1 divide-y divide-slate-100 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl dark:divide-slate-700/70 dark:border-slate-700 dark:bg-slate-800">
      <template :for="result in placeResults()">
        <li>
          <button type="button" @click="goTo(result)" class="flex min-h-11 w-full items-center gap-3 px-3 py-2 text-left transition hover:bg-slate-50 dark:hover:bg-slate-700/60">
            <i class="i-lucide-map-pin h-4 w-4 shrink-0 text-emerald-600" aria-hidden="true"></i>
            <span class="min-w-0">
              <span class="block truncate text-sm font-semibold text-slate-900 dark:text-white">{{ result.name }}</span>
              <span class="block truncate text-xs text-slate-500 dark:text-slate-400">{{ result.detail }}</span>
            </span>
          </button>
        </li>
      </template>
    </ul>
  </div>

  <!-- The map you draw on. -->
  <div id="route-planner" class="relative scroll-mt-20 overflow-hidden rounded-2xl border border-slate-200 shadow-sm dark:border-slate-700">
    <div id="route-builder-map" data-stx-ignore class="ts-map-container h-[58vh] min-h-[320px] w-full sm:h-[480px]"></div>

    <!-- What the line adds up to, over the map where the eye already is. -->
    <!-- z-[500]: above the map's own panes, which stack from 400. -->
    <div class="pointer-events-none absolute inset-x-0 bottom-8 z-[500] flex justify-center px-3">
      <p :if="pointCount() === 0" class="rounded-full bg-slate-900/85 px-4 py-2 text-sm font-semibold text-white shadow-lg backdrop-blur">Tap the map to set your start</p>
      <p :if="pointCount() === 1" class="rounded-full bg-slate-900/85 px-4 py-2 text-sm font-semibold text-white shadow-lg backdrop-blur">Now tap where you want to go</p>
      <p :if="pointCount() > 1" class="flex items-center gap-2 rounded-full bg-slate-900/85 px-4 py-2 text-sm font-semibold tabular-nums text-white shadow-lg backdrop-blur" aria-live="polite">
        <i :if="pending() > 0" class="i-lucide-loader-circle h-4 w-4 animate-spin" aria-hidden="true"></i>
        {{ statsLine() }}
      </p>
    </div>
  </div>

  <p :if="hint()" class="mt-2 text-sm text-slate-600 dark:text-slate-300" role="status">{{ hint() }}</p>

  <!-- How to reshape it, once there is a line to reshape. -->
  <ul :if="hasRoute()" class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500 dark:text-slate-400" aria-label="Editing the route">
    <li class="inline-flex items-center gap-1.5"><i class="i-lucide-move h-3.5 w-3.5 text-emerald-600" aria-hidden="true"></i>Drag a point to move it</li>
    <li class="inline-flex items-center gap-1.5"><i class="i-lucide-spline h-3.5 w-3.5 text-emerald-600" aria-hidden="true"></i>Drag the line or a <span class="font-bold text-emerald-600">+</span> to go through somewhere new</li>
    <li class="inline-flex items-center gap-1.5"><i class="i-lucide-circle-x h-3.5 w-3.5 text-emerald-600" aria-hidden="true"></i>Tap a point to remove it</li>
  </ul>

  <!-- Tools, thumb-sized. -->
  <div class="mt-3 flex flex-wrap items-center gap-2">
    <div class="inline-flex rounded-full bg-slate-100 p-1 dark:bg-slate-800" role="group" aria-label="How new legs are drawn">
      <button type="button" @click="setFollowPaths(true)" :aria-pressed="followPaths() ? 'true' : 'false'" x-class="followPaths() ? 'bg-white text-slate-900 shadow-sm dark:bg-slate-700 dark:text-white' : 'text-slate-500 dark:text-slate-400'" class="inline-flex min-h-10 items-center gap-1.5 rounded-full px-3.5 text-sm font-semibold transition">
        <i class="i-lucide-footprints h-4 w-4" aria-hidden="true"></i>
        Follow paths
      </button>
      <button type="button" @click="setFollowPaths(false)" :aria-pressed="followPaths() ? 'false' : 'true'" x-class="!followPaths() ? 'bg-white text-slate-900 shadow-sm dark:bg-slate-700 dark:text-white' : 'text-slate-500 dark:text-slate-400'" class="inline-flex min-h-10 items-center gap-1.5 rounded-full px-3.5 text-sm font-semibold transition">
        <i class="i-lucide-pencil-line h-4 w-4" aria-hidden="true"></i>
        Straight
      </button>
    </div>
    <button type="button" @click="undo()" x-disabled="!canUndo()" class="inline-flex min-h-11 items-center gap-1.5 rounded-full border border-slate-200 px-4 text-sm font-semibold text-slate-700 transition hover:border-emerald-400 disabled:opacity-40 dark:border-slate-600 dark:text-slate-200">
      <i class="i-lucide-undo-2 h-4 w-4" aria-hidden="true"></i>
      Undo
    </button>
    <button type="button" @click="loopBack()" x-disabled="pointCount() < 2 || isLoop()" class="inline-flex min-h-11 items-center gap-1.5 rounded-full border border-slate-200 px-4 text-sm font-semibold text-slate-700 transition hover:border-emerald-400 disabled:opacity-40 dark:border-slate-600 dark:text-slate-200">
      <i class="i-lucide-rotate-cw h-4 w-4" aria-hidden="true"></i>
      Loop back
    </button>
    <button type="button" @click="outAndBack()" x-disabled="pointCount() < 2 || isLoop()" class="inline-flex min-h-11 items-center gap-1.5 rounded-full border border-slate-200 px-4 text-sm font-semibold text-slate-700 transition hover:border-emerald-400 disabled:opacity-40 dark:border-slate-600 dark:text-slate-200">
      <i class="i-lucide-arrow-left-right h-4 w-4" aria-hidden="true"></i>
      Out &amp; back
    </button>
    <button type="button" @click="clearRoute()" x-disabled="pointCount() === 0" class="inline-flex min-h-11 items-center gap-1.5 rounded-full px-3 text-sm font-semibold text-slate-500 transition hover:text-rose-600 disabled:opacity-40 dark:text-slate-400">
      <i class="i-lucide-trash-2 h-4 w-4" aria-hidden="true"></i>
      Clear
    </button>
  </div>

  <!-- Save, then plan. -->
  <section :if="hasRoute()" class="mt-4 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:shadow-none" aria-label="Save this route">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
      <div class="min-w-0 flex-1">
        <label for="route-name" class="mb-1.5 block text-xs font-semibold text-slate-600 dark:text-slate-300">Name</label>
        <input id="route-name" x-value="routeName" @input="routeName.set($event.target.value)" x-placeholder="defaultName()" maxlength="200" class="h-12 w-full rounded-xl border border-slate-200 bg-white px-3 text-base text-slate-900 placeholder:text-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 sm:text-sm dark:border-slate-600 dark:bg-slate-900 dark:text-white" />
      </div>
      <button :if="savedRouteId() > 0" type="button" @click="saveRoute(true)" x-disabled="saving() || pending() > 0" class="inline-flex h-12 items-center justify-center gap-2 rounded-full border border-slate-200 px-5 text-sm font-semibold text-slate-700 transition hover:border-emerald-400 active:scale-[0.98] disabled:opacity-60 dark:border-slate-600 dark:text-slate-200">
        <i class="i-lucide-copy-plus h-4 w-4" aria-hidden="true"></i>
        Save as new
      </button>
      <button type="button" @click="saveRoute()" x-disabled="saving() || pending() > 0" class="inline-flex h-12 items-center justify-center gap-2 rounded-full bg-emerald-600 px-6 text-sm font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98] disabled:opacity-60">
        <i x-class="saving() ? 'i-lucide-loader-circle h-4 w-4 animate-spin' : 'i-lucide-bookmark-plus h-4 w-4'" aria-hidden="true"></i>
        {{ saving() ? 'Saving…' : savedRouteId() > 0 ? 'Save changes' : 'Save route' }}
      </button>
    </div>
    <div :if="saveMessage()" class="mt-3 flex flex-wrap items-center gap-2">
      <p class="flex items-center gap-1.5 text-sm font-medium text-emerald-700 dark:text-emerald-400" role="status">
        <i class="i-lucide-circle-check h-4 w-4 shrink-0" aria-hidden="true"></i>
        {{ saveMessage() }}
      </p>
      <StxLink :if="savedRouteId() > 0" x-to="planSavedUrl()" class="inline-flex min-h-10 items-center gap-1.5 rounded-full bg-emerald-600 px-4 text-sm font-semibold text-white transition hover:bg-emerald-700">
        <i class="i-lucide-calendar-plus h-4 w-4" aria-hidden="true"></i>
        Plan this route
      </StxLink>
    </div>
  </section>

  <!-- Saved -->
  <div class="mb-3 mt-8 flex items-baseline justify-between">
    <h2 class="font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">Your routes</h2>
    <span :if="routes().length > 0" class="text-sm text-slate-500 tabular-nums dark:text-slate-400">{{ routes().length === 1 ? '1 route' : routes().length + ' routes' }}</span>
  </div>

  <div :if="!loaded()" class="space-y-3" role="status" aria-label="Loading saved routes">
    <div class="flex animate-pulse items-center gap-4 rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-800"><div class="h-16 w-16 rounded-xl bg-slate-200 dark:bg-slate-700"></div><div class="flex-1 space-y-2"><div class="h-3.5 w-1/2 rounded bg-slate-200 dark:bg-slate-700"></div><div class="h-3 w-1/3 rounded bg-slate-200 dark:bg-slate-700"></div></div></div>
  </div>

  <div :if="loaded()" class="space-y-3">
    <template :for="route in routes()">
      <div :id="'route-' + route.id" class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-700 dark:bg-slate-800">
        <div class="wl-topo relative h-16 w-16 shrink-0 overflow-hidden rounded-xl" aria-hidden="true">
          <svg :if="routeShape(route).points !== ''" viewBox="0 0 100 100" class="absolute inset-0 h-full w-full">
            <polyline x-points="routeShape(route).points" class="wl-route-casing" />
            <polyline x-points="routeShape(route).points" class="wl-route-line" />
          </svg>
          <i :if="routeShape(route).points === ''" class="i-lucide-route absolute inset-0 m-auto h-6 w-6 text-emerald-700/40 dark:text-emerald-300/30"></i>
        </div>
        <div class="min-w-0 flex-1">
          <p class="truncate font-semibold text-slate-900 dark:text-white">{{ route.name }}</p>
          <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-500 dark:text-slate-400">
            <span class="font-medium text-slate-700 tabular-nums dark:text-slate-200">{{ route.distance.toFixed(1) + ' mi' }}</span>
            <span :if="route.elevation > 0" class="tabular-nums">{{ '+' + Math.round(route.elevation).toLocaleString() + ' ft' }}</span>
            <span x-class="route.closedLoop ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300' : 'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300'" class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-semibold">
              <i x-class="route.closedLoop ? 'i-lucide-rotate-cw h-3 w-3' : 'i-lucide-move-right h-3 w-3'" aria-hidden="true"></i>
              {{ route.closedLoop ? 'Loop' : 'Point to point' }}
            </span>
          </p>
          <div class="mt-2 flex flex-wrap gap-1">
            <a href="#route-planner" @click="editRoute(route)" class="inline-flex min-h-9 items-center gap-1 rounded-full bg-slate-100 px-3 text-xs font-semibold text-slate-700 transition hover:bg-slate-200 dark:bg-slate-700 dark:text-slate-200 dark:hover:bg-slate-600">
              <i class="i-lucide-pencil h-3.5 w-3.5" aria-hidden="true"></i>
              Edit
            </a>
            <StxLink x-to="planRouteUrl(route)" class="inline-flex min-h-9 items-center gap-1 rounded-full bg-emerald-50 px-3 text-xs font-semibold text-emerald-800 transition hover:bg-emerald-100 dark:bg-emerald-500/10 dark:text-emerald-300">
              <i class="i-lucide-calendar-plus h-3.5 w-3.5" aria-hidden="true"></i>
              Plan
            </StxLink>
            <a x-href="routeStartDirections(route)" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-9 items-center gap-1 rounded-full px-3 text-xs font-semibold text-slate-600 transition hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-700/60">
              <i class="i-lucide-navigation h-3.5 w-3.5" aria-hidden="true"></i>
              To the start
            </a>
          </div>
        </div>
        <button @click="deleteRoute(route.id)" x-aria-label="'Delete ' + route.name" class="grid h-11 w-11 shrink-0 place-items-center self-start rounded-full text-slate-400 transition hover:bg-rose-50 hover:text-rose-600 active:scale-95 dark:hover:bg-rose-500/10 dark:hover:text-rose-400">
          <i class="i-lucide-trash-2 h-4 w-4" aria-hidden="true"></i>
        </button>
      </div>
    </template>

    <div :if="routes().length === 0" class="rounded-2xl border border-dashed border-slate-200 px-6 py-10 text-center dark:border-slate-700">
      <p class="font-semibold text-slate-900 dark:text-white">{{ signedIn() ? 'No saved routes yet' : 'Your routes, on every device' }}</p>
      <p class="mx-auto mt-1 max-w-sm text-sm text-slate-500 dark:text-slate-400">{{ signedIn() ? 'Draw one above and save it — then plan it for a day.' : 'Draw one above; sign in when you save it.' }}</p>
    </div>
  </div>
</div>
<style>
  /* Contour-tinted ground for a card with no photo. Four layouts, picked by
     id, so a grid of them reads as different places rather than one tile. */
  .wl-topo {
    --topo-x: 78%;
    --topo-y: 28%;

    background-color: #eef3ef;
    background-image:
      radial-gradient(90% 120% at 12% 115%, rgb(16 185 129 / 0.12), transparent 60%),
      repeating-radial-gradient(ellipse 150% 110% at var(--topo-x) var(--topo-y), transparent 0 15px, rgb(15 70 45 / 0.08) 15px 16px),
      repeating-radial-gradient(ellipse 80% 60% at calc(100% - var(--topo-x)) calc(100% - var(--topo-y)), transparent 0 23px, rgb(15 70 45 / 0.045) 23px 24px);
  }

  .wl-topo-1 { --topo-x: 22%; --topo-y: 30%; }
  .wl-topo-2 { --topo-x: 60%; --topo-y: 85%; }
  .wl-topo-3 { --topo-x: 95%; --topo-y: 65%; }

  .dark .wl-topo {
    background-color: #0f1a16;
    background-image:
      radial-gradient(90% 120% at 12% 115%, rgb(16 185 129 / 0.14), transparent 60%),
      repeating-radial-gradient(ellipse 150% 110% at var(--topo-x) var(--topo-y), transparent 0 15px, rgb(167 243 208 / 0.065) 15px 16px),
      repeating-radial-gradient(ellipse 80% 60% at calc(100% - var(--topo-x)) calc(100% - var(--topo-y)), transparent 0 23px, rgb(167 243 208 / 0.035) 23px 24px);
  }

  .wl-route-casing,
  .wl-route-line {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .wl-route-casing { stroke: #fff; stroke-width: 6; }
  .wl-route-line { stroke: #059669; stroke-width: 3; }
  .wl-route-start { fill: #10b981; stroke: #fff; stroke-width: 2; }
  .wl-route-end { fill: #0f172a; stroke: #fff; stroke-width: 2; }

  .dark .wl-route-casing { stroke: #0b1411; }
  .dark .wl-route-line { stroke: #34d399; }
  .dark .wl-route-start { stroke: #0b1411; }
  .dark .wl-route-end { fill: #e2e8f0; stroke: #0b1411; }
</style>
@endsection
