@extends('layouts/default')

@section('title', 'Route Planner - WildLoop')

@section('content')
<script server>
  /*
   * Page metadata, in `<script server>` so it is in the HTML a crawler is
   * served rather than something only hydration produces. See athletes.stx for
   * the full reasoning; the short version is that `useSeoMeta` is the only one
   * of the head helpers that reaches the composed document head from a page,
   * and it has to be written inline because the engine injects it into the
   * page's own scope and not into a module it imports.
   */
  useSeoMeta({
    title: 'Route Planner — WildLoop',
    description: 'Build a route from verified trail geometry and save it for offline navigation, with distance and elevation as you go.',
    canonical: 'https://wildloop.org/routes',
    robots: 'index, follow, max-image-preview:large',
    ogTitle: 'Route Planner — WildLoop',
    ogDescription: 'Build a route from verified trail geometry and save it for offline navigation, with distance and elevation as you go.',
    ogType: 'website',
    ogUrl: 'https://wildloop.org/routes',
    ogImage: 'https://wildloop.org/images/social/og-default.jpg',
    ogSiteName: 'WildLoop',
    ogLocale: 'en_US',
    twitterCard: 'summary_large_image',
    twitterTitle: 'Route Planner — WildLoop',
    twitterDescription: 'Build a route from verified trail geometry and save it for offline navigation, with distance and elevation as you go.',
    twitterImage: 'https://wildloop.org/images/social/og-default.jpg',
  })
</script>

<script client>
  import { readyToken } from '../assets/scripts/auth'

  useHead({ title: 'Route Planner - WildLoop' })
  const wl = useStore('wl')

  // The catalog itself is hydrated by the layout, which decides per path what
  // this page needs — `/routes` was missing from that list, so the picker
  // below listed the store's demo fixtures and offered trails that do not
  // exist.

  const name = state('')
  const selectedTrailId = state(0)
  const routes = state<any[]>([])
  const message = state('')

  async function loadRoutes() {
    const bearer = await readyToken()
    if (!bearer) {
      navigate('/login')
      return
    }
    const res = await fetch('/api/custom-routes', { headers: { Authorization: `Bearer ${bearer}` } }).catch(() => null)
    const payload = await res?.json().catch(() => null)
    routes.set(res?.ok && Array.isArray(payload?.routes) ? payload.routes : [])
  }

  async function saveRoute() {
    const bearer = await readyToken()
    if (!bearer) {
      navigate('/login')
      return
    }
    const trailId = Number(selectedTrailId())
    const trail = wl?.findTrail(trailId)
    const route = wl?.trailRoutes()[trailId] ?? []
    if (!trail || route.length < 2) {
      message.set('Choose a trail with verified route geometry.')
      return
    }
    const res = await fetch('/api/custom-routes', {
      method: 'POST',
      headers: { Authorization: `Bearer ${bearer}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: name().trim() || `${trail.name} route`, route, elevation: trail.elevation }),
    })
    const payload = await res.json().catch(() => null)
    if (!res.ok) {
      message.set(payload?.error || 'Could not save route')
      return
    }
    message.set(payload.route.closedLoop ? 'Saved as a closed loop.' : 'Saved. This route does not close within 50 metres.')
    name.set('')
    await loadRoutes()
  }

  async function deleteRoute(id) {
    const bearer = await readyToken()
    if (!bearer) {
      navigate('/login')
      return
    }
    await fetch(`/api/custom-routes/${id}`, { method: 'DELETE', headers: { Authorization: `Bearer ${bearer}` } })
    await loadRoutes()
  }

  onMount(() => void loadRoutes())
</script>

<div class="mx-auto px-4 py-8 max-w-4xl">
  <header class="mb-6">
    <h1 class="font-bold text-2xl dark:text-white">Route Planner</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-slate-400">Turn verified catalog geometry into a saved route for offline preparation and navigation.</p>
  </header>

  <section class="card mb-6">
    <div class="grid gap-3 sm:grid-cols-[1fr_1fr_auto]">
      <input x-value="name" @input="name.set($event.target.value)" placeholder="Route name" class="px-3 py-2 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-600 rounded-lg" />
      <select @change="selectedTrailId.set(Number($event.target.value))" class="px-3 py-2 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-600 rounded-lg">
        <option value="0">Choose a trail…</option>
        <template :for="trail in wl?.trails() || []"><option x-value="trail.id" :text="trail.name"></option></template>
      </select>
      <button @click="saveRoute()" class="px-5 py-2 font-semibold text-sm text-white bg-emerald-600 rounded-lg">Save route</button>
    </div>
    <p :if="message" class="mt-3 text-sm text-emerald-600">{{ message }}</p>
  </section>

  <div class="space-y-3">
    <template :for="route in routes">
      <div class="flex gap-4 items-center card">
        <div class="flex-1">
          <p class="font-semibold dark:text-white">{{ route.name }}</p>
          <p class="text-xs text-gray-500">{{ route.distance.toFixed(1) + ' mi · ' + (route.closedLoop ? 'closed loop' : 'point-to-point') }}</p>
        </div>
        <button @click="deleteRoute(route.id)" class="px-3 py-1.5 text-xs font-semibold text-red-600 border border-red-200 rounded-lg">Delete</button>
      </div>
    </template>
    <p :if="routes.length === 0" class="py-12 text-center text-gray-400">No saved routes yet.</p>
  </div>
</div>
@endsection
