<script>
interface NativeAppShellProps {
  class?: string
  tabBar?: boolean
}

const { tabBar = false } = defineProps<NativeAppShellProps>()
</script>

<script client>
import { isNativeMobile } from '@stacksjs/mobile'

const className = useReactiveProp<string>('class', '')
const nativeMobile = state(isNativeMobile())
</script>

<div
  data-native-app-shell
  class="native-app-shell"
  :class="className()"
  x-class="nativeMobile() ? 'native-mobile' : ''"
>
  <!-- The application layout owns the single <main> landmark. This shell is
       structural chrome; making it another <main> creates invalid nested
       landmarks and gives both elements the router's stx-content view-
       transition name. -->
  <div class="native-app-content">
    <slot />
  </div>
  @if(tabBar)
    <footer class="native-app-tab-slot">
      <slot name="tab-bar" />
    </footer>
  @endif
</div>
