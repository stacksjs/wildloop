<script server>
import { defineProps, withDefaults } from 'stx'

type ActivityType = 'Trail Run' | 'Hike' | 'Walk' | 'Bike'

// Can accept either a plain object or a browser model instance
interface ActivityCardProps {
  activity?: any
}

const { activity } = withDefaults(defineProps<ActivityCardProps>(), {
  activity: null
})

// Helper to get value from either plain object or model instance
function getValue(obj: any, key: string, defaultValue: any = ''): any {
  if (!obj) return defaultValue
  // Check if it's a model instance with get() method
  if (typeof obj.get === 'function') {
    return obj.get(key) ?? defaultValue
  }
  // Plain object
  return obj[key] ?? defaultValue
}

function formatNumber(num: number): string {
  return (num || 0).toLocaleString()
}

function formatDuration(seconds: number): string {
  if (!seconds || typeof seconds !== 'number') return '0:00'
  const hours = Math.floor(seconds / 3600)
  const minutes = Math.floor((seconds % 3600) / 60)
  const secs = seconds % 60
  if (hours > 0) {
    return `${hours}:${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`
  }
  return `${minutes}:${secs.toString().padStart(2, '0')}`
}

function getRelativeTime(dateString: string): string {
  if (!dateString) return 'Unknown'
  const date = new Date(dateString)
  const now = new Date()
  const diffMs = now.getTime() - date.getTime()
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60))
  const diffDays = Math.floor(diffHours / 24)

  if (diffHours < 1) return 'Just now'
  if (diffHours < 24) return `${diffHours} hour${diffHours === 1 ? '' : 's'} ago`
  if (diffDays < 7) return `${diffDays} day${diffDays === 1 ? '' : 's'} ago`
  return date.toLocaleDateString()
}

// Extract values with fallbacks
const user = getValue(activity, 'user', 'Anonymous')
const avatar = getValue(activity, 'avatar', 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&h=100&fit=crop')
const trail = getValue(activity, 'trail', 'Unknown Trail')
const activityType = getValue(activity, 'activityType', getValue(activity, 'type', 'Hike')) as ActivityType
const distance = getValue(activity, 'distance', 0)
const duration = getValue(activity, 'duration', 0)
const time = typeof duration === 'number' ? formatDuration(duration) : getValue(activity, 'time', '0:00')
const pace = getValue(activity, 'pace', '0:00')
const elevation = getValue(activity, 'elevation', 0)
const completedAt = getValue(activity, 'completedAt', '')
const date = completedAt ? getRelativeTime(completedAt) : getValue(activity, 'date', 'Unknown')
const kudos = getValue(activity, 'kudosCount', getValue(activity, 'kudos', 0))
</script>

<template>
  <div class="p-6 bg-white border border-gray-100 rounded-2xl shadow-sm hover:shadow-md transition">
    <!-- Header -->
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center space-x-3">
        <Image src="{{ avatar }}" alt="{{ user }}" width="48" height="48" sizes="48px" placeholder="blur" class="object-cover h-12 w-12 border-2 border-emerald-100 rounded-full" />
        <div>
          <p class="font-semibold text-gray-900">{{ user }}</p>
          <p class="text-gray-500 text-sm">{{ date }} · {{ activityType }}</p>
        </div>
      </div>
      <button class="text-gray-400 hover:text-gray-600">
        <Icon name="ellipsis" size="20" />
      </button>
    </div>

    <!-- Trail name -->
    <h3 class="mb-3 font-bold text-gray-900 text-lg hover:text-emerald-600 transition cursor-pointer">
      {{ trail }}
    </h3>

    <!-- Stats grid -->
    <div class="grid gap-4 grid-cols-4 mb-4">
      <div class="p-3 text-center bg-gray-50 rounded-xl">
        <p class="font-bold text-2xl text-gray-900">{{ distance }}</p>
        <p class="text-gray-500 text-xs">Miles</p>
      </div>
      <div class="p-3 text-center bg-gray-50 rounded-xl">
        <p class="font-bold text-2xl text-gray-900">{{ time }}</p>
        <p class="text-gray-500 text-xs">Time</p>
      </div>
      <div class="p-3 text-center bg-gray-50 rounded-xl">
        <p class="font-bold text-2xl text-gray-900">{{ pace }}</p>
        <p class="text-gray-500 text-xs">Pace</p>
      </div>
      <div class="p-3 text-center bg-gray-50 rounded-xl">
        <p class="font-bold text-2xl text-gray-900">{{ formatNumber(elevation) }}</p>
        <p class="text-gray-500 text-xs">Elev (ft)</p>
      </div>
    </div>

    <!-- Map preview -->
    <div class="flex items-center justify-center mb-4 h-32 rounded-xl map-preview">
      <div class="relative z-10 text-center">
        <Icon name="map" size="32" class="mb-1 mx-auto text-sky-500" />
        <p class="font-medium text-sky-600 text-sm">View Route</p>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-between pt-4 border-gray-100 border-t">
      <div class="flex items-center space-x-4">
        <button class="flex items-center space-x-2 text-gray-500 hover:text-red-500 transition">
          <Icon name="heart" size="20" />
          <span class="font-medium text-sm">{{ kudos }} Kudos</span>
        </button>
        <button class="flex items-center space-x-2 text-gray-500 hover:text-emerald-500 transition">
          <Icon name="message-circle" size="20" />
          <span class="font-medium text-sm">Comment</span>
        </button>
      </div>
      <button class="text-gray-400 hover:text-gray-600 transition">
        <Icon name="share-2" size="20" />
      </button>
    </div>
  </div>
</template>
