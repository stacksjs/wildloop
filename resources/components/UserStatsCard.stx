<script server>
import { defineProps, withDefaults } from 'stx'

interface UserStats {
  totalDistance: number
  totalTime: string
  totalElevation: number
  trailsCompleted: number
  currentStreak: number
  longestStreak: number
}

interface UserStatsCardProps {
  stats?: UserStats
}

const defaultStats: UserStats = {
  totalDistance: 0,
  totalTime: '0h 0m',
  totalElevation: 0,
  trailsCompleted: 0,
  currentStreak: 0,
  longestStreak: 0
}

const { stats } = withDefaults(defineProps<UserStatsCardProps>(), {
  stats: defaultStats
})

function formatNumber(num: number): string {
  return num.toLocaleString()
}
</script>

<template>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6 dark:border-slate-700 dark:bg-slate-800 dark:shadow-none">
    <h3 class="mb-4 flex items-center gap-2 font-display text-lg font-bold text-slate-900 dark:text-white">
      <Icon name="bar-chart-3" size="20" class="text-emerald-600 dark:text-emerald-400" />
      Your stats
    </h3>
    <div class="space-y-3">
      <div class="flex items-center justify-between rounded-xl bg-emerald-50 p-4 dark:bg-emerald-500/10">
        <div>
          <p class="font-display text-3xl font-bold tabular-nums text-emerald-700 dark:text-emerald-300">{{ stats.totalDistance }}</p>
          <p class="text-sm text-emerald-700/80 dark:text-emerald-400/80">Total miles</p>
        </div>
        <Icon name="trending-up" size="32" class="text-emerald-300 dark:text-emerald-500/50" />
      </div>
      <dl class="grid grid-cols-2 gap-3">
        <div class="rounded-xl bg-slate-50 p-3 dark:bg-slate-900/60">
          <dd class="text-lg font-bold tabular-nums text-slate-900 dark:text-white">{{ stats.totalTime }}</dd>
          <dt class="metric-label mt-0.5">Time active</dt>
        </div>
        <div class="rounded-xl bg-slate-50 p-3 dark:bg-slate-900/60">
          <dd class="text-lg font-bold tabular-nums text-slate-900 dark:text-white">{{ formatNumber(stats.totalElevation) }}</dd>
          <dt class="metric-label mt-0.5">Elevation ft</dt>
        </div>
        <div class="rounded-xl bg-slate-50 p-3 dark:bg-slate-900/60">
          <dd class="text-lg font-bold tabular-nums text-slate-900 dark:text-white">{{ stats.trailsCompleted }}</dd>
          <dt class="metric-label mt-0.5">Trails done</dt>
        </div>
        <div class="rounded-xl bg-slate-50 p-3 dark:bg-slate-900/60">
          <dd class="flex items-center gap-1 text-lg font-bold tabular-nums text-slate-900 dark:text-white"><Icon name="flame" size="16" class="text-orange-500" />{{ stats.currentStreak }}</dd>
          <dt class="metric-label mt-0.5">Day streak</dt>
        </div>
      </dl>
    </div>
  </div>
</template>
