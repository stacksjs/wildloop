<script server>
import { defineProps, withDefaults } from 'stx'

interface TerritoryStatsCardProps {
  totalTerritoriesOwned?: number
  totalAreaOwned?: number
  territoriesClaimed?: number
  territoriesConquered?: number
  territoriesLost?: number
  territoriesDefended?: number
  weeklyRank?: number
  allTimeRank?: number
}

const props = withDefaults(defineProps<TerritoryStatsCardProps>(), {
  totalTerritoriesOwned: 0,
  totalAreaOwned: 0,
  territoriesClaimed: 0,
  territoriesConquered: 0,
  territoriesLost: 0,
  territoriesDefended: 0,
  weeklyRank: 999,
  allTimeRank: 999
})

function formatArea(sqMeters: number): string {
  if (sqMeters >= 1000000) {
    return `${(sqMeters / 1000000).toFixed(2)} km²`
  } else if (sqMeters >= 10000) {
    return `${(sqMeters / 10000).toFixed(1)} ha`
  }
  return `${Math.round(sqMeters).toLocaleString()} m²`
}
</script>

<template>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6 dark:border-slate-700 dark:bg-slate-800 dark:shadow-none">
    <h3 class="mb-4 flex items-center gap-2 font-display text-lg font-bold text-slate-900 dark:text-white">
      <Icon name="globe" size="20" class="text-emerald-600 dark:text-emerald-400" />
      Your territory empire
    </h3>

    <!-- Main Stats -->
    <dl class="mb-5 grid grid-cols-2 gap-3">
      <div class="rounded-xl bg-emerald-50 p-4 dark:bg-emerald-500/10">
        <dt class="metric-label">Territories</dt>
        <dd class="mt-1 font-display text-3xl font-bold tabular-nums text-slate-900 dark:text-white">{{ props.totalTerritoriesOwned }}</dd>
        <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">currently held</p>
      </div>
      <div class="rounded-xl bg-slate-50 p-4 dark:bg-slate-900/60">
        <dt class="metric-label">Total area</dt>
        <dd class="mt-1 font-display text-2xl font-bold tabular-nums text-slate-900 dark:text-white">{{ formatArea(props.totalAreaOwned) }}</dd>
        <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">controlled</p>
      </div>
    </dl>

    <!-- Detailed Stats -->
    <dl class="divide-y divide-slate-100 dark:divide-slate-700/70">
      <div class="flex min-h-11 items-center justify-between">
        <dt class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
          <Icon name="check-circle" size="16" class="text-emerald-500" />
          Territories claimed
        </dt>
        <dd class="font-semibold tabular-nums text-slate-900 dark:text-white">{{ props.territoriesClaimed }}</dd>
      </div>
      <div class="flex min-h-11 items-center justify-between">
        <dt class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
          <Icon name="flame" size="16" class="text-orange-500" />
          Territories conquered
        </dt>
        <dd class="font-semibold tabular-nums text-slate-900 dark:text-white">{{ props.territoriesConquered }}</dd>
      </div>
      <div class="flex min-h-11 items-center justify-between">
        <dt class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
          <Icon name="shield" size="16" class="text-emerald-500" />
          Successfully defended
        </dt>
        <dd class="font-semibold tabular-nums text-slate-900 dark:text-white">{{ props.territoriesDefended }}</dd>
      </div>
      <div class="flex min-h-11 items-center justify-between">
        <dt class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
          <Icon name="x-circle" size="16" class="text-red-500" />
          Territories lost
        </dt>
        <dd class="font-semibold tabular-nums text-slate-900 dark:text-white">{{ props.territoriesLost }}</dd>
      </div>
    </dl>

    <!-- Rankings -->
    <dl class="mt-5 grid grid-cols-2 divide-x divide-slate-100 rounded-xl bg-slate-50 py-3 text-center dark:divide-slate-700 dark:bg-slate-900/60">
      <div>
        <dt class="metric-label">Weekly rank</dt>
        <dd class="mt-0.5 font-display text-2xl font-bold tabular-nums text-slate-900 dark:text-white">#{{ props.weeklyRank }}</dd>
      </div>
      <div>
        <dt class="metric-label">All-time rank</dt>
        <dd class="mt-0.5 font-display text-2xl font-bold tabular-nums text-slate-900 dark:text-white">#{{ props.allTimeRank }}</dd>
      </div>
    </dl>
  </div>
</template>
