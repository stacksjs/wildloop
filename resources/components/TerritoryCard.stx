<script server>
import { defineProps, withDefaults } from 'stx'

interface TerritoryCardProps {
  id?: number
  name?: string
  ownerName?: string
  ownerAvatar?: string
  areaSize?: number
  conquestCount?: number
  claimedAt?: string
  isOwned?: boolean
}

const props = withDefaults(defineProps<TerritoryCardProps>(), {
  id: 1,
  name: 'Downtown Territory',
  ownerName: 'Unknown',
  ownerAvatar: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&h=100&fit=crop',
  areaSize: 25000,
  conquestCount: 3,
  claimedAt: '2 days ago',
  isOwned: false
})

// Format area size for display
function formatArea(sqMeters: number): string {
  if (sqMeters >= 1000000) {
    return `${(sqMeters / 1000000).toFixed(2)} km²`
  } else if (sqMeters >= 10000) {
    return `${(sqMeters / 10000).toFixed(2)} ha`
  }
  return `${sqMeters.toLocaleString()} m²`
}

const formattedArea = formatArea(props.areaSize)
</script>

<template>
  <div class="territory-card overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:shadow-lg dark:border-slate-700 dark:bg-slate-800 dark:shadow-none" x-class="props.isOwned ? 'ring-2 ring-emerald-500' : ''">
    <!-- Territory Preview Map -->
    <div class="relative h-32 bg-gradient-to-br from-emerald-100 to-teal-50 dark:from-emerald-500/15 dark:to-slate-800">
      <div class="absolute inset-0 grid place-items-center">
        <i class="i-lucide-map-pin h-14 w-14 text-emerald-300 dark:text-emerald-500/50" aria-hidden="true"></i>
      </div>
      @if(props.isOwned)
        <div class="absolute right-2 top-2 rounded-full bg-emerald-600 px-2.5 py-1 text-[11px] font-semibold text-white">
          Your territory
        </div>
      @endif
      @if(props.conquestCount > 0)
        <div class="absolute left-2 top-2 flex items-center gap-1 rounded-full bg-orange-500 px-2.5 py-1 text-[11px] font-semibold text-white">
          <Icon name="flame" size="12" />
          <span class="tabular-nums">{{ props.conquestCount }}× conquered</span>
        </div>
      @endif
    </div>

    <!-- Territory Info -->
    <div class="p-4">
      <h3 class="mb-2 truncate font-display text-lg font-bold text-slate-900 dark:text-white">{{ props.name }}</h3>

      <div class="mb-3 flex items-center gap-2">
        <Image x-src="props.ownerAvatar" x-alt="props.ownerName" width="24" height="24" sizes="24px" placeholder="blur" class="h-6 w-6 rounded-full object-cover" />
        <span class="truncate text-sm text-slate-600 dark:text-slate-400">Owned by <span class="font-medium text-slate-900 dark:text-white">{{ props.ownerName }}</span></span>
      </div>

      <dl class="grid grid-cols-2 gap-2 text-sm">
        <div class="rounded-xl bg-slate-50 p-2.5 dark:bg-slate-900/60">
          <dt class="metric-label">Area</dt>
          <dd class="mt-0.5 font-semibold tabular-nums text-slate-900 dark:text-white">{{ formattedArea }}</dd>
        </div>
        <div class="rounded-xl bg-slate-50 p-2.5 dark:bg-slate-900/60">
          <dt class="metric-label">Claimed</dt>
          <dd class="mt-0.5 font-semibold text-slate-900 dark:text-white">{{ props.claimedAt }}</dd>
        </div>
      </dl>

      <StxLink x-to="'/territory/' + props.id" class="mt-4 flex min-h-11 w-full items-center justify-center gap-2 rounded-full bg-emerald-600 font-semibold text-white transition hover:bg-emerald-700 active:scale-[0.98]">
        <Icon name="map" size="16" />
        View on map
      </StxLink>
    </div>
  </div>
</template>
