<script server>
import { defineProps, withDefaults } from 'stx'

interface Achievement {
  name: string
  icon: string
  description: string
  progress: number
  total: number
}

interface AchievementProgressProps {
  achievement?: Achievement
}

const defaultAchievement: Achievement = {
  name: 'Achievement',
  icon: '🏆',
  description: 'Complete this achievement',
  progress: 0,
  total: 100
}

const { achievement } = withDefaults(defineProps<AchievementProgressProps>(), {
  achievement: defaultAchievement
})

// Precompute the bar width once (clamped 0-100) rather than interpolating an
// arithmetic expression inside the style attribute, which renders unreliably.
const pct = Math.max(0, Math.min(100, Math.round((achievement.progress / (achievement.total || 1)) * 100)))
</script>

<template>
  <div class="rounded-xl bg-slate-50 p-3 dark:bg-slate-900/60">
    <div class="mb-2 flex items-center gap-3">
      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white text-xl shadow-sm dark:bg-slate-800" aria-hidden="true">{{ achievement.icon }}</span>
      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-semibold text-slate-900 dark:text-white">{{ achievement.name }}</p>
        <p class="truncate text-xs text-slate-500 dark:text-slate-400">{{ achievement.description }}</p>
      </div>
      <p class="shrink-0 text-xs font-semibold tabular-nums text-slate-500 dark:text-slate-400">{{ achievement.progress }}/{{ achievement.total }}</p>
    </div>
    <div class="relative h-2 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700">
      <div class="absolute left-0 top-0 h-full rounded-full bg-emerald-500 transition-all" style="width: {{ pct }}%"></div>
    </div>
  </div>
</template>
