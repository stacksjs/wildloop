<script client>
  import { currentUser, initializeAuthSession, signOut, token } from '../assets/scripts/auth'

  const mobileOpen = state(false)
  const accountOpen = state(false)

  // Signed-in state is the presence of the bearer token the browser auth
  // client stores. Server rendering has no token, so the signed-out nav is
  // also the right first paint for a visitor who has never signed in.
  //
  // Declared plainly at the top level. The previous shape wrapped these in
  // `if (typeof x === 'undefined') var x = …` to guard against a double
  // include — but stx only lifts declarations it finds at the top level of the
  // script, and a `var` inside an `if` is not one. Every `:if` that read them
  // therefore resolved against an undefined name and silently dropped its
  // element, which is why the navbar showed no Log in, no Sign up, and no
  // account menu to anybody.
  const signedIn = state(false)
  const accountName = state('')
  const accountInitial = state('·')

  // Offer the Admin link only to an admin. Presentation only: the dashboard
  // and its endpoint both re-check the role server-side, so a visitor who
  // edits this flag in devtools gains a link that refuses them.
  const isAdmin = state(false)

  function applyAccount() {
    signedIn.set(!!token())
    const account = currentUser()
    const source = (account?.name || account?.email || '').trim()
    accountName.set(account?.name?.trim() || source)
    accountInitial.set(source ? source.charAt(0).toUpperCase() : '·')
    isAdmin.set(Array.isArray(account?.roles) && account.roles.includes('admin'))
  }

  async function handleSignOut() {
    accountOpen.set(false)
    await signOut()
    applyAccount()
    navigate('/')
  }

  /**
   * Whether the bar is currently drawn over a photograph.
   *
   * A page whose first element is a full-bleed image wants the nav to be part
   * of that image, not a white strip cutting the top off it. But the moment
   * you scroll, the bar is over ordinary page content and has to become opaque
   * or it is unreadable. So it is two states, not one, and the switch is
   * scroll position.
   *
   * The page opts in by marking the element the bar sits over with
   * `data-nav-overlay`; a page without one (every catalog and list screen) is
   * simply always in the solid state. Detecting it rather than hardcoding "the
   * homepage" means a second hero page gets the behaviour for free, and a page
   * that loses its hero cannot leave the nav invisible over white.
   */
  const overHero = state(false)
  const atTop = state(true)

  const navClear = derived(() => overHero() && atTop())

  function detectHero() {
    overHero.set(!!document.querySelector('[data-nav-overlay]'))
  }

  function onScroll() {
    // A few pixels of tolerance: elastic scroll on macOS reports fractional
    // negative offsets, and a threshold of exactly 0 makes the bar flicker.
    atTop.set((globalThis.scrollY || 0) <= 8)
  }

  onMount(() => {
    applyAccount()
    void initializeAuthSession().then(applyAccount)
    // A native sign-in resolves out of the Keychain after first paint.
    globalThis.addEventListener('wildloop:auth-ready', applyAccount)

    detectHero()
    onScroll()
    globalThis.addEventListener('scroll', onScroll, { passive: true })
    // The client router swaps the contents of `main` and leaves this bar in
    // place, so the hero can appear or disappear underneath it without a page
    // load. Re-check when it does.
    globalThis.addEventListener('stx:swap-complete', detectHero)
    globalThis.addEventListener('stx:load', detectHero)
  })

  onDestroy(() => {
    globalThis.removeEventListener('wildloop:auth-ready', applyAccount)
    globalThis.removeEventListener('scroll', onScroll)
    globalThis.removeEventListener('stx:swap-complete', detectHero)
    globalThis.removeEventListener('stx:load', detectHero)
  })
</script>

<!--
  The solid appearance stays in the static `class`, and the transparent state
  is one class that overrides it. Putting the solid utilities in `x-class`
  instead looked tidier and did not work: the CSS scanner only reads literal
  class attributes, so `bg-white/90` was never generated and the bar stayed
  see-through over the page it had scrolled onto.
-->
<nav
  x-class="navClear() ? 'wl-nav-clear' : ''"
  class="wl-nav sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur-xl transition-colors duration-300 dark:border-slate-700 dark:bg-slate-900/90">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-14 items-center justify-between">

      <div class="flex items-center gap-6">
        <StxLink to="/" class="flex items-center gap-2" aria-label="WildLoop home">
          <!-- Brand mark: a closed ring with the runner's position on it.
               Pure CSS on purpose, so the wordmark never depends on icon
               resolution the way the rest of the UI's glyphs do. -->
          <BrandMark />
          <span class="text-sm font-bold tracking-wide">WILDLOOP</span>
        </StxLink>

        <div class="hidden items-center gap-1 xl:flex">
          <StxLink to="/trails" activeClass="nav-active" class="rounded px-3 py-2 text-sm font-medium text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">Trails</StxLink>
          <StxLink to="/feed" activeClass="nav-active" class="rounded px-3 py-2 text-sm font-medium text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">Feed</StxLink>
          <StxLink to="/events" activeClass="nav-active" class="rounded px-3 py-2 text-sm font-medium text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">Events</StxLink>
          <StxLink to="/territories" activeClass="nav-active" class="rounded px-3 py-2 text-sm font-medium text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">Territory</StxLink>
          <StxLink to="/records" activeClass="nav-active" class="rounded px-3 py-2 text-sm font-medium text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">Records</StxLink>
          <StxLink to="/leaderboard" activeClass="nav-active" class="rounded px-3 py-2 text-sm font-medium text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">Leaderboard</StxLink>
          <StxLink to="/clubs" activeClass="nav-active" class="rounded px-3 py-2 text-sm font-medium text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">Clubs</StxLink>
        </div>
      </div>

      <div class="hidden items-center gap-2 xl:flex">
        <button @click="useDark().toggle()" aria-label="Toggle dark mode" class="rounded-lg p-2 text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">
          <Icon name="moon" size="18" class="dark:hidden" />
          <Icon name="sun" size="18" class="hidden dark:inline" />
        </button>

        <!-- Signed out: the job is to get someone in, not to ask them to record
             an activity they have not started. -->
        <div :if="!signedIn" class="flex items-center gap-1">
          <StxLink to="/login" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white">Log in</StxLink>
          <StxLink to="/register" class="wl-nav-cta rounded-full bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-emerald-700 active:scale-[0.98]">Sign up</StxLink>
        </div>

        <!-- Signed in: recording is a real intent now, but it stays secondary
             to the account, which is what people reach for most often. -->
        <div :if="signedIn" class="flex items-center gap-2">
          <StxLink to="/record" class="rounded-full border border-slate-300 px-3.5 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 active:scale-[0.98] dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Record</StxLink>
          <StxLink to="/notifications" aria-label="Alerts" class="relative rounded-lg p-2 text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">
            <Icon name="bell" size="20" />
            <span class="absolute right-1 top-1 h-2 w-2 rounded-full bg-emerald-500"></span>
          </StxLink>

          <div class="relative">
            <button
              @click="accountOpen.set(!accountOpen())"
              :aria-expanded="accountOpen"
              aria-haspopup="menu"
              class="flex items-center gap-2 rounded-full border border-slate-300 py-1 pl-1 pr-3 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
            >
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white" aria-hidden="true">{{ accountInitial }}</span>
              Account
              <i class="i-lucide-chevron-down h-3.5 w-3.5" aria-hidden="true"></i>
            </button>

            <div :show="accountOpen()" x-cloak role="menu" class="absolute right-0 z-50 mt-2 w-56 overflow-hidden rounded-2xl border border-slate-200 bg-white py-1.5 shadow-xl dark:border-slate-700 dark:bg-slate-800">
              <p class="truncate px-4 pb-2 pt-1.5 text-xs text-slate-400 dark:text-slate-500">{{ accountName || 'Signed in' }}</p>
              <StxLink to="/profile" role="menuitem" @click="accountOpen.set(false)" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700/60">Profile</StxLink>
              <StxLink to="/stats" role="menuitem" @click="accountOpen.set(false)" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700/60">Stats</StxLink>
              <StxLink to="/settings" role="menuitem" @click="accountOpen.set(false)" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700/60">Settings</StxLink>
              <StxLink :if="isAdmin" to="/admin" role="menuitem" @click="accountOpen.set(false)" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700/60">Admin</StxLink>
              <div class="my-1.5 border-t border-slate-100 dark:border-slate-700"></div>
              <button @click="handleSignOut()" role="menuitem" class="block w-full px-4 py-2 text-left text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700/60">Log out</button>
            </div>
          </div>
        </div>
      </div>

      <button class="p-2 text-slate-500 xl:hidden dark:text-slate-400" @click="mobileOpen.set(!mobileOpen())" aria-label="Menu">
        <Icon :show="!mobileOpen()" name="menu" size="24" />
        <Icon :show="mobileOpen()" name="x" size="24" />
      </button>
    </div>

    <div :show="mobileOpen()" x-cloak class="space-y-1 pb-4 xl:hidden">
      <StxLink to="/trails" class="block rounded px-3 py-2 text-sm text-slate-500 dark:text-slate-400">Trails</StxLink>
      <StxLink to="/feed" class="block rounded px-3 py-2 text-sm text-slate-500 dark:text-slate-400">Feed</StxLink>
      <StxLink to="/events" class="block rounded px-3 py-2 text-sm text-slate-500 dark:text-slate-400">Events</StxLink>
      <StxLink to="/territories" class="block rounded px-3 py-2 text-sm text-slate-500 dark:text-slate-400">Territory</StxLink>
      <StxLink to="/records" class="block rounded px-3 py-2 text-sm text-slate-500 dark:text-slate-400">Records</StxLink>
      <StxLink to="/leaderboard" class="block rounded px-3 py-2 text-sm text-slate-500 dark:text-slate-400">Leaderboard</StxLink>
      <StxLink to="/clubs" class="block rounded px-3 py-2 text-sm text-slate-500 dark:text-slate-400">Clubs</StxLink>

      <div :if="!signedIn" class="space-y-1 pt-2">
        <StxLink to="/login" class="block rounded px-3 py-2 text-sm text-slate-600 dark:text-slate-400">Log in</StxLink>
        <StxLink to="/register" class="mt-1 block rounded-full bg-emerald-600 px-4 py-2.5 text-center text-sm font-semibold text-white">Sign up</StxLink>
      </div>

      <div :if="signedIn" class="space-y-1 pt-2">
        <StxLink to="/record" class="block rounded px-3 py-2 text-sm font-medium text-emerald-700 dark:text-emerald-400">Record an activity</StxLink>
        <StxLink to="/stats" class="block rounded px-3 py-2 text-sm text-slate-600 dark:text-slate-400">Stats</StxLink>
        <StxLink to="/notifications" class="block rounded px-3 py-2 text-sm text-slate-600 dark:text-slate-400">Alerts</StxLink>
        <StxLink to="/profile" class="block rounded px-3 py-2 text-sm text-slate-600 dark:text-slate-400">Account</StxLink>
        <StxLink :if="isAdmin" to="/admin" class="block rounded px-3 py-2 text-sm font-medium text-emerald-700 dark:text-emerald-400">Admin</StxLink>
        <button @click="handleSignOut()" class="block w-full rounded px-3 py-2 text-left text-sm text-slate-600 dark:text-slate-400">Log out</button>
      </div>
    </div>
  </div>
</nav>

<style>
  /*
   * The transparent state.
   *
   * Only the colours change — layout, height and stickiness are identical in
   * both states, so the switch is a cross-fade rather than a jump that shifts
   * the page under the pointer.
   *
   * Everything inside inherits white, including the links' hover colour and
   * the dark-mode variants the utility classes set: over a photograph there is
   * no light or dark mode, there is only the photograph. `!important` is
   * needed for exactly that reason — these are overriding utilities that are
   * doing their job correctly in every other context.
   */
  .wl-nav-clear {
    background: transparent !important;
    border-bottom-color: transparent !important;
    backdrop-filter: none !important;
  }

  .wl-nav-clear a,
  .wl-nav-clear button,
  .wl-nav-clear span {
    color: #fff !important;
  }

  /* The two calls to action keep their fills: they are the point of the bar
     for a signed-out visitor, and a white ghost button on a bright sky is
     an invitation nobody can see. */
  .wl-nav-clear .wl-nav-cta {
    color: #fff !important;
    background: #059669 !important;
  }

  .wl-nav-clear .wl-nav-cta:hover {
    background: #047857 !important;
  }

  /* A photograph can be bright anywhere, so the type carries its own contrast
     rather than relying on the scrim underneath it. */
  .wl-nav-clear a,
  .wl-nav-clear button {
    text-shadow: 0 1px 12px rgb(4 12 10 / 45%);
  }

  .wl-nav-clear .wl-nav-cta {
    text-shadow: none;
  }
</style>
