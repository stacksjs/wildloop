<script client>
  import { watchScrolled } from '../composables/watchScrolled'
  import { requestRecordingExit } from '../assets/scripts/recording-navigation'
  const mobileOpen = state(false)
  const accountOpen = state(false)

  // Who is signed in comes from the shared store, which the layout fills from
  // the session. Importing the auth client here instead put a copy of it (and
  // of the whole native bridge) into this bundle on every page
  // (stacksjs/stx#1957). Server rendering has no session, so the signed-out
  // nav is also the right first paint for a visitor who has never signed in.
  //
  // Declared plainly at the top level: stx only lifts declarations it finds at
  // the top level of the script, and an earlier `if (…) var x = …` guard hid
  // them from every `:if`, which dropped Log in, Sign up and the account
  // menu for everybody.
  const wl = useStore('wl')
  const account = derived(() => (wl && wl.currentUserId() > 0 ? wl.currentUser() : null))
  const signedIn = derived(() => account() !== null)
  const accountName = derived(() => (account()?.name || account()?.email || '').trim())
  const accountInitial = derived(() => accountName().charAt(0).toUpperCase() || '·')

  // Offer the Admin link only to an admin. Presentation only: the dashboard
  // and its endpoint both re-check the role server-side, so a visitor who
  // edits this flag in devtools gains a link that refuses them.
  const isAdmin = derived(() => Boolean(account()?.roles?.includes('admin')))
  // The alerts dot was unconditional markup, so it lit up for every signed-in
  // account regardless of whether anything was unread. Bind it to the count
  // the layout keeps in the store.
  const unreadCount = derived(() => (signedIn() ? wl.unreadCount() : 0))

  async function handleSignOut() {
    if (!requestRecordingExit()) return
    accountOpen.set(false)
    await wl?.signOut()
    navigate('/')
  }

  // Over a page that opens on a full-bleed photograph, the bar is part of the
  // photograph until the first scroll, then turns into the usual solid bar —
  // over ordinary content a transparent one is unreadable. Which pages have
  // such a photograph is decided in CSS (see the style block below), so this
  // only tracks the scroll. Started from this component's own onMount — see
  // watchScrolled for why the listener cannot come from a composable's.
  const scrolled = state(false)
  let stopWatchingScroll = null

  onMount(() => {
    stopWatchingScroll = watchScrolled(value => scrolled.set(value))
  })

  onDestroy(() => {
    stopWatchingScroll?.()
    stopWatchingScroll = null
  })
</script>

<!--
  The solid look stays in the static `class`; the transparent one is a CSS
  override. Putting the solid utilities in `x-class` instead does not work: the
  CSS scanner only reads literal class attributes, so they would never be
  generated. `wl-nav-scrolled` is the state that switches it off.
-->
<nav
  x-class="scrolled() ? 'wl-nav-scrolled' : ''"
  class="wl-nav sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur-xl transition-colors duration-300 dark:border-slate-700 dark:bg-slate-900/90">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-14 items-center justify-between">

      <div class="flex items-center gap-6">
        <StxLink to="/" class="flex items-center gap-2" aria-label="Wildloop home">
          <!-- Brand mark: a closed ring with the runner's position on it.
               Pure CSS on purpose, so the wordmark never depends on icon
               resolution the way the rest of the UI's glyphs do. -->
          <BrandMark />
          <span class="text-sm font-bold tracking-wide">WILDLOOP</span>
        </StxLink>

        <div class="hidden items-center gap-0.5 lg:flex">
          <StxLink to="/trails" activeClass="nav-active" class="rounded-full px-3 py-2 text-sm font-medium text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">Trails</StxLink>
          <StxLink to="/feed" activeClass="nav-active" class="rounded-full px-3 py-2 text-sm font-medium text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">Feed</StxLink>
          <StxLink to="/events" activeClass="nav-active" class="rounded-full px-3 py-2 text-sm font-medium text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">Events</StxLink>
          <StxLink to="/clubs" activeClass="nav-active" class="rounded-full px-3 py-2 text-sm font-medium text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">Clubs</StxLink>

          <!-- The competitive surfaces, grouped. Seven top-level links made
               the bar read as a sitemap; these four share one idea — who is
               fastest, and who holds the ground — so they share one menu.
               Opened by hover or focus in CSS rather than a signal, so it
               works before hydration and from the keyboard, and the trigger
               lights up whenever one of its pages is the current one. -->
          <div class="wl-more relative">
            <button type="button" aria-haspopup="menu" class="wl-more-trigger flex items-center gap-1 rounded-full px-3 py-2 text-sm font-medium text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">
              Compete
              <i class="wl-more-chevron i-lucide-chevron-down h-3.5 w-3.5 transition-transform" aria-hidden="true"></i>
            </button>
            <div role="menu" class="wl-more-panel absolute left-0 top-full z-50 w-72 pt-2">
              <div class="rounded-2xl border border-slate-200 bg-white p-1.5 shadow-xl dark:border-slate-700 dark:bg-slate-800">
              <StxLink to="/records" activeClass="nav-active" role="menuitem" class="wl-more-item flex items-start gap-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-slate-50 dark:hover:bg-slate-700/50">
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400"><i class="i-lucide-timer h-4 w-4" aria-hidden="true"></i></span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-slate-900 dark:text-white">Records</span>
                  <span class="block text-xs leading-snug text-slate-500 dark:text-slate-400">Fastest known times, and who is out on course now</span>
                </span>
              </StxLink>
              <StxLink to="/territories" activeClass="nav-active" role="menuitem" class="wl-more-item flex items-start gap-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-slate-50 dark:hover:bg-slate-700/50">
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400"><i class="i-lucide-flag h-4 w-4" aria-hidden="true"></i></span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-slate-900 dark:text-white">Territory</span>
                  <span class="block text-xs leading-snug text-slate-500 dark:text-slate-400">Close a loop to claim the ground inside it</span>
                </span>
              </StxLink>
              <StxLink to="/leaderboard" activeClass="nav-active" role="menuitem" class="wl-more-item flex items-start gap-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-slate-50 dark:hover:bg-slate-700/50">
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400"><i class="i-lucide-trophy h-4 w-4" aria-hidden="true"></i></span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-slate-900 dark:text-white">Leaderboard</span>
                  <span class="block text-xs leading-snug text-slate-500 dark:text-slate-400">Distance, climbing and land held, ranked</span>
                </span>
              </StxLink>
              <StxLink to="/challenges" activeClass="nav-active" role="menuitem" class="wl-more-item flex items-start gap-3 rounded-xl px-3 py-2.5 transition-colors hover:bg-slate-50 dark:hover:bg-slate-700/50">
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400"><i class="i-lucide-swords h-4 w-4" aria-hidden="true"></i></span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-slate-900 dark:text-white">Challenges</span>
                  <span class="block text-xs leading-snug text-slate-500 dark:text-slate-400">Head-to-head fights over a parcel</span>
                </span>
              </StxLink>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="hidden items-center gap-2 lg:flex">
        <button @click="useDark().toggle()" aria-label="Toggle dark mode" class="rounded-lg p-2 text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">
          <Icon name="moon" size="18" class="dark:hidden" />
          <Icon name="sun" size="18" class="hidden dark:inline" />
        </button>

        <!-- Signed out: the job is to get someone in, not to ask them to record
             an activity they have not started. -->
        <div :if="!signedIn" class="flex items-center gap-1">
          <StxLink to="/login" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white">Log in</StxLink>
          <StxLink to="/register" class="wl-nav-cta rounded-full bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-emerald-700 active:scale-[0.98]">Sign up</StxLink>
        </div>

        <!-- Signed in: recording is a real intent now, but it stays secondary
             to the account, which is what people reach for most often. -->
        <div :if="signedIn" class="flex items-center gap-2">
          <StxLink to="/record" class="rounded-full border border-slate-300 px-3.5 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 active:scale-[0.98] dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">Record</StxLink>
          <StxLink to="/notifications" aria-label="Alerts" class="relative rounded-lg p-2 text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">
            <Icon name="bell" size="20" />
            <span :if="unreadCount() > 0" class="absolute right-1 top-1 h-2 w-2 rounded-full bg-emerald-500"></span>
          </StxLink>

          <div class="relative">
            <button
              @click="accountOpen.set(!accountOpen())"
              :aria-expanded="accountOpen"
              aria-haspopup="menu"
              class="flex items-center gap-2 rounded-full border border-slate-300 py-1 pl-1 pr-3 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
            >
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-600 text-xs font-bold text-white" aria-hidden="true">{{ accountInitial }}</span>
              Account
              <i class="i-lucide-chevron-down h-3.5 w-3.5" aria-hidden="true"></i>
            </button>

            <div :show="accountOpen()" x-cloak role="menu" class="wl-account-menu absolute right-0 z-50 mt-2 w-56 overflow-hidden rounded-2xl border border-slate-200 bg-white py-1.5 shadow-xl dark:border-slate-700 dark:bg-slate-800">
              <p class="truncate px-4 pb-2 pt-1.5 text-xs text-slate-400 dark:text-slate-500">{{ accountName || 'Signed in' }}</p>
              <StxLink to="/profile" role="menuitem" @click="accountOpen.set(false)" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700/60">Profile</StxLink>
              <StxLink to="/trails?list=saved" role="menuitem" @click="accountOpen.set(false)" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700/60">Saved trails</StxLink>
              <StxLink to="/trails?list=completed" role="menuitem" @click="accountOpen.set(false)" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700/60">Completed trails</StxLink>
              <StxLink to="/stats" role="menuitem" @click="accountOpen.set(false)" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700/60">Stats</StxLink>
              <StxLink to="/settings" role="menuitem" @click="accountOpen.set(false)" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700/60">Settings</StxLink>
              <StxLink :if="isAdmin" to="/admin" role="menuitem" @click="accountOpen.set(false)" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700/60">Admin</StxLink>
              <div class="my-1.5 border-t border-slate-100 dark:border-slate-700"></div>
              <button @click="handleSignOut()" role="menuitem" class="block w-full px-4 py-2 text-left text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700/60">Log out</button>
            </div>
          </div>
        </div>
      </div>

      <button class="p-2 text-slate-500 lg:hidden dark:text-slate-400" @click="mobileOpen.set(!mobileOpen())" aria-label="Menu">
        <Icon :show="!mobileOpen()" name="menu" size="24" />
        <Icon :show="mobileOpen()" name="x" size="24" />
      </button>
    </div>

    <div :show="mobileOpen()" x-cloak class="space-y-1 pb-4 lg:hidden">
      <StxLink to="/trails" class="block rounded px-3 py-2 text-sm text-slate-500 dark:text-slate-400">Trails</StxLink>
      <StxLink to="/feed" class="block rounded px-3 py-2 text-sm text-slate-500 dark:text-slate-400">Feed</StxLink>
      <StxLink to="/events" class="block rounded px-3 py-2 text-sm text-slate-500 dark:text-slate-400">Events</StxLink>
      <StxLink to="/territories" class="block rounded px-3 py-2 text-sm text-slate-500 dark:text-slate-400">Territory</StxLink>
      <StxLink to="/records" class="block rounded px-3 py-2 text-sm text-slate-500 dark:text-slate-400">Records</StxLink>
      <StxLink to="/leaderboard" class="block rounded px-3 py-2 text-sm text-slate-500 dark:text-slate-400">Leaderboard</StxLink>
      <StxLink to="/challenges" class="block rounded px-3 py-2 text-sm text-slate-500 dark:text-slate-400">Challenges</StxLink>
      <StxLink to="/clubs" class="block rounded px-3 py-2 text-sm text-slate-500 dark:text-slate-400">Clubs</StxLink>

      <div :if="!signedIn" class="space-y-1 pt-2">
        <StxLink to="/login" class="block rounded px-3 py-2 text-sm text-slate-600 dark:text-slate-400">Log in</StxLink>
        <StxLink to="/register" class="mt-1 block rounded-full bg-emerald-600 px-4 py-2.5 text-center text-sm font-semibold text-white">Sign up</StxLink>
      </div>

      <div :if="signedIn" class="space-y-1 pt-2">
        <StxLink to="/record" class="block rounded px-3 py-2 text-sm font-medium text-emerald-700 dark:text-emerald-400">Record an activity</StxLink>
        <StxLink to="/trails?list=saved" class="block rounded px-3 py-2 text-sm text-slate-600 dark:text-slate-400">Saved trails</StxLink>
        <StxLink to="/trails?list=completed" class="block rounded px-3 py-2 text-sm text-slate-600 dark:text-slate-400">Completed trails</StxLink>
        <StxLink to="/stats" class="block rounded px-3 py-2 text-sm text-slate-600 dark:text-slate-400">Stats</StxLink>
        <StxLink to="/notifications" class="block rounded px-3 py-2 text-sm text-slate-600 dark:text-slate-400">Alerts</StxLink>
        <StxLink to="/profile" class="block rounded px-3 py-2 text-sm text-slate-600 dark:text-slate-400">Account</StxLink>
        <StxLink :if="isAdmin" to="/admin" class="block rounded px-3 py-2 text-sm font-medium text-emerald-700 dark:text-emerald-400">Admin</StxLink>
        <button @click="handleSignOut()" class="block w-full rounded px-3 py-2 text-left text-sm text-slate-600 dark:text-slate-400">Log out</button>
      </div>
    </div>
  </div>
</nav>

<style>
  /*
   * Transparent over a hero photograph, until the first scroll.
   *
   * A page opts in by marking the element the bar sits over with
   * `data-nav-overlay` (the homepage hero, which also pulls itself up under
   * the bar). Detected with :has rather than hardcoding the homepage, so a
   * second hero page gets this for free and a page without one — every list
   * and detail screen — is simply always solid. Being CSS, it also follows the
   * client router: the bar stays mounted while `main` is swapped under it.
   *
   * Transparent is the default and scrolling switches it off, not the other
   * way round, so the server-rendered first paint is already right at the top
   * of the page instead of flashing white until the script hydrates.
   *
   * Only colours change: height, position and the 1px border stay, so the
   * switch is a cross-fade and nothing shifts. `!important` because these
   * override utilities that are correct in every other context; over a
   * photograph there is no light or dark mode, only the photograph. From `lg`,
   * the only width this bar is shown at (the layout hides it below).
   */
  @media (min-width: 1024px) {
    body:has([data-nav-overlay]) .wl-nav:not(.wl-nav-scrolled) {
      background: transparent !important;
      border-bottom-color: transparent !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }

    /* White type, carrying its own contrast: a photograph can be bright
       anywhere. The two menus are white panels of their own and keep their
       normal colours. */
    body:has([data-nav-overlay]) .wl-nav:not(.wl-nav-scrolled) :is(a, button, span):not(.wl-more-panel *, .wl-account-menu *) {
      color: #fff !important;
      text-shadow: 0 1px 12px rgb(4 12 10 / 45%);
    }

    body:has([data-nav-overlay]) .wl-nav:not(.wl-nav-scrolled) :is(a, button):not(.wl-more-panel *, .wl-account-menu *):hover {
      background-color: rgb(255 255 255 / 14%) !important;
    }

    /* Outlined buttons (Record, Account) keep an outline you can see. */
    body:has([data-nav-overlay]) .wl-nav:not(.wl-nav-scrolled) :is(a, button).border:not(.wl-more-panel *, .wl-account-menu *) {
      border-color: rgb(255 255 255 / 45%) !important;
    }

    /* Sign up keeps its fill: it is the point of the bar for a signed-out
       visitor, and a white ghost button on a bright sky is invisible. */
    body:has([data-nav-overlay]) .wl-nav:not(.wl-nav-scrolled) .wl-nav-cta {
      background: #059669 !important;
      text-shadow: none;
    }

    body:has([data-nav-overlay]) .wl-nav:not(.wl-nav-scrolled) .wl-nav-cta:hover {
      background: #047857 !important;
    }
  }

  /* Closed until hovered or focused. visibility rather than display so the
     panel can fade, and so the gap between trigger and panel (the pt-2 above)
     is still part of the hover target instead of closing the menu mid-reach. */
  .wl-more-panel {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 150ms ease, transform 150ms ease, visibility 0s linear 150ms;
  }

  .wl-more:hover .wl-more-panel,
  .wl-more:focus-within .wl-more-panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition: opacity 150ms ease, transform 150ms ease, visibility 0s;
  }

  .wl-more:hover .wl-more-chevron,
  .wl-more:focus-within .wl-more-chevron {
    transform: rotate(180deg);
  }

  /* The trigger is not a link, so the router's activeClass never reaches it.
     Light it up from the link inside that did get marked. */
  .wl-more:has(.nav-active) .wl-more-trigger {
    color: var(--accent);
    font-weight: 600;
  }

  /* Inside the menu the item's title carries the state, not the whole row. */
  .wl-more-item.nav-active {
    background: rgb(236 253 245);
  }

  .dark .wl-more-item.nav-active {
    background: rgb(6 78 59 / 0.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .wl-more-panel,
    .wl-more-chevron {
      transition: none;
    }
  }
</style>
