<style>
  /* ==========================================================================
     WildLoop design system.

     Three locks the rest of the app inherits:
       - ONE accent (emerald) on cool slate neutrals. No second hue.
       - ONE radius scale: pill for controls, --r-card for surfaces,
         --r-control for inputs. Nothing invents its own.
       - Shadows are tinted toward the surface hue, never pure black.
     ========================================================================== */
  :root {
    --r-card: 1rem;
    --r-control: 0.625rem;
    --native-safe-area-background: #fff;

    --accent: #059669;
    --accent-bright: #34d399;

    /* Tinted, not black: a neutral-slate cast reads as depth rather than dirt. */
    --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.06);
    --shadow-md: 0 4px 16px -4px rgba(15, 23, 42, 0.10);
    --shadow-lg: 0 18px 40px -12px rgba(15, 23, 42, 0.18);
    --shadow-accent: 0 10px 30px -8px rgba(5, 150, 105, 0.35);
  }

  /* ts-maps */
  .ts-map-container,
  .trail-map-panel {
    z-index: 1;
    font-family: inherit;
    width: 100%;
    min-height: 280px;
  }
  .trail-map-panel { height: 420px; }
  .trail-map-panel-lg { height: min(55vh, 520px); }
  .ts-map-container .map-attribution,
  .ts-map-container [class*='attribution'] {
    font-size: 9px !important;
  }

  /* Shaded relief, multiplied over the vector basemap. The DEM is shaded
     theme-neutrally — white highlights, grey shadows — and multiply is what
     makes one shading work for both themes: a lit slope is white, and white
     multiplies to nothing, so only the shadowed faces darken. Blends that lift
     as well as darken (soft-light, overlay) turn the dark basemap into a white
     relief map, because on near-black land there is far more headroom above
     than below. Strength is set on the layer, not here — it writes its own
     inline opacity, which a rule in this file could never outrank. */
  .wl-map-relief {
    mix-blend-mode: multiply;
  }

  /* Map chrome, wearing the app's neutrals.

     ts-maps themes its controls, popups, attribution and tile background
     through custom properties on the map container, which is the seam to use:
     one set of tokens instead of chasing individual selectors, and it keeps
     working when the library restyles a button. Its defaults are Google's warm
     greys — #292a2d panels, a blue accent — and this app is cool slate with a
     single emerald. Same mismatch the basemap had, one layer up. */
  .ts-map-container.tsmap-container {
    --tsmap-accent: #059669;
    --tsmap-surface: #fff;
    --tsmap-surface-hover: #f1f5f9;
    --tsmap-fg: #334155;
    --tsmap-fg-muted: #64748b;
    --tsmap-fg-disabled: #cbd5e1;
    --tsmap-divider: rgb(15 23 42 / 10%);
    --tsmap-hairline: #e2e8f0;
    --tsmap-scale-line: #64748b;

    /* The ground a tile fades in against. Matched to the basemap palette's own
       background, so a pan shows the map's colour rather than a grey band. */
    --tsmap-tile-bg: #e8eef3;
  }

  .ts-map-container.tsmap-container.tsmap-dark {
    --tsmap-accent: #34d399;
    --tsmap-surface: #1e293b;
    --tsmap-surface-hover: #334155;
    --tsmap-fg: #e2e8f0;
    --tsmap-fg-muted: #94a3b8;
    --tsmap-fg-disabled: #475569;
    --tsmap-divider: rgb(255 255 255 / 12%);
    --tsmap-hairline: #334155;
    --tsmap-scale-line: #94a3b8;
    --tsmap-tile-bg: #0b1220;
  }

  /* The corner radius the rest of the app uses, and a shadow so a control has
     an edge against a pale basemap. */
  .ts-map-container .tsmap-control-navigation,
  .ts-map-container .tsmap-control-locate,
  .ts-map-container .tsmap-control-fullscreen,
  .ts-map-container .tsmap-control-geocoder,
  .ts-map-container .tsmap-control-zoom {
    border-radius: 10px;
    overflow: hidden;
  }

  /* Trail pins get a soft drop shadow rather than sitting flat on the tiles. */
  .wl-map-pin {
    filter: drop-shadow(0 1px 2px rgb(9 20 16 / 45%));
  }


  /* Geist over Inter: Inter is the default every generated site reaches for.
     15px base because 14px body copy on a content-led product reads cramped. */
  body {
    font-family: 'Geist', system-ui, -apple-system, sans-serif;
    font-size: 15px;
    -webkit-font-smoothing: antialiased;
  }

  /*
   * Let the browser choose where headings break.
   *
   * Default wrapping is greedy: it fills each line to the edge and drops
   * whatever is left onto the next one, so "Backyard ultras, lap by lap."
   * broke as "Backyard ultras, lap" / "by lap." — twenty characters against
   * seven, with the break landing mid-clause instead of at the comma sitting
   * right there. `balance` optimises for even line lengths across the whole
   * block, which puts the break at the punctuation almost every time, and it
   * costs nothing: the browser does it at layout, with no markup and no
   * hard-coded <br> to go stale when the copy changes.
   *
   * `pretty` on body copy is the cheaper cousin — it only prevents a single
   * orphaned word on the last line, which is the failure mode paragraphs have.
   */
  h1, h2, h3, h4, .display, .hero-title {
    text-wrap: balance;
  }

  p, .lede, blockquote, figcaption {
    text-wrap: pretty;
  }

  .font-display {
    font-family: 'Outfit', system-ui, sans-serif;
    letter-spacing: -0.02em;
  }

  .nav-active {
    color: var(--accent) !important;
    font-weight: 600;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--accent), var(--accent-bright));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .gradient-bg {
    background: linear-gradient(135deg, #065f46, var(--accent), var(--accent-bright));
  }

  /* The surface primitive. Every `class="card"` in the views resolved to
     nothing before this existed, so panels rendered as unstyled text blocks. */
  .card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: var(--r-card);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  /* Padding at zero specificity, so a padding utility on the same element
     wins. As a plain `.card` rule it beat `p-0`, and every map dropped into
     a card sat inside a 20px white frame. */
  :where(.card) {
    padding: 1.25rem;
  }

  .dark .card {
    background: #1e293b;
    border-color: #334155;
    box-shadow: none;
  }

  /* Only interactive cards lift. A static panel that moves on hover is noise. */
  a.card:hover,
  button.card:hover {
    border-color: var(--accent-bright);
    box-shadow: var(--shadow-md);
  }

  a.card:active,
  button.card:active { transform: scale(0.995); }

  .metric-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #64748b;
  }

  .dark .metric-label { color: #94a3b8; }

  /* Trail card hover */
  .trail-card { transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .trail-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .trail-card:hover .trail-image { transform: scale(1.04); }
  .trail-image { transition: transform 0.5s ease; }

  /* The action bar on a trail page: fixed to the bottom of the viewport, and
     above the native tab bar rather than behind it. The tab slot is 4rem plus
     the home-indicator inset and sits at z-index 30, so this clears both. It
     only ever renders below `lg`, which is exactly where that bar exists. */
  .trail-action-bar {
    position: fixed;
    right: 0;
    bottom: calc(4rem + var(--native-safe-area-bottom, 0px));
    left: 0;
    z-index: 35;
    border-top: 1px solid #e2e8f0;
    background: rgb(255 255 255 / 0.95);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
  }

  .dark .trail-action-bar {
    border-top-color: #334155;
    background: rgb(15 23 42 / 0.95);
  }

  /* Map preview */
  .map-preview {
    background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);
    position: relative;
    overflow: hidden;
  }

  html.dark {
    --native-safe-area-background: #0f172a;

    background: #0f172a;
    color-scheme: dark;
  }

  .game-dashboard-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(52, 211, 153, 0.25);
    border-radius: var(--r-card);
    padding: 1.5rem;
    backdrop-filter: blur(12px);
  }

  .capture-bar {
    height: 8px;
    background: #e2e8f0;
    border-radius: 9999px;
    overflow: hidden;
  }

  .dark .capture-bar { background: #334155; }

  /* Emerald ramp, not the old purple-to-green: one accent per project, and a
     second hue here made capture progress read as a different feature. */
  .capture-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-bright));
    border-radius: 9999px;
    transition: width 0.25s ease;
  }

  .capture-toast { animation: capture-pop 0.35s ease; }

  @keyframes capture-pop {
    0% { transform: translate(-50%, -8px) scale(0.9); opacity: 0; }
    100% { transform: translate(-50%, 0) scale(1); opacity: 1; }
  }

  /* Skeleton for list/stat loading, shaped by the caller so it matches the
     final layout instead of a generic spinner. */
  .skeleton {
    background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 37%, #f1f5f9 63%);
    background-size: 400% 100%;
    animation: skeleton-sweep 1.4s ease infinite;
    border-radius: var(--r-control);
  }

  .dark .skeleton {
    background: linear-gradient(90deg, #1e293b 25%, #334155 37%, #1e293b 63%);
    background-size: 400% 100%;
  }

  @keyframes skeleton-sweep {
    0% { background-position: 100% 50%; }
    100% { background-position: 0 50%; }
  }

  .stat-tile {
    text-align: center;
    padding: 0.625rem;
    border-radius: var(--r-control);
    background: #f8fafc;
  }

  .dark .stat-tile { background: #0f172a; }

  .record-btn-start,
  .record-btn-pause,
  .record-btn-resume {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 5rem;
    width: 5rem;
    font-size: 1.5rem;
    color: white;
    border-radius: 9999px;
    transition: background 0.2s ease, transform 0.12s ease;
  }

  .record-btn-start { background: var(--accent); box-shadow: var(--shadow-accent); }
  .record-btn-start:hover { background: #047857; }
  .record-btn-pause { background: var(--accent); box-shadow: var(--shadow-accent); }
  .record-btn-pause:hover { background: #047857; }
  .record-btn-resume { background: #eab308; box-shadow: 0 10px 30px -8px rgba(234, 179, 8, 0.35); }
  .record-btn-resume:hover { background: #ca8a04; }

  .record-btn-stop {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4rem;
    width: 4rem;
    font-size: 1.25rem;
    color: white;
    background: #ef4444;
    border-radius: 9999px;
    box-shadow: 0 8px 20px -6px rgba(239, 68, 68, 0.35);
    transition: background 0.2s ease, transform 0.12s ease;
  }

  .record-btn-stop:hover { background: #dc2626; }

  /* Tactile press on every recorder control. */
  .record-btn-start:active,
  .record-btn-pause:active,
  .record-btn-resume:active,
  .record-btn-stop:active { transform: scale(0.96); }

  /* Keyboard users get the same affordance mouse users do. */
  :focus-visible {
    outline: 2px solid var(--accent-bright);
    outline-offset: 2px;
    border-radius: 4px;
  }

  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
  .dark ::-webkit-scrollbar-thumb { background: #475569; }

  /* Motion is decoration here, so it all yields to the OS preference. */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
    .trail-card:hover { transform: none; }
  }
</style>
