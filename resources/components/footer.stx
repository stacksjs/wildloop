          Find trails. Track miles. Hold ground.
        </p>

        <!-- The install path that actually works today. A visitor on Android or
             desktop Chrome gets the real prompt; on iOS there is no programmatic
             install, so say what to tap instead of offering a dead button. -->
        <div class="mt-6">
          <p :if="installed" class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3.5 py-2 text-sm font-semibold text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
            <i class="i-lucide-check h-4 w-4" aria-hidden="true"></i>
            App installed
          </p>
          <button
            :if="!installed && canPrompt"
            @click="promptInstall()"
            class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800 active:scale-[0.98] dark:bg-white dark:text-slate-900 dark:hover:bg-slate-100"
          >
            <i class="i-lucide-download h-4 w-4" aria-hidden="true"></i>
            Install the app
          </button>
          <p :if="!installed && !canPrompt && platform === 'ios'" class="max-w-[30ch] text-sm leading-relaxed text-slate-500 dark:text-slate-400">
            On iPhone: tap <span class="font-semibold text-slate-700 dark:text-slate-200">Share</span>, then
            <span class="font-semibold text-slate-700 dark:text-slate-200">Add to Home Screen</span>.
          </p>
          <StxLink :if="!installed && !canPrompt && platform !== 'ios'" to="/app" class="inline-flex items-center gap-2 rounded-full border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-white dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800">
            <i class="i-lucide-smartphone h-4 w-4" aria-hidden="true"></i>
            Get the app
          </StxLink>
