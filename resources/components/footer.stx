          <li><StxLink to="/athletes" class="text-slate-600 transition hover:text-emerald-600 dark:text-slate-400 dark:hover:text-emerald-400">Athletes</StxLink></li>
        </ul>
      </div>

      <div>
        <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400 dark:text-slate-500">Company</h2>
