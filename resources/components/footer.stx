    <!--
      Data attribution. Not decoration: OpenStreetMap is published under the
      ODbL, which requires that any product built on it credits the source and
      names the licence. The two federal datasets are public domain and need no
      permission, but saying where a trail came from is what lets someone judge
      whether to trust it.
    -->
    <div class="mt-12 flex flex-col gap-4 border-t border-slate-200 pt-6 dark:border-slate-800 md:flex-row md:items-start md:justify-between">
      <p class="max-w-3xl text-xs leading-relaxed text-slate-500 dark:text-slate-400">
        Trail data from
        <a href="https://www.openstreetmap.org/copyright" rel="noopener" class="underline decoration-slate-300 underline-offset-2 transition hover:text-emerald-600 dark:decoration-slate-600 dark:hover:text-emerald-400">OpenStreetMap contributors</a>
        (<a href="https://opendatacommons.org/licenses/odbl/" rel="noopener" class="underline decoration-slate-300 underline-offset-2 transition hover:text-emerald-600 dark:decoration-slate-600 dark:hover:text-emerald-400">ODbL</a>),
        the <a href="https://data.fs.usda.gov/geodata/edw/datasets.php" rel="noopener" class="underline decoration-slate-300 underline-offset-2 transition hover:text-emerald-600 dark:decoration-slate-600 dark:hover:text-emerald-400">USDA Forest Service</a>
        and the <a href="https://public-nps.opendata.arcgis.com/" rel="noopener" class="underline decoration-slate-300 underline-offset-2 transition hover:text-emerald-600 dark:decoration-slate-600 dark:hover:text-emerald-400">National Park Service</a>.
