<script server>
import { defineProps, withDefaults } from 'stx'

interface FeaturedTrailCardProps {
  name?: string
  location?: string
  distance?: number
  elevation?: number
  difficulty?: string
  rating?: number
  image?: string
}

const { name, location, distance, elevation, difficulty, rating, image } = withDefaults(defineProps<FeaturedTrailCardProps>(), {
  name: 'Featured Trail',
  location: 'Unknown Location',
  distance: 0,
  elevation: 0,
  difficulty: 'moderate',
  rating: 0,
  image: ''
})
</script>

<template>
  <div class="relative">
    {{-- Main card --}}
    <div class="overflow-hidden bg-white rounded-3xl shadow-2xl duration-300 transition-transform rotate-2 transform hover:rotate-0">
      <div class="overflow-hidden relative h-64">
        <Image src="{{ image }}" alt="{{ name }}" width="800" height="600" sizes="(max-width: 768px) 100vw, 50vw" placeholder="blur" class="object-cover h-full w-full" />
        <div class="absolute left-4 top-4">
          <span class="px-3 py-1 font-semibold text-emerald-700 text-sm bg-white/90 rounded-full backdrop-blur-sm">
            Featured Trail
          </span>
        </div>
        <div class="flex absolute bottom-4 right-4 items-center px-3 py-1.5 space-x-1 bg-black/50 rounded-full backdrop-blur-sm">
          <Icon name="star" size="16" class="text-yellow-400" />
          <span class="font-medium text-sm text-white">{{ rating }}</span>
        </div>
      </div>
      <div class="p-6">
        <h3 class="mb-1 font-bold text-gray-900 text-xl">{{ name }}</h3>
        <p class="mb-4 text-gray-500 text-sm">{{ location }}</p>
        <div class="flex items-center justify-between text-sm">
          <div class="flex items-center space-x-4">
            <span class="flex items-center text-gray-600">
              <Icon name="trending-up" size="16" class="mr-1" />
              {{ distance }} mi
            </span>
            <span class="flex items-center text-gray-600">
              <Icon name="arrow-up" size="16" class="mr-1" />
              {{ elevation.toLocaleString() }} ft
            </span>
          </div>
          <span class="px-3 py-1 capitalize font-semibold text-xs rounded-full difficulty difficulty-{{ difficulty }}">{{ difficulty }}</span>
        </div>
      </div>
    </div>

    {{-- Floating activity card --}}
