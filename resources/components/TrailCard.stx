<script server>
import { defineProps, withDefaults } from 'stx'
import { difficultyTitle, trailDifficultyLabel } from '../functions/trail-difficulty'

type Difficulty = 'easy' | 'moderate' | 'hard'

// Can accept either a plain object or a browser model instance
interface TrailCardProps {
  trail?: any
}

const { trail } = withDefaults(defineProps<TrailCardProps>(), {
  trail: null
})

// Helper to get value from either plain object or model instance
function getValue(obj: any, key: string, defaultValue: any = ''): any {
  if (!obj) return defaultValue
  // Check if it's a model instance with get() method
  if (typeof obj.get === 'function') {
    return obj.get(key) ?? defaultValue
  }
  // Plain object
  return obj[key] ?? defaultValue
}

function getDifficultyClass(difficulty: Difficulty): string {
  const classes: Record<Difficulty, string> = {
    easy: 'difficulty-easy',
    moderate: 'difficulty-moderate',
    hard: 'difficulty-hard'
  }
  return classes[difficulty] || 'difficulty-moderate'
}

function formatNumber(num: number): string {
  return (num || 0).toLocaleString()
}

// Extract values with fallbacks
const name = getValue(trail, 'name', 'Unknown Trail')
const location = getValue(trail, 'location', 'Unknown Location')
const distance = getValue(trail, 'distance', 0)
const elevation = getValue(trail, 'elevation', 0)
const difficulty = getValue(trail, 'difficulty', 'moderate') as Difficulty
const rating = getValue(trail, 'rating', 0)
const reviews = getValue(trail, 'reviewCount', getValue(trail, 'reviews', 0))
const time = getValue(trail, 'estimatedTime', getValue(trail, 'time', '0m'))
const image = getValue(trail, 'image', 'https://images.unsplash.com/photo-1448375240586-882707db888b?w=800&h=600&fit=crop')
const tagsRaw = getValue(trail, 'tags', '')
const tags = typeof tagsRaw === 'string' ? (tagsRaw ? tagsRaw.split(',') : []) : (tagsRaw || [])

/*
 * The badge says which kind of grade it is (#1004). Three quarters of the
 * catalog has no measured ascent, so the grade there is distance alone — a
 * tilde rather than a blank, because a catalog with no difficulty on it helps
 * nobody, and the title carries the sentence for a reader who needs it.
 */
const gradeLabel = trailDifficultyLabel(difficulty, elevation)
const gradeTitle = difficultyTitle(difficulty, elevation)
</script>

<template>
  <article class="overflow-hidden bg-white border border-gray-100 rounded-2xl shadow-md trail-card">
    <!-- Image -->
    <div class="overflow-hidden relative h-48">
      <Image src="{{ image }}" alt="{{ name }}" width="800" height="600" sizes="(max-width: 768px) 100vw, 33vw" placeholder="blur" class="object-cover h-full w-full trail-image" />
      <div class="absolute left-4 top-4">
        <span class="px-3 py-1 capitalize font-semibold text-xs rounded-full {{ getDifficultyClass(difficulty) }}" title="{{ gradeTitle }}">
          {{ gradeLabel }}
        </span>
      </div>
      <button class="absolute right-4 top-4 p-2 bg-white/90 hover:bg-white rounded-full shadow-md backdrop-blur-sm transition">
        <Icon name="heart" size="20" class="text-gray-600 hover:text-red-500 transition" />
      </button>
    </div>

    <!-- Content -->
    <div class="p-5">
      <div class="flex items-start justify-between mb-2">
        <h3 class="font-bold text-gray-900 text-lg hover:text-emerald-600 transition cursor-pointer">{{ name }}</h3>
        <div class="flex items-center space-x-1 text-sm">
          <Icon name="star" size="16" class="text-yellow-400" />
          <span class="font-semibold text-gray-900">{{ rating }}</span>
          <span class="text-gray-400">({{ formatNumber(reviews) }})</span>
        </div>
      </div>

      <p class="flex items-center mb-4 text-gray-500 text-sm">
        <Icon name="map-pin" size="16" class="mr-1" />
        {{ location }}
      </p>

      <!-- Stats -->
      <div class="flex items-center justify-between pt-4 text-gray-600 text-sm border-gray-100 border-t">
        <div class="flex items-center space-x-4">
          <span class="flex items-center">
            <Icon name="trending-up" size="16" class="mr-1 text-emerald-500" />
            {{ distance }} mi
          </span>
          <span class="flex items-center">
            <Icon name="arrow-up" size="16" class="mr-1 text-emerald-500" />
            {{ formatNumber(elevation) }} ft
          </span>
        </div>
        <span class="text-gray-400">~{{ time }}</span>
      </div>

      <!-- Tags -->
      @if(tags.length > 0)
        <div class="flex flex-wrap gap-2 mt-4">
          @foreach(tags as tag)
            <span class="px-2 py-1 capitalize text-gray-600 text-xs bg-gray-100 rounded-md">{{ tag }}</span>
          @endforeach
        </div>
      @endif
    </div>
  </article>
</template>
