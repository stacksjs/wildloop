<script client>
import { haptics, location } from '@stacksjs/mobile'
import { withLocationRequestTimeout } from '../assets/scripts/location-request'

const label = useReactiveProp<string>('label', 'Allow precise location')
const grantedLabel = useReactiveProp<string>('grantedLabel', 'Location ready')
// Appearance only. The layout that keeps the icon beside its label lives on
// the element itself: a caller passing `class` replaces this value wholesale,
// and when the Record page did that the button lost `inline-flex`, fell back
// to `display: block`, and rendered the pin on one line with the label
// wrapping underneath it.
const className = useReactiveProp<string>('class', 'min-h-11 rounded-xl px-4 text-sm font-semibold')
const status = state<'undetermined' | 'checking' | 'granted' | 'denied'>('undetermined')
const message = state('')
const emit = defineEmits()

async function requestLocation(): Promise<void> {
  if (status() === 'checking' || status() === 'granted') return
  status.set('checking')
  message.set('')

  try {
    await haptics.selection()
    await withLocationRequestTimeout(location.getCurrentPosition({ enableHighAccuracy: true, maximumAge: 0, timeout: 15_000 }))
    status.set('granted')
    emit('change', 'granted')
    await haptics.notification('success')
  }
  catch {
    status.set('denied')
    message.set('WildLoop could not get a current location. Check your device settings and try again.')
    emit('change', 'denied')
    try {
      await haptics.notification('warning')
    }
    catch {
      // Haptics are optional and must not hide the location error.
    }
  }
}
</script>

<div class="inline-flex flex-col gap-2">
  <button
    type="button"
    :class="'inline-flex items-center justify-center gap-2 whitespace-nowrap ' + className()"
    :disabled="status() === 'checking' || status() === 'granted'"
    :aria-busy="status() === 'checking' ? 'true' : 'false'"
    @click="requestLocation()"
  >
    <i aria-hidden="true" :class="status() === 'granted' ? 'i-hugeicons-checkmark-circle-02' : 'i-hugeicons-location-01'" class="h-5 w-5"></i>
    <span>{{ status() === 'checking' ? 'Checking location' : status() === 'granted' ? grantedLabel() : label() }}</span>
  </button>
  <p :if="message" role="alert" class="max-w-sm text-sm text-red-600 dark:text-red-300">{{ message() }}</p>
</div>
