<script>
interface BrandMarkProps {
  /**
   * `default` for nav, footer and mobile header; `lg` for the auth pages,
   * where the mark sits beside a large wordmark and needs to match it.
   */
  size?: 'default' | 'lg'
}

const { size = 'default' } = defineProps<BrandMarkProps>()
</script>

{{--
  The Wildloop mark: a closed ring with the runner's position on it.

  Pure CSS on purpose, so the wordmark never depends on icon resolution the way
  the rest of the UI's glyphs do — and one component, because it did not used
  to be. The nav, footer and mobile header drew the ring-and-dot; the three
  auth pages drew a DIFFERENT shape, a 3/4 ring with `border-t-transparent`,
  which reads as a loading spinner and rendered as nothing beside the wordmark.
  Sign-in is the first page a logged-out visitor sees, so that was the one
  place the brand had to be right and the one place it wasn't.

  The size classes are written out per branch rather than interpolated into the
  class attribute. Crosswind scans templates for literal class names, so a
  class assembled at runtime is a class it never generates — which is exactly
  how the first version of this component shipped a 0x0 ring with only the
  position dot visible.
--}}
@if(size === 'lg')
  <span
    class="relative mr-2 inline-block h-7 w-7 shrink-0 rounded-full border-2 border-emerald-500 align-middle"
    aria-hidden="true"
  >
    <span class="absolute -top-1 left-1/2 h-2 w-2 -translate-x-1/2 rounded-full bg-emerald-400"></span>
  </span>
@else
  <span
    class="relative inline-block h-5 w-5 shrink-0 rounded-full border-2 border-emerald-500"
    aria-hidden="true"
  >
    <span class="absolute -top-0.5 left-1/2 h-1.5 w-1.5 -translate-x-1/2 rounded-full bg-emerald-400"></span>
  </span>
@endif
