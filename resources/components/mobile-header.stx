<script client>
// Everything here comes from the shared store, which the layout fills from
// the session and hands the native bridge. Importing the auth client, the
// API client and @stacksjs/mobile for a badge and a tap put about 38 KB into
// this bundle on every page (stacksjs/stx#1957).
const wl = useStore('wl')
const signedIn = derived(() => Boolean(wl && wl.currentUserId() > 0))
const isAdmin = derived(() => Boolean(signedIn() && wl.currentUser()?.roles?.includes('admin')))
// The bell's dot used to be markup with no condition, so it lit up for every
// signed-in account even with an empty notifications page. Drive it from the
// real unread count instead.
const unreadCount = derived(() => (signedIn() ? wl.unreadCount() : 0))
// In the app this is the top bar of the Feed and the Menu, the way Instagram
// and Strava carry theirs: the brand on the left, search and notifications on
// the right. Other screens have their own title or, like Record, need the
// room. On the mobile website it stays on every page, as its only navigation.
const inAppHeader = derived(() => ['/', '/feed', '/menu'].includes(wl?.currentPath?.() || ''))

function tap(): void {
  wl?.tap()
}
</script>

<header x-class="inAppHeader() ? 'native-app-header' : ''" class="native-app-sticky-top sticky z-40 flex h-13 items-center justify-between border-b border-slate-200/70 bg-white/90 px-4 backdrop-blur-xl lg:hidden dark:border-slate-700/70 dark:bg-slate-950/90">
  <!-- Native header links follow the same reliable document navigation as the tab bar. -->
  <a href="/feed" class="flex items-center gap-2" aria-label="WildLoop feed" @click="tap()">
    <BrandMark />
    <span class="font-display text-sm font-bold tracking-[0.12em] text-slate-950 dark:text-white">WILDLOOP</span>
  </a>

  <div class="flex items-center gap-1">
    <a href="/search" aria-label="Search" class="grid h-11 w-11 place-items-center rounded-full text-slate-600 transition active:scale-95 dark:text-slate-300" @click="tap()">
      <i class="i-lucide-search h-5 w-5" aria-hidden="true"></i>
    </a>
    <!-- The app signs people in from the Menu; a Log in / Sign up pair in its
         top bar was the website showing through. -->
    <div :if="!signedIn" class="web-only flex items-center gap-1" x-cloak>
      <a href="/login" class="rounded-full px-3 py-2 text-sm font-semibold text-slate-700 transition active:scale-95 dark:text-slate-200" @click="tap()">Log in</a>
      <a href="/register" class="rounded-full bg-emerald-600 px-3 py-2 text-sm font-semibold text-white transition active:scale-95" @click="tap()">Sign up</a>
    </div>
    <a :if="signedIn" href="/notifications" aria-label="Notifications" class="relative grid h-11 w-11 place-items-center rounded-full text-slate-600 transition active:scale-95 dark:text-slate-300" @click="tap()" x-cloak>
      <i class="i-lucide-bell h-5 w-5" aria-hidden="true"></i>
      <span :if="unreadCount() > 0" class="absolute right-2.5 top-2.5 h-2 w-2 rounded-full border-2 border-white bg-emerald-500 dark:border-slate-950"></span>
    </a>
    <a :if="isAdmin" href="/admin" aria-label="Admin" class="web-only grid h-11 w-11 place-items-center rounded-full text-emerald-600 transition active:scale-95 dark:text-emerald-400" @click="tap()">
      <i class="i-lucide-shield-check h-5 w-5" aria-hidden="true"></i>
    </a>
    <a :if="signedIn" href="/settings" aria-label="Settings" class="web-only grid h-11 w-11 place-items-center rounded-full text-slate-600 transition active:scale-95 dark:text-slate-300" @click="tap()" x-cloak>
      <i class="i-lucide-settings-2 h-5 w-5" aria-hidden="true"></i>
    </a>
  </div>
</header>
