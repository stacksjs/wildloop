<script client>
import { haptics } from '@stacksjs/mobile'
import { currentUser, initializeAuthSession, token } from '../assets/scripts/auth'
import { fetchNotifications } from '../assets/scripts/game-api'

const isAdmin = state(false)
const signedIn = state(false)
// The bell's dot used to be markup with no condition, so it lit up for every
// signed-in account even with an empty notifications page. Drive it from the
// real unread count instead.
const unreadCount = state(0)

async function refreshUnread(): Promise<void> {
  if (!token()) {
    unreadCount.set(0)
    return
  }
  try {
    const payload = await fetchNotifications()
    unreadCount.set(Number(payload?.unreadCount ?? 0))
  }
  catch {
    // A failed poll must not invent a badge.
    unreadCount.set(0)
  }
}

function tap(): void {
  void haptics.selection()
}

function applyAccount(): void {
  const account = currentUser()
  const hasSession = Boolean(token())
  signedIn.set(hasSession)
  isAdmin.set(Boolean(hasSession && account?.roles?.includes('admin')))
}

function applyAccountAndUnread(): void {
  applyAccount()
  void refreshUnread()
}

onMount(() => {
  applyAccountAndUnread()
  void initializeAuthSession().then(applyAccountAndUnread)
  globalThis.addEventListener('wildloop:auth-ready', applyAccountAndUnread)
})

onDestroy(() => globalThis.removeEventListener('wildloop:auth-ready', applyAccountAndUnread))
</script>

<header class="native-app-sticky-top sticky z-40 flex h-13 items-center justify-between border-b border-slate-200/70 bg-white/90 px-4 backdrop-blur-xl lg:hidden dark:border-slate-700/70 dark:bg-slate-950/90">
  <!-- Native header links follow the same reliable document navigation as the tab bar. -->
  <a href="/feed" class="flex items-center gap-2" aria-label="WildLoop feed" @click="tap()">
    <BrandMark />
    <span class="font-display text-sm font-bold tracking-[0.12em] text-slate-950 dark:text-white">WILDLOOP</span>
  </a>

  <div class="flex items-center gap-1">
    <div :if="!signedIn" class="flex items-center gap-1" x-cloak>
      <a href="/login" class="rounded-full px-3 py-2 text-sm font-semibold text-slate-700 transition active:scale-95 dark:text-slate-200" @click="tap()">Log in</a>
      <a href="/register" class="rounded-full bg-emerald-600 px-3 py-2 text-sm font-semibold text-white transition active:scale-95" @click="tap()">Sign up</a>
    </div>
    <a :if="signedIn" href="/notifications" aria-label="Notifications" class="relative grid h-11 w-11 place-items-center rounded-full text-slate-600 transition active:scale-95 dark:text-slate-300" @click="tap()" x-cloak>
      <i class="i-lucide-bell h-5 w-5" aria-hidden="true"></i>
      <span :if="unreadCount() > 0" class="absolute right-2.5 top-2.5 h-2 w-2 rounded-full border-2 border-white bg-emerald-500 dark:border-slate-950"></span>
    </a>
    <a :if="isAdmin" href="/admin" aria-label="Admin" class="grid h-11 w-11 place-items-center rounded-full text-emerald-600 transition active:scale-95 dark:text-emerald-400" @click="tap()">
      <i class="i-lucide-shield-check h-5 w-5" aria-hidden="true"></i>
    </a>
    <a :if="signedIn" href="/settings" aria-label="Settings" class="grid h-11 w-11 place-items-center rounded-full text-slate-600 transition active:scale-95 dark:text-slate-300" @click="tap()" x-cloak>
      <i class="i-lucide-settings-2 h-5 w-5" aria-hidden="true"></i>
    </a>
  </div>
</header>
