<script>
interface NativeTabItemProps {
  label: string
  href: string
  icon: string
}

const { href, icon, label } = defineProps<NativeTabItemProps>()
</script>

<script client>
import { device, isNativeMobile } from '@stacksjs/mobile'
import { activeTabFor } from '../functions/native-tabs'

// Craft currently installs its iOS bridge after the document has started.
// Keeping an iPhone tab change inside the existing document therefore retains
// the already-resolved Keychain session. Android deliberately keeps the href
// navigation below: its packaged fallback needs document loads after a cold
// start. This is a narrow client-side resilience measure, not auth enforcement.
const usesIosNativeRouting = state(isNativeMobile() && device.isIOS())
const isNativeAndroid = state(isNativeMobile() && device.isAndroid())

// Highlight from the shared store: this component is layout chrome, and its
// own state stops rendering after the first in-app navigation (stx#1958).
const tabHref = useReactiveProp<string>('href', '')
const wl = useStore('wl')
const isActive = derived(() => {
  const path = wl?.currentPath?.() || (typeof location === 'undefined' ? '' : location.pathname)
  return Boolean(path) && activeTabFor(path) === tabHref()
})

/** Long enough that a slow page is never mistaken for a stalled router. */
const ROUTER_STALL_MS = 8000

function followTab(event: MouseEvent): void {
  if (!usesIosNativeRouting()) return

  // The destination comes off the element, not from the `href` prop.
  //
  // A component's client bundle is compiled into its own scope and does not
  // close over the props declared in `<script>`: `navigate(href)` threw
  // ReferenceError here, *after* preventDefault had already cancelled the
  // link. Every tab tap on iPhone did nothing at all — no navigation, no
  // error anybody would see — while the same bar worked in a browser, where
  // this path is skipped entirely.
  const link = event.currentTarget as HTMLAnchorElement | null
  const to = link?.getAttribute('href')

  // Falling through to the browser is the honest failure: a tab that loads
  // the document beats a tab that does nothing.
  if (!to || typeof navigate !== 'function') return

  event.preventDefault()

  // Wait for the router's own answer rather than second-guessing it on a
  // timer. It already loads the document itself when its fetch fails, and it
  // answers false when a navigation is still in flight. The 400ms timer that
  // used to sit here fired a full page load on any slow navigation, so two
  // quick taps on a slow server started two page loads, WebKit cancelled the
  // first, and Craft treats a cancelled load as a failure: it swapped the rest
  // of the session to its stale bundled copy of the site, the one with the
  // website header, the landing page and no API. The only case left to cover
  // is a router that never answers at all.
  let settled = false
  void Promise.resolve(navigate(to)).finally(() => {
    settled = true
  })

  setTimeout(() => {
    if (settled)
      return
    const here = globalThis.location?.pathname ?? ''
    if (here !== to && !here.startsWith(`${to}/`))
      globalThis.location.assign(to)
  }, ROUTER_STALL_MS)
}

/**
 * A tap that Android's WebView has already turned into a long press.
 *
 * A tab bar sits over whatever the page is painting. On /trails that is the
 * map, and while it draws, the app's UI thread stalls for most of a second, so
 * the finger-up reaches Chromium late. The tap is then a long press: no click
 * is ever dispatched, and Chromium started a native drag of the link instead.
 * Record did nothing from Trails (Mobile E2E, 24 Sep 2026, logcat "perform
 * drag ... touch(540,2265)"), while the same tap worked everywhere else.
 * `draggable="false"` stops the drag; this makes the long press still count,
 * because a tab has no context menu worth keeping. Android only, so a desktop
 * right-click still offers "open in new tab".
 */
function followLongPress(event: MouseEvent): void {
  if (!isNativeAndroid()) return

  const to = (event.currentTarget as HTMLAnchorElement | null)?.getAttribute('href')
  if (!to) return

  event.preventDefault()
  if (globalThis.location?.pathname !== to)
    globalThis.location.assign(to)
}
</script>

<!--
  Native tabs deliberately use document navigation. Craft's Android WebView
  loads each bundled fallback page reliably, while an SPA fragment swap can
  leave a client module unexecuted after a cold start.
-->
<a
  href="{{ href }}"
  aria-label="{{ label }}"
  class="native-tab-item"
  x-class="isActive() ? 'is-active' : ''"
  x-aria-current="isActive() ? 'page' : 'false'"
  draggable="false"
  @click="followTab"
  @contextmenu="followLongPress"
>
  <i aria-hidden="true" class="{{ icon }} native-tab-icon"></i>
  <span>{{ label }}</span>
</a>
