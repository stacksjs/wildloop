<script client>
  import { computeConquestRecord } from '../functions/conquest-stats'
  import { computeTrainingStats } from '../functions/training-stats'

  // ===== Types =====
  interface User {
    id: number
    name: string
    email: string
    avatar: string | null
    joinedAt: string
    roles?: string[]
  }

  interface Trail {
    id: number
    name: string
    location: string
    difficulty: 'easy' | 'moderate' | 'hard'
    distance: number
    elevation: number
    estimatedTime: string
    rating: number
    reviewCount: number
    description: string
    lat: number
    lng: number
    image: string | null
    tags: string[]
    conditions: string
  }

  interface Split {
    mile: number
    pace: string
    elev: number
  }

  interface Comment {
    user_id: number
    userName: string
    text: string
    created_at: string
  }

  interface Activity {
    id: number
    user_id: number
    userName: string
    trail_id: number | null
    trail_name: string
    title: string
    activityType: 'Trail Run' | 'Hike' | 'Walk' | 'Bike'
    distance: number
    duration: string
    moving_time: string
    pace: string
    elevation_gain: number
    calories: number
    heartRateAvg: number | null
    heartRateMax: number | null
    cadence: number | null
    splits: Split[]
    kudos_count: number
    comments: Comment[]
    notes?: string
    visibility?: string
    hasGps?: boolean
    created_at: string
  }

  interface Territory {
    id: number
    name: string
    user_id: number
    areaSize: number
    conquestCount: number
    defendCount: number
    totalRunners: number
    // Same vocabulary as the backend Territory.status enum; "Secure" is a
    // display label for 'active', never a stored value.
    status: 'active' | 'contested'
    claimedAt: string
    lat: number
    lng: number
  }

  interface Conquest {
    id: number
    territory_id: number
    territoryName: string
    attacker_id: number
    attackerName: string
    defender_id: number
    defenderName: string
    status: 'active' | 'conquered' | 'defended'
    areaCaptured: number
    runDistance: number
    description: string
    created_at: string
  }

  interface Challenge {
    id: number
    challenger_id: number
    challengerName: string
    challenged_id: number
    challengedName: string
    territory_id: number
    territoryName: string
    status: 'active' | 'pending' | 'completed'
    winner_id?: number
    areaAtStake: number
    deadline: string
    created_at: string
  }

  interface Review {
    id: number
    trail_id: number
    user_id: number
    userName: string
    rating: number
    text: string
    conditions: string
    created_at: string
  }

  interface Club {
    id: number
    name: string
    description: string
    memberCount: number
    location: string
    type: 'Running' | 'Hiking' | 'Mixed' | 'Territory Game'
    isPrivate: boolean
    weeklyDistance: number
    activitiesThisWeek: number
    members: number[]
    isMember?: boolean
    creatorId?: number
    created_at: string
  }

  interface Achievement {
    id: number
    name: string
    description: string
    icon: string
    progress: number
    total: number
    unlockedAt: string | null
  }

  interface Notification {
    id: number
    type: 'kudos' | 'comment' | 'conquest_attack' | 'conquest_defend' | 'conquest_win' | 'challenge' | 'achievement' | 'club'
    title: string
    message: string
    link: string
    read: boolean
    created_at: string
  }

  interface Segment {
    id: number
    name: string
    trail_id: number
    distance: number
    elevation: number
    leaderTime: string
    leaderName: string
    yourTime: string | null
    yourRank: number | null
    totalAttempts: number
  }

  interface UserStats {
    user_id: number
    totalDistance: number
    totalElevation: number
    trailsCompleted: number
    totalActivities: number
    currentStreak: number
    longestStreak: number
    totalTime: string
    avgPace: string
    totalCalories: number
    weeklyDistance: number
    weeklyElevation: number
    weeklyActivities: number
    monthlyDistance: number
    monthlyElevation: number
    personalRecords: {
      fastestMile: string
      longestRun: number
      biggestClimb: number
      longestStreak: number
    }
    weeklyHistory: Array<{ week: string, distance: number, elevation: number }>
  }

  interface ConquestStats {
    user_id: number
    totalConquests: number
    territoriesLost: number
    successfulDefenses: number
    winRate: number
    powerRating: number
    longestConquestStreak: number
    totalAreaConquered: number
    uniqueRivalsBeaten: number
  }

