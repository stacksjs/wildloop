  const seedConquestStats: ConquestStats = {
    user_id: 1,
    totalConquests: 3,
    territoriesLost: 0,
    successfulDefenses: 6,
    winRate: 75,
    powerRating: 1847,
    longestConquestStreak: 3,
    totalAreaConquered: 128000,
    uniqueRivalsBeaten: 4,
  }

  // ===== Store =====
  // defineStore is idempotent - returns existing store on re-navigation
  const wlStore = defineStore('wl', {
    state: () => ({
      // 0 is the explicit guest sentinel. The authenticated id is hydrated
      // from /api/me; it is never inferred from seed/demo data.
      currentUserId: 0,
      users: seedUsers,
      /**
       * Only the API fills this. The demo list that seeded it held twelve
       * trails under ids 1-12, which are real ids in the catalog, so
       * `findTrail(1)` answered with a fabricated trail and a detail page
       * painted it under a URL for a different one — and because that page
       * skips its fetch when the store already holds the id, the real record
       * was never requested.
       *
       * It cost three patches before it was removed: `hydrateTrailsFromApi`
       * learned to throw the fixtures away, `upsertTrailFromApi` learned to
       * drop a stale route so a seeded line was not drawn under a real trail,
       * and the detail page learned to refuse a fixture outright. None of that
       * is needed once nothing fabricates a trail to begin with.
       */
      trails: [] as Trail[],
      /**
       * Ids of trails fetched one at a time, by a detail page.
       *
       * The catalog is ~600k rows and the bootstrap loads the featured 200, so
       * a trail reached directly — every result from search, every shared
       * link, every one of the sitemap's URLs — is almost never in that set.
       * It arrives through `upsertTrailFromApi`, and without a record of that
       * the next `hydrateTrailsFromApi` cannot tell it apart from the demo
       * fixtures it is there to throw away.
       */
      apiTrailIds: [] as number[],
      activities: seedActivities,
      // Only the API fills these. The demo territories that seeded them sat
      // under ids 1-10, which are real territory ids, and stayed on screen
      // whenever the map loaded late or not at all: the record screen offered
      // "Cascade Ridge Zone" as a target, sent its id to the server as the
      // focus of a run, and a detail page showed Yosemite under a real
      // territory's URL.
      territories: [] as Territory[],
      // Battles come only from /api/territories/battles. The demo list that
      // used to seed this had three "active" battles in it, so the feed said
      // turf was being taken right now whether or not anything was.
      conquests: [] as Conquest[],
      // The signed-in player's own battles, all of them (`?mine=1`). Their
      // record is folded from these, not from the game-wide feed above.
      myConquests: [] as Conquest[],
      // Only the API fills this, for the same reason: a player with no
      // challenges was shown six between demo athletes, some naming them.
      challenges: [] as Challenge[],
      reviews: seedReviews,
      // Club discovery is backed by /api/clubs. Starting empty prevents SSR
      // from emitting links to demo-only ids before live hydration completes.
      clubs: [] as Club[],
      achievements: seedAchievements,
      // Only the API fills this. The demo list that seeded it lit the unread
      // badge for notifications nobody had sent.
      notifications: [] as Notification[],
      segments: seedSegments,
      userStats: seedUserStats,
      conquestStats: seedConquestStats,
      // Keyed by trail id, and the seed that filled it used the same ids 1-12
      // as the trail fixtures — a demo line under whatever real trail shares
      // the id. `trailRouteParts` below has always started empty; this now
      // matches it.
      trailRoutes: {} as Record<number, [number, number][]>,
      /**
       * Every part of the trails that are in more than one piece (trail id →
       * parts), for drawing the whole trail. `trailRoutes` holds each trail's
       * main line; the parts are never joined into it, because the join would
       * be a straight line across whatever lies between them.
       */
      trailRouteParts: {} as Record<number, [number, number][][]>,
      territoryPolygons: {} as Record<number, [number, number][]>,
      /** GPS samples inside enemy polygons this session (territory id → count). */
      captureSamples: {} as Record<number, number>,
      sessionXp: 0,
      /** Trail ids the current user has saved (hydrated from the API, #969). */
      savedTrailIds: [] as number[],
      /** User ids the current user follows (hydrated from /api/users/{id}/follows). */
      following: [] as number[],
      /**
       * The page on screen, for the tab bar's highlight. Kept here because
       * layout components stop re-rendering after an in-app navigation
       * (stacksjs/stx#1958); state every instance shares still updates.
       */
      currentPath: '',
    }),

    getters: {
      currentUser: (state) => state.users.find(u => u.id === state.currentUserId) ?? null,
      unreadCount: (state) => state.notifications.filter(n => !n.read).length,
    },

    // Every action changes state by assigning a new value to it, never by
    // mutating one in place. A write to an object inside a list (a.read =
    // true, Object.assign(existing, …)) reaches no signal at all, so nothing
    // re-renders; an in-place push only does on stx 0.2.303 and later.
    actions: {
      /** Merge a server-verified identity into the catalog and select it. */
      hydrateAuthenticatedUser(user: Partial<User> & { id: number, created_at?: string }) {
        const existing = this.users.find((candidate: User) => candidate.id === user.id)
        // `undefined` means the payload did not say (an older cached copy);
        // `null` means the server cleared it, e.g. a removed photo.
        const normalized = {
          id: user.id,
          name: user.name || existing?.name || 'Athlete',
          email: user.email || existing?.email || '',
          avatar: user.avatar !== undefined ? user.avatar : existing?.avatar ?? null,
          bio: user.bio !== undefined ? user.bio : existing?.bio ?? null,
          location: user.location !== undefined ? user.location : existing?.location ?? null,
          joinedAt: user.joinedAt || user.created_at || existing?.joinedAt || new Date().toISOString(),
          roles: user.roles ?? existing?.roles ?? [],
          // Unknown until /api/me says, and unknown reads as "has one".
          hasPassword: user.hasPassword ?? existing?.hasPassword,
        }
        this.users = existing
          ? this.users.map((candidate: User) => candidate.id === user.id ? { ...candidate, ...normalized } : candidate)
          : [...this.users, normalized]
        this.currentUserId = user.id
        // Activities and battles often land before /api/me answers, so both
        // folds have to run again once we know whose page this is.
        this.recomputeUserStats()
        this.recomputeConquestStats()
      },
      setCurrentPath(path: string) {
        this.currentPath = path
      },
      clearAuthenticatedUser() {
        this.currentUserId = 0
        // What belonged to that account goes with it. Signing out left the
        // feed saying "Following" on everyone the last athlete followed, and
        // their saved hearts and unread badge in place for whoever came next.
        this.following = []
        this.savedTrailIds = []
        this.notifications = []
        this.captureSamples = {}
        this.sessionXp = 0
      },
      provideServices(services: Partial<AppServices>) {
        Object.assign(appServices, services)
      },
      /** Sign in; resolves to an error message, or null. */
      signIn(email: string, password: string): Promise<string | null> {
        return appServices.signIn?.(email, password) ?? Promise.resolve(SERVICES_NOT_READY)
      },
      /** Register; resolves to an error message, or null. */
      signUp(name: string, email: string, password: string): Promise<string | null> {
        return appServices.signUp?.(name, email, password) ?? Promise.resolve(SERVICES_NOT_READY)
      },
      signOut(): Promise<void> {
        return appServices.signOut?.() ?? Promise.resolve()
      },
      /** Leave for the full sign-in or sign-up page, coming back here afterwards. */
      openAuthPage(mode: 'login' | 'register') {
        appServices.openAuthPage?.(mode)
      },
      /** A light haptic tick on native; nothing on the web. */
      tap() {
        appServices.tap?.()
      },
      /**
       * Replace seed trails with API/OSM data when available.
       *
       * Everything the seed shipped goes; individually-fetched trails stay.
       * Both loads run on a detail page — the layout bootstraps the featured
       * list on every route — and this one usually lands second, so a plain
       * `this.trails = trails` silently deleted the very trail the page was
       * opened to show. It looked like a missing record: the fetch returned
       * 200, the upsert ran, and the page still rendered "Trail not found",
       * for every trail outside the featured 200.
       */
      hydrateTrailsFromApi(
        trails: Trail[],
        routes: Record<number, [number, number][]>,
        parts: Record<number, [number, number][][]> = {},
      ) {
        const incoming = new Set(trails.map((trail: Trail) => trail.id))
        const kept = this.trails.filter((trail: Trail) =>
          this.apiTrailIds.includes(trail.id) && !incoming.has(trail.id))

        this.trails = [...trails, ...kept]
        // A trail the API sent without a line has no route, whatever the seed
        // filed under the same id. Merging over the old map kept the seed's,
        // which drew Sedona's loop under Half Dome.
        const merged = { ...this.trailRoutes, ...routes }
        const mergedParts = { ...this.trailRouteParts, ...parts }
        for (const id of incoming) {
          if (!routes[id])
            delete merged[id]
          if (!parts[id])
            delete mergedParts[id]
        }
        this.trailRoutes = merged
        this.trailRouteParts = mergedParts
      },
      upsertTrailFromApi(trail: Trail, route?: [number, number][], parts?: [number, number][][]) {
        const index = this.trails.findIndex((candidate: Trail) => candidate.id === trail.id)
        this.trails = index >= 0
          ? this.trails.map((candidate: Trail, i: number) => i === index ? trail : candidate)
          : [...this.trails, trail]
        if (!this.apiTrailIds.includes(trail.id))
          this.apiTrailIds = [...this.apiTrailIds, trail.id]
        // The API is the truth for this id, including when it has no line.
        // Keeping whatever was stored drew a demo trail's route (Sedona,
        // seeded under the same id) under a real trail that has none.
        if (route && route.length >= 2) {
          this.trailRoutes = { ...this.trailRoutes, [trail.id]: route }
        }
        else if (this.trailRoutes[trail.id]) {
          const { [trail.id]: _stale, ...rest } = this.trailRoutes
          this.trailRoutes = rest
        }
        if (parts && parts.length > 1) {
          this.trailRouteParts = { ...this.trailRouteParts, [trail.id]: parts }
        }
        else if (this.trailRouteParts[trail.id]) {
          const { [trail.id]: _staleParts, ...restParts } = this.trailRouteParts
          this.trailRouteParts = restParts
        }
      },
      /** Replace seed territories with live data from /api/territories/map. */
      hydrateTerritoriesFromApi(
        territories: Territory[],
        polygons: Record<number, [number, number][]>,
        users: User[],
      ) {
        this.territories = territories
        this.territoryPolygons = polygons
        // Upsert the owners, rather than only adding unfamiliar ones.
        //
        // The store ships demo users occupying ids 1..N, so a real owner whose
        // id collided with one of them was skipped and the territory rendered
        // under the fixture's name — "Owned by Jake Thompson" on land that
        // belongs to a seeded athlete. The API's users are the truth here, so
        // a matching id is overwritten and only genuinely new owners appended.
        const next = [...this.users]
        for (const u of users) {
          const index = next.findIndex((candidate: User) => candidate.id === u.id)
          if (index >= 0)
            next[index] = { ...next[index], ...u }
          else
            next.push(u)
        }
        this.users = next
      },
      /** Insert or replace one territory fetched on its own (a detail page). */
      upsertTerritoryFromApi(territory: Territory, polygon: [number, number][] | null, owner: User) {
        const index = this.territories.findIndex((t: Territory) => t.id === territory.id)
        this.territories = index >= 0
          ? this.territories.map((t: Territory, i: number) => i === index ? territory : t)
          : [...this.territories, territory]
        if (polygon)
          this.territoryPolygons = { ...this.territoryPolygons, [territory.id]: polygon }
        const ownerIndex = this.users.findIndex((u: User) => u.id === owner.id)
        this.users = ownerIndex >= 0
          ? this.users.map((u: User, i: number) => i === ownerIndex ? { ...u, ...owner } : u)
          : [...this.users, owner]
      },
      /** Replace seed activities with live data from /api/activities. */
      hydrateActivitiesFromApi(activities: Activity[]) {
        this.activities = activities
        this.recomputeUserStats()
      },
      /**
       * Refold the signed-in athlete's training totals from their activities.
       *
       * `userStats` was a fixture and nothing ever replaced it, so /stats and
       * /profile showed the same 78.4 miles and 12-day streak for every
       * account — including one with no activities at all. There is no
       * endpoint for these numbers (user_stats has no weekly or monthly
       * split), and folding them from the activities already in the store is
       * what keeps the summary and the feed below it in agreement.
       */
      recomputeUserStats() {
        if (!this.currentUserId)
          return
        this.userStats = computeTrainingStats(this.currentUserId, this.activities)
      },
      hydrateConquestsFromApi(conquests: Conquest[]) {
        this.conquests = conquests
        this.recomputeConquestStats()
      },
      hydrateMyConquestsFromApi(conquests: Conquest[]) {
        this.myConquests = conquests
        this.recomputeConquestStats()
      },
      /**
       * Refold the signed-in athlete's game record from the battle feed.
       *
       * `conquestStats` was a fixture too, so /conquests reported the same
       * three conquests and six defences to every account regardless of what
       * the battles below the counters actually said.
       */
      recomputeConquestStats() {
        if (!this.currentUserId)
          return
        // The player's own history once it has arrived; until then, what the
        // game-wide feed shows of them.
        this.conquestStats = computeConquestRecord(this.currentUserId, this.myConquests.length > 0 ? this.myConquests : this.conquests)
      },
      findTrail(id: number): Trail | undefined {
        return this.trails.find((t: Trail) => t.id === id)
      },
      findTerritory(id: number): Territory | undefined {
        return this.territories.find((t: Territory) => t.id === id)
      },
      findActivity(id: number): Activity | undefined {
        return this.activities.find((a: Activity) => a.id === id)
      },
      findUser(id: number): User | undefined {
        return this.users.find((u: User) => u.id === id)
      },
      trailReviews(trailId: number): Review[] {
        return this.reviews.filter((r: Review) => r.trail_id === trailId)
      },
      trailSegments(trailId: number): Segment[] {
        return this.segments.filter((s: Segment) => s.trail_id === trailId)
      },
      territoryConquests(territoryId: number): Conquest[] {
        return this.conquests.filter((c: Conquest) => c.territory_id === territoryId)
      },
      addActivity(activity: Omit<Activity, 'id' | 'created_at'> & { id?: number }) {
        // Use the backend id when the caller has one (manual entry), otherwise
        // synthesize a local id (recorder's optimistic insert).
        const id = activity.id ?? Math.max(0, ...this.activities.map((a: Activity) => a.id)) + 1
        this.activities = [{
          ...activity,
          id,
          created_at: new Date().toISOString(),
        } as Activity, ...this.activities]
      },
      /** Apply an edit returned by PATCH /api/activities/{id}. */
      patchActivity(id: number, fields: Partial<Activity>) {
        this.activities = this.activities.map((a: Activity) => a.id === id ? { ...a, ...fields } : a)
      },
      removeActivity(id: number) {
        this.activities = this.activities.filter((a: Activity) => a.id !== id)
      },
      toggleKudos(activityId: number, delta: number) {
        this.activities = this.activities.map((a: Activity) =>
          a.id === activityId ? { ...a, kudos_count: Math.max(0, a.kudos_count + delta) } : a)
      },
      /** Set the authoritative kudos count returned by the backend. */
      setActivityKudos(activityId: number, count: number) {
        this.activities = this.activities.map((a: Activity) => a.id === activityId ? { ...a, kudos_count: count } : a)
      },
      /** Replace the current user's following list (from the API). */
      hydrateFollowing(ids: number[]) {
        this.following = ids
      },
      /** Replace notifications with live data from /api/notifications. */
      hydrateNotifications(list: Notification[]) {
        this.notifications = list
      },
      /** Replace achievements with live engine data (#982). */
      hydrateAchievements(list: Achievement[]) {
        if (list.length)
          this.achievements = list
      },
      /** Replace saved trail ids with live data (#969). */
      hydrateSavedTrails(ids: number[]) {
        this.savedTrailIds = ids
      },
      /** Mirror the backend's recomputed trail rating/review_count (#981). */
      setTrailRating(trailId: number, rating: number, reviewCount: number) {
        this.trails = this.trails.map((t: Trail) => t.id === trailId ? { ...t, rating, reviewCount } : t)
      },
      /** Replace challenges with live API data (#965). */
      hydrateChallenges(list: Challenge[]) {
        // An empty answer is an answer: no challenges.
        this.challenges = list
      },
      /** Insert or replace a challenge (create/respond outcome, #965). */
      upsertChallenge(challenge: Challenge) {
        const i = this.challenges.findIndex((c: Challenge) => c.id === challenge.id)
        this.challenges = i >= 0
          ? this.challenges.map((c: Challenge, index: number) => index === i ? challenge : c)
          : [challenge, ...this.challenges]
      },
      /** Replace clubs with live API data (#964). */
      hydrateClubs(list: Club[]) {
        this.clubs = list
      },
      /** Prepend a newly-created club (#964). */
      addClub(club: Club) {
        this.clubs = [club, ...this.clubs.filter((c: Club) => c.id !== club.id)]
      },
      /** Reflect a join/leave toggle on a club (#964). */
      applyClubMembership(clubId: number, joined: boolean, memberCount: number) {
        const me = this.currentUserId
        this.clubs = this.clubs.map((c: Club) => {
          if (c.id !== clubId) return c
          const members = new Set(c.members ?? [])
          if (joined) members.add(me)
          else members.delete(me)
          return {
            ...c,
            members: [...members],
            isMember: joined,
            ...(typeof memberCount === 'number' && { memberCount }),
          }
        })
      },
      isTrailSaved(trailId: number): boolean {
        return (this.savedTrailIds ?? []).includes(trailId)
      },
      setTrailSaved(trailId: number, saved: boolean) {
        const has = (this.savedTrailIds ?? []).includes(trailId)
        if (saved && !has)
          this.savedTrailIds = [...(this.savedTrailIds ?? []), trailId]
        else if (!saved && has)
          this.savedTrailIds = (this.savedTrailIds ?? []).filter((id: number) => id !== trailId)
      },
      /** Reflect a follow/unfollow toggle in the local following list. */
      setFollowing(userId: number, isFollowing: boolean) {
        const has = this.following.includes(userId)
        if (isFollowing && !has) this.following = [...this.following, userId]
        else if (!isFollowing && has) this.following = this.following.filter((id: number) => id !== userId)
      },
      isFollowing(userId: number): boolean {
        return this.following.includes(userId)
      },
      addComment(activityId: number, text: string) {
        const user = this.users.find((u: User) => u.id === this.currentUserId)
        if (!user || !this.activities.some((a: Activity) => a.id === activityId)) return
        const comment = {
          user_id: user.id,
          userName: user.name,
          text,
          created_at: new Date().toISOString(),
        }
        this.activities = this.activities.map((a: Activity) =>
          a.id === activityId ? { ...a, comments: [...a.comments, comment] } : a)
      },
      markNotificationRead(id: number) {
        this.notifications = this.notifications.map((n: Notification) => n.id === id ? { ...n, read: true } : n)
      },
      markAllNotificationsRead() {
        this.notifications = this.notifications.map((n: Notification) => ({ ...n, read: true }))
      },
      timeAgo(dateStr: string): string {
        if (!dateStr) return ''
        const diff = Date.now() - new Date(dateStr).getTime()
        const mins = Math.floor(diff / 60000)
        if (mins < 1) return 'just now'
        if (mins < 60) return `${mins}m ago`
        const hours = Math.floor(mins / 60)
        if (hours < 24) return `${hours}h ago`
        const days = Math.floor(hours / 24)
        if (days < 7) return `${days}d ago`
        return `${Math.floor(days / 7)}w ago`
      },
      /** Enemy zones you can capture on your next run (Interval-style turf war). */
      attackableTerritories(): Territory[] {
        return this.territories.filter((t: Territory) => t.user_id !== this.currentUserId)
      },
      myTerritories(): Territory[] {
        return this.territories.filter((t: Territory) => t.user_id === this.currentUserId)
      },
      liveConquests(): Conquest[] {
        return this.conquests.filter((c: Conquest) => c.status === 'active')
      },
      /**
       * Live capture meter: each GPS hit inside an enemy polygon adds progress.
       * Returns 0-100. Visual only: the server decides every battle.
       */
      applyCaptureSample(territoryId: number, samplesNeeded = 10): number {
        const prev = this.captureSamples[territoryId] ?? 0
        const next = Math.min(samplesNeeded, prev + 1)
        this.captureSamples = { ...this.captureSamples, [territoryId]: next }
        return Math.round((next / samplesNeeded) * 100)
      },
      resetCaptureSamples(): void {
        this.captureSamples = {}
        this.sessionXp = 0
      },
    },

    // PERSIST-KEY DISCIPLINE (#988): a persisted snapshot fully REPLACES the
    // seeded state on hydration, so any breaking change to the store's shape -
    // a renamed/removed field, a changed enum vocabulary, or a new field that
    // older snapshots lack and code assumes - MUST bump this version suffix
    // (-v4 -> -v5 …). Bumping invalidates every stale snapshot in the wild so
    // the new shape/seed actually takes effect instead of being masked.
    // History: v3 - territory status 'secure' -> 'active' (#942);
    //          v4 - added savedTrailIds for saved trails (#969).
    // The Wildloop rebrand rotated the namespace off `trailbuddy-tb-`, which
    // already orphans every snapshot written under the old name. The shape is
    // unchanged, so the suffix stays at v4 and the key drops the now-redundant
    // store-id segment rather than reading `wildloop-wl-`.
    //          v6 - no demo territories, polygons or challenges; a snapshot
    //               would otherwise keep showing them as real.
    persist: { key: 'wildloop-v6' },
  })
</script>

<!-- STX needs a concrete root to hydrate this client-only store bootstrap. -->
<div class="contents" aria-hidden="true"></div>
