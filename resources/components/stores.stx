  ]

  /**
   * What the layout hands the store at start-up, so components can sign in,
   * sign out or tap without bundling their own copy of the auth client and the
   * native bridge: stx inlines a component's imports into that component
   * (stacksjs/stx#1957), which put three copies of each on every page.
   */
  interface AppServices {
    signIn: (email: string, password: string) => Promise<string | null>
    signUp: (name: string, email: string, password: string) => Promise<string | null>
    signOut: () => Promise<void>
    openAuthPage: (mode: 'login' | 'register') => void
    tap: () => void
  }

  const appServices: Partial<AppServices> = {}
  const SERVICES_NOT_READY = 'Wildloop is still starting. Try again in a moment.'

  const seedSegments: Segment[] = [
    { id: 1, name: 'Cascade Switchbacks', trail_id: 3, distance: 1.2, elevation: 480, leaderTime: '8:15', leaderName: 'Marcus Johnson', yourTime: '8:52', yourRank: 3, totalAttempts: 45 },
    { id: 2, name: 'Thunder Ridge Sprint', trail_id: 6, distance: 0.8, elevation: 320, leaderTime: '5:42', leaderName: 'Jake Thompson', yourTime: '6:18', yourRank: 5, totalAttempts: 38 },
