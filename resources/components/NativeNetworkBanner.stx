<script client>
import { network } from '@stacksjs/mobile'
import { onDestroy, onMount } from 'stx'

const className = useReactiveProp<string>('class', '')
const offlineLabel = useReactiveProp<string>('offlineLabel', 'You are offline. Changes will sync automatically.')
const connected = state(true)
let removeListener: (() => void) | null = null

function applyStatus(status: { isConnected: boolean }): void {
  connected.set(status.isConnected)
}

onMount(() => {
  void network.getStatus().then(applyStatus).catch(() => connected.set(false))
  removeListener = network.onChange(applyStatus)
})

onDestroy(() => removeListener?.())
</script>

<!--
  Visibility is a class, not `:if`.

  A component's `:if` binds once and then never re-runs inside Craft's
  WebView — it reads correctly on the first pass and is deaf to the signal
  afterwards, silently, while the same markup works in Safari and in every
  browser. This banner starts connected, so `:if` removed it on that first
  pass and the app could never tell you it had gone offline. Class bindings
  do re-run there, so the element stays mounted and only its display changes.

  Both states go through the one `:class`. Each class binding captures the
  element's classes when it binds and then assigns `className` outright, so a
  second binding on the same element overwrites whatever the first decided —
  which left this banner stuck in one state whichever way the signal went.
-->
<div
  role="status"
  aria-live="polite"
  class="native-network-banner"
  :class="(connected() ? 'native-network-banner--quiet ' : '') + className()"
>
  <i aria-hidden="true" class="h-4 w-4 i-hugeicons-wifi-disconnected-01"></i>
  <span>{{ offlineLabel() }}</span>
</div>

<style>
  .native-network-banner {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.625rem 1rem;
    color: rgb(120 53 15);
    background: rgb(254 243 199 / 0.96);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  /* After the base rule and doubled up: both are single-class selectors, so
     source order alone decided it, and `display: flex` won. */
  .native-network-banner.native-network-banner--quiet { display: none; }

  @media (prefers-color-scheme: dark) {
    .native-network-banner { color: rgb(254 243 199); background: rgb(120 53 15 / 0.96); }
  }
</style>
