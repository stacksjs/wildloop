@include('../components/styles')
@include('../components/theme')
<link rel="stylesheet" href="/css/ts-maps.css" data-ts-maps-css>
<link rel="manifest" href="/manifest.webmanifest">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#059669">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
@include('../components/stores')

<script client>
  import { useWildLoopApp } from '../composables/useWildLoopApp'
  import { useNativeServices } from '../composables/useNativeServices'

  useWildLoopApp()
  useNativeServices()
</script>

<NativeAppShell tabBar>
  <NativeNetworkBanner />
  @include('../components/mobile-header')
  <div class="hidden lg:block">
    @include('../components/nav')
  </div>

  <main class="flex-1">
    @slot('content')
  </main>

  <div class="mt-auto hidden shrink-0 lg:block">
    @include('../components/footer')
  </div>

  <!-- The sign-in wall, mounted once so every gated control on every page
       shares one modal and one queued intent (see useAuthGate). -->
  <AuthGate />

  <template #tab-bar>
    <div class="lg:hidden">
      <NativeTabBar label="WildLoop navigation">
        <NativeTabItem label="Feed" href="/feed" icon="i-lucide-house" />
        <NativeTabItem label="Trails" href="/trails" icon="i-lucide-map" />
        <NativeTabItem label="Record" href="/record" icon="i-lucide-circle-dot" />
        <NativeTabItem label="Territory" href="/territories" icon="i-lucide-flag" />
        <NativeTabItem label="Profile" href="/profile" icon="i-lucide-user" />
      </NativeTabBar>
    </div>
  </template>
</NativeAppShell>

<style>
  /* The shell reserves a full viewport, but its content was a plain block, so
     `main.flex-1` and the footer's `mt-auto` had nothing to grow against. On a
     short page — a territory with little history, an empty state — the footer
     sat wherever the content ended and left dead space under it. Making the
     content a column is what puts the footer on the bottom of the viewport
     when the page is short, and below the content when it is not. */
  [data-native-app-shell] .native-app-content {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 1024px) {
    [data-native-app-shell] .native-app-content {
      padding-bottom: 0;
    }

    [data-native-app-shell] .native-app-tab-slot {
      display: none;
    }
  }
</style>
