@include('../components/styles')
@include('../components/theme')
<link rel="stylesheet" href="/css/ts-maps.css" data-ts-maps-css>
<link rel="manifest" href="/manifest.webmanifest">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#059669">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
@include('../components/stores')

<script client>
  import { useWildLoopApp } from '../composables/useWildLoopApp'
  import { useNativeServices } from '../composables/useNativeServices'

  useWildLoopApp()
  useNativeServices()
</script>

<NativeAppShell tabBar>
  <NativeNetworkBanner />
  @include('../components/mobile-header')
  <!-- Sticky here, not only on the nav inside: a sticky element sticks within
       its parent, and this wrapper is exactly the nav's height, so the nav's
       own `sticky` had no room and the bar scrolled off with the page. -->
  <div class="sticky top-0 z-50 hidden lg:block">
    @include('../components/nav')
  </div>

  <main class="flex-1">
    @slot('content')
  </main>

  <div class="mt-auto hidden shrink-0 lg:block">
    @include('../components/footer')
  </div>

  <!-- The sign-in wall, mounted once so every gated control on every page
       shares one modal and one queued intent (see useAuthGate). -->
  <AuthGate />

  <template #tab-bar>
    <div class="native-tab-visibility">
      <NativeTabBar label="WildLoop navigation">
        <NativeTabItem label="Feed" href="/feed" icon="i-lucide-house" />
        <NativeTabItem label="Record" href="/record" icon="i-lucide-circle-dot" />
        <NativeTabItem label="Menu" href="/menu" icon="i-lucide-menu" />
      </NativeTabBar>
    </div>
  </template>
</NativeAppShell>

<style>
  /* The shell reserves a full viewport, but its content was a plain block, so
     `main.flex-1` and the footer's `mt-auto` had nothing to grow against. On a
     short page — a territory with little history, an empty state — the footer
     sat wherever the content ended and left dead space under it. Making the
     content a column is what puts the footer on the bottom of the viewport
     when the page is short, and below the content when it is not. */
  [data-native-app-shell] .native-app-content {
    display: flex;
    flex-direction: column;
  }

  /* A page's own overlay (the trail review sheet) is rendered inside <main>,
     and <main> carries the router's view-transition-name, which makes it a
     stacking context: the overlay sat under the sticky header and the tab bar
     whatever its z-index. While one is open, <main> gives the name up so the
     overlay stacks against the whole page. Nothing navigates with a sheet
     open, so no page transition is lost. */
  main:has([data-page-overlay][data-open="true"]) {
    view-transition-name: none;
  }

</style>
