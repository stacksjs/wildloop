<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import { onNativeAccountChange, createNativeApi } from '../functions/native-api'
import { formatTerritoryArea, territoryColor } from '../functions/territory-style'
import {
  filterTerritories,
  TERRITORY_FILTER_LABELS,
  TERRITORY_FILTERS,
  TERRITORY_RADIUS_KM,
  territoriesMapPath,
  territoryBadge,
  territoryGeometry,
  territoryLeaderboard,
  territoryOwnerLine,
  territoryRowsFrom,
  zonesHeldText,
} from '../functions/territories'
import { mapBoundsAround } from '../functions/map-area'

/*
 * The territory map, natively. Twelfth screen, and the first to draw a real
 * map rather than an SVG thumbnail.
 *
 * `Map` with a `MapPolyline` per zone is the whole reason this screen waited:
 * the renderer arrived in craft-native 0.0.174 and the pin sat at 0.0.173
 * because 0.0.174 and 0.0.175 did not compile. stx compiles the markup on
 * 0.2.520, and the bound `:geometry` reaches the host as an `updateNode` props
 * patch in the first post-mount batch — see
 * tests/unit/native-conditional-timing.test.ts, and the note in CLAUDE.md
 * about the two issues I filed off a misreading of the initial RENDER.
 *
 * There is no polygon primitive, only polylines and markers, so a zone is a
 * polyline closed by repeating its first point (`territoryGeometry`). Colour
 * is identity and comes from `territory-style`, shared with the web map, so
 * the same athlete is the same colour on both.
 *
 * Narrower than the web page: no place search and no viewport refetch. The
 * screen loads the land around the athlete once. Panning to another city is
 * what the web map is for.
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft

const filterIndex = state(0)
const rows = state<any[]>([])
const viewerId = state(0)
{{-- The box the map asked for, or null while the device has not said. --}}
const viewport = state<any>(null)
const loading = state(true)
const error = state('')
const signedOut = state(false)
const api = createNativeApi(craft)
let active = true

function filter(): any {
  return TERRITORY_FILTERS[filterIndex()]
}

function filterName(): string {
  return TERRITORY_FILTER_LABELS[filter()]
}

function cycleFilter(): void {
  filterIndex.set((filterIndex() + 1) % TERRITORY_FILTERS.length)
}

function shown(): any[] {
  return filterTerritories(rows(), filter(), viewerId())
}

/*
 * One polyline per zone that has a boundary. A zone whose feature carried no
 * geometry still appears in the list below — it just cannot be drawn.
 */
function shapes(): any[] {
  const drawable: any[] = []
  for (const row of shown()) {
    const geometry = territoryGeometry(row.ring)
    if (geometry.length > 0)
      drawable.push({ id: row.id, geometry, color: territoryColor(row.userId, viewerId()) })
  }
  return drawable
}

function holders(): any[] {
  return territoryLeaderboard(rows())
}

function areaText(row: any): string {
  return formatTerritoryArea(row.areaSize)
}

function badgeText(row: any): string {
  return territoryBadge(row, viewerId())
}

function ownerText(row: any): string {
  return territoryOwnerLine(row, viewerId())
}

function holderName(holder: any): string {
  return holder.userId === viewerId() ? 'You' : holder.userName
}

function holderZones(holder: any): string {
  return zonesHeldText(holder.zones)
}

function holderArea(holder: any): string {
  return formatTerritoryArea(holder.area)
}

function rankText(holder: any): string {
  return String(holder.rank)
}

function emptyTitle(): string {
  return filter() === 'contested' ? 'Nothing contested right now' : 'No territories yet'
}

function emptyBody(): string {
  return filter() === 'contested'
    ? 'Every zone in view is held without a fight.'
    : 'Run a closed loop to claim your first territory.'
}

function openTerritory(row: any): void {
  craft.navigation.open(`/territory/${row.id}`)
}

let loadVersion = 0
async function load(): Promise<void> {
  const currentLoad = ++loadVersion
  loading.set(true)
  error.set('')
  try {
    const token = await api.readToken()
    if (!token) {
      if (active && currentLoad === loadVersion)
        signedOut.set(true)
      return
    }

    const me = await api.send('/api/me')
    if (!me.ok || !me.body?.user?.id) {
      if (active && currentLoad === loadVersion)
        signedOut.set(true)
      return
    }
    if (active && currentLoad === loadVersion)
      viewerId.set(Number(me.body.user.id))

    {{-- Scoped to the ground around the viewer when the device will say
         where that is. Without it the screen asks for every zone on earth and
         the heading above the list — 'Nearby territories' — is a fiction. --}}
    const result = await api.send(territoriesMapPath(viewport()))
    if (!active || currentLoad !== loadVersion)
      return
    if (!result.ok)
      throw new Error('Could not load the territory map')

    const nearby = territoryRowsFrom(result.body)
    {{-- Nobody has claimed anything within reach yet — which is the normal
         state of a new map, and an empty screen is a poor way to say it. Ask
         again without the box so the viewer at least sees where the game is
         being played. --}}
    if (nearby.length === 0 && viewport()) {
      const anywhere = await api.send(territoriesMapPath())
      if (!active || currentLoad !== loadVersion)
        return
      if (anywhere.ok) {
        rows.set(territoryRowsFrom(anywhere.body))
        return
      }
    }
    rows.set(nearby)
  }
  catch (cause) {
    if (active && currentLoad === loadVersion)
      error.set(cause instanceof Error ? cause.message : 'Could not load the territory map')
  }
  finally {
    if (active && currentLoad === loadVersion)
      loading.set(false)
  }
}

/**
 * Ask the device where it is, then load. A refusal, a build without the
 * capability, or a position that never arrives all fall through to the
 * unscoped request this screen made before — a worldwide map is a poor map,
 * but it beats an empty one.
 */
async function locateThenLoad(): Promise<void> {
  try {
    if (!craft.location)
      throw new Error('no location in this build')
    const point = await craft.location.getCurrentPosition({ enableHighAccuracy: false, timeout: 15000 })
    {{-- A refused position comes back as an object without coordinates rather
         than as a rejection, and an unchecked one reaches the API as
         `min_lat=NaN`: a viewport the server cannot read, from a screen that
         believes it asked for one. --}}
    if (active && Number.isFinite(point?.latitude) && Number.isFinite(point?.longitude))
      viewport.set(mapBoundsAround({ lat: point.latitude, lng: point.longitude }, TERRITORY_RADIUS_KM))
  }
  catch {
    // Not an error the viewer needs to see: the map simply stays worldwide.
  }
  await load()
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Territory', largeTitle: true })
  void locateThenLoad()
})

onDestroy(() => {
  active = false
})
onMount(() => onNativeAccountChange(craft, () => { rows.set([]); void load() }))
</script>

<SafeAreaView class="flex-1 bg-[#f2f4ef] dark:bg-[#101c16]">
  <ScrollView class="p-4" testID="territories-scroll">
    <Text class="mt-1 text-sm text-[#51604e] dark:text-[#b0bfac]">Green is yours. Run a closed loop to claim new ground.</Text>

    <ActivityIndicator :show="loading" testID="territories-loading" class="mt-6" />
    <Text :show="error" testID="territories-error" class="mt-4 text-[#b4232a] dark:text-[#ff8487]" :text="error" />
    <Text :show="signedOut" testID="territories-signed-out" class="mt-4 text-amber-300">Sign in on the web to see your territory.</Text>

    <View :show="rows().length > 0" testID="territories-body" class="mt-5 gap-4">
      {{-- The map. `fitToBounds` frames whatever is drawn, so the screen opens
           on the athlete's own ground rather than the middle of the ocean. --}}
      <View :show="shapes().length > 0" testID="territory-map-frame" class="h-64 overflow-hidden rounded-2xl bg-white dark:bg-[#1b2c22]">
        <Map testID="territory-map" class="flex-1" :fitToBounds="true" :showsUserLocation="true" mapType="standard">
          <MapPolyline :for="shape in shapes()" :key="shape.id" :geometry="shape.geometry" :strokeColor="shape.color" :strokeWidth="3" />
        </Map>
      </View>

      <View class="gap-2">
        <Text testID="territories-filter" class="text-xs font-semibold uppercase text-[#64745f] dark:text-[#91a28b]" :text="filterName()" />
        <Button testID="cycle-filter" @click="cycleFilter()">Change the filter</Button>
      </View>

      <Text :show="shown().length === 0" testID="territories-empty-title" class="mt-2 text-base font-semibold text-[#192414] dark:text-[#f0f5ec]" :text="emptyTitle()" />
      <Text :show="shown().length === 0" testID="territories-empty-body" class="text-sm text-[#51604e] dark:text-[#b0bfac]" :text="emptyBody()" />

      <View :show="shown().length > 0" class="gap-2">
        <Text class="text-xs font-semibold uppercase text-[#64745f] dark:text-[#91a28b]">Nearby territories</Text>
        <Pressable :for="row in shown()" :key="row.id" testID="territory-row" @click="openTerritory(row)" class="gap-2 rounded-xl bg-white dark:bg-[#1b2c22] p-3">
          <View class="flex-row justify-between">
            <Text class="flex-1 text-sm font-semibold text-[#192414] dark:text-[#f0f5ec]" :text="row.name" />
            <Text testID="territory-badge" class="text-xs text-[#51604e] dark:text-[#b0bfac]" :text="badgeText(row)" />
          </View>
          <Text class="text-xs text-[#64745f] dark:text-[#91a28b]" :text="ownerText(row)" />
          <View class="flex-row gap-4">
            <Text testID="territory-area" class="text-xs text-[#51604e] dark:text-[#b0bfac]" :text="areaText(row)" />
            <Text class="text-xs text-[#64745f] dark:text-[#91a28b]" :text="row.conquestCount" />
            <Text class="text-xs text-[#64745f] dark:text-[#91a28b]" :text="row.defendCount" />
          </View>
        </Pressable>
      </View>

      {{-- Who holds the land in view, built from the zones themselves rather
           than a roster — a roster lists strangers holding nothing. --}}
      <View :show="holders().length > 0" testID="territory-leaders" class="gap-2">
        <Text class="text-xs font-semibold uppercase text-[#64745f] dark:text-[#91a28b]">Territory leaders</Text>
        <View :for="holder in holders()" :key="holder.userId" class="flex-row items-center gap-3 rounded-xl bg-white dark:bg-[#1b2c22] p-3">
          <Text testID="holder-rank" class="text-xs font-bold text-amber-400" :text="rankText(holder)" />
          <View class="flex-1">
            <Text class="text-sm font-semibold text-[#192414] dark:text-[#f0f5ec]" :text="holderName(holder)" />
            <Text testID="holder-zones" class="text-xs text-[#64745f] dark:text-[#91a28b]" :text="holderZones(holder)" />
          </View>
          <Text testID="holder-area" class="text-sm font-semibold text-slate-200" :text="holderArea(holder)" />
        </View>
      </View>
    </View>
  </ScrollView>
</SafeAreaView>
