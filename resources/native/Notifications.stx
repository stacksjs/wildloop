<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import {
  groupNotificationsByDay,
  matchesNotificationFilter,
  NOTIFICATION_FILTERS,
  notificationRowsFrom,
  timeAgo,
} from '../functions/notifications'

/*
 * Notifications, natively.
 *
 * The second list screen, and the first that reads something only the signed-in
 * athlete can see — so unlike the records board this one needs the token, and
 * unlike the manual entry form it also writes (marking read). Which alerts
 * belong under a filter, which day each one sits in, and how long ago it
 * arrived are all decided in `resources/functions/notifications.ts`, the module
 * the web page reads too.
 *
 * A row opens the thing it is about on the web side through
 * `craft.navigation.open`: a kudos leads to an activity, a conquest to a
 * territory, and both of those screens are built around a map
 * (craft-native/craft#340).
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft

const FILTERS = NOTIFICATION_FILTERS.map(filter => filter.key)

const filterIndex = state(0)
const rows = state<any[]>([])
const loading = state(true)
const error = state('')
const signedOut = state(false)
let active = true

function filterLabel(): string {
  return NOTIFICATION_FILTERS[filterIndex()].label
}

/** The rows under the chosen chip, grouped the way the web page groups them. */
function sections(): any[] {
  const chosen = FILTERS[filterIndex()]
  return groupNotificationsByDay(rows().filter((row: any) => matchesNotificationFilter(row, chosen)))
}

function unread(): number {
  return rows().filter((row: any) => !row.read).length
}

/*
 * Read once and kept: one round trip rather than two for a value that cannot
 * change while the screen is open.
 *
 * Not because a second read fails. It was blamed for a write that hung here,
 * and it is innocent — the bridge gives every request a new id and holds no
 * cache. The hang was a tap that never ran, from an `:if` on the button.
 */
const bearer = state('')

async function readToken(): Promise<string> {
  if (bearer())
    return bearer()
  const value = await craft.secureStorage.get('auth_token')
  const token = typeof value === 'string' ? value : ''
  bearer.set(token)
  return token
}

async function load(): Promise<void> {
  loading.set(true)
  error.set('')
  try {
    const token = await readToken()
    if (!token) {
      if (active) {
        signedOut.set(true)
        loading.set(false)
      }
      return
    }
    const response = await fetch('https://wildloop.org/api/notifications', {
      headers: { Accept: 'application/json', Authorization: `Bearer ${token}` },
    })
    const body = await response.json().catch(() => null)
    if (!active)
      return
    if (response.status === 401) {
      signedOut.set(true)
      loading.set(false)
      return
    }
    if (!response.ok)
      throw new Error('Could not load your notifications')
    signedOut.set(false)
    rows.set(notificationRowsFrom(body))
  }
  catch (cause) {
    if (active)
      error.set(cause instanceof Error ? cause.message : 'Could not load your notifications')
  }
  finally {
    if (active)
      loading.set(false)
  }
}

function cycleFilter(): void {
  filterIndex.set((filterIndex() + 1) % FILTERS.length)
}

/*
 * Marked read here first and sent afterwards: the badge is the reason somebody
 * opened the screen, and waiting for a round trip to clear it reads as a tap
 * that did nothing. A failed write leaves the list read and the next load
 * corrects it, which is the same bargain the web page makes.
 */
async function markAllRead(): Promise<void> {
  if (unread() === 0)
    return
  rows.set(rows().map((row: any) => ({ ...row, read: true })))
  try {
    const token = await readToken()
    if (!token)
      return
    await fetch('https://wildloop.org/api/notifications/read', {
      method: 'POST',
      headers: { Accept: 'application/json', Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({}),
    })
    if (active)
      await craft.haptics.selection()
  }
  catch {
    // The list is already read; the next load is the correction.
  }
}

function openRow(row: any): void {
  if (!row?.link || row.link === '#')
    return
  craft.navigation.open(String(row.link))
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Notifications', largeTitle: true })
  void load()
})

onDestroy(() => {
  active = false
})
</script>

<SafeAreaView class="flex-1 bg-slate-950">
  <ScrollView class="p-4" testID="notifications-scroll">
    <Text class="text-3xl font-bold text-white">Notifications</Text>
    <Text testID="unread-count" class="mt-1 text-sm text-slate-400" :text="unread() > 0 ? unread() + ' unread' : 'All caught up'" />

    <View class="mt-4 gap-2">
      <Text testID="filter-label" class="text-sm text-slate-300" :text="filterLabel()" />
      <Button testID="cycle-filter" @click="cycleFilter()">Change filter</Button>
      {{-- Always rendered, never behind an `:if`.

           A Button inside `:if="unread() > 0"` appeared in the first RENDER and
           was then never re-created: no `createNode` arrived when the condition
           turned true, so the handler the host held belonged to a node that was
           no longer live and the tap did nothing. Tapping with nothing unread
           is handled where it belongs, in `markAllRead`. --}}
      <Button testID="mark-all" @click="markAllRead()">Mark all read</Button>
    </View>

    <ActivityIndicator :if="loading" testID="notifications-loading" class="mt-6" />
    <Text :if="error" testID="notifications-error" class="mt-4 text-rose-300" :text="error" />
    <Text :if="signedOut" testID="notifications-signed-out" class="mt-4 text-sm text-slate-400">
      Sign in to hear when somebody gives you kudos, challenges you, or takes your ground.
    </Text>

    {{-- A keyed `:for` on the element, not a `<template>` inside a FlatList:
         FlatList's item-template expansion is host-specific, while `:for`
         renders the shared keyed mutation protocol and keeps row identity and
         event scope across updates (093ef1ac, which moved Records onto it).
         Nested here because the list has day headings. --}}
    <View testID="notifications-list" class="mt-5 gap-5">
      <View :for="day in sections()" :key="day.label" class="gap-2">
        <Text testID="day-heading" class="text-xs font-semibold uppercase text-slate-500" :text="day.label" />
        <Pressable :for="row in day.items" :key="row.id" testID="notification-row" class="rounded-xl bg-slate-900 p-3" @click="openRow(row)">
          <View class="flex-row items-baseline gap-2">
            <Text class="text-base font-semibold text-white" :text="row.title" />
            <Text class="text-xs text-slate-500" :text="timeAgo(row.created_at)" />
          </View>
          <Text class="mt-1 text-sm text-slate-300" :text="row.message" />
          <Text :if="!row.read" testID="row-unread" class="mt-1 text-xs text-emerald-300">New</Text>
        </Pressable>
      </View>
    </View>

    <Text :if="!loading && !error && !signedOut && sections().length === 0" testID="notifications-empty" class="mt-6 text-sm text-slate-400">
      Nothing under this filter.
    </Text>
  </ScrollView>
</SafeAreaView>
