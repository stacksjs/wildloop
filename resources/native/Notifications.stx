<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import { onNativeAccountChange, createNativeApi } from '../functions/native-api'
import { nativeUi } from '../functions/native-ui'
import {
  groupNotificationsByDay,
  matchesNotificationFilter,
  NOTIFICATION_FILTERS,
  notificationRowsFrom,
  timeAgo,
} from '../functions/notifications'

/*
 * Notifications, natively.
 *
 * The second list screen, and the first that reads something only the signed-in
 * athlete can see — so unlike the records board this one needs the token, and
 * unlike the manual entry form it also writes (marking read). Which alerts
 * belong under a filter, which day each one sits in, and how long ago it
 * arrived are all decided in `resources/functions/notifications.ts`, the module
 * the web page reads too.
 *
 * A row opens the thing it is about on the web side through
 * `craft.navigation.open`: a kudos leads to an activity, a conquest to a
 * territory, and both of those screens are built around a map
 * (craft-native/craft#340).
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft
const ui = nativeUi

const FILTERS = NOTIFICATION_FILTERS.map(filter => filter.key)

const chosenFilter = state<string>(FILTERS[0])
const rows = state<any[]>([])
const loading = state(true)
const error = state('')
const signedOut = state(false)
let active = true

/* Every filter on screen at once, the unread one carrying its count. */
const filterOptions = derived(() => NOTIFICATION_FILTERS.map(filter => ({
  value: filter.key,
  label: filter.label,
  count: filter.key === 'unread' ? unread() : 0,
})))

/*
 * An empty list means two different things. Under "Conquests" it means the
 * filter is hiding everything else, and saying so tells the reader what to do.
 * Under "All" there is no filter to blame — "Nothing under this filter" then
 * reads as though something is being withheld, when the truthful answer is
 * that nothing has happened yet.
 *
 * Built in a `derived` rather than inlined in `:text`, because concatenating a
 * signal inside an interpolation renders `[object Object]` (stacksjs/stx#2069).
 */
const emptyMessage = derived(() => chosenFilter() === 'all' ? 'No notifications yet.' : 'Nothing under this filter.')

/** The rows under the chosen chip, grouped the way the web page groups them. */
function sections(): any[] {
  const chosen = chosenFilter()
  return groupNotificationsByDay(rows().filter((row: any) => matchesNotificationFilter(row, chosen)))
}

function unread(): number {
  return rows().filter((row: any) => !row.read).length
}

/*
 * Read once and kept: one round trip rather than two for a value that cannot
 * change while the screen is open.
 *
 * Not because a second read fails. It was blamed for a write that hung here,
 * and it is innocent — the bridge gives every request a new id and holds no
 * cache. The hang was a tap that never ran, from an `:if` on the button.
 */
const api = createNativeApi(craft)

let loadVersion = 0
async function load(): Promise<void> {
  const currentLoad = ++loadVersion
  loading.set(true)
  error.set('')
  try {
    const token = await api.readToken()
    if (!token) {
      if (active && currentLoad === loadVersion) {
        signedOut.set(true)
        loading.set(false)
      }
      return
    }
    const response = await api.send('/api/notifications')
    const body = response.body
    if (!active || currentLoad !== loadVersion)
      return
    if (response.status === 401) {
      signedOut.set(true)
      loading.set(false)
      return
    }
    if (!response.ok)
      throw new Error('Could not load your notifications')
    signedOut.set(false)
    rows.set(notificationRowsFrom(body))
  }
  catch (cause) {
    if (active && currentLoad === loadVersion)
      error.set(cause instanceof Error ? cause.message : 'Could not load your notifications')
  }
  finally {
    if (active && currentLoad === loadVersion)
      loading.set(false)
  }
}

/*
 * Marked read here first and sent afterwards: the badge is the reason somebody
 * opened the screen, and waiting for a round trip to clear it reads as a tap
 * that did nothing. A failed write leaves the list read and the next load
 * corrects it, which is the same bargain the web page makes.
 */
async function markAllRead(): Promise<void> {
  if (unread() === 0)
    return
  rows.set(rows().map((row: any) => ({ ...row, read: true })))
  try {
    const token = await api.readToken()
    if (!token)
      return
    await api.send('/api/notifications/read', 'POST', {})
    if (active)
      await craft.haptics.selection()
  }
  catch {
    // The list is already read; the next load is the correction.
  }
}

function openRow(row: any): void {
  if (!row?.link || row.link === '#')
    return
  craft.navigation.open(String(row.link))
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Notifications', largeTitle: true })
  void load()
})

onDestroy(() => {
  active = false
})
onMount(() => onNativeAccountChange(craft, () => { rows.set([]); void load() }))
</script>

<View :class="ui.screen">
  <ScrollView class="flex-1 pb-8" testID="notifications-scroll">
    <Text :show="!signedOut()" testID="unread-count" :class="ui.caption" class="mx-4 mt-3" :text="unread() > 0 ? unread() + ' unread' : 'All caught up'" />

    {{-- Every filter on screen, scrolling sideways: five is more than a
         segmented control holds, and a button that cycled them one tap at a
         time hid the other four. --}}
    <ChoiceChips :show="!signedOut()" testID="filter" label="Show" className="mt-3" v-model:value="chosenFilter" :options="filterOptions()" />

    <Button :show="unread() > 0" testID="mark-all" :class="ui.secondary" class="mx-4 mt-3" @click="markAllRead()">Mark all read</Button>

    <ActivityIndicator :show="loading() && rows().length === 0" testID="notifications-loading" class="mt-8" />
    <ErrorState :show="error()" testID="notifications-error" :title="error()" message="Check your connection, then try again." :busy="loading()" className="mt-4" @retry="load()" />
    <EmptyState :show="signedOut()" testID="notifications-signed-out" variant="bare" className="mt-4" title="Notifications are for your account" description="Sign in to hear when somebody gives you kudos, challenges you, or takes your ground.">
      <Button testID="notifications-sign-in" :class="ui.action" @click="craft.navigation.open('/login?next=/notifications')">Sign in</Button>
    </EmptyState>

    {{-- One inset group per day, as the web page groups them. --}}
    <View testID="notifications-list">
      <GroupedList :for="day in sections()" :key="day.label" className="mt-6" :title="day.label">
        <GroupedListRow
          :for="(row, index) in day.items"
          :key="row.id"
          testID="notification-row"
          :title="row.title"
          :subtitle="row.message"
          :value="timeAgo(row.created_at)"
          :separator="index > 0"
          pressable
          @select="openRow(row)"
        >
          <Text :show="!row.read" testID="row-unread" class="text-[13px] font-semibold text-accent">New</Text>
        </GroupedListRow>
      </GroupedList>
    </View>

    <EmptyState :show="!loading() && !error() && !signedOut() && sections().length === 0" testID="notifications-empty" variant="bare" className="mt-6" :title="emptyMessage()" />
  </ScrollView>
</View>
