<script client lang="ts">
import type { NativeCraft } from '@stacksjs/stx/native'
import { onNativeAccountChange, createNativeApi, nativeApiOrigin } from '../functions/native-api'
import { chooseNativeChoice, nativeChoiceLabel } from '../functions/native-choice'
import { nativeUi as ui } from '../functions/native-ui'
import { routeShapeFor } from '../functions/route-shape'
const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft
const api=createNativeApi(craft)
const rows = state<any[]>([])
const loading = state(true)
const error = state('')
const filter = state('all')
const scope = state('all')
const hasMore = state(false)
const kudosed = state<Record<number, boolean>>({})
const pending = state<Record<number, boolean>>({})
let active = true
let loadVersion = 0
const shown = derived(() => rows())
function shape(row: any): string { return routeShapeFor(row.route, 320, 140, 12)?.points ?? '' }
function photo(row: any): string {
  const url = row.photo?.url || ''
  return url.startsWith('/') ? nativeApiOrigin(craft) + url : url
}
async function load(more = false) {
  const currentLoad = ++loadVersion
  loading.set(true)
  error.set('')
  try {
    const response = await api.send(`/api/activities?limit=30&offset=${more ? rows().length : 0}&scope=${scope()}${filter() === 'all' ? '' : '&activity_type=' + encodeURIComponent(filter())}`)
    if (!response.ok) throw new Error('The feed could not be loaded. Pull down to retry.')
    if (!active || currentLoad !== loadVersion) return
    rows.set(more ? [...rows(), ...response.body.activities] : response.body.activities ?? [])
    kudosed.set({ ...more ? kudosed() : {}, ...Object.fromEntries((response.body.activities ?? []).map((row:any)=>[row.id,Boolean(row.viewerKudosed)])) })
    hasMore.set(Boolean(response.body.meta?.hasMore))
  }
  catch (cause) { if (active && currentLoad === loadVersion) error.set(cause instanceof Error ? cause.message : 'The feed could not be loaded.') }
  finally { if (active && currentLoad === loadVersion) loading.set(false) }
}
async function chooseScope(value:string) {
  if(value==='following' && !await api.readToken()){craft.navigation.open('/login?next=/feed');return}
  scope.set(value);void load()
}
async function kudos(row: any) {
  if (pending()[row.id]) return
  if (!await api.readToken()) { craft.navigation.open('/login?next=/feed'); return }
  pending.set({ ...pending(), [row.id]: true })
  try {
    const response = await api.send(`/api/activities/${row.id}/kudos`, kudosed()[row.id] ? 'DELETE' : 'PUT')
    if (!response.ok) throw new Error('Kudos could not be updated.')
    kudosed.set({ ...kudosed(), [row.id]: Boolean(response.body.kudosed) })
    rows.set(rows().map(activity => activity.id === row.id ? { ...activity, kudosCount: response.body.kudosCount ?? activity.kudosCount } : activity))
  }
  catch (cause) { error.set(cause instanceof Error ? cause.message : 'Kudos could not be updated.') }
  finally { pending.set({ ...pending(), [row.id]: false }) }
}
onMount(() => {
  craft.navigation.setOptions({ title: 'Feed', largeTitle: true, rightButtons: [{ id: 'search', symbol: 'magnifyingglass', accessibilityLabel: 'Search' }, { id: 'notifications', symbol: 'bell', accessibilityLabel: 'Notifications' }] })
  const buttons = craft.navigation.onButton(event => craft.navigation.open(event.id === 'search' ? '/search' : '/notifications'))
  const appear = craft.navigation.onAppear(() => { void load() })
  void load()
  return () => { active = false; buttons(); appear() }
})
onMount(() => onNativeAccountChange(craft, () => { rows.set([]); kudosed.set({}); scope.set('all'); void load() }))
</script>
<View :class="ui.screen">
  <ScrollView class="flex-1 pb-6" :refreshing="loading" @refresh="load()" testID="native-feed-scroll">
    <View class="mx-4 mt-4 flex-row gap-2">
      <Button :class="ui.secondary" @click="craft.navigation.open('/activity/new')">Log activity</Button>
      <Button :class="ui.secondary" @click="craft.navigation.open('/trails')">Find a trail</Button>
    </View>
    <Button testID="feed-scope" class="mx-4 mt-3" :class="ui.secondary" :title="'Feed' + ': ' + nativeChoiceLabel([{value:'all',label:'Everyone'},{value:'following',label:'Following'}],scope())" accessibilityLabel="Feed" :accessibilityValue="nativeChoiceLabel([{value:'all',label:'Everyone'},{value:'following',label:'Following'}],scope())" @click="chooseNativeChoice(craft,'Feed',[{value:'all',label:'Everyone'},{value:'following',label:'Following'}],choice=>{chooseScope(choice)},message=>error.set(message))" />
    <Button testID="feed-type" class="mx-4 mt-3" :class="ui.secondary" :title="'Activity type' + ': ' + nativeChoiceLabel([{value:'all',label:'All activities'}, ...['Trail Run','Hike','Walk','Bike'].map(value => ({value,label:value}))],filter())" accessibilityLabel="Activity type" :accessibilityValue="nativeChoiceLabel([{value:'all',label:'All activities'}, ...['Trail Run','Hike','Walk','Bike'].map(value => ({value,label:value}))],filter())" @click="chooseNativeChoice(craft,'Activity type',[{value:'all',label:'All activities'}, ...['Trail Run','Hike','Walk','Bike'].map(value => ({value,label:value}))],choice=>{filter.set(choice);load()},message=>error.set(message))" />
    <Text :show="error" :text="error" :class="ui.danger" class="m-4" testID="feed-error" />
    <ActivityIndicator :show="loading" testID="feed-loading" />
    <Text :show="!loading() && !shown().length" :class="ui.caption" class="m-4">No activities here yet. Record a run or explore a trail.</Text>
    <View :for="activity in shown()" :key="activity.id" :class="ui.card" class="mt-4">
      <Pressable :class="ui.row" @click="craft.navigation.open('/athlete/' + activity.userId)">
        <Text :text="activity.userName" :class="ui.title" />
      </Pressable>
      <Pressable testID="feed-activity" @click="craft.navigation.open('/activity/' + activity.id)" class="gap-2">
        <Text :text="activity.title || activity.activityType" :class="ui.title" />
        <Text :text="activity.distance + ' mi · ' + activity.duration + ' · ' + activity.elevationGain + ' ft'" :class="ui.body" />
        <Image :show="photo(activity)" :source="{uri: photo(activity)}" class="h-40 w-full rounded-[12px]" resizeMode="cover" />
        <View :show="!photo(activity) && shape(activity)" class="h-[140px] w-full rounded-[12px] bg-[#eef2e9] dark:bg-[#101c16]">
          <svg viewBox="0 0 320 140" class="h-full w-full"><polyline :points="shape(activity)" fill="none" stroke="#24724b" stroke-width="3" /></svg>
        </View>
      </Pressable>
      <Button :show="activity.trailId" :class="ui.secondary" @click="craft.navigation.open('/trail/' + activity.trailId)" :text="activity.trailName || 'View trail'" />
      <View class="mt-3 flex-row gap-3">
        <Button testID="feed-kudos" :class="ui.secondary" :disabled="pending()[activity.id]" @click="kudos(activity)" :text="(kudosed()[activity.id] ? 'Kudos given' : 'Give kudos') + ' · ' + activity.kudosCount" />
        <Button :class="ui.secondary" @click="craft.navigation.open('/activity/' + activity.id)">Comments</Button>
      </View>
    </View>
    <Button :show="hasMore" :disabled="loading" class="m-4" :class="ui.secondary" @click="load(true)" testID="feed-load-more">Load more</Button>
  </ScrollView>
</View>
