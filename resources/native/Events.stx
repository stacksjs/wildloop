<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import { onNativeAccountChange, nativeApiOrigin } from '../functions/native-api'
import {
  EVENT_TYPES,
  EVENT_TYPE_LABELS,
  eventRowsFrom,
  eventSections,
  eventStandingLine,
  eventsPath,
  eventTypeLabel,
  eventWhenLabel,
} from '../functions/events'

/*
 * The events directory, natively.
 *
 * Fifth list screen. Live events first, then what is coming, then what is over
 * — the same three sections the web page shows, from `eventSections` in
 * `resources/functions/events.ts`, which also decides what kind of event each
 * one is, when it starts, and what a backyard ultra's standing reads like
 * mid-race.
 *
 * Narrower than the web page on purpose. No create form: it is nine fields and
 * a map pin. No radius: the "within 20 mi of here" filter needs a fix, and
 * geolocation is not in the native capability set (fetch, secureStorage,
 * haptics, lifecycle). Both stay one tap away on the web, which is what the
 * warm web view is for.
 *
 * A row pushes the event's own board (EventDetail), which draws its loop
 * (craft-native/craft#340), so it hands off rather than pretending.
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft

const TYPE_CHOICES = ['all', ...EVENT_TYPES] as const

const typeIndex = state(0)
const rows = state<any[]>([])
const loading = state(true)
const error = state('')
let active = true

function typeName(): string {
  const choice = TYPE_CHOICES[typeIndex()]
  return choice === 'all' ? 'Every kind' : EVENT_TYPE_LABELS[choice]
}

function live(): any[] {
  return eventSections(rows()).live
}

function upcoming(): any[] {
  return eventSections(rows()).upcoming
}

function past(): any[] {
  return eventSections(rows()).past
}

function kind(row: any): string {
  return eventTypeLabel(row?.type ?? '')
}

function when(row: any): string {
  return eventWhenLabel(row?.startTime ?? '')
}

function standing(row: any): string {
  return eventStandingLine(row)
}

function where(row: any): string {
  return row?.clubName ? `${row.location} · ${row.clubName}` : String(row?.location ?? '')
}

let loadVersion = 0
async function load(): Promise<void> {
  const currentLoad = ++loadVersion
  loading.set(true)
  error.set('')
  try {
    const response = await fetch(`${nativeApiOrigin(craft)}${eventsPath(TYPE_CHOICES[typeIndex()])}`, {
      headers: { Accept: 'application/json' },
    })
    const body = await response.json().catch(() => null)
    if (!active || currentLoad !== loadVersion)
      return
    if (!response.ok)
      throw new Error('Could not load events')
    rows.set(eventRowsFrom(body))
  }
  catch (cause) {
    if (active && currentLoad === loadVersion)
      error.set(cause instanceof Error ? cause.message : 'Could not load events')
  }
  finally {
    if (active && currentLoad === loadVersion)
      loading.set(false)
  }
}

function cycleType(): void {
  typeIndex.set((typeIndex() + 1) % TYPE_CHOICES.length)
  void load()
}

/*
 * An event's own board is native now (EventDetail), so this pushes it rather
 * than handing off to the web view.
 */
function openEvent(row: any): void {
  if (!row?.id)
    return
  craft.navigation.push('EventDetail', { id: String(row.id) })
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Events', largeTitle: true })
  void load()
})

onDestroy(() => {
  active = false
})
onMount(() => onNativeAccountChange(craft, () => { rows.set([]); void load() }))
</script>

<SafeAreaView class="flex-1 bg-[#f2f4ef] dark:bg-[#101c16]">
  <ScrollView class="p-4" testID="events-scroll">
    <Text class="mt-1 text-sm text-[#51604e] dark:text-[#b0bfac]">Races, group runs and backyard ultras.</Text>

    <View class="mt-4 gap-2">
      <Text testID="type-label" class="text-sm text-[#253321] dark:text-[#e3ecdf]" :text="typeName()" />
      <Button testID="cycle-type" @click="cycleType()">Change the kind</Button>
    </View>

    <ActivityIndicator :show="loading" testID="events-loading" class="mt-6" />
    <Text :show="error" testID="events-error" class="mt-4 text-[#b4232a] dark:text-[#ff8487]" :text="error" />

    {{-- Three keyed lists rather than one with headings: a live event and a
         finished one are different things to somebody standing at a start
         line, and the order is the information. --}}
    <View :show="live().length > 0" class="mt-5 gap-2">
      <Text testID="live-heading" class="text-xs font-semibold uppercase text-[#24724b] dark:text-[#9be579]">Live now</Text>
      <Pressable :for="row in live()" :key="row.id" testID="live-row" class="rounded-xl bg-emerald-950 p-3" @click="openEvent(row)">
        <Text class="text-base font-semibold text-[#192414] dark:text-[#f0f5ec]" :text="row.name" />
        <Text class="text-xs text-emerald-200" :text="standing(row)" />
        <Text :show="where(row)" class="text-xs text-[#51604e] dark:text-[#b0bfac]" :text="where(row)" />
      </Pressable>
    </View>

    <View :show="upcoming().length > 0" class="mt-5 gap-2">
      <Text testID="upcoming-heading" class="text-xs font-semibold uppercase text-[#64745f] dark:text-[#91a28b]">Coming up</Text>
      <Pressable :for="row in upcoming()" :key="row.id" testID="upcoming-row" class="rounded-xl bg-white dark:bg-[#1b2c22] p-3" @click="openEvent(row)">
        <Text class="text-base font-semibold text-[#192414] dark:text-[#f0f5ec]" :text="row.name" />
        <Text class="text-xs text-[#253321] dark:text-[#e3ecdf]" :text="kind(row) + ' · ' + when(row)" />
        <Text :show="where(row)" class="text-xs text-[#51604e] dark:text-[#b0bfac]" :text="where(row)" />
        <Text class="text-xs text-[#64745f] dark:text-[#91a28b]" :text="standing(row)" />
      </Pressable>
    </View>

    <View :show="past().length > 0" class="mt-5 gap-2">
      <Text testID="past-heading" class="text-xs font-semibold uppercase text-slate-600">Finished</Text>
      <Pressable :for="row in past()" :key="row.id" testID="past-row" class="rounded-xl bg-white dark:bg-[#1b2c22]/60 p-3" @click="openEvent(row)">
        <Text class="text-sm font-semibold text-[#253321] dark:text-[#e3ecdf]" :text="row.name" />
        <Text class="text-xs text-[#64745f] dark:text-[#91a28b]" :text="kind(row) + ' · ' + when(row)" />
      </Pressable>
    </View>

    <Text :show="!loading && !error && rows().length === 0" testID="events-empty" class="mt-6 text-sm text-[#51604e] dark:text-[#b0bfac]">
      No events of this kind yet.
    </Text>
  </ScrollView>
</SafeAreaView>
