<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import { onNativeAccountChange, nativeApiOrigin } from '../functions/native-api'
import { requireNativeAccount } from '../functions/native-session'
import { nativeUi } from '../functions/native-ui'
import {
  EVENT_TYPES,
  EVENT_TYPE_LABELS,
  eventRowsFrom,
  eventSections,
  eventStandingLine,
  eventsPath,
  eventTypeLabel,
  eventWhenLabel,
} from '../functions/events'

/*
 * The events directory, natively.
 *
 * Fifth list screen. Live events first, then what is coming, then what is over
 * — the same three sections the web page shows, from `eventSections` in
 * `resources/functions/events.ts`, which also decides what kind of event each
 * one is, when it starts, and what a backyard ultra's standing reads like
 * mid-race.
 *
 * Narrower than the web page on purpose. No create form: it is nine fields and
 * a map pin. No radius: the "within 20 mi of here" filter needs a fix, and
 * geolocation is not in the native capability set (fetch, secureStorage,
 * haptics, lifecycle). Both stay one tap away on the web, which is what the
 * warm web view is for.
 *
 * A row pushes the event's own board (EventDetail), which draws its loop
 * (craft-native/craft#340), so it hands off rather than pretending.
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft
const ui = nativeUi

const TYPE_CHOICES = ['all', ...EVENT_TYPES] as const

const TYPE_OPTIONS = TYPE_CHOICES.map(value => ({ value, label: value === 'all' ? 'Every kind' : EVENT_TYPE_LABELS[value] }))
const chosenType = state<string>(TYPE_CHOICES[0])
const rows = state<any[]>([])
const loading = state(true)
const error = state('')
let active = true


function live(): any[] {
  return eventSections(rows()).live
}

function upcoming(): any[] {
  return eventSections(rows()).upcoming
}

function past(): any[] {
  return eventSections(rows()).past
}

function kind(row: any): string {
  return eventTypeLabel(row?.type ?? '')
}

function when(row: any): string {
  return eventWhenLabel(row?.startTime ?? '')
}

function standing(row: any): string {
  return eventStandingLine(row)
}

function where(row: any): string {
  return row?.clubName ? `${row.location} · ${row.clubName}` : String(row?.location ?? '')
}

let loadVersion = 0
async function load(): Promise<void> {
  if (!await requireNativeAccount(craft, '/events')) return
  const currentLoad = ++loadVersion
  loading.set(true)
  error.set('')
  try {
    const response = await fetch(`${nativeApiOrigin(craft)}${eventsPath(chosenType() as any)}`, {
      headers: { Accept: 'application/json' },
    })
    const body = await response.json().catch(() => null)
    if (!active || currentLoad !== loadVersion)
      return
    if (!response.ok)
      throw new Error('Could not load events')
    rows.set(eventRowsFrom(body))
  }
  catch (cause) {
    if (active && currentLoad === loadVersion)
      error.set(cause instanceof Error ? cause.message : 'Could not load events')
  }
  finally {
    if (active && currentLoad === loadVersion)
      loading.set(false)
  }
}

/* Each kind is its own list on the server, so a change reloads it. */
function chooseType(value: string): void {
  chosenType.set(value)
  void load()
}

/*
 * An event's own board is native now (EventDetail), so this pushes it rather
 * than handing off to the web view.
 */
function openEvent(row: any): void {
  if (!row?.id)
    return
  craft.navigation.push('EventDetail', { id: String(row.id) })
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Events', largeTitle: true })
  void load()
})

onDestroy(() => {
  active = false
})
onMount(() => onNativeAccountChange(craft, () => { rows.set([]); void load() }))
</script>

<View :class="ui.screen">
  <ScrollView class="flex-1 pb-8" testID="events-scroll">
    <Text :class="ui.caption" class="mx-4 mt-3">Races, group runs and backyard ultras.</Text>

    <ChoiceChips testID="type" label="Kind" className="mt-3" :value="chosenType()" :options="TYPE_OPTIONS" @change="chooseType($event)" />

    <ActivityIndicator :show="loading() && rows().length === 0" testID="events-loading" class="mt-8" />
    <ErrorState :show="error()" testID="events-error" :title="error()" message="Check your connection, then try again." :busy="loading()" className="mt-4" @retry="load()" />

    {{-- Three groups rather than one list with headings: a live event and a
         finished one are different things to somebody standing at a start
         line, and the order is the information. --}}
    <GroupedList :show="live().length > 0" testID="live-heading" className="mt-6" title="Live now">
      <GroupedListRow :for="(row, index) in live()" :key="row.id" testID="live-row" :title="row.name" :subtitle="standing(row)" :value="where(row)" :separator="index > 0" chevron @select="openEvent(row)" />
    </GroupedList>

    <GroupedList :show="upcoming().length > 0" testID="upcoming-heading" className="mt-6" title="Coming up">
      <GroupedListRow :for="(row, index) in upcoming()" :key="row.id" testID="upcoming-row" :title="row.name" :subtitle="kind(row) + ' · ' + when(row)" :value="standing(row)" :separator="index > 0" chevron @select="openEvent(row)" />
    </GroupedList>

    <GroupedList :show="past().length > 0" testID="past-heading" className="mt-6" title="Finished">
      <GroupedListRow :for="(row, index) in past()" :key="row.id" testID="past-row" :title="row.name" :subtitle="kind(row) + ' · ' + when(row)" :separator="index > 0" chevron @select="openEvent(row)" />
    </GroupedList>

    <EmptyState :show="!loading() && !error() && rows().length === 0" testID="events-empty" variant="bare" className="mt-6" title="No events of this kind yet." />
  </ScrollView>
</View>
