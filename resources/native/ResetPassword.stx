<script client lang="ts">
import type { NativeCraft } from '@stacksjs/stx/native'
import { createNativeApi } from '../functions/native-api'
import { PASSWORD_MIN_LENGTH, PASSWORD_MAX_LENGTH } from '../functions/password-change'
import { nativeUi as ui } from '../functions/native-ui'
const craft=(globalThis as typeof globalThis & {craft:NativeCraft}).craft
const email=state(String(craft.route.params.email ?? ''))
const password=state('')
const confirmation=state('')
const busy=state(false)
const error=state('')
const saved=state(false)
async function reset() {
  if(busy())return
  if(!craft.route.params.token){error.set('This reset link is missing its token. Request a new link.');return}
  if(password().length<PASSWORD_MIN_LENGTH || password().length>PASSWORD_MAX_LENGTH || password()!==confirmation()){error.set('Use a password of 8–255 characters and enter it twice.');return}
  busy.set(true);error.set('')
  try{
    const response=await createNativeApi(craft).send('/api/password/reset','POST',{email:email().trim(),token:craft.route.params.token,password:password(),password_confirmation:confirmation()})
    if(!response.ok)throw new Error(response.body?.message || response.body?.error || 'This reset link is invalid or expired. Request a new link.')
    password.set('');confirmation.set('');saved.set(true)
  }
  catch(cause){error.set(cause instanceof Error?cause.message:'Your password could not be reset.')}
  finally{busy.set(false)}
}
onMount(()=>{craft.navigation.setOptions({title:'Reset your password',largeTitle:false})})
onMount(()=>craft.route.onParams(params=>{email.set(String(params.email ?? ''));password.set('');confirmation.set('');error.set('');saved.set(false)}))
</script>
<KeyboardAvoidingView :class="ui.screen">
  <ScrollView class="flex-1 p-6" keyboardDismissMode="on-drag">
    <View :show="!saved()" class="gap-4">
      <Text :class="ui.title">Choose a new password</Text>
      <TextInput testID="reset-email" accessibilityLabel="Email" :class="ui.input" :value="email" keyboardType="email-address" autoCapitalize="none" @input="email.set($event.text)" />
      <TextInput testID="reset-password" accessibilityLabel="New password" :class="ui.input" :value="password" :secureTextEntry="true" textContentType="newPassword" @input="password.set($event.text)" />
      <TextInput testID="reset-confirmation" accessibilityLabel="Confirm new password" :class="ui.input" :value="confirmation" :secureTextEntry="true" textContentType="newPassword" @input="confirmation.set($event.text)" />
      <Button testID="reset-submit" :class="ui.action" :disabled="busy" @click="reset()"><Text :class="ui.actionText">Reset password</Text></Button>
    </View>
    <Text :show="error" :text="error" :class="ui.danger" class="my-4" />
    <Text :show="saved" :class="ui.body" class="my-4">Your password has been reset. Sign in with your new password.</Text>
    <Button :show="saved" :class="ui.action" @click="craft.navigation.open('/login')"><Text :class="ui.actionText">Log in</Text></Button>
    <Button class="mt-4" @click="craft.navigation.open('/forgot-password')">Request a new reset link</Button>
  </ScrollView>
</KeyboardAvoidingView>
