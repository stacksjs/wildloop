<script client lang="ts">
import type { NativeCraft } from '@stacksjs/stx/native'
import { createLiveActivity } from '@stacksjs/stx/native/live-activity'
import { createHealthWorkout } from '../functions/health-workout'
import { useIntervalFn } from '@stacksjs/composables'
import { readNativeAccount } from '../functions/native-session'
import { onNativeAccountChange, createNativeApi } from '../functions/native-api'
import { nativeOutdoorTiles } from '../functions/native-basemaps'
import { chooseNativeChoice, nativeChoiceLabel } from '../functions/native-choice'
import { nativeUi as ui } from '../functions/native-ui'
import { nativeRecordingDuration, movingSeconds, recordingFigures, recordingPayload, recordingSamples, type NativeRecording } from '../functions/native-recording'
const craft = (globalThis as typeof globalThis & {craft:NativeCraft}).craft
{{-- One api for the screen: the keychain is read once, however many of
     these paths run. --}}
const api = createNativeApi(craft)
const KEY = 'wildloop-native-recording-v1'
const recording = state<NativeRecording|null>(null)
const running = state(false)
const paused = state(false)
const busy = state(false)
const loading = state(true)
const error = state('')
const notice = state('')
const activityType = state('Trail Run')
const visibility = state('followers')
const gameMode = state('capture')
const now = state(Date.now())
const figures = derived(() => recording() ? recordingFigures(recording()!) : {distance:0,elevation:0})
const movingTime = derived(() => { const value=recording(); return value ? movingSeconds(value,now()) : 0 })
const coordinates = derived(() => recording()?.samples.flatMap(sample => [sample.lat,sample.lng]) ?? [])
let alive = true
let owner = 0
let watch: number | null = null
let writes = Promise.resolve()
let recovering = false
const live=createLiveActivity(craft.liveActivity)
let lastLiveUpdate=0
function updateLive(force=false) {
  const value=recording(),at=Date.now()
  if(!value?.id || !running())return
  if(!force && at-lastLiveUpdate<5000)return
  lastLiveUpdate=at
  const moving=movingSeconds(value,at)
  void live.update({activityId:'wildloop:'+value.id,title:value.type,symbol:'figure.run',deepLink:'wildloop://record',tint:'#24724b',status:paused()?'Paused':'Recording',paused:paused(),distanceMeters:recordingFigures(value).distance*1609.344,durationSeconds:moving,timerStartedAt:paused()?null:at-moving*1000}).catch(()=>{})
}
/** How long a recording may go without a single fix before the screen says so. */
const GPS_SILENCE_SECONDS = 30

/*
 * What the line under the clock is allowed to claim.
 *
 * iOS does not refuse `startUpdatingLocation` when location is denied — it
 * accepts it and then delivers nothing — so `startRecording` answers
 * `active: true` and the screen used to settle on "Recording GPS" over a clock
 * counting up and a distance that never moved. Measured on a device with
 * location denied: forty-three seconds of "moving", not one sample, and
 * nothing anywhere on the screen suggesting the run was not being recorded.
 * Granting the permission mid-recording fixed it on the spot, which is what
 * pinned the cause.
 *
 * The screen cannot ask whether permission was granted — the host keeps
 * `locationPermissionGranted` to itself (`CraftNativeScreen.swift`) — and it
 * does not need to. A recording holding no samples at all is either waiting
 * for a fix or never going to get one, and both of those are worth saying
 * instead of dressing up as recording. Once half a minute has passed with
 * nothing, the likely cause gets named, because by then it is no longer a
 * cold start.
 *
 * It never stops the recording. A fix can arrive late from a pocket or a
 * valley, and throwing away a run that was about to start working is worse
 * than a pessimistic caption.
 */
function recordingState(): string {
  if (!running())
    return recording() ? 'Recording retained on device' : 'Ready to explore'
  if (paused())
    return 'Paused'
  if ((recording()?.samples.length ?? 0) > 0)
    return 'Recording GPS'
  return movingTime() >= GPS_SILENCE_SECONDS
    ? 'Still no GPS. Check location permission in Settings.'
    : 'Waiting for GPS…'
}

function persist(value: NativeRecording): Promise<void> {
  const snapshot = JSON.parse(JSON.stringify(value))
  writes = writes.catch(() => {}).then(async () => {await craft.storage.set(KEY,snapshot)})
  return writes
}
async function perform(work:()=>Promise<void>) {
  if (busy()) return
  busy.set(true);error.set('')
  try { await work() }
  catch (cause) { error.set(cause instanceof Error ? cause.message : 'The recording could not be updated. Your track remains on this device.') }
  finally { busy.set(false) }
}
function append(locations:any[]) {
  const value = recording()
  if (!value || value.pending) return
  const samples = recordingSamples(value,locations.map(location => ({...location,accuracy:location.accuracy ?? null})))
  recording.set({...value,samples})
  now.set(Date.now());updateLive()
}
function attachWatch() {
  if (watch !== null || !craft.location) return
  watch = craft.location.watchPosition(location => {
    if (!alive || busy() || paused() || !running()) return
    append([location])
    if (recording()) void persist(recording()!).catch(() => error.set('Device storage could not save a checkpoint. Keep the app open until your activity is saved.'))
  },{enableHighAccuracy:true})
}
async function recover() {
  if (recovering || busy()) return
  recovering=true;loading.set(true)
  try {
    const cached=await readNativeAccount(craft)
    const me=cached ? null : await api.send('/api/me')
    if (!alive) return
    owner=cached?.id ?? (Number(me?.body?.user?.id)||0)
    const saved=await craft.storage.get<NativeRecording>(KEY)
    const host=await craft.location?.getRecordingState()
    if (!alive) return
    if (saved && saved.userId !== owner) {
      recording.set(null);running.set(false)
      error.set('Log in as the account that started the saved recording before resuming or uploading it.')
      return
    }
    if (host?.active && (!saved || (saved.id && saved.id !== host.id))) {
      error.set('A device recording is already active. Its account checkpoint could not be verified, so it has been retained without starting another recording.')
      return
    }
    recording.set(saved)
    running.set(Boolean(host?.active))
    paused.set(Boolean(host?.paused))
    if (saved && host?.active && !saved.pending) {
      append(await craft.location!.readRecording())
      await persist(recording()!)
      attachWatch()
      notice.set('Your recording has been recovered from this device.');updateLive(true)
    }
    if (saved?.pending) notice.set('Your finished recording is saved on this device. Retry the upload when connected.')
    now.set(Date.now())
  }
  catch { if (alive) error.set('Could not check the device recording. Pull down to retry before starting another activity.') }
  finally { recovering=false;if(alive) loading.set(false) }
}
/**
 * Recording belongs to an account. Every sample is uploaded under one, so a
 * signed-out viewer could start a run, cover ten miles and find the app has
 * nowhere to put it — the screen used to let them in and only say so when
 * they pressed Start.
 *
 * A retained recording is the exception: it was started by somebody who was
 * signed in, and bouncing them to a login screen is how a run gets lost.
 */
async function requireAccount(): Promise<boolean> {
  if (recording()) return true
  {{-- `readNativeAccount` is the test, not the bearer on its own. A token
       outlives the session it belongs to — logging out revokes it server-side
       and a stale one left on the device still reads as truthy, which is
       exactly how this screen kept letting a signed-out viewer in while
       Territory, which asks the server, said they were signed out. An account
       is a bearer the device still has a user for. --}}
  try {
    if ((await readNativeAccount(craft))?.id) return true
  }
  catch {
    // Cancelled because the screen closed; there is nobody to send anywhere.
    return true
  }
  craft.navigation.open('/login?next=/record')
  return false
}
function guarded(): void {
  void (async () => { if (await requireAccount()) await recover() })()
}
function start() { void perform(async () => {
  if (!craft.location) throw new Error('Location recording is unavailable in this app build.')
  const cached=await readNativeAccount(craft)
  const me=cached ? null : await api.send('/api/me')
  const userId=cached?.id ?? (Number(me?.body?.user?.id)||0)
  if (!userId) {craft.navigation.open('/login?next=/record');return}
  if (recording()) throw new Error('Save your previous recording before starting another.')
  if ((await craft.location.getRecordingState()).active) throw new Error('A recording is already active on this device. Pull down to recover it.')
  const value:NativeRecording={userId,id:null,startedAt:Date.now(),type:activityType(),visibility:visibility(),gameMode:gameMode() === 'capture' ? 'capture':'free',targetTerritoryId:Number(craft.route.params.target)||null,pauses:[],samples:[]}
  // Bind the account before location starts. The host owns background fixes;
  // this checkpoint owns the account and upload identity across app restarts.
  await persist(value)
  recording.set(value)
  const host=await craft.location.startRecording({enableHighAccuracy:true})
  if (!host.active || !host.id) throw new Error('Location recording did not start. Check location permission and try again.')
  recording.set({...value,id:host.id,startedAt:host.startedAt ?? value.startedAt})
  owner=value.userId
  await persist(recording()!)
  running.set(true);paused.set(false);now.set(Date.now());notice.set('Recording continues with your phone locked.')
  attachWatch()
  updateLive(true)
  await craft.setKeepAwake?.(true)
}) }
function togglePause() { void perform(async () => {
  const value=recording()
  if (!value || !running() || !craft.location) return
  const at=Date.now()
  if (paused()) {
    await craft.location.resumeRecording()
    const pauses=value.pauses.map((pause,index) => index === value.pauses.length-1 && pause.end === null ? {...pause,end:at}:pause)
    recording.set({...value,pauses});paused.set(false)
  }
  else {
    await craft.location.pauseRecording()
    append(await craft.location.readRecording())
    recording.set({...recording()!,pauses:[...value.pauses,{start:at,end:null}]});paused.set(true)
  }
  await persist(recording()!);now.set(at);updateLive(true)
}) }
async function upload() {
  const value=recording()
  if (!value?.pending) return
  const me=await api.send('/api/me')
  if (!me.ok || Number(me.body?.user?.id) !== value.userId) throw new Error('Log in as the account that started this recording before uploading it.')
  const response=await api.send('/api/activities','POST',value.pending)
  if (!response.ok || !response.body?.activity?.id) throw new Error(response.body?.error || 'Upload failed. Your finished track is saved on this device; retry when connected.')
  const activity=response.body.activity
  let result='Activity saved.'
  if (value.gameMode === 'capture' && activity.captureEligible) {
    const claim=await api.send('/api/territories/claim','POST',{activity_id:activity.id})
    const conquest=await api.send('/api/territories/process-conquest','POST',{activity_id:activity.id,...value.targetTerritoryId ? {target_territory_id:value.targetTerritoryId}:{}})
    if (claim.status >= 500 || conquest.status >= 500) throw new Error('Your activity is saved. Territory processing will be retried with the same activity when you retry the upload.')
    result=claim.body?.success ? `Activity saved. ${claim.body.xpGained ?? 0} XP earned.` : `Activity saved. ${claim.body?.error || 'Your territory results are ready.'}`
  }
  else if (value.gameMode === 'capture' && !activity.captureEligible) result=`Saved to your log. This track cannot capture territory: ${activity.integrityReason || 'route telemetry was not eligible'}`
  if(craft.health && await craft.secureStorage.get('wildloop_health_connected')==='true') {
    try {await craft.health.saveWorkout(createHealthWorkout({activityId:activity.id,activityType:value.type as 'Trail Run'|'Hike'|'Walk'|'Bike',startedAt:value.startedAt,endedAt:Date.parse(String(value.pending.completed_at)),distanceMiles:recordingFigures(value).distance,elapsedSeconds:movingSeconds(value,Date.parse(String(value.pending.completed_at))),samples:value.samples}))}
    catch {result+=' Your workout could not be exported to Health; check its permission in Settings.'}
  }
  await craft.snapshots.set('wildloop-activity-notice',{activityId:activity.id,message:result})
  await writes.catch(()=>{})
  await craft.storage.remove(KEY)
  recording.set(null);notice.set(result)
  craft.navigation.open(`/activity/${activity.id}`)
}
function finish() { void perform(async () => {
  if (!recording() || !craft.location) return
  if (running()) {
    const ended=await craft.location.stopRecording()
    append(ended.locations)
    running.set(false);paused.set(false)
    await live.end().catch(()=>{})
    await craft.setKeepAwake?.(false)
  }
  const value=recording()!
  if (value.samples.length < 2) {await persist(value);throw new Error('Not enough GPS fixes to save an activity. Your available fixes remain on this device.')}
  if (!value.id) throw new Error('The native recording identity is unavailable. Your fixes have been retained.')
  if (!value.pending) recording.set({...value,pending:recordingPayload(value,Date.now())})
  await persist(recording()!)
  await upload()
}) }
function retry() {void perform(upload)}
function discard() {void perform(async()=>{
  if (running()) throw new Error('Finish your recording before discarding it.')
  if (!await craft.dialog?.confirm({title:'Discard this recording?',message:'This removes the unsaved track from this device.',confirmLabel:'Discard',destructive:true})) return
  await writes.catch(()=>{});await craft.storage.remove(KEY);recording.set(null);notice.set('Recording discarded.')
})}
onMount(()=>onNativeAccountChange(craft,()=>{recording.set(null);running.set(false);paused.set(false);owner=0;if(watch!==null){craft.location?.clearWatch(watch);watch=null}void recover()}))
onMount(()=>{
  craft.navigation.setOptions({title:'Record',largeTitle:false})
  guarded()
  const clock=useIntervalFn(()=>{if(running() && !paused())now.set(Date.now())},1000)
  const appear=craft.navigation.onAppear(()=>{guarded()})
  const lifecycle=craft.lifecycle.onStateChange(value=>{if(value==='active') void recover()})
  return()=>{alive=false;clock.pause();appear();lifecycle();if(watch!==null)craft.location?.clearWatch(watch)}
})
</script>
<View :class="ui.screen">
  <ScrollView class="flex-1 pb-4" :refreshing="loading" @refresh="recover()" testID="native-record">
    <ActivityIndicator :show="loading" />
    <Text :show="error" :text="error" :class="ui.danger" class="m-4" testID="record-error" />
    <Text :show="notice" :text="notice" :class="ui.body" class="m-4" testID="record-notice" />
    <View :class="ui.card" class="mt-4 gap-3">
      <Text :text="figures().distance.toFixed(2) + ' mi'" class="text-[42px] font-bold text-[#192414] dark:text-white" testID="record-distance" />
      <Text :text="nativeRecordingDuration(movingTime()) + ' moving · ' + Math.round(figures().elevation) + ' ft gain'" :class="ui.body" testID="record-time" />
      <Text :text="recordingState()" :class="ui.caption" testID="record-state" />
      <Map testID="record-native-map" :tileOverlay="nativeOutdoorTiles" class="h-[320px] rounded-[12px]" :fitToBounds="coordinates().length >= 4" :showsUserLocation="running" :showsCompass="true" :showsScale="true" :rotateEnabled="true">
        <MapPolyline :geometry="coordinates()" strokeColor="#24724b" :strokeWidth="5" />
      </Map>
    </View>
    <View :show="!recording()" :class="ui.card" class="mt-4 gap-3">
      <Text :class="ui.caption">Activity</Text><Button testID="record-type" :class="ui.secondary" :title="'Activity' + ': ' + nativeChoiceLabel(['Trail Run','Hike','Walk','Bike'].map(value=>({value,label:value})),activityType())" accessibilityLabel="Activity" :accessibilityValue="nativeChoiceLabel(['Trail Run','Hike','Walk','Bike'].map(value=>({value,label:value})),activityType())" @click="chooseNativeChoice(craft,'Activity',['Trail Run','Hike','Walk','Bike'].map(value=>({value,label:value})),choice=>{activityType.set(choice)},message=>error.set(message))" />
      <Text :class="ui.caption">Visibility</Text><Button testID="record-visibility" :class="ui.secondary" :title="'Visibility' + ': ' + nativeChoiceLabel(['public','followers','private'].map(value=>({value,label:value})),visibility())" accessibilityLabel="Visibility" :accessibilityValue="nativeChoiceLabel(['public','followers','private'].map(value=>({value,label:value})),visibility())" @click="chooseNativeChoice(craft,'Visibility',['public','followers','private'].map(value=>({value,label:value})),choice=>{visibility.set(choice)},message=>error.set(message))" />
      <Text :class="ui.caption">Territory game</Text><Button testID="record-mode" :class="ui.secondary" :title="'Territory game' + ': ' + nativeChoiceLabel([{value:'capture',label:'Capture territory'},{value:'free',label:'Free activity'}],gameMode())" accessibilityLabel="Territory game" :accessibilityValue="nativeChoiceLabel([{value:'capture',label:'Capture territory'},{value:'free',label:'Free activity'}],gameMode())" @click="chooseNativeChoice(craft,'Territory game',[{value:'capture',label:'Capture territory'},{value:'free',label:'Free activity'}],choice=>{gameMode.set(choice)},message=>error.set(message))" />
      <Text :class="ui.caption">Only verified GPS tracks can capture territory. Your activity visibility controls who can see it.</Text>
      <Button @click="craft.navigation.open('/activity/new')">Log a manual activity instead</Button>
    </View>
  </ScrollView>
  <View class="px-4 py-3 gap-2 bg-white dark:bg-[#1b2c22]">
    <Button :show="!recording()" testID="record-start" :disabled="busy || loading" :class="ui.action" @click="start()" title="Start recording" />
    <View :show="running()" class="flex-row gap-3">
      <Button testID="record-pause" :disabled="busy" :class="ui.secondary" class="flex-1" @click="togglePause()" :text="paused() ? 'Resume' : 'Pause'" />
      <Button testID="record-finish" :disabled="busy" :class="ui.action" class="flex-1" @click="finish()" title="Finish and save" />
    </View>
    <Button :show="recording()?.pending" testID="record-retry" :disabled="busy" :class="ui.action" @click="retry()" title="Retry upload" />
    <Button :show="recording() && !running() && !recording()?.pending" :disabled="busy" @click="finish()">Save retained recording</Button>
    <Button :show="recording() && !running()" :disabled="busy" :class="ui.danger" @click="discard()">Discard recording</Button>
  </View>
</View>
