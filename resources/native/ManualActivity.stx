<script client lang="ts">
import type { NativeCraft } from '@stacksjs/stx/native'
import { buildManualActivity, MANUAL_ACTIVITY_TYPES, todayLocal } from '../functions/manual-activity'

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft
const types = [...MANUAL_ACTIVITY_TYPES]
const visibilities = ['public', 'followers', 'private']
const routeUserId = Number(craft.route.params.userId ?? 0)

const userId = state(Number.isFinite(routeUserId) ? routeUserId : 0)
const typeIndex = state(0)
const visibilityIndex = state(1)
const distance = state('')
const duration = state('')
const elevation = state('')
const trailId = state('')
const date = state(todayLocal())
const notes = state('')
const saving = state(false)
const error = state('')
let active = true

function eventText(event: { text?: unknown }): string {
  return event?.text == null ? '' : String(event.text)
}

function cycleType() {
  typeIndex.set((typeIndex() + 1) % types.length)
}

function cycleVisibility() {
  visibilityIndex.set((visibilityIndex() + 1) % visibilities.length)
}

function goBack() {
  craft.navigation.back()
}

async function messageFrom(response: Response, fallback: string): Promise<{ body: any, message: string }> {
  const body = await response.json().catch(() => null)
  const fields = body?.fields ?? body?.errors
  const message = fields && typeof fields === 'object'
    ? Object.values(fields).map(String).join(' ')
    : String(body?.message ?? fallback)
  return { body, message }
}

async function submit() {
  if (saving()) return
  const built = buildManualActivity({
    type: types[typeIndex()],
    distance: distance(),
    duration: duration(),
    elevation: elevation(),
    trailId: trailId(),
    date: date(),
    notes: notes(),
    visibility: visibilities[visibilityIndex()],
  }, userId())
  if (built.ok === false) {
    error.set(built.error)
    return
  }

  saving.set(true)
  error.set('')
  try {
    const token = await craft.secureStorage.get('auth_token')
    if (!token) throw new Error('Sign in before saving an activity')
    const response = await fetch('https://wildloop.org/api/activities', {
      method: 'POST',
      headers: {
        Accept: 'application/json',
        Authorization: `Bearer ${token}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(built.payload),
    })
    const result = await messageFrom(response, 'Could not save the activity')
    if (!response.ok) throw new Error(result.message)
    const created = result.body?.activity
    if (!created?.id) throw new Error('Wildloop did not return the saved activity')
    if (!active) return
    await craft.haptics.notification('success')
    if (!active) return
    craft.navigation.push('activity', {
      id: created.id,
      userId: built.payload.user_id,
      activityType: built.payload.activity_type,
      distance: built.payload.distance,
      duration: built.payload.duration,
      pace: built.payload.pace,
      elevation: built.payload.elevation,
      completedAt: built.payload.completed_at,
    })
  }
  catch (cause) {
    if (active) error.set(cause instanceof Error ? cause.message : 'Could not save the activity')
  }
  finally {
    if (active) saving.set(false)
  }
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Log activity', largeTitle: true })
})
onDestroy(() => {
  active = false
})
</script>

<SafeAreaView class="flex-1 bg-slate-950">
  <ScrollView class="p-4" testID="manual-scroll">
    <Text class="text-3xl font-bold text-white">Log an activity</Text>
    <Text class="mt-1 text-sm text-slate-400">The same manual entry saved by the Wildloop web feed.</Text>

    <View class="mt-5 gap-2">
      <Text class="text-sm font-semibold text-slate-200">Activity</Text>
      <Text testID="activity-type" class="text-lg text-emerald-300" :text="types[typeIndex()]" />
      <Button testID="cycle-type" @click="cycleType()">Change activity type</Button>
    </View>

    <View class="mt-4 gap-2">
      <Text class="text-sm text-slate-200">Distance (miles)</Text>
      <TextInput testID="distance-input" placeholder="5.0" :value="distance" @input="distance.set(eventText($event))" />
      <Text class="text-sm text-slate-200">Duration (MM:SS or H:MM:SS)</Text>
      <TextInput testID="duration-input" placeholder="45:30" :value="duration" @input="duration.set(eventText($event))" />
      <Text class="text-sm text-slate-200">Elevation gain (feet)</Text>
      <TextInput testID="elevation-input" placeholder="800" :value="elevation" @input="elevation.set(eventText($event))" />
      <Text class="text-sm text-slate-200">Trail id (optional)</Text>
      <TextInput testID="trail-input" placeholder="42" :value="trailId" @input="trailId.set(eventText($event))" />
      <Text class="text-sm text-slate-200">Date</Text>
      <TextInput testID="date-input" placeholder="YYYY-MM-DD" :value="date" @input="date.set(eventText($event))" />
      <Text class="text-sm text-slate-200">Notes</Text>
      <TextInput testID="notes-input" placeholder="How did it go?" :value="notes" @input="notes.set(eventText($event))" />
    </View>

    <View class="mt-4 gap-2">
      <Text testID="visibility" class="text-sm text-slate-300" :text="'Visible to ' + visibilities[visibilityIndex()]" />
      <Button testID="cycle-visibility" @click="cycleVisibility()">Change visibility</Button>
    </View>

    <View class="mt-5 gap-2">
      <NativeRunMetric label="Distance" testID="distance-preview">
        <Text class="text-xl font-bold text-white" :text="distance() ? distance() + ' mi' : '--'" />
      </NativeRunMetric>
      <NativeRunMetric label="Duration" testID="duration-preview">
        <Text class="text-xl font-bold text-white" :text="duration() || '--'" />
      </NativeRunMetric>
    </View>

    <Text :if="error" testID="manual-error" class="mt-4 text-rose-300" :text="error" />
    <Button testID="save-activity" class="mt-5" @click="submit()">Save activity</Button>
    <Button testID="manual-back" class="mt-2" @click="goBack()">Back</Button>
  </ScrollView>
</SafeAreaView>
