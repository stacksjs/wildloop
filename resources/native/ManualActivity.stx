<script client lang="ts">
import { nativeApiOrigin } from '../functions/native-api'
import type { NativeCraft } from '@stacksjs/stx/native'
import { ACTIVITY_VISIBILITIES, buildManualActivity, MANUAL_ACTIVITY_TYPES, todayLocal } from '../functions/manual-activity'
import { nativeUi as ui } from '../functions/native-ui'

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft
const types = [...MANUAL_ACTIVITY_TYPES]
const visibilities = [...ACTIVITY_VISIBILITIES]

const typeIndex = state(0)
const visibilityIndex = state(1)
const distance = state('')
const duration = state('')
const elevation = state('')
const trailId = state('')
const date = state(todayLocal())
const notes = state('')
const saving = state(false)
const error = state('')
let active = true

function eventText(event: { text?: unknown }): string {
  return event?.text == null ? '' : String(event.text)
}

function cycleType() {
  typeIndex.set((typeIndex() + 1) % types.length)
}

function cycleVisibility() {
  visibilityIndex.set((visibilityIndex() + 1) % visibilities.length)
}

function goBack() {
  craft.navigation.back()
}

async function messageFrom(response: Response, fallback: string): Promise<{ body: any, message: string }> {
  const body = await response.json().catch(() => null)
  const fields = body?.fields ?? body?.errors
  const message = fields && typeof fields === 'object'
    ? Object.values(fields).map(String).join(' ')
    : String(body?.message ?? fallback)
  return { body, message }
}

async function submit() {
  if (saving()) return
  const built = buildManualActivity({
    type: types[typeIndex()],
    distance: distance(),
    duration: duration(),
    elevation: elevation(),
    trailId: trailId(),
    date: date(),
    notes: notes(),
    visibility: visibilities[visibilityIndex()],
    // No id: the token below is the only identity this screen has, and the API
    // takes the actor from the session regardless. Reading one from
    // `route.params` refused a save on a cold start, where `initialScreen`
    // passes no params — with a valid token sitting in secureStorage.
  }, null)
  if (built.ok === false) {
    error.set(built.error)
    return
  }

  saving.set(true)
  error.set('')
  try {
    const token = await craft.secureStorage.get('auth_token')
    if (!token) throw new Error('Sign in before saving an activity')
    const response = await fetch(`${nativeApiOrigin(craft)}/api/activities`, {
      method: 'POST',
      headers: {
        Accept: 'application/json',
        Authorization: `Bearer ${token}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(built.payload),
    })
    const result = await messageFrom(response, 'Could not save the activity')
    if (!response.ok) throw new Error(result.message)
    const created = result.body?.activity
    if (!created?.id) throw new Error('Wildloop did not return the saved activity')
    if (!active) return
    await craft.haptics.notification('success')
    if (!active) return
    craft.navigation.push('ActivitySaved', {
      id: created.id,
      // The server's answer, not a guess carried in from the route.
      userId: created.userId ?? 0,
      activityType: built.payload.activity_type,
      distance: built.payload.distance,
      duration: built.payload.duration,
      pace: built.payload.pace,
      elevation: built.payload.elevation,
      completedAt: built.payload.completed_at,
    })
  }
  catch (cause) {
    if (active) error.set(cause instanceof Error ? cause.message : 'Could not save the activity')
  }
  finally {
    if (active) saving.set(false)
  }
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Log activity', largeTitle: true })
})
onDestroy(() => {
  active = false
})
</script>

<SafeAreaView :class="ui.screen">
  <ScrollView class="flex-1 p-4" testID="manual-scroll">
    <Text class="mt-1" :class="ui.caption">Add a run, hike, walk, or ride to your log.</Text>

    <View class="mt-5 gap-2">
      <Text :class="ui.title">Activity</Text>
      <Text testID="activity-type" class="text-lg text-[#24724b] dark:text-[#9be579]" :text="types[typeIndex()]" />
      <Button testID="cycle-type" :class="ui.secondary" @click="cycleType()">Change activity type</Button>
    </View>

    <View class="mt-4 gap-2">
      <Text :class="ui.caption">Distance (miles)</Text>
      <TextInput testID="distance-input" :class="ui.input" placeholder="5.0" :value="distance" @input="distance.set(eventText($event))" />
      <Text :class="ui.caption">Duration (MM:SS or H:MM:SS)</Text>
      <TextInput testID="duration-input" :class="ui.input" placeholder="45:30" :value="duration" @input="duration.set(eventText($event))" />
      <Text :class="ui.caption">Elevation gain (feet)</Text>
      <TextInput testID="elevation-input" :class="ui.input" placeholder="800" :value="elevation" @input="elevation.set(eventText($event))" />
      <Text :class="ui.caption">Trail id (optional)</Text>
      <TextInput testID="trail-input" :class="ui.input" placeholder="42" :value="trailId" @input="trailId.set(eventText($event))" />
      <Text :class="ui.caption">Date</Text>
      <TextInput testID="date-input" :class="ui.input" placeholder="YYYY-MM-DD" :value="date" @input="date.set(eventText($event))" />
      <Text :class="ui.caption">Notes</Text>
      <TextInput testID="notes-input" :class="ui.input" placeholder="How did it go?" :value="notes" @input="notes.set(eventText($event))" />
    </View>

    <View class="mt-4 gap-2">
      <Text testID="visibility" class="text-sm text-[#253321] dark:text-[#e3ecdf]" :text="'Visible to ' + visibilities[visibilityIndex()]" />
      <Button testID="cycle-visibility" :class="ui.secondary" @click="cycleVisibility()">Change visibility</Button>
    </View>

    <View class="mt-5 gap-2">
      <NativeRunMetric label="Distance" testID="distance-preview">
        <Text class="text-xl font-bold text-[#192414] dark:text-[#f0f5ec]" :text="distance() ? distance() + ' mi' : '--'" />
      </NativeRunMetric>
      <NativeRunMetric label="Duration" testID="duration-preview">
        <Text class="text-xl font-bold text-[#192414] dark:text-[#f0f5ec]" :text="duration() || '--'" />
      </NativeRunMetric>
    </View>

    <Text :show="error" testID="manual-error" class="mt-4 text-[#b4232a] dark:text-[#ff8487]" :text="error" />
    <Button testID="save-activity" class="mt-5" :class="ui.action" :disabled="saving" :title="saving() ? 'Saving…' : 'Save activity'" @click="submit()" />
    <Button testID="manual-back" class="mt-2" :class="ui.secondary" @click="goBack()">Back</Button>
  </ScrollView>
</SafeAreaView>
