<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import { onNativeAccountChange, createNativeApi, loadOutcome } from '../functions/native-api'
import { requireNativeAccount } from '../functions/native-session'
import { settledFollowerCount } from '../functions/athletes'
import {
  canDeleteClub,
  canInviteToClub,
  clubApiPath,
  clubDeleteRequest,
  clubDetailFrom,
  clubDoorLabel,
  clubInvitesPath,
  clubJoinRequest,
  clubMemberText,
  clubPlaceLine,
  clubRedeemPath,
  clubRoleOf,
  clubWeeklyActivitiesText,
  clubWeeklyDistanceText,
  inviteLine,
  inviteRowsFrom,
  inviteStatusText,
  isRedeemable,
  memberLine,
  memberRoleText,
} from '../functions/clubs'
import { pathIdFrom } from '../functions/route-id'

/*
 * One club, natively. Eighteenth screen.
 *
 * `/api/clubs/{id}` answers `{ success, club }` and the club carries its own
 * members, week and leaderboard, so this is one request plus the invites.
 *
 * The permissions are read off the payload, never guessed. Inviting needs an
 * owner or an admin *on the roster* — `isMember` is not enough — and deleting
 * is the creator's alone, which an admin's role sounds like it should cover
 * and does not. A screen that decided either for itself would offer a control
 * the API refuses.
 *
 * Joining and leaving are one endpoint: the server holds the membership and
 * answers with `joined`, so the direction is never guessed. The count settles
 * through `settledFollowerCount`, shared with the athlete screen and the web
 * page — settling from the direction of the tap is what took this very club
 * from 48 members to 47 on a refused join.
 *
 * **No copy button on an invite code.** `enableClipboard` is false in the
 * app's capability set, so `craft.clipboard` does not exist here; the code is
 * shown as text rather than behind a button that would do nothing.
 *
 * Deleting takes two taps. There is no system confirm dialog in a native
 * screen and a delete takes the club away from everybody in it.
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft
const params = craft.route.params

/** Digits only: `/club/2.5` must not load club 2. */
const wanted = pathIdFrom(params.id)

const club = state<any>(null)
const invites = state<any[]>([])
const viewerId = state(0)
const memberCount = state(0)
const joined = state(false)
const loading = state(true)
const error = state('')
const missing = state(false)
const working = state(false)
const notice = state('')
const redeemCode = state('')
const inviteEmail = state('')
const deleteArmed = state(false)
const api = createNativeApi(craft)
let active = true


function eventText(event: { text?: unknown }): string {
  return typeof event?.text === 'string' ? event.text : ''
}

function nameText(): string {
  return String(club()?.name ?? '')
}

function placeText(): string {
  return clubPlaceLine(club())
}

function typeText(): string {
  return String(club()?.type ?? '')
}

function aboutText(): string {
  return String(club()?.description ?? '')
}

function membersText(): string {
  return clubMemberText(memberCount())
}

function weekDistanceText(): string {
  return clubWeeklyDistanceText(club())
}

function weekActivitiesText(): string {
  return clubWeeklyActivitiesText(club())
}

function roleText(): string {
  const role = clubRoleOf(club(), viewerId())
  return role ? memberRoleText({ role }) : ''
}

function doorText(): string {
  return clubDoorLabel(club())
}

/*
 * The join button's own words. `clubActionLabel` reads a list row, which holds
 * its membership as `isMember`; here the live signal is what the button must
 * follow, so the four cases are spelled out against it.
 */
function joinText(): string {
  const current = club()
  if (!current)
    return ''
  if (joined())
    return 'Leave'
  return current.joinPolicy === 'invite_only'
    ? 'Invite only'
    : current.joinPolicy === 'request' ? 'Ask to join' : 'Join'
}

function canJoin(): boolean {
  return Boolean(club()) && (joined() || club()?.joinPolicy !== 'invite_only')
}

/*
 * Whether to offer the code field instead of the button.
 *
 * `!canJoin()` alone is *true* before anything has loaded — there is no club
 * yet — so the panel flashed its redeem field on every load. Both halves have
 * to be asked: there is a club, and its door is not one a button can open.
 */
function isClosedDoor(): boolean {
  return Boolean(club()) && !canJoin()
}

function members(): any[] {
  return Array.isArray(club()?.members) ? club().members : []
}

function board(): any[] {
  return Array.isArray(club()?.leaderboard) ? club().leaderboard : []
}

function memberText(member: any): string {
  return memberLine(member)
}

function roleOf(member: any): string {
  return memberRoleText(member)
}

function boardLine(row: any): string {
  return `${row?.rank ?? ''}. ${row?.name ?? ''}`
}

function boardDistance(row: any): string {
  return `${Number(row?.weeklyDistance ?? 0).toFixed(1)} mi`
}

function mayInvite(): boolean {
  return canInviteToClub(club(), viewerId())
}

function mayDelete(): boolean {
  return canDeleteClub(club(), viewerId())
}

function inviteText(invite: any): string {
  return inviteLine(invite)
}

function inviteStatus(invite: any): string {
  return inviteStatusText(invite)
}

function deleteText(): string {
  return deleteArmed() ? 'Really delete? Everybody loses it.' : 'Delete this club'
}

function openMember(member: any): void {
  const id = Number(member?.userId) || 0
  if (id > 0)
    craft.navigation.push('AthleteDetail', { id: String(id) })
}

function backToClubs(): void {
  craft.navigation.push('Clubs', {})
}

/*
 * Join or leave. The server decides which way it goes, so the direction is
 * never guessed — and the count settles from the state *before* the tap.
 */
async function toggleMembership(): Promise<void> {
  if (working() || wanted === null || !canJoin())
    return
  const was = joined()
  const countWas = memberCount()
  working.set(true)
  notice.set('')
  joined.set(!was)
  memberCount.set(settledFollowerCount(was, !was, countWas))

  try {
    const request = clubJoinRequest(wanted)
    const result = await api.send(request.path, request.method, {})
    if (!active)
      return
    if (!result.ok || result.body?.success === false)
      throw new Error(String(result.body?.error ?? 'Could not update your membership.'))

    const settled = typeof result.body?.joined === 'boolean' ? result.body.joined : !was
    joined.set(settled)
    memberCount.set(settledFollowerCount(was, settled, countWas, result.body?.memberCount))
  }
  catch (cause) {
    if (!active)
      return
    joined.set(was)
    memberCount.set(settledFollowerCount(was, was, countWas))
    notice.set(cause instanceof Error ? cause.message : 'Could not reach the service.')
  }
  finally {
    if (active)
      working.set(false)
  }
}

/*
 * An invite-only club is reached with a code rather than a button. Held to
 * eight characters here so a half-typed code reads as "finish typing" rather
 * than the server's "that code did not work".
 */
async function redeem(): Promise<void> {
  if (working() || wanted === null)
    return
  if (!isRedeemable(redeemCode())) {
    notice.set('Enter the invite code you were sent.')
    return
  }
  working.set(true)
  notice.set('')
  try {
    const result = await api.send(clubRedeemPath(), 'POST', { code: redeemCode().trim() })
    if (!active)
      return
    if (result.ok && result.body?.success !== false) {
      redeemCode.set('')
      notice.set('Code accepted.')
      await load()
      return
    }
    notice.set(String(result.body?.error ?? 'That code did not work.'))
  }
  catch {
    if (active)
      notice.set('Could not reach the service.')
  }
  finally {
    if (active)
      working.set(false)
  }
}

async function createInvite(): Promise<void> {
  if (working() || wanted === null || !mayInvite())
    return
  const email = inviteEmail().trim()
  if (!email) {
    notice.set('Enter the email address to invite.')
    return
  }
  working.set(true)
  notice.set('')
  try {
    const result = await api.send(clubInvitesPath(wanted), 'POST', { email })
    if (!active)
      return
    if (result.ok && result.body?.success !== false) {
      inviteEmail.set('')
      await loadInvites()
      return
    }
    notice.set(String(result.body?.error ?? 'Could not create the invite.'))
  }
  catch {
    if (active)
      notice.set('Could not reach the service.')
  }
  finally {
    if (active)
      working.set(false)
  }
}

function armDelete(): void {
  if (!deleteArmed()) {
    deleteArmed.set(true)
    return
  }
  void doDelete()
}

async function doDelete(): Promise<void> {
  if (working() || wanted === null || !mayDelete())
    return
  working.set(true)
  try {
    const request = clubDeleteRequest(wanted)
    const result = await api.send(request.path, request.method)
    if (!active)
      return
    if (result.ok) {
      craft.navigation.push('Clubs', {})
      return
    }
    notice.set(String(result.body?.error ?? 'Could not delete this club.'))
  }
  catch {
    if (active)
      notice.set('Could not reach the service.')
  }
  finally {
    if (active) {
      working.set(false)
      deleteArmed.set(false)
    }
  }
}

async function loadInvites(): Promise<void> {
  if (wanted === null || !mayInvite())
    return
  const result = await api.send(clubInvitesPath(wanted))
  if (active && result.ok)
    invites.set(inviteRowsFrom(result.body))
}

let loadVersion = 0
async function load(): Promise<void> {
  const currentLoad = ++loadVersion
  loading.set(true)
  error.set('')
  try {
    if (wanted === null) {
      if (active && currentLoad === loadVersion)
        missing.set(true)
      return
    }

    if (!await requireNativeAccount(craft, `/club/${wanted}`)) return

    const me = await api.send('/api/me')
    if (active && me.ok && me.body?.user?.id)
      viewerId.set(Number(me.body.user.id))

    const result = await api.send(clubApiPath(wanted))
    if (!active || currentLoad !== loadVersion)
      return
    // A record that does not exist is an answer, not a failure to load.
    const outcome = loadOutcome(result)
    if (outcome === 'missing') {
      missing.set(true)
      return
    }
    if (outcome === 'error')
      throw new Error('Could not load this club')

    const row = clubDetailFrom(result.body)
    if (!row) {
      missing.set(true)
      return
    }
    club.set(row)
    memberCount.set(Number(row.memberCount) || 0)
    joined.set(Boolean(row.isMember))

    // Only an owner or an admin may list these, and a refusal costs the list
    // rather than the club.
    await loadInvites()
  }
  catch (cause) {
    if (active && currentLoad === loadVersion)
      error.set(cause instanceof Error ? cause.message : 'Could not load this club')
  }
  finally {
    if (active && currentLoad === loadVersion)
      loading.set(false)
  }
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Club', largeTitle: false })
  void load()
})

onDestroy(() => {
  active = false
})
onMount(() => onNativeAccountChange(craft, () => { club.set(null); invites.set([]); void load() }))
</script>

<View class="flex-1 bg-page">
  <ScrollView class="p-4" testID="club-detail-scroll">
    <ActivityIndicator :show="loading" testID="club-loading" class="mt-6" />
    <ErrorState :show="error()" testID="club-error" :title="error()" message="Check your connection, then try again." :busy="loading()" className="mt-4" @retry="load()" />

    <View :show="missing" testID="club-missing" class="mt-6 gap-3">
      <Text class="text-lg font-semibold text-fg">No such club</Text>
      <Button testID="back-to-clubs" @click="backToClubs()">See the directory</Button>
    </View>

    <Text :show="notice" testID="club-notice" class="mt-4 text-sm text-warning" :text="notice" />

    <View :show="club()" testID="club-body" class="gap-4">
      <View class="gap-1">
        <Text testID="club-name" class="text-2xl font-bold text-fg" :text="nameText()" />
        <Text testID="club-place" class="text-sm text-fg-muted" :text="placeText()" />
        <View class="mt-1 flex-row gap-2">
          <Text testID="club-type" class="text-xs uppercase text-fg-soft" :text="typeText()" />
          <Text testID="club-members" class="text-xs text-fg-soft" :text="membersText()" />
          <Text :show="roleText()" testID="club-role" class="text-xs uppercase text-accent" :text="roleText()" />
        </View>
      </View>

      <Text :show="aboutText()" testID="club-about" class="text-sm text-fg-strong" :text="aboutText()" />

      <Button :show="canJoin()" testID="club-join" @click="toggleMembership()" :text="joinText()" />

      {{-- An invite-only club is reached with a code, not a button. The door
           label says which kind of club this is. --}}
      <View :show="isClosedDoor()" testID="club-closed" class="gap-2 rounded-xl bg-panel p-3">
        <Text testID="club-door" class="text-sm text-warning" :text="doorText()" />
        <TextInput testID="redeem-code" placeholder="Invite code" :value="redeemCode" @input="redeemCode.set(eventText($event))" />
        <Button testID="club-redeem" @click="redeem()">Redeem</Button>
      </View>

      <View class="flex-row gap-2">
        <View class="flex-1 rounded-xl bg-panel p-3">
          <Text class="text-xs uppercase text-fg-soft">This week</Text>
          <Text testID="club-week-distance" class="text-lg font-bold text-fg" :text="weekDistanceText()" />
        </View>
        <View class="flex-1 rounded-xl bg-panel p-3">
          <Text class="text-xs uppercase text-fg-soft">Activities</Text>
          <Text testID="club-week-activities" class="text-lg font-bold text-fg" :text="weekActivitiesText()" />
        </View>
      </View>

      <View :show="board().length > 0" testID="club-board" class="gap-2">
        <Text class="text-xs font-semibold uppercase text-fg-soft">This week's leaders</Text>
        <View :for="row in board()" :key="row.rank" class="flex-row justify-between rounded-xl bg-panel p-3">
          <Text testID="board-line" class="flex-1 text-sm text-fg" :text="boardLine(row)" />
          <Text testID="board-distance" class="text-sm text-fg-muted" :text="boardDistance(row)" />
        </View>
      </View>

      <View :show="members().length > 0" testID="club-roster" class="gap-2">
        <Text class="text-xs font-semibold uppercase text-fg-soft">Members</Text>
        <Pressable :for="member in members()" :key="member.userId" testID="club-member" @click="openMember(member)" class="flex-row justify-between rounded-xl bg-panel p-3">
          <Text class="flex-1 text-sm text-fg" :text="memberText(member)" />
          <Text testID="member-role" class="text-xs text-fg-soft" :text="roleOf(member)" />
        </Pressable>
      </View>

      {{-- Owners and admins only, read off the roster. The code is shown as
           text: `enableClipboard` is false, so a copy button would do nothing. --}}
      <View :show="mayInvite()" testID="club-invites" class="gap-2 rounded-xl bg-panel p-3">
        <Text class="text-xs font-semibold uppercase text-fg-soft">Invites</Text>
        <TextInput testID="invite-email" placeholder="their@email.com" :value="inviteEmail" @input="inviteEmail.set(eventText($event))" />
        <Button testID="club-invite" @click="createInvite()">Create an invite</Button>
        <View :for="invite in invites()" :key="invite.id" class="gap-1 rounded-lg bg-page p-2">
          <Text testID="invite-line" class="text-sm text-fg" :text="inviteText(invite)" />
          <Text testID="invite-code" class="text-xs text-accent" :text="invite.code" />
          <Text testID="invite-status" class="text-xs text-fg-soft" :text="inviteStatus(invite)" />
        </View>
      </View>

      <Button :show="mayDelete()" testID="club-delete" @click="armDelete()" :text="deleteText()" />
    </View>
  </ScrollView>
</View>
