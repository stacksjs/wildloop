<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import { onNativeAccountChange, createNativeApi } from '../functions/native-api'
import {
  achievementsPath,
  activitiesPath,
  badgeIsEarned,
  badgeProgressText,
  badgeRowsFrom,
  bestMonthText,
  monthBars,
  sortBadges,
  YEAR_CHART,
  yearTotalText,
} from '../functions/achievements'
import { monthlyProgress, personalBests } from '../functions/personal-bests'

/*
 * Achievements, natively. Ninth screen, and the first that draws a chart.
 *
 * The year is twelve `<rect>`s in one SVG, each bound to its month's share of
 * the best one. The web page does the same thing with twelve divs and a
 * percentage height; a native screen has no percentage heights, and a bound
 * geometry attribute on a shape does reach the renderer — `:points` on the
 * trails screen draws real routes on device.
 *
 * Everything numeric comes from `personal-bests.ts`, which the web page has
 * always used: the three records and the twelve months are computed from the
 * same activity rows by the same functions. This screen only decides where the
 * bars go.
 *
 * Narrower than the web page: no carousel (it tracks scroll position to colour
 * the screen, and a phone list does not need a third way to move), and no
 * Share. Sharing a record goes through the web page, which has the sheet.
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft

const badges = state<any[]>([])
const records = state<any[]>([])
const months = state<any[]>([])
const loading = state(true)
const error = state('')
const signedOut = state(false)
const api = createNativeApi(craft)
let active = true

/** The chart's box, so the viewBox in the markup and the bars agree. */
function chartBox(): string {
  return `0 0 ${YEAR_CHART.width} ${YEAR_CHART.height}`
}

function bars(): any[] {
  return monthBars(months())
}

/*
 * Twelve months of zeroes still produce twelve bars, each zero high, so the
 * card drew nothing and "This year" sat over an empty white box — the same
 * shape the six-week chart had on Stats. A month nobody ran still gets no bar,
 * which is the honest gap beside a month that was run; it is only every month
 * being empty that has nothing to draw.
 *
 * The caption below the chart stays either way: "0 mi this year" is a fact
 * worth reading, and it is what is left once the empty card goes.
 */
function hasYearChart(): boolean {
  return months().some((month: any) => Number(month?.miles) > 0)
}

function yearTotal(): string {
  return yearTotalText(months())
}

function bestMonth(): string {
  return bestMonthText(months())
}

function earned(badge: any): boolean {
  return badgeIsEarned(badge)
}

function progress(badge: any): string {
  return badgeProgressText(badge)
}

function badgeLine(badge: any): string {
  return `${badge?.icon ? `${badge.icon} ` : ''}${badge?.name ?? ''}`
}

let loadVersion = 0
async function load(): Promise<void> {
  const currentLoad = ++loadVersion
  loading.set(true)
  error.set('')
  try {
    const token = await api.readToken()
    if (!token) {
      if (active && currentLoad === loadVersion)
        signedOut.set(true)
      return
    }

    const me = await api.send('/api/me')
    if (!me.ok || !me.body?.user?.id) {
      if (active && currentLoad === loadVersion)
        signedOut.set(true)
      return
    }
    const userId = Number(me.body.user.id)

    /*
     * The badges and the activities are independent, so they go together
     * rather than one after the other — this screen is two round trips deep
     * already, behind the keychain and `/api/me`.
     */
    const [badgeResult, activityResult] = await Promise.all([
      api.send(achievementsPath(userId)),
      api.send(activitiesPath(userId)),
    ])
    if (!active || currentLoad !== loadVersion)
      return

    if (badgeResult.ok)
      badges.set(sortBadges(badgeRowsFrom(badgeResult.body)))

    if (!activityResult.ok)
      throw new Error('Could not load your activities')

    // The endpoint answers with the athlete's own rows; the filter is what the
    // web page does, and costs nothing if the server already narrowed it.
    const mine = (activityResult.body?.activities ?? []).filter((row: any) => Number(row?.userId) === userId)
    records.set(personalBests(mine))
    months.set(monthlyProgress(mine, new Date().getFullYear()))
  }
  catch (cause) {
    if (active && currentLoad === loadVersion)
      error.set(cause instanceof Error ? cause.message : 'Could not load your achievements')
  }
  finally {
    if (active && currentLoad === loadVersion)
      loading.set(false)
  }
}

function openRecord(record: any): void {
  if (!record?.activityId)
    return
  craft.navigation.open(`/activity/${record.activityId}`)
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Achievements', largeTitle: true })
  void load()
})

onDestroy(() => {
  active = false
})
onMount(() => onNativeAccountChange(craft, () => { badges.set([]); records.set([]); months.set([]); void load() }))
</script>

<View class="flex-1 bg-page">
  <ScrollView class="p-4" testID="achievements-scroll">
    <Text class="mt-1 text-sm text-fg-muted">Your records, your year, and every badge.</Text>

    <ActivityIndicator :show="loading" testID="achievements-loading" class="mt-6" />
    <ErrorState :show="error()" testID="achievements-error" :title="error()" message="Check your connection, then try again." :busy="loading()" className="mt-4" @retry="load()" />
    <Text :show="signedOut" testID="achievements-signed-out" class="mt-4 text-warning">Sign in to see your achievements.</Text>
    <Button :show="signedOut" testID="achievements-sign-in" @click="craft.navigation.open('/login?next=/achievements')">Sign in</Button>

    {{-- The year, as twelve bars. A month that was run always gets a sliver:
         nothing and almost nothing look the same otherwise, and only one of
         them is true. --}}
    <View :show="months().length > 0" testID="year-chart" class="mt-6 gap-2">
      <Text class="text-xs font-semibold uppercase text-fg-soft">This year</Text>
      <View :show="hasYearChart()" testID="year-chart-card" class="h-20 w-full rounded-xl bg-panel p-2">
        <svg :viewBox="chartBox()" class="h-full w-full">
          <rect :for="bar in bars()" :key="bar.month" :x="bar.x" :y="bar.y" :width="bar.width" :height="bar.height" fill="#34d399" />
        </svg>
      </View>
      <Text testID="year-total" class="text-sm text-fg" :text="yearTotal()" />
      <Text :show="bestMonth()" testID="best-month" class="text-xs text-fg-muted" :text="bestMonth()" />
    </View>

    <View :show="records().length > 0" class="mt-6 gap-2">
      <Text class="text-xs font-semibold uppercase text-fg-soft">Personal bests</Text>
      <Pressable :for="record in records()" :key="record.key" testID="record-row" class="rounded-xl bg-panel p-3" @click="openRecord(record)">
        <Text class="text-xs text-fg-muted" :text="record.label" />
        <Text class="text-xl font-bold text-fg" :text="record.value" />
        <Text class="text-xs text-fg-muted" :text="record.activityTitle" />
      </Pressable>
    </View>

    <View :show="badges().length > 0" class="mt-6 gap-2">
      <Text class="text-xs font-semibold uppercase text-fg-soft">Badges</Text>
      <View :for="badge in badges()" :key="badge.id" class="flex-row items-center gap-3 rounded-xl bg-panel p-3">
        <View class="flex-1">
          <Text testID="badge-name" class="text-sm font-semibold text-fg" :text="badgeLine(badge)" />
          <Text :show="badge.description" class="text-xs text-fg-muted" :text="badge.description" />
        </View>
        <Text testID="badge-progress" :class="earned(badge) ? 'text-xs font-semibold text-accent' : 'text-xs font-semibold text-fg-soft'" :text="progress(badge)" />
      </View>
    </View>

    <EmptyState :show="!loading && !error && !signedOut && badges().length === 0 && records().length === 0" testID="achievements-empty" variant="bare" className="mt-6" title="Record runs and take territory to start unlocking badges." />
  </ScrollView>
</View>
