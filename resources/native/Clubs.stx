<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import { settledFollowerCount } from '../functions/athletes'
import { onNativeAccountChange, createNativeApi } from '../functions/native-api'
import { requireNativeAccount } from '../functions/native-session'
import { nativeUi } from '../functions/native-ui'
import {
  CLUB_FILTER_LABELS,
  CLUB_FILTERS,
  clubActionLabel,
  clubDoorLabel,
  clubJoinRequest,
  clubMemberText,
  clubPlaceLine,
  clubRowsFrom,
  clubsPath,
  clubWeekLine,
  filterClubs,
} from '../functions/clubs'

/*
 * The club directory, natively. Seventh screen.
 *
 * Joining is the point of this one, and it is the second screen that writes
 * per row. Join and leave are the same endpoint — the server owns the
 * membership and answers with `joined` — so the row moves optimistically and
 * is put back from what the server says rather than from what the tap assumed.
 *
 * An invite-only club the viewer is not in is not joinable from a list, so its
 * row opens the club's page instead, where an invite would be waiting. That
 * rule lives in `clubActionLabel`, with the web page reading the same one.
 *
 * Narrower than the web page: no create form (six fields and a join policy),
 * and no distance sorting — the web page puts the nearest crews first from a
 * resolved location, and geolocation is not in the native capability set. The
 * server's order, biggest crew first, is what a list without a location can
 * honestly offer.
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft
const ui = nativeUi

const FILTER_OPTIONS = CLUB_FILTERS.map(value => ({ value, label: CLUB_FILTER_LABELS[value] }))
const chosenFilter = state<string>(CLUB_FILTERS[0])
const rows = state<any[]>([])
const loading = state(true)
const error = state('')
const api = createNativeApi(craft)
let active = true

function currentFilter(): any {
  return chosenFilter()
}

function shown(): any[] {
  return filterClubs(rows(), currentFilter())
}

function heading(): string {
  const total = shown().length
  if (total === 0)
    return ''
  return total === 1 ? 'One crew' : `${total} crews`
}

function place(club: any): string {
  return clubPlaceLine(club)
}

function members(club: any): string {
  return clubMemberText(club?.memberCount)
}

function week(club: any): string {
  return clubWeekLine(club)
}

function door(club: any): string {
  return clubDoorLabel(club)
}

function action(club: any): string {
  return clubActionLabel(club)
}


let loadVersion = 0
async function load(): Promise<void> {
  const currentLoad = ++loadVersion
  loading.set(true)
  error.set('')
  if (!await requireNativeAccount(craft, '/clubs')) {
    // Stop the spinner before leaving. A screen that returns here is on its
    // way to Login, but Craft prepares the tab roots hidden beside the
    // visible screen, so this one went on spinning behind the gate — and an
    // animating spinner is an animation that never ends, which is UIKit's
    // definition of an app that is not idle. XCUITest then blocks every tap
    // for sixty seconds waiting for quiescence, and the device suite went
    // from 22 seconds to 740. Found 23 Oct 2026.
    loading.set(false)
    return
  }
  try {
    const result = await api.send(clubsPath())
    if (!active || currentLoad !== loadVersion)
      return
    if (!result.ok)
      throw new Error('Could not load clubs')
    rows.set(clubRowsFrom(result.body))
  }
  catch (cause) {
    if (active && currentLoad === loadVersion)
      error.set(cause instanceof Error ? cause.message : 'Could not load clubs')
  }
  finally {
    if (active && currentLoad === loadVersion)
      loading.set(false)
  }
}

/** Replace one club in the list, leaving the rest and their order alone. */
function patch(id: number, changes: Record<string, unknown>): void {
  rows.set(rows().map(club => (club.id === id ? { ...club, ...changes } : club)))
}

async function toggleMembership(club: any): Promise<void> {
  const id = Number(club?.id)
  if (!id)
    return

  // Not a door this list can open. The club's own page is where an invite is
  // redeemed, and it is native now, so it is pushed rather than handed off.
  if (clubActionLabel(club) === 'View') {
    craft.navigation.push('ClubDetail', { id: String(id) })
    return
  }

  if (!await requireNativeAccount(craft, '/clubs')) return

  const was = club.isMember === true
  const countWas = Number(club.memberCount) || 0
  patch(id, { isMember: !was, memberCount: was ? Math.max(0, countWas - 1) : countWas + 1 })

  const { path, method } = clubJoinRequest(id)
  let joined = was
  let serverCount: number | null = null
  try {
    const result = await api.send(path, method, {})
    if (result.ok && typeof result.body?.joined === 'boolean')
      joined = result.body.joined
    if (typeof result.body?.memberCount === 'number')
      serverCount = result.body.memberCount
  }
  catch {
    joined = was
  }

  if (!active)
    return

  /*
   * What the server says, not what the tap assumed — and counted from where
   * the row started rather than from the direction of the tap. A refused join
   * leaves the club exactly as big as it was; an earlier version of this
   * subtracted one anyway and sent 48 members to 47 for failing to join.
   *
   * That arithmetic is `settledFollowerCount` now, shared with the club,
   * athlete and web pages that each had their own copy of this bug waiting.
   */
  patch(id, { isMember: joined, memberCount: settledFollowerCount(was, joined, countWas, serverCount) })
}

function openClub(club: any): void {
  if (!club?.id)
    return
  craft.navigation.push('ClubDetail', { id: String(club.id) })
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Clubs', largeTitle: true })
  void load()
})

onDestroy(() => {
  active = false
})
onMount(() => onNativeAccountChange(craft, () => { rows.set([]); void load() }))
</script>

<View :class="ui.screen">
  <ScrollView class="flex-1 pb-8" testID="clubs-scroll">
    <Text :class="ui.caption" class="mx-4 mt-3">Crews training together — join one, or start your own on the web.</Text>

    <ChoiceChips testID="clubs-filter" label="Show" className="mt-3" v-model:value="chosenFilter" :options="FILTER_OPTIONS" />

    <ActivityIndicator :show="loading() && rows().length === 0" testID="clubs-loading" class="mt-8" />
    <ErrorState :show="error()" testID="clubs-error" :title="error()" message="Check your connection, then try again." :busy="loading()" className="mt-4" @retry="load()" />
    {{-- Rows from the grouped vocabulary rather than GroupedListRow: a crew's
         place, its week and its door are separate lines, and the week line is
         the one a join changes in place. --}}
    <View :show="heading()" testID="clubs-list" class="mt-6">
      <Text :class="ui.header" class="mt-0" :text="heading()" />
      <View :class="ui.group">
        <View :for="(club, index) in shown()" :key="club.id">
          <View :show="index > 0" :class="ui.separator" />
          <View :class="ui.row">
            <Pressable testID="club-row" class="flex-1 gap-0.5" @click="openClub(club)">
              <Text :class="ui.titleStrong" :text="club.name" />
              <Text :show="place(club)" :class="ui.subtitle" :text="place(club)" />
              <Text :class="ui.caption" :text="members(club) + ' · ' + week(club)" />
              <Text :show="door(club)" testID="club-door" class="text-[13px] text-warning" :text="door(club)" />
            </Pressable>
            <Button testID="club-action" :class="ui.secondary" @click="toggleMembership(club)" :text="action(club)" />
          </View>
        </View>
      </View>
    </View>

    <EmptyState :show="!loading() && !error() && shown().length === 0" testID="clubs-empty" variant="bare" className="mt-6" title="No club under that filter yet." />
  </ScrollView>
</View>
