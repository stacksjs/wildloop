<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import {
  CLUB_FILTER_LABELS,
  CLUB_FILTERS,
  clubActionLabel,
  clubDoorLabel,
  clubJoinRequest,
  clubMemberText,
  clubPath,
  clubPlaceLine,
  clubRowsFrom,
  clubsPath,
  clubWeekLine,
  filterClubs,
} from '../functions/clubs'

/*
 * The club directory, natively. Seventh screen.
 *
 * Joining is the point of this one, and it is the second screen that writes
 * per row. Join and leave are the same endpoint — the server owns the
 * membership and answers with `joined` — so the row moves optimistically and
 * is put back from what the server says rather than from what the tap assumed.
 *
 * An invite-only club the viewer is not in is not joinable from a list, so its
 * row opens the club's page instead, where an invite would be waiting. That
 * rule lives in `clubActionLabel`, with the web page reading the same one.
 *
 * Narrower than the web page: no create form (six fields and a join policy),
 * and no distance sorting — the web page puts the nearest crews first from a
 * resolved location, and geolocation is not in the native capability set. The
 * server's order, biggest crew first, is what a list without a location can
 * honestly offer.
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft

const filterIndex = state(0)
const rows = state<any[]>([])
const loading = state(true)
const error = state('')
const signedOut = state(false)
const bearer = state('')
let active = true
let reading: Promise<string> | null = null

/*
 * One read of the keychain, memoized as the promise rather than the value:
 * two callers at mount otherwise each issue their own request before either
 * has an answer to cache.
 */
async function readToken(): Promise<string> {
  if (bearer())
    return bearer()

  reading ??= Promise.resolve(craft.secureStorage.get('auth_token')).then((value) => {
    const token = typeof value === 'string' ? value : ''
    bearer.set(token)
    return token
  })

  return reading
}

function currentFilter(): any {
  return CLUB_FILTERS[filterIndex()]
}

function filterName(): string {
  return CLUB_FILTER_LABELS[currentFilter()]
}

function shown(): any[] {
  return filterClubs(rows(), currentFilter())
}

function heading(): string {
  const total = shown().length
  if (total === 0)
    return ''
  return total === 1 ? 'One crew' : `${total} crews`
}

function place(club: any): string {
  return clubPlaceLine(club)
}

function members(club: any): string {
  return clubMemberText(club?.memberCount)
}

function week(club: any): string {
  return clubWeekLine(club)
}

function door(club: any): string {
  return clubDoorLabel(club)
}

function action(club: any): string {
  return clubActionLabel(club)
}

async function load(): Promise<void> {
  loading.set(true)
  error.set('')
  try {
    const token = await readToken()
    const response = await fetch(`https://wildloop.org${clubsPath()}`, {
      headers: token
        ? { 'Accept': 'application/json', 'Authorization': `Bearer ${token}` }
        : { Accept: 'application/json' },
    })
    const body = await response.json().catch(() => null)
    if (!active)
      return
    if (!response.ok)
      throw new Error('Could not load clubs')
    rows.set(clubRowsFrom(body))
  }
  catch (cause) {
    if (active)
      error.set(cause instanceof Error ? cause.message : 'Could not load clubs')
  }
  finally {
    if (active)
      loading.set(false)
  }
}

function cycleFilter(): void {
  filterIndex.set((filterIndex() + 1) % CLUB_FILTERS.length)
}

/** Replace one club in the list, leaving the rest and their order alone. */
function patch(id: number, changes: Record<string, unknown>): void {
  rows.set(rows().map(club => (club.id === id ? { ...club, ...changes } : club)))
}

async function toggleMembership(club: any): Promise<void> {
  const id = Number(club?.id)
  if (!id)
    return

  // Not a door this list can open. The club's own page is where an invite is.
  if (clubActionLabel(club) === 'View') {
    craft.navigation.open(clubPath(id))
    return
  }

  const token = await readToken()
  if (!token) {
    signedOut.set(true)
    return
  }

  const was = club.isMember === true
  const countWas = Number(club.memberCount) || 0
  patch(id, { isMember: !was, memberCount: was ? Math.max(0, countWas - 1) : countWas + 1 })

  const { path, method } = clubJoinRequest(id)
  let joined = was
  let serverCount: number | null = null
  try {
    const response = await fetch(`https://wildloop.org${path}`, {
      method,
      headers: { 'Accept': 'application/json', 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
      body: JSON.stringify({}),
    })
    const body = await response.json().catch(() => null)
    if (response.ok && typeof body?.joined === 'boolean')
      joined = body.joined
    if (typeof body?.memberCount === 'number')
      serverCount = body.memberCount
  }
  catch {
    joined = was
  }

  if (!active)
    return

  /*
   * What the server says, not what the tap assumed — and counted from where
   * the row started rather than from the direction of the tap. A refused join
   * leaves the club exactly as big as it was; an earlier version of this
   * subtracted one anyway and sent 48 members to 47 for failing to join.
   */
  const settled = joined === was
    ? countWas
    : joined ? countWas + 1 : Math.max(0, countWas - 1)
  patch(id, { isMember: joined, memberCount: serverCount ?? settled })
}

function openClub(club: any): void {
  if (!club?.id)
    return
  craft.navigation.open(clubPath(club.id))
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Clubs', largeTitle: true })
  void load()
})

onDestroy(() => {
  active = false
})
</script>

<SafeAreaView class="flex-1 bg-slate-950">
  <ScrollView class="p-4" testID="clubs-scroll">
    <Text class="mt-1 text-sm text-slate-400">Crews training together — join one, or start your own on the web.</Text>

    <View class="mt-4 gap-2">
      <Text testID="clubs-filter" class="text-sm text-slate-300" :text="filterName()" />
      <Button testID="cycle-filter" @click="cycleFilter()">Change the filter</Button>
    </View>

    <ActivityIndicator :show="loading" testID="clubs-loading" class="mt-6" />
    <Text :show="error" testID="clubs-error" class="mt-4 text-rose-300" :text="error" />
    <Text :show="signedOut" testID="clubs-signed-out" class="mt-4 text-amber-300">Sign in on the web to join a club.</Text>

    <Text :show="heading()" testID="clubs-count" class="mt-5 text-xs font-semibold uppercase text-slate-500" :text="heading()" />

    <View class="mt-2 gap-2">
      <View :for="club in shown()" :key="club.id" class="rounded-xl bg-slate-900 p-3">
        <Pressable testID="club-row" @click="openClub(club)">
          <Text class="text-base font-semibold text-white" :text="club.name" />
          <Text :show="place(club)" class="text-xs text-slate-400" :text="place(club)" />
          <Text class="mt-1 text-xs text-slate-300" :text="members(club) + ' · ' + week(club)" />
          <Text :show="door(club)" testID="club-door" class="mt-1 text-xs text-amber-300" :text="door(club)" />
        </Pressable>
        <Button testID="club-action" class="mt-2" @click="toggleMembership(club)" :text="action(club)" />
      </View>
    </View>

    <Text :show="!loading && !error && shown().length === 0" testID="clubs-empty" class="mt-6 text-sm text-slate-400">No club under that filter yet.</Text>
  </ScrollView>
</SafeAreaView>
