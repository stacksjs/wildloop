<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import { createNativeApi } from '../functions/native-api'
import { activitiesPath } from '../functions/achievements'
import {
  activityBreakdown,
  computeTrainingStats,
  periodStats,
  STATS_PERIOD_LABELS,
  STATS_PERIODS,
  trainingActivitiesFrom,
  WEEK_CHART,
  weekBars,
} from '../functions/training-stats'

/*
 * Training stats, natively. Eleventh screen.
 *
 * There is no endpoint for these numbers — `user_stats` has no weekly or
 * monthly split — so both screens fold them from the athlete's activities with
 * `computeTrainingStats`. The web page does it in the store; this asks the API
 * and does it here.
 *
 * The translation on the way in is the part that matters. `/api/activities`
 * answers in camelCase and `computeTrainingStats` reads snake_case, because
 * those names came from the database rows the store used to hold. Feeding the
 * API's shape in untranslated returns zero for everything — silently, and
 * plausibly, like an athlete who had a quiet week. `trainingActivitiesFrom`
 * is that translation, shared so the web cannot drift from it.
 *
 * Narrower than the web page: no personal-records panel, which the
 * achievements screen already shows, and no activity list, which the feed is.
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft

const periodIndex = state(0)
const stats = state<any>(null)
const activities = state<any[]>([])
const loading = state(true)
const error = state('')
const signedOut = state(false)
const api = createNativeApi(craft)
let active = true

function period(): any {
  return STATS_PERIODS[periodIndex()]
}

function periodName(): string {
  return STATS_PERIOD_LABELS[period()]
}

function milesText(): string {
  return String(periodStats(stats(), period()).distance)
}

function elevationText(): string {
  return `${periodStats(stats(), period()).elevation.toLocaleString('en-US')} ft`
}

function activitiesText(): string {
  const count = periodStats(stats(), period()).activities
  return count === 1 ? '1 activity' : `${count} activities`
}

function streakText(): string {
  const current = Number(stats()?.currentStreak) || 0
  return current === 1 ? '1 day' : `${current} days`
}

function bestStreakText(): string {
  const best = Number(stats()?.longestStreak) || 0
  return `Best: ${best === 1 ? '1 day' : `${best} days`}`
}

function chartBox(): string {
  return `0 0 ${WEEK_CHART.width} ${WEEK_CHART.height}`
}

function bars(): any[] {
  return weekBars(stats()?.weeklyHistory ?? [])
}

function breakdown(): any[] {
  return activityBreakdown(activities()).filter(row => row.count > 0)
}

function breakdownText(row: any): string {
  return `${row.count} · ${row.share}%`
}

function cyclePeriod(): void {
  periodIndex.set((periodIndex() + 1) % STATS_PERIODS.length)
}

async function load(): Promise<void> {
  loading.set(true)
  error.set('')
  try {
    const token = await api.readToken()
    if (!token) {
      if (active)
        signedOut.set(true)
      return
    }

    const me = await api.send('/api/me')
    if (!me.ok || !me.body?.user?.id) {
      if (active)
        signedOut.set(true)
      return
    }
    const userId = Number(me.body.user.id)

    const result = await api.send(activitiesPath(userId))
    if (!active)
      return
    if (!result.ok)
      throw new Error('Could not load your training')

    const rows = trainingActivitiesFrom(result.body)
    activities.set(result.body?.activities ?? [])
    stats.set(computeTrainingStats(userId, rows))
  }
  catch (cause) {
    if (active)
      error.set(cause instanceof Error ? cause.message : 'Could not load your training')
  }
  finally {
    if (active)
      loading.set(false)
  }
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Training stats', largeTitle: true })
  void load()
})

onDestroy(() => {
  active = false
})
</script>

<SafeAreaView class="flex-1 bg-slate-950">
  <ScrollView class="p-4" testID="stats-scroll">
    <Text class="mt-1 text-sm text-slate-400">Your training, folded from everything you record.</Text>

    <ActivityIndicator :show="loading" testID="stats-loading" class="mt-6" />
    <Text :show="error" testID="stats-error" class="mt-4 text-rose-300" :text="error" />
    <Text :show="signedOut" testID="stats-signed-out" class="mt-4 text-amber-300">Sign in on the web to see your training stats.</Text>

    <View :show="stats()" testID="stats-body" class="mt-5 gap-4">
      <View class="gap-2">
        <Text testID="stats-period" class="text-xs font-semibold uppercase text-slate-500" :text="periodName()" />
        <Button testID="cycle-period" @click="cyclePeriod()">Change the period</Button>
      </View>

      <View class="flex-row gap-2">
        <View class="flex-1 rounded-xl bg-slate-900 p-3">
          <Text class="text-xs uppercase text-slate-500">Miles</Text>
          <Text testID="stat-miles" class="text-2xl font-bold text-white" :text="milesText()" />
        </View>
        <View class="flex-1 rounded-xl bg-slate-900 p-3">
          <Text class="text-xs uppercase text-slate-500">Climbing</Text>
          <Text testID="stat-elevation" class="text-2xl font-bold text-white" :text="elevationText()" />
        </View>
      </View>

      <View class="flex-row gap-2">
        <View class="flex-1 rounded-xl bg-slate-900 p-3">
          <Text class="text-xs uppercase text-slate-500">Activities</Text>
          <Text testID="stat-activities" class="text-base font-semibold text-white" :text="activitiesText()" />
        </View>
        <View class="flex-1 rounded-xl bg-slate-900 p-3">
          <Text class="text-xs uppercase text-slate-500">Day streak</Text>
          <Text testID="stat-streak" class="text-base font-semibold text-white" :text="streakText()" />
          <Text testID="stat-best-streak" class="text-xs text-slate-400" :text="bestStreakText()" />
        </View>
      </View>

      {{-- Six weeks of history. A week that was run always gets a sliver; a
           week nobody ran gets no bar, which is the honest shape of it. --}}
      <View :show="bars().length > 0" testID="week-chart" class="gap-2">
        <Text class="text-xs font-semibold uppercase text-slate-500">Last six weeks</Text>
        <View class="h-20 w-full rounded-xl bg-slate-900 p-2">
          <svg :viewBox="chartBox()" class="h-full w-full">
            <rect :for="bar in bars()" :key="bar.week" :x="bar.x" :y="bar.y" :width="bar.width" :height="bar.height" fill="#34d399" />
          </svg>
        </View>
      </View>

      <View :show="breakdown().length > 0" testID="breakdown" class="gap-2">
        <Text class="text-xs font-semibold uppercase text-slate-500">What you do</Text>
        <View :for="row in breakdown()" :key="row.type" class="flex-row justify-between rounded-xl bg-slate-900 p-3">
          <Text class="text-sm text-white" :text="row.label" />
          <Text testID="breakdown-count" class="text-sm text-slate-400" :text="breakdownText(row)" />
        </View>
      </View>
    </View>
  </ScrollView>
</SafeAreaView>
