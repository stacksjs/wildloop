<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import { onNativeAccountChange, createNativeApi } from '../functions/native-api'
import { requireNativeAccount } from '../functions/native-session'
import { activitiesPath } from '../functions/achievements'
import {
  activityBreakdown,
  computeTrainingStats,
  periodStats,
  STATS_PERIOD_LABELS,
  STATS_PERIODS,
  trainingActivitiesFrom,
  WEEK_CHART,
  weekBars,
} from '../functions/training-stats'

/*
 * Training stats, natively. Eleventh screen.
 *
 * There is no endpoint for these numbers — `user_stats` has no weekly or
 * monthly split — so both screens fold them from the athlete's activities with
 * `computeTrainingStats`. The web page does it in the store; this asks the API
 * and does it here.
 *
 * The translation on the way in is the part that matters. `/api/activities`
 * answers in camelCase and `computeTrainingStats` reads snake_case, because
 * those names came from the database rows the store used to hold. Feeding the
 * API's shape in untranslated returns zero for everything — silently, and
 * plausibly, like an athlete who had a quiet week. `trainingActivitiesFrom`
 * is that translation, shared so the web cannot drift from it.
 *
 * Narrower than the web page: no personal-records panel, which the
 * achievements screen already shows, and no activity list, which the feed is.
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft

const PERIOD_OPTIONS = STATS_PERIODS.map(value => ({ value, label: STATS_PERIOD_LABELS[value] }))
const chosenPeriod = state<string>(STATS_PERIODS[0])
const stats = state<any>(null)
const activities = state<any[]>([])
const loading = state(true)
const error = state('')
{{-- Not "signed out": the guard above has already sent anybody without an
     account to Login, so reaching this means the device still holds a bearer
     the server has stopped accepting. Bouncing straight back to Login on a
     401 would loop against a server having a bad minute, so it is said on
     the screen instead — the same thing Settings says. --}}
const sessionExpired = state(false)
const api = createNativeApi(craft)
let active = true

function period(): any {
  return chosenPeriod()
}

function milesText(): string {
  return String(periodStats(stats(), period()).distance)
}

function elevationText(): string {
  return `${periodStats(stats(), period()).elevation.toLocaleString('en-US')} ft`
}

function activitiesText(): string {
  const count = periodStats(stats(), period()).activities
  return count === 1 ? '1 activity' : `${count} activities`
}

function streakText(): string {
  const current = Number(stats()?.currentStreak) || 0
  return current === 1 ? '1 day' : `${current} days`
}

function bestStreakText(): string {
  const best = Number(stats()?.longestStreak) || 0
  return `Best: ${best === 1 ? '1 day' : `${best} days`}`
}

function chartBox(): string {
  return `0 0 ${WEEK_CHART.width} ${WEEK_CHART.height}`
}

function bars(): any[] {
  return weekBars(stats()?.weeklyHistory ?? [])
}

/*
 * Six weeks of zeroes still produce six bars — the server sends a row per week
 * whether it was run or not — each with a height of zero, so the chart drew
 * nothing inside a white card under a heading. A new account saw an empty box
 * and no way to read it as "you have not run yet".
 *
 * A week nobody ran still gets no bar, which is the honest shape of a quiet
 * week beside a busy one. It is only every week being quiet that has nothing
 * to draw, and then the card goes too.
 */
function hasWeekChart(): boolean {
  return bars().some(bar => Number(bar.distance) > 0)
}

function breakdown(): any[] {
  return activityBreakdown(activities()).filter(row => row.count > 0)
}

function breakdownText(row: any): string {
  return `${row.count} · ${row.share}%`
}

let loadVersion = 0
async function load(): Promise<void> {
  const currentLoad = ++loadVersion
  loading.set(true)
  error.set('')
  try {
    if (!await requireNativeAccount(craft, '/stats')) return

    const me = await api.send('/api/me')
    if (!me.ok || !me.body?.user?.id) {
      if (active && currentLoad === loadVersion)
        sessionExpired.set(true)
      return
    }
    const userId = Number(me.body.user.id)

    const result = await api.send(activitiesPath(userId))
    if (!active || currentLoad !== loadVersion)
      return
    if (!result.ok)
      throw new Error('Could not load your training')

    const rows = trainingActivitiesFrom(result.body)
    activities.set(result.body?.activities ?? [])
    stats.set(computeTrainingStats(userId, rows))
  }
  catch (cause) {
    if (active && currentLoad === loadVersion)
      error.set(cause instanceof Error ? cause.message : 'Could not load your training')
  }
  finally {
    if (active && currentLoad === loadVersion)
      loading.set(false)
  }
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Training stats', largeTitle: true })
  void load()
})

onDestroy(() => {
  active = false
})
onMount(() => onNativeAccountChange(craft, () => { stats.set(null); activities.set([]); void load() }))
</script>

<View class="flex-1 bg-page">
  <ScrollView class="p-4" testID="stats-scroll">
    <Text class="mt-1 text-sm text-fg-muted">Your training, folded from everything you record.</Text>

    <ActivityIndicator :show="loading" testID="stats-loading" class="mt-6" />
    <ErrorState :show="error()" testID="stats-error" :title="error()" message="Check your connection, then try again." :busy="loading()" className="mt-4" @retry="load()" />
    <Text :show="sessionExpired" testID="stats-session-expired" class="mt-4 text-warning">Your session has expired. Log in again to see your training stats.</Text>
    <Button :show="sessionExpired" testID="stats-log-in-again" @click="craft.navigation.open('/login?next=/stats')">Log in again</Button>

    <View :show="stats()" testID="stats-body" class="mt-5 gap-4">
      <SegmentedControl testID="stats-period" label="Period" stretch v-model:value="chosenPeriod" :options="PERIOD_OPTIONS" />

      <View class="flex-row gap-2">
        <View class="flex-1 rounded-xl bg-panel p-3">
          <Text class="text-xs uppercase text-fg-soft">Miles</Text>
          <Text testID="stat-miles" class="text-2xl font-bold text-fg" :text="milesText()" />
        </View>
        <View class="flex-1 rounded-xl bg-panel p-3">
          <Text class="text-xs uppercase text-fg-soft">Climbing</Text>
          <Text testID="stat-elevation" class="text-2xl font-bold text-fg" :text="elevationText()" />
        </View>
      </View>

      <View class="flex-row gap-2">
        <View class="flex-1 rounded-xl bg-panel p-3">
          <Text class="text-xs uppercase text-fg-soft">Activities</Text>
          <Text testID="stat-activities" class="text-base font-semibold text-fg" :text="activitiesText()" />
        </View>
        <View class="flex-1 rounded-xl bg-panel p-3">
          <Text class="text-xs uppercase text-fg-soft">Day streak</Text>
          <Text testID="stat-streak" class="text-base font-semibold text-fg" :text="streakText()" />
          <Text testID="stat-best-streak" class="text-xs text-fg-muted" :text="bestStreakText()" />
        </View>
      </View>

      {{-- Six weeks of history. A week that was run always gets a sliver; a
           week nobody ran gets no bar, which is the honest shape of it. --}}
      <View :show="hasWeekChart()" testID="week-chart" class="gap-2">
        <Text class="text-xs font-semibold uppercase text-fg-soft">Last six weeks</Text>
        <View class="h-20 w-full rounded-xl bg-panel p-2">
          <svg :viewBox="chartBox()" class="h-full w-full">
            <rect :for="bar in bars()" :key="bar.week" :x="bar.x" :y="bar.y" :width="bar.width" :height="bar.height" fill="#34d399" />
          </svg>
        </View>
      </View>

      <View :show="breakdown().length > 0" testID="breakdown" class="gap-2">
        <Text class="text-xs font-semibold uppercase text-fg-soft">What you do</Text>
        <View :for="row in breakdown()" :key="row.type" class="flex-row justify-between rounded-xl bg-panel p-3">
          <Text class="text-sm text-fg" :text="row.label" />
          <Text testID="breakdown-count" class="text-sm text-fg-muted" :text="breakdownText(row)" />
        </View>
      </View>
    </View>
  </ScrollView>
</View>
