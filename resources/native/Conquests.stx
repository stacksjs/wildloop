<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import { createNativeApi } from '../functions/native-api'
import { computeConquestRecord } from '../functions/conquest-stats'
import { formatTerritoryArea } from '../functions/territory-style'
import {
  battleRowsFrom,
  battlesPath,
  CONQUEST_FILTER_LABELS,
  CONQUEST_FILTERS,
  conquestEmptyText,
  filterConquests,
  ownBadge,
  ownLine,
  underAttack,
} from '../functions/battles'

/*
 * The athlete's own record in the territory game, natively. Fourteenth screen.
 *
 * `?mine=1` rather than the global feed: the feed is the newest 200 battles in
 * the whole game, which once it is busy holds a few of anyone's. Folding a
 * record out of that counted only the battles still in the window, which is
 * how `/conquests` came to report the same three conquests for everybody.
 *
 * The counters come from `computeConquestRecord`, which the web page already
 * uses, so the numbers here and there cannot disagree. The voice is the second
 * person — `ownBadge`/`ownLine` — and the same battle the feed badges
 * "Conquered" is "Lost" to the athlete who held the ground.
 *
 * Unlike the battles feed, this needs a viewer: `?mine=1` is ignored without
 * one, and the global feed answered in its place would be every battle in the
 * game listed as the athlete's own.
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft

const filterIndex = state(0)
const rows = state<any[]>([])
const viewerId = state(0)
const loading = state(true)
const error = state('')
const signedOut = state(false)
const api = createNativeApi(craft)
let active = true

function filter(): any {
  return CONQUEST_FILTERS[filterIndex()]
}

function filterName(): string {
  return CONQUEST_FILTER_LABELS[filter()]
}

function cycleFilter(): void {
  filterIndex.set((filterIndex() + 1) % CONQUEST_FILTERS.length)
}

function shown(): any[] {
  return filterConquests(rows(), filter(), viewerId())
}

function record(): any {
  return computeConquestRecord(viewerId(), rows())
}

function takenText(): string {
  return String(record().totalConquests)
}

function heldText(): string {
  return String(record().successfulDefenses)
}

function lostText(): string {
  return String(record().territoriesLost)
}

function winRateText(): string {
  return `${record().winRate}%`
}

function powerText(): string {
  return String(record().powerRating)
}

function groundWonText(): string {
  return formatTerritoryArea(record().totalAreaConquered)
}

function threatened(): any[] {
  return underAttack(rows(), viewerId())
}

function threatCount(): string {
  const count = threatened().length
  return count === 1 ? '1 zone under attack' : `${count} zones under attack`
}

function lineText(battle: any): string {
  return ownLine(battle, viewerId())
}

function badgeText(battle: any): string {
  return ownBadge(battle, viewerId())
}

function emptyText(): string {
  return conquestEmptyText(filter())
}

function openTerritory(battle: any): void {
  craft.navigation.open(`/territory/${battle.territory_id}`)
}

async function load(): Promise<void> {
  loading.set(true)
  error.set('')
  try {
    const token = await api.readToken()
    if (!token) {
      if (active)
        signedOut.set(true)
      return
    }

    const me = await api.send('/api/me')
    if (!me.ok || !me.body?.user?.id) {
      if (active)
        signedOut.set(true)
      return
    }
    const userId = Number(me.body.user.id)
    if (active)
      viewerId.set(userId)

    const result = await api.send(battlesPath({ mine: true }))
    if (!active)
      return
    if (!result.ok)
      throw new Error('Could not load your record')

    rows.set(battleRowsFrom(result.body))
  }
  catch (cause) {
    if (active)
      error.set(cause instanceof Error ? cause.message : 'Could not load your record')
  }
  finally {
    if (active)
      loading.set(false)
  }
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Your conquests', largeTitle: true })
  void load()
})

onDestroy(() => {
  active = false
})
</script>

<SafeAreaView class="flex-1 bg-slate-950">
  <ScrollView class="p-4" testID="conquests-scroll">
    <Text class="mt-1 text-sm text-slate-400">Every zone you have taken, held or lost.</Text>

    <ActivityIndicator :show="loading" testID="conquests-loading" class="mt-6" />
    <Text :show="error" testID="conquests-error" class="mt-4 text-rose-300" :text="error" />
    <Text :show="signedOut" testID="conquests-signed-out" class="mt-4 text-amber-300">Sign in on the web to see your record.</Text>

    <View :show="viewerId() > 0 && !error()" testID="conquests-body" class="mt-5 gap-4">
      {{-- Ground of theirs being taken right now, above everything else: it is
           the only thing on this screen they can still do something about. --}}
      <View :show="threatened().length > 0" testID="conquests-threat" class="gap-2 rounded-xl bg-rose-950 p-3">
        <Text testID="threat-count" class="text-sm font-semibold text-rose-200" :text="threatCount()" />
        <Text :for="battle in threatened()" :key="battle.id" testID="threat-row" class="text-xs text-rose-300" :text="lineText(battle)" />
      </View>

      <View class="flex-row gap-2">
        <View class="flex-1 rounded-xl bg-slate-900 p-3">
          <Text class="text-xs uppercase text-slate-500">Taken</Text>
          <Text testID="record-taken" class="text-2xl font-bold text-white" :text="takenText()" />
        </View>
        <View class="flex-1 rounded-xl bg-slate-900 p-3">
          <Text class="text-xs uppercase text-slate-500">Held</Text>
          <Text testID="record-held" class="text-2xl font-bold text-white" :text="heldText()" />
        </View>
        <View class="flex-1 rounded-xl bg-slate-900 p-3">
          <Text class="text-xs uppercase text-slate-500">Lost</Text>
          <Text testID="record-lost" class="text-2xl font-bold text-white" :text="lostText()" />
        </View>
      </View>

      <View class="flex-row gap-2">
        <View class="flex-1 rounded-xl bg-slate-900 p-3">
          <Text class="text-xs uppercase text-slate-500">Win rate</Text>
          <Text testID="record-winrate" class="text-base font-semibold text-white" :text="winRateText()" />
        </View>
        <View class="flex-1 rounded-xl bg-slate-900 p-3">
          <Text class="text-xs uppercase text-slate-500">Power</Text>
          <Text testID="record-power" class="text-base font-semibold text-white" :text="powerText()" />
        </View>
        <View class="flex-1 rounded-xl bg-slate-900 p-3">
          <Text class="text-xs uppercase text-slate-500">Ground won</Text>
          <Text testID="record-ground" class="text-base font-semibold text-white" :text="groundWonText()" />
        </View>
      </View>

      <View class="gap-2">
        <Text testID="conquests-filter" class="text-xs font-semibold uppercase text-slate-500" :text="filterName()" />
        <Button testID="cycle-filter" @click="cycleFilter()">Change the filter</Button>
      </View>

      <Text :show="shown().length === 0" testID="conquests-empty" class="mt-2 text-sm text-slate-400" :text="emptyText()" />

      <View :show="shown().length > 0" class="gap-2">
        <Text class="text-xs font-semibold uppercase text-slate-500">Your battles</Text>
        <Pressable :for="battle in shown()" :key="battle.id" testID="conquest-row" @click="openTerritory(battle)" class="flex-row justify-between rounded-xl bg-slate-900 p-3">
          <Text class="flex-1 text-sm text-white" :text="lineText(battle)" />
          <Text testID="conquest-badge" class="text-xs text-slate-400" :text="badgeText(battle)" />
        </Pressable>
      </View>
    </View>
  </ScrollView>
</SafeAreaView>
