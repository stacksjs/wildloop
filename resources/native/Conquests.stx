<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import { onNativeAccountChange, createNativeApi } from '../functions/native-api'
import { requireNativeAccount } from '../functions/native-session'
import { computeConquestRecord } from '../functions/conquest-stats'
import { formatTerritoryArea } from '../functions/territory-style'
import {
  battleRowsFrom,
  battlesPath,
  CONQUEST_FILTER_LABELS,
  CONQUEST_FILTERS,
  conquestEmptyText,
  filterConquests,
  ownBadge,
  ownLine,
  underAttack,
} from '../functions/battles'

/*
 * The athlete's own record in the territory game, natively. Fourteenth screen.
 *
 * `?mine=1` rather than the global feed: the feed is the newest 200 battles in
 * the whole game, which once it is busy holds a few of anyone's. Folding a
 * record out of that counted only the battles still in the window, which is
 * how `/conquests` came to report the same three conquests for everybody.
 *
 * The counters come from `computeConquestRecord`, which the web page already
 * uses, so the numbers here and there cannot disagree. The voice is the second
 * person — `ownBadge`/`ownLine` — and the same battle the feed badges
 * "Conquered" is "Lost" to the athlete who held the ground.
 *
 * Unlike the battles feed, this needs a viewer: `?mine=1` is ignored without
 * one, and the global feed answered in its place would be every battle in the
 * game listed as the athlete's own.
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft

const FILTER_OPTIONS = CONQUEST_FILTERS.map(value => ({ value, label: CONQUEST_FILTER_LABELS[value] }))
const chosenFilter = state<string>(CONQUEST_FILTERS[0])
const rows = state<any[]>([])
const viewerId = state(0)
const loading = state(true)
const error = state('')
{{-- Not "signed out": the guard above has already sent anybody without an
     account to Login, so reaching this means the device still holds a bearer
     the server has stopped accepting. Bouncing straight back to Login on a
     401 would loop against a server having a bad minute, so it is said on
     the screen instead — the same thing Settings says. --}}
const sessionExpired = state(false)
const api = createNativeApi(craft)
let active = true

function filter(): any {
  return chosenFilter()
}

function shown(): any[] {
  return filterConquests(rows(), filter(), viewerId())
}

function record(): any {
  return computeConquestRecord(viewerId(), rows())
}

function takenText(): string {
  return String(record().totalConquests)
}

function heldText(): string {
  return String(record().successfulDefenses)
}

function lostText(): string {
  return String(record().territoriesLost)
}

function winRateText(): string {
  return `${record().winRate}%`
}

function powerText(): string {
  return String(record().powerRating)
}

function groundWonText(): string {
  return formatTerritoryArea(record().totalAreaConquered)
}

function threatened(): any[] {
  return underAttack(rows(), viewerId())
}

function threatCount(): string {
  const count = threatened().length
  return count === 1 ? '1 zone under attack' : `${count} zones under attack`
}

function lineText(battle: any): string {
  return ownLine(battle, viewerId())
}

function badgeText(battle: any): string {
  return ownBadge(battle, viewerId())
}

function emptyText(): string {
  return conquestEmptyText(filter())
}

function openTerritory(battle: any): void {
  craft.navigation.open(`/territory/${battle.territory_id}`)
}

let loadVersion = 0
async function load(): Promise<void> {
  const currentLoad = ++loadVersion
  loading.set(true)
  error.set('')
  try {
    if (!await requireNativeAccount(craft, '/conquests')) return

    const me = await api.send('/api/me')
    if (!me.ok || !me.body?.user?.id) {
      if (active && currentLoad === loadVersion)
        sessionExpired.set(true)
      return
    }
    const userId = Number(me.body.user.id)
    if (active && currentLoad === loadVersion)
      viewerId.set(userId)

    const result = await api.send(battlesPath({ mine: true }))
    if (!active || currentLoad !== loadVersion)
      return
    if (!result.ok)
      throw new Error('Could not load your record')

    rows.set(battleRowsFrom(result.body))
  }
  catch (cause) {
    if (active && currentLoad === loadVersion)
      error.set(cause instanceof Error ? cause.message : 'Could not load your record')
  }
  finally {
    if (active && currentLoad === loadVersion)
      loading.set(false)
  }
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Your conquests', largeTitle: true })
  void load()
})

onDestroy(() => {
  active = false
})
onMount(() => onNativeAccountChange(craft, () => { rows.set([]); viewerId.set(0); void load() }))
</script>

<View class="flex-1 bg-page">
  <ScrollView class="p-4" testID="conquests-scroll">
    <Text class="mt-1 text-sm text-fg-muted">Every zone you have taken, held or lost.</Text>

    <ActivityIndicator :show="loading" testID="conquests-loading" class="mt-6" />
    <ErrorState :show="error()" testID="conquests-error" :title="error()" message="Check your connection, then try again." :busy="loading()" className="mt-4" @retry="load()" />
    <Text :show="sessionExpired" testID="conquests-session-expired" class="mt-4 text-warning">Your session has expired. Log in again to see your record.</Text>
    <Button :show="sessionExpired" testID="conquests-log-in-again" @click="craft.navigation.open('/login?next=/conquests')">Log in again</Button>

    <View :show="viewerId() > 0 && !error()" testID="conquests-body" class="mt-5 gap-4">
      {{-- Ground of theirs being taken right now, above everything else: it is
           the only thing on this screen they can still do something about. --}}
      <View :show="threatened().length > 0" testID="conquests-threat" class="gap-2 rounded-xl bg-danger-soft p-3">
        <Text testID="threat-count" class="text-sm font-semibold text-danger-soft-ink" :text="threatCount()" />
        <Text :for="battle in threatened()" :key="battle.id" testID="threat-row" class="text-xs text-danger" :text="lineText(battle)" />
      </View>

      <View class="flex-row gap-2">
        <View class="flex-1 rounded-xl bg-panel p-3">
          <Text class="text-xs uppercase text-fg-soft">Taken</Text>
          <Text testID="record-taken" class="text-2xl font-bold text-fg" :text="takenText()" />
        </View>
        <View class="flex-1 rounded-xl bg-panel p-3">
          <Text class="text-xs uppercase text-fg-soft">Held</Text>
          <Text testID="record-held" class="text-2xl font-bold text-fg" :text="heldText()" />
        </View>
        <View class="flex-1 rounded-xl bg-panel p-3">
          <Text class="text-xs uppercase text-fg-soft">Lost</Text>
          <Text testID="record-lost" class="text-2xl font-bold text-fg" :text="lostText()" />
        </View>
      </View>

      <View class="flex-row gap-2">
        <View class="flex-1 rounded-xl bg-panel p-3">
          <Text class="text-xs uppercase text-fg-soft">Win rate</Text>
          <Text testID="record-winrate" class="text-base font-semibold text-fg" :text="winRateText()" />
        </View>
        <View class="flex-1 rounded-xl bg-panel p-3">
          <Text class="text-xs uppercase text-fg-soft">Power</Text>
          <Text testID="record-power" class="text-base font-semibold text-fg" :text="powerText()" />
        </View>
        <View class="flex-1 rounded-xl bg-panel p-3">
          <Text class="text-xs uppercase text-fg-soft">Ground won</Text>
          <Text testID="record-ground" class="text-base font-semibold text-fg" :text="groundWonText()" />
        </View>
      </View>

      <SegmentedControl testID="conquests-filter" label="Show" stretch v-model:value="chosenFilter" :options="FILTER_OPTIONS" />

      <EmptyState :show="shown().length === 0" testID="conquests-empty" variant="bare" className="mt-6" :title="emptyText()" />

      <View :show="shown().length > 0" class="gap-2">
        <Text class="text-xs font-semibold uppercase text-fg-soft">Your battles</Text>
        <Pressable :for="battle in shown()" :key="battle.id" testID="conquest-row" @click="openTerritory(battle)" class="flex-row justify-between rounded-xl bg-panel p-3">
          <Text class="flex-1 text-sm text-fg" :text="lineText(battle)" />
          <Text testID="conquest-badge" class="text-xs text-fg-muted" :text="badgeText(battle)" />
        </Pressable>
      </View>
    </View>
  </ScrollView>
</View>
