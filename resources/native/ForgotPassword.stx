<script client lang="ts">
import type { NativeCraft } from '@stacksjs/stx/native'
import { createNativeApi } from '../functions/native-api'
import { nativeUi as ui } from '../functions/native-ui'
const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft
const email = state('')
const busy = state(false)
const error = state('')
const notice = state('')
async function send() {
  if (busy() || !email().trim()) return
  busy.set(true);error.set('');notice.set('')
  try {
    const response = await createNativeApi(craft).send('/api/password/forgot','POST',{email:email().trim()})
    if (!response.ok) throw new Error(response.body?.message || 'The reset link could not be requested. Try again later.')
    notice.set('If an account exists for that email address, a password reset link has been sent.')
  }
  catch (cause) { error.set(cause instanceof Error ? cause.message : 'The reset link could not be requested.') }
  finally { busy.set(false) }
}
onMount(() => { craft.navigation.setOptions({title:'Reset password',largeTitle:false,tabBarHidden:true,hidden:true,swipeBack:false}) })
</script>
<KeyboardAvoidingView :class="ui.screen">
  <ScrollView class="flex-1 p-6" keyboardDismissMode="on-drag">
    <Text :class="ui.title">Forgot your password?</Text>
    <Text :class="ui.body" class="my-4">Enter your account email and we’ll send you a reset link.</Text>
    <TextInput testID="forgot-email" accessibilityLabel="Email" :class="ui.input" :value="email" keyboardType="email-address" autoCapitalize="none" textContentType="emailAddress" @input="email.set($event.text || '')" />
    <Text :show="error" :text="error" :class="ui.danger" class="my-4" testID="forgot-error" />
    <Text :show="notice" :text="notice" :class="ui.body" class="my-4" testID="forgot-notice" />
    <Button testID="forgot-submit" :class="ui.action" :disabled="busy || !email().trim()" @click="send()" :title="busy() ? 'Sending…' : 'Send reset link'" />
  </ScrollView>
</KeyboardAvoidingView>
