<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import { onNativeAccountChange, createNativeApi, loadOutcome } from '../functions/native-api'
import { requireNativeAccount } from '../functions/native-session'
import {
  battleRowsFrom,
  battlesPath,
  feedBadge,
  hereLine,
  territoryHistory,
} from '../functions/battles'
import { formatTerritoryArea, territoryColor } from '../functions/territory-style'
import {
  isOwnTerritory,
  territoryActionLabel,
  territoryFrom,
  territoryGeometry,
  territoryHolderLine,
  territoryIdFrom,
  territoryPath,
  territoryStandingText,
} from '../functions/territories'

/*
 * One territory, natively. Fifteenth screen, and the first that takes a route
 * parameter.
 *
 * `'/territory/:id'` in `ios.nativeScreens`: the shell matches the pattern
 * (`CraftHybridRoutes` in craft-native, with the same rules as the TypeScript
 * `matchNativePath`) and binds `id` into `craft.route.params`. Static segments
 * beat parameters there, so `/territories` keeps going to the list screen and
 * only `/territory/<something>` reaches this one — asserted in
 * tests/unit/native-route-table.test.ts against craft's own matcher rather
 * than against my reading of it.
 *
 * An id that is not a number is treated as no territory rather than as zero.
 * The web page uses -1 as its sentinel for the same reason: territory 1 is a
 * real zone, and loading it because a param failed to parse is worse than
 * saying nothing was found.
 *
 * The history is filtered out of the battle feed, as the web page does from
 * its store — there is no per-territory battles endpoint. And it is told in a
 * third voice: the feed names the territory, and here the reader is already
 * looking at it, so `hereLine` says "is attacking it".
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft
const params = craft.route.params

/*
 * Digits only. `Number.parseInt` would read `/territory/7.5.1` as 7 and load
 * a zone the path does not name — see `territoryIdFrom`.
 */
const wanted = territoryIdFrom(params.id)

const territory = state<any>(null)
const battles = state<any[]>([])
const viewerId = state(0)
const loading = state(true)
const error = state('')
const missing = state(false)
const api = createNativeApi(craft)
let active = true


function name(): string {
  return String(territory()?.name ?? '')
}

function holderText(): string {
  return territoryHolderLine(territory(), viewerId())
}

function standingText(): string {
  return territoryStandingText(territory())
}

function actionText(): string {
  return territoryActionLabel(territory(), viewerId())
}

function areaText(): string {
  return formatTerritoryArea(Number(territory()?.areaSize) || 0)
}

function conquestsText(): string {
  return String(territory()?.conquestCount ?? 0)
}

function defencesText(): string {
  return String(territory()?.defendCount ?? 0)
}

function mineText(): string {
  return isOwnTerritory(territory(), viewerId()) ? 'Your territory' : 'Enemy territory'
}

/** The boundary, as the one closed polyline a MapPolyline takes. */
function shape(): number[] {
  return territoryGeometry(territory()?.ring)
}

function shapeColor(): string {
  return territoryColor(Number(territory()?.userId) || 0, viewerId())
}

function history(): any[] {
  return territoryHistory(battles(), wanted)
}

function eventText(battle: any): string {
  return hereLine(battle)
}

function eventBadge(battle: any): string {
  return feedBadge(battle)
}

function openRecord(): void {
  craft.navigation.open('/record')
}

function openOwner(): void {
  const ownerId = Number(territory()?.userId) || 0
  if (ownerId > 0)
    craft.navigation.push('AthleteDetail', { id: String(ownerId) })
}

function backToList(): void {
  craft.navigation.push('Territories', {})
}

let loadVersion = 0
async function load(): Promise<void> {
  const currentLoad = ++loadVersion
  loading.set(true)
  error.set('')
  try {
    if (wanted === null) {
      if (active && currentLoad === loadVersion)
        missing.set(true)
      return
    }

    if (!await requireNativeAccount(craft, `/territory/${wanted}`)) return

    const me = await api.send('/api/me')
    if (active && me.ok && me.body?.user?.id)
      viewerId.set(Number(me.body.user.id))

    const result = await api.send(territoryPath(wanted))
    if (!active || currentLoad !== loadVersion)
      return
    // A record that does not exist is an answer, not a failure to load.
    const outcome = loadOutcome(result)
    if (outcome === 'missing') {
      missing.set(true)
      return
    }
    if (outcome === 'error')
      throw new Error('Could not load this territory')

    const row = territoryFrom(result.body)
    if (!row) {
      missing.set(true)
      return
    }
    territory.set(row)

    // Its history, filtered out of the feed. A failure here costs the history
    // and not the territory, so it is not allowed to throw.
    const feed = await api.send(battlesPath())
    if (active && feed.ok)
      battles.set(battleRowsFrom(feed.body))
  }
  catch (cause) {
    if (active && currentLoad === loadVersion)
      error.set(cause instanceof Error ? cause.message : 'Could not load this territory')
  }
  finally {
    if (active && currentLoad === loadVersion)
      loading.set(false)
  }
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Territory', largeTitle: false })
  void load()
})

onDestroy(() => {
  active = false
})
onMount(() => onNativeAccountChange(craft, () => { territory.set(null); battles.set([]); void load() }))
</script>

<View class="flex-1 bg-page">
  <ScrollView class="p-4" testID="territory-detail-scroll">
    <ActivityIndicator :show="loading" testID="detail-loading" class="mt-6" />
    <ErrorState :show="error()" testID="detail-error" :title="error()" message="Check your connection, then try again." :busy="loading()" className="mt-4" @retry="load()" />

    <View :show="missing" testID="detail-missing" class="mt-6 gap-3">
      <Text class="text-lg font-semibold text-fg">No such territory</Text>
      <Text class="text-sm text-fg-muted">It may have been decayed or never claimed.</Text>
      <Button testID="back-to-territories" @click="backToList()">See the territory map</Button>
    </View>

    <View :show="territory()" testID="detail-body" class="gap-4">
      <View class="gap-1">
        <Text testID="detail-name" class="text-2xl font-bold text-fg" :text="name()" />
        <Text testID="detail-holder" class="text-sm text-fg-muted" :text="holderText()" />
        <View class="mt-1 flex-row gap-2">
          <Text testID="detail-mine" class="text-xs font-semibold uppercase text-accent" :text="mineText()" />
          <Text testID="detail-standing" class="text-xs font-semibold uppercase text-warning" :text="standingText()" />
        </View>
      </View>

      {{-- The zone itself. `fitToBounds` frames the boundary, which is the only
           thing drawn, so the map opens on the ground rather than the ocean. --}}
      <View :show="shape().length > 0" testID="detail-map-frame" class="h-56 overflow-hidden rounded-2xl bg-panel">
        <Map testID="detail-map" class="flex-1" :fitToBounds="true" basemap="standard">
          <MapPolyline :geometry="shape()" :strokeColor="shapeColor()" :strokeWidth="3" />
        </Map>
      </View>

      <View class="flex-row gap-2">
        <View class="flex-1 rounded-xl bg-panel p-3">
          <Text class="text-xs uppercase text-fg-soft">Ground</Text>
          <Text testID="detail-area" class="text-xl font-bold text-accent" :text="areaText()" />
        </View>
        <View class="flex-1 rounded-xl bg-panel p-3">
          <Text class="text-xs uppercase text-fg-soft">Conquests</Text>
          <Text testID="detail-conquests" class="text-xl font-bold text-fg" :text="conquestsText()" />
        </View>
        <View class="flex-1 rounded-xl bg-panel p-3">
          <Text class="text-xs uppercase text-fg-soft">Defenses</Text>
          <Text testID="detail-defences" class="text-xl font-bold text-fg" :text="defencesText()" />
        </View>
      </View>

      <Button testID="territory-action" @click="openRecord()" :text="actionText()" />

      <Pressable :show="territory()?.userId > 0" testID="detail-owner" @click="openOwner()" class="rounded-xl bg-panel p-3">
        <Text class="text-xs uppercase text-fg-soft">Holder</Text>
        <Text testID="detail-owner-name" class="text-sm font-semibold text-fg" :text="territory()?.ownerName" />
      </Pressable>

      <View :show="history().length > 0" testID="detail-history" class="gap-2">
        <Text class="text-xs font-semibold uppercase text-fg-soft">How it changed hands</Text>
        <View :for="battle in history()" :key="battle.id" class="flex-row justify-between rounded-xl bg-panel p-3">
          <Text testID="history-line" class="flex-1 text-sm text-fg" :text="eventText(battle)" />
          <Text testID="history-badge" class="text-xs text-fg-muted" :text="eventBadge(battle)" />
        </View>
      </View>

      <Text :show="history().length === 0" testID="detail-no-history" class="text-sm text-fg-soft">Nobody has fought over this ground yet.</Text>
    </View>
  </ScrollView>
</View>
