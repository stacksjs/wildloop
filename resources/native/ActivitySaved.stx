<script client lang="ts">
import type { NativeCraft } from '@stacksjs/stx/native'

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft
const params = craft.route.params
const id = state(String(params.id ?? ''))
const userId = Number(params.userId ?? 0)
const activityType = state(String(params.activityType ?? 'Activity'))
const distance = state(Number(params.distance ?? 0))
const duration = state(String(params.duration ?? '--'))
const pace = state(String(params.pace ?? '--'))
const elevation = state(Number(params.elevation ?? 0))

function goBack() {
  craft.navigation.back()
}

function logAnother() {
  craft.navigation.replace('ManualActivity', { userId })
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Activity saved', largeTitle: false })
})
</script>

<SafeAreaView class="flex-1 bg-[#f2f4ef] dark:bg-[#101c16] p-4">
  <Text testID="saved-title" class="text-3xl font-bold text-[#192414] dark:text-[#f0f5ec]" :text="activityType() + ' saved'" />
  <Text testID="saved-id" class="mt-1 text-sm text-[#51604e] dark:text-[#b0bfac]" :text="'Wildloop activity #' + id()" />
  <View class="mt-5 gap-2">
    <NativeRunMetric label="Distance" testID="saved-distance">
      <Text class="text-xl font-bold text-[#192414] dark:text-[#f0f5ec]" :text="distance() + ' mi'" />
    </NativeRunMetric>
    <NativeRunMetric label="Duration" testID="saved-duration">
      <Text class="text-xl font-bold text-[#192414] dark:text-[#f0f5ec]" :text="duration" />
    </NativeRunMetric>
    <NativeRunMetric label="Pace" testID="saved-pace">
      <Text class="text-xl font-bold text-[#192414] dark:text-[#f0f5ec]" :text="pace" />
    </NativeRunMetric>
    <NativeRunMetric label="Elevation" testID="saved-elevation">
      <Text class="text-xl font-bold text-[#192414] dark:text-[#f0f5ec]" :text="elevation() + ' ft'" />
    </NativeRunMetric>
  </View>
  <Button testID="activity-back" class="mt-5" @click="goBack()">Back to feed</Button>
  <Button testID="log-another" class="mt-2" @click="logAnother()">Log another</Button>
</SafeAreaView>
