<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import { onNativeAccountChange, createNativeApi, nativeApiOrigin, nativeImageUrl } from '../functions/native-api'
import { requireNativeAccount } from '../functions/native-session'
import { avatarInitial, avatarUrl } from '../functions/avatars'
import {
  LEADERBOARD_METRICS,
  LEADERBOARD_PERIODS,
  leaderboardQuery,
  leaderMetricText,
  leaderRowsFrom,
  leaderSecondaryText,
  metricPhrase,
  periodPhrase,
} from '../functions/leaderboard'

/*
 * The leaderboard, natively.
 *
 * Third list screen, and the first with a remote image on every row, so this
 * is where `Image` earns its place. The period, the measure, the query they
 * build and the way a row's figures are put into words all come from
 * `resources/functions/leaderboard.ts` — the module the web page reads. The two
 * screens choose differently between a row of pills and a cycling button, and
 * must not choose differently about what "this week" covers.
 *
 * Two of the web page's three scopes are here. `following` needs the token, so
 * it asks for one and says what signing in would get. `local` needs a
 * coordinate, and geolocation is not in the native capability set
 * (fetch, secureStorage, haptics, lifecycle), so it stays on the web side.
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft

const SCOPES = ['global', 'following'] as const

/* What each control offers, in the web board's words. */
const SCOPE_OPTIONS = [{ value: 'global', label: 'Global' }, { value: 'following', label: 'Following' }]
const PERIOD_OPTIONS = [{ value: 'weekly', label: 'This week' }, { value: 'monthly', label: 'This month' }, { value: 'alltime', label: 'All time' }]
const METRIC_OPTIONS = [{ value: 'distance', label: 'Distance' }, { value: 'elevation', label: 'Elevation' }, { value: 'activities', label: 'Activities' }]

const chosenPeriod = state<string>(LEADERBOARD_PERIODS[0])
const chosenMetric = state<string>(LEADERBOARD_METRICS[0])
const chosenScope = state<string>(SCOPES[0])
const rows = state<any[]>([])
const loading = state(true)
const error = state('')
const needsSignIn = state(false)
const api = createNativeApi(craft)
let active = true

function period(): any {
  return chosenPeriod()
}

function metric(): any {
  return chosenMetric()
}

function scope(): any {
  return chosenScope()
}

/** "Who covered the most ground this week." */
function headline(): string {
  return `Who ${metricPhrase(metric())} ${periodPhrase(period())}.`
}

function figure(row: any): string {
  return leaderMetricText(row, metric())
}

function secondary(row: any): string {
  return leaderSecondaryText(row, metric())
}

/*
 * The thumbnail, not the full photo: `avatarUrl` answers the `-thumb` variant
 * by default, which is the whole point of asking for it on a list row over
 * mobile data. An account with no photo answers '' and gets its initial.
 */
function photo(row: any): string {
  return nativeImageUrl(craft, avatarUrl(row?.userAvatar ?? null))
}

function initial(row: any): string {
  return avatarInitial(row?.userName ?? '')
}

let loadVersion = 0
async function load(): Promise<void> {
  if (!await requireNativeAccount(craft, '/leaderboard')) return
  const currentLoad = ++loadVersion
  loading.set(true)
  error.set('')
  needsSignIn.set(false)
  try {
    const headers: Record<string, string> = { Accept: 'application/json' }
    if (scope() === 'following') {
      const token = await api.readToken()
      if (!token) {
        if (active && currentLoad === loadVersion) {
          needsSignIn.set(true)
          rows.set([])
          loading.set(false)
        }
        return
      }
      headers.Authorization = `Bearer ${token}`
    }

    const query = leaderboardQuery({ period: period(), metric: metric(), scope: scope() })
    const response = await fetch(`${nativeApiOrigin(craft)}/api/activities/leaderboard?${query}`, { headers })
    const body = await response.json().catch(() => null)
    if (!active || currentLoad !== loadVersion)
      return
    if (!response.ok)
      throw new Error('Could not load the leaderboard')
    rows.set(leaderRowsFrom(body))
  }
  catch (cause) {
    if (active && currentLoad === loadVersion)
      error.set(cause instanceof Error ? cause.message : 'Could not load the leaderboard')
  }
  finally {
    if (active && currentLoad === loadVersion)
      loading.set(false)
  }
}

/* Each choice is its own board on the server, so a change reloads it. */
function chooseScope(value: string): void {
  chosenScope.set(value)
  void load()
}

function choosePeriod(value: string): void {
  chosenPeriod.set(value)
  void load()
}

function chooseMetric(value: string): void {
  chosenMetric.set(value)
  void load()
}

/*
 * A row with no athlete behind it goes nowhere. The board aggregates anonymous
 * activity under one "Athlete", and that row has no profile to open.
 */
function openAthlete(row: any): void {
  if (!row?.userId)
    return
  craft.navigation.push('AthleteDetail', { id: String(row.userId) })
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Leaderboard', largeTitle: true })
  void load()
})

onDestroy(() => {
  active = false
})
onMount(() => onNativeAccountChange(craft, () => { rows.set([]); void load() }))
</script>

<View class="flex-1 bg-page">
  <ScrollView class="p-4" testID="leaderboard-scroll">
    <Text testID="headline" class="mt-1 text-sm text-fg-muted" :text="headline()" />

    <View class="mt-4 gap-2">
      <SegmentedControl testID="scope" label="Who is ranked" stretch :value="chosenScope()" :options="SCOPE_OPTIONS" @change="chooseScope($event)" />
      <SegmentedControl testID="period" label="Period" stretch :value="chosenPeriod()" :options="PERIOD_OPTIONS" @change="choosePeriod($event)" />
      <SegmentedControl testID="metric" label="Measure" stretch :value="chosenMetric()" :options="METRIC_OPTIONS" @change="chooseMetric($event)" />
    </View>

    <ActivityIndicator :show="loading" testID="leaderboard-loading" class="mt-6" />
    <ErrorState :show="error()" testID="leaderboard-error" :title="error()" message="Check your connection, then try again." :busy="loading()" className="mt-4" @retry="load()" />
    <Text :show="needsSignIn" testID="leaderboard-signed-out" class="mt-4 text-sm text-fg-muted">
      Sign in to see how you rank against the people you follow.
    </Text>

    {{-- Keyed `:for` on the element: the portable list boundary (093ef1ac). --}}
    <View testID="leaderboard-list" class="mt-5 gap-3">
      <Pressable :for="row in rows()" :key="row.rank" testID="leader-row" class="flex-row items-center gap-3 rounded-xl bg-panel p-3" @click="openAthlete(row)">
        <Text testID="leader-rank" class="w-7 text-center text-base font-bold text-fg-muted" :text="row.rank" />
        <Image :show="photo(row)" testID="leader-avatar" class="h-10 w-10 rounded-full" :source="photo(row)" />
        <Text :show="!photo(row)" testID="leader-initial" class="h-10 w-10 rounded-full bg-surface-sunken text-center text-base font-bold text-fg-strong" :text="initial(row)" />
        <View class="flex-1">
          <Text class="text-base font-semibold text-fg" :text="row.userName" />
          <Text class="text-xs text-fg-muted" :text="secondary(row)" />
        </View>
        <Text class="text-lg font-bold text-accent" :text="figure(row)" />
      </Pressable>
    </View>

    <EmptyState :show="!loading && !error && !needsSignIn && rows().length === 0" testID="leaderboard-empty" variant="bare" className="mt-6" title="Nobody has logged anything in this period yet." />
  </ScrollView>
</View>
