<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import { onNativeAccountChange, createNativeApi, nativeApiOrigin } from '../functions/native-api'
import { avatarInitial, avatarUrl } from '../functions/avatars'
import {
  LEADERBOARD_METRICS,
  LEADERBOARD_PERIODS,
  leaderboardQuery,
  leaderMetricText,
  leaderRowsFrom,
  leaderSecondaryText,
  metricPhrase,
  periodPhrase,
} from '../functions/leaderboard'

/*
 * The leaderboard, natively.
 *
 * Third list screen, and the first with a remote image on every row, so this
 * is where `Image` earns its place. The period, the measure, the query they
 * build and the way a row's figures are put into words all come from
 * `resources/functions/leaderboard.ts` — the module the web page reads. The two
 * screens choose differently between a row of pills and a cycling button, and
 * must not choose differently about what "this week" covers.
 *
 * Two of the web page's three scopes are here. `following` needs the token, so
 * it asks for one and says what signing in would get. `local` needs a
 * coordinate, and geolocation is not in the native capability set
 * (fetch, secureStorage, haptics, lifecycle), so it stays on the web side.
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft

const SCOPES = ['global', 'following'] as const

const periodIndex = state(0)
const metricIndex = state(0)
const scopeIndex = state(0)
const rows = state<any[]>([])
const loading = state(true)
const error = state('')
const needsSignIn = state(false)
const api = createNativeApi(craft)
let active = true

function period(): any {
  return LEADERBOARD_PERIODS[periodIndex()]
}

function metric(): any {
  return LEADERBOARD_METRICS[metricIndex()]
}

function scope(): any {
  return SCOPES[scopeIndex()]
}

/** "Who covered the most ground this week." */
function headline(): string {
  return `Who ${metricPhrase(metric())} ${periodPhrase(period())}.`
}

function periodName(): string {
  return periodPhrase(period())
}

function metricName(): string {
  return metricPhrase(metric())
}

function scopeName(): string {
  return scope() === 'following' ? 'People you follow' : 'Everyone'
}

function figure(row: any): string {
  return leaderMetricText(row, metric())
}

function secondary(row: any): string {
  return leaderSecondaryText(row, metric())
}

/*
 * The thumbnail, not the full photo: `avatarUrl` answers the `-thumb` variant
 * by default, which is the whole point of asking for it on a list row over
 * mobile data. An account with no photo answers '' and gets its initial.
 */
function photo(row: any): string {
  return avatarUrl(row?.userAvatar ?? null)
}

function initial(row: any): string {
  return avatarInitial(row?.userName ?? '')
}

let loadVersion = 0
async function load(): Promise<void> {
  const currentLoad = ++loadVersion
  loading.set(true)
  error.set('')
  needsSignIn.set(false)
  try {
    const headers: Record<string, string> = { Accept: 'application/json' }
    if (scope() === 'following') {
      const token = await api.readToken()
      if (!token) {
        if (active && currentLoad === loadVersion) {
          needsSignIn.set(true)
          rows.set([])
          loading.set(false)
        }
        return
      }
      headers.Authorization = `Bearer ${token}`
    }

    const query = leaderboardQuery({ period: period(), metric: metric(), scope: scope() })
    const response = await fetch(`${nativeApiOrigin(craft)}/api/activities/leaderboard?${query}`, { headers })
    const body = await response.json().catch(() => null)
    if (!active || currentLoad !== loadVersion)
      return
    if (!response.ok)
      throw new Error('Could not load the leaderboard')
    rows.set(leaderRowsFrom(body))
  }
  catch (cause) {
    if (active && currentLoad === loadVersion)
      error.set(cause instanceof Error ? cause.message : 'Could not load the leaderboard')
  }
  finally {
    if (active && currentLoad === loadVersion)
      loading.set(false)
  }
}

function cyclePeriod(): void {
  periodIndex.set((periodIndex() + 1) % LEADERBOARD_PERIODS.length)
  void load()
}

function cycleMetric(): void {
  metricIndex.set((metricIndex() + 1) % LEADERBOARD_METRICS.length)
  void load()
}

function cycleScope(): void {
  scopeIndex.set((scopeIndex() + 1) % SCOPES.length)
  void load()
}

/*
 * A row with no athlete behind it goes nowhere. The board aggregates anonymous
 * activity under one "Athlete", and that row has no profile to open.
 */
function openAthlete(row: any): void {
  if (!row?.userId)
    return
  craft.navigation.push('AthleteDetail', { id: String(row.userId) })
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Leaderboard', largeTitle: true })
  void load()
})

onDestroy(() => {
  active = false
})
onMount(() => onNativeAccountChange(craft, () => { rows.set([]); void load() }))
</script>

<SafeAreaView class="flex-1 bg-[#f2f4ef] dark:bg-[#101c16]">
  <ScrollView class="p-4" testID="leaderboard-scroll">
    <Text testID="headline" class="mt-1 text-sm text-[#51604e] dark:text-[#b0bfac]" :text="headline()" />

    <View class="mt-4 gap-2">
      <Text testID="scope-label" class="text-sm text-[#253321] dark:text-[#e3ecdf]" :text="scopeName()" />
      <Button testID="cycle-scope" @click="cycleScope()">Change who is ranked</Button>
      <Text testID="period-label" class="text-sm text-[#253321] dark:text-[#e3ecdf]" :text="periodName()" />
      <Button testID="cycle-period" @click="cyclePeriod()">Change the period</Button>
      <Text testID="metric-label" class="text-sm text-[#253321] dark:text-[#e3ecdf]" :text="metricName()" />
      <Button testID="cycle-metric" @click="cycleMetric()">Change the measure</Button>
    </View>

    <ActivityIndicator :show="loading" testID="leaderboard-loading" class="mt-6" />
    <Text :show="error" testID="leaderboard-error" class="mt-4 text-[#b4232a] dark:text-[#ff8487]" :text="error" />
    <Text :show="needsSignIn" testID="leaderboard-signed-out" class="mt-4 text-sm text-[#51604e] dark:text-[#b0bfac]">
      Sign in to see how you rank against the people you follow.
    </Text>

    {{-- Keyed `:for` on the element: the portable list boundary (093ef1ac). --}}
    <View testID="leaderboard-list" class="mt-5 gap-3">
      <Pressable :for="row in rows()" :key="row.rank" testID="leader-row" class="flex-row items-center gap-3 rounded-xl bg-white dark:bg-[#1b2c22] p-3" @click="openAthlete(row)">
        <Text testID="leader-rank" class="w-7 text-center text-base font-bold text-[#51604e] dark:text-[#b0bfac]" :text="row.rank" />
        <Image :show="photo(row)" testID="leader-avatar" class="h-10 w-10 rounded-full" :source="photo(row)" />
        <Text :show="!photo(row)" testID="leader-initial" class="h-10 w-10 rounded-full bg-[#e7edde] dark:bg-[#314536] text-center text-base font-bold text-[#253321] dark:text-[#e3ecdf]" :text="initial(row)" />
        <View class="flex-1">
          <Text class="text-base font-semibold text-[#192414] dark:text-[#f0f5ec]" :text="row.userName" />
          <Text class="text-xs text-[#51604e] dark:text-[#b0bfac]" :text="secondary(row)" />
        </View>
        <Text class="text-lg font-bold text-[#24724b] dark:text-[#9be579]" :text="figure(row)" />
      </Pressable>
    </View>

    <Text :show="!loading && !error && !needsSignIn && rows().length === 0" testID="leaderboard-empty" class="mt-6 text-sm text-[#51604e] dark:text-[#b0bfac]">
      Nobody has logged anything in this period yet.
    </Text>
  </ScrollView>
</SafeAreaView>
