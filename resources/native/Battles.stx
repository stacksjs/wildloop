<script client>
import type { NativeCraft } from '@stacksjs/stx/native'
import { onNativeAccountChange, createNativeApi } from '../functions/native-api'
import { formatTerritoryArea } from '../functions/territory-style'
import {
  BATTLE_PERIOD_LABELS,
  BATTLE_PERIODS,
  battleRowsFrom,
  battlesPath,
  countByStatus,
  feedBadge,
  feedLine,
  filterBattlesByPeriod,
  liveBattles,
} from '../functions/battles'

/*
 * The live battle feed, natively. Thirteenth screen.
 *
 * Public, unlike every other screen here: `/api/territories/battles` answers
 * without a viewer, and only `?mine=1` needs one. So this does not gate on a
 * token — a signed-out athlete sees the game being played, which is most of
 * the argument for the page existing. The token is still sent when there is
 * one, because the endpoint hides blocked athletes from a viewer it knows.
 *
 * Narrower than the web page: no "near me" scope. That reads a location, and
 * the period filter is the one that changes what is worth looking at. The
 * voice is the feed's — `feedBadge`/`feedLine` rather than the second-person
 * `ownBadge`/`ownLine` the conquests screen uses, which is the distinction
 * the two web pages used to get wrong in opposite directions.
 */

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft

const PERIOD_OPTIONS = BATTLE_PERIODS.map(value => ({ value, label: BATTLE_PERIOD_LABELS[value] }))
const chosenPeriod = state<string>(BATTLE_PERIODS[0])
const rows = state<any[]>([])
const loading = state(true)
const error = state('')
const api = createNativeApi(craft)
let active = true

function period(): any {
  return chosenPeriod()
}

function shown(): any[] {
  return filterBattlesByPeriod(rows(), period())
}

function liveText(): string {
  const live = liveBattles(shown()).length
  return live === 1 ? '1 live battle' : `${live} live battles`
}

function conqueredText(): string {
  return String(countByStatus(shown(), 'conquered'))
}

function defendedText(): string {
  return String(countByStatus(shown(), 'defended'))
}

function lineText(battle: any): string {
  return feedLine(battle)
}

function badgeText(battle: any): string {
  return feedBadge(battle)
}

function groundText(battle: any): string {
  return formatTerritoryArea(battle.areaCaptured)
}

function emptyText(): string {
  return period() === 'today'
    ? 'Nobody has fought over anything today.'
    : 'No battles in this stretch.'
}

function openTerritory(battle: any): void {
  craft.navigation.open(`/territory/${battle.territory_id}`)
}

let loadVersion = 0
async function load(): Promise<void> {
  const currentLoad = ++loadVersion
  loading.set(true)
  error.set('')
  try {
    const result = await api.send(battlesPath())
    if (!active || currentLoad !== loadVersion)
      return
    if (!result.ok)
      throw new Error('Could not load the battle feed')

    rows.set(battleRowsFrom(result.body))
  }
  catch (cause) {
    if (active && currentLoad === loadVersion)
      error.set(cause instanceof Error ? cause.message : 'Could not load the battle feed')
  }
  finally {
    if (active && currentLoad === loadVersion)
      loading.set(false)
  }
}

onMount(() => {
  craft.navigation.setOptions({ title: 'Live battles', largeTitle: true })
  void load()
})

onDestroy(() => {
  active = false
})
onMount(() => onNativeAccountChange(craft, () => { rows.set([]); void load() }))
</script>

<SafeAreaView class="flex-1 bg-[#f2f4ef] dark:bg-[#101c16]">
  <ScrollView class="p-4" testID="battles-scroll">
    <Text class="mt-1 text-sm text-[#51604e] dark:text-[#b0bfac]">Ground changing hands across the game.</Text>

    <ActivityIndicator :show="loading" testID="battles-loading" class="mt-6" />
    <Text :show="error" testID="battles-error" class="mt-4 text-[#b4232a] dark:text-[#ff8487]" :text="error" />

    <View :show="!loading() && !error()" testID="battles-body" class="mt-5 gap-4">
      <SegmentedControl testID="battles-period" label="Period" stretch v-model:value="chosenPeriod" :options="PERIOD_OPTIONS" />

      <View class="flex-row gap-2">
        <View class="flex-1 rounded-xl bg-white dark:bg-[#1b2c22] p-3">
          <Text class="text-xs uppercase text-[#64745f] dark:text-[#91a28b]">Live</Text>
          <Text testID="battles-live" class="text-base font-semibold text-[#192414] dark:text-[#f0f5ec]" :text="liveText()" />
        </View>
        <View class="flex-1 rounded-xl bg-white dark:bg-[#1b2c22] p-3">
          <Text class="text-xs uppercase text-[#64745f] dark:text-[#91a28b]">Taken</Text>
          <Text testID="battles-conquered" class="text-2xl font-bold text-[#192414] dark:text-[#f0f5ec]" :text="conqueredText()" />
        </View>
        <View class="flex-1 rounded-xl bg-white dark:bg-[#1b2c22] p-3">
          <Text class="text-xs uppercase text-[#64745f] dark:text-[#91a28b]">Held</Text>
          <Text testID="battles-defended" class="text-2xl font-bold text-[#192414] dark:text-[#f0f5ec]" :text="defendedText()" />
        </View>
      </View>

      <Text :show="shown().length === 0" testID="battles-empty" class="mt-2 text-sm text-[#51604e] dark:text-[#b0bfac]" :text="emptyText()" />

      <View :show="shown().length > 0" class="gap-2">
        <Text class="text-xs font-semibold uppercase text-[#64745f] dark:text-[#91a28b]">What is happening</Text>
        <Pressable :for="battle in shown()" :key="battle.id" testID="battle-row" @click="openTerritory(battle)" class="gap-1 rounded-xl bg-white dark:bg-[#1b2c22] p-3">
          <View class="flex-row justify-between">
            <Text class="flex-1 text-sm text-[#192414] dark:text-[#f0f5ec]" :text="lineText(battle)" />
            <Text testID="battle-badge" class="text-xs text-[#51604e] dark:text-[#b0bfac]" :text="badgeText(battle)" />
          </View>
          <Text testID="battle-ground" class="text-xs text-[#64745f] dark:text-[#91a28b]" :text="groundText(battle)" />
        </Pressable>
      </View>
    </View>
  </ScrollView>
</SafeAreaView>
