<script client lang="ts">
import type { NativeCraft } from '@stacksjs/stx/native'
import { mobileMenuGroups } from '../functions/mobile-menu'
import { requireNativeAccount } from '../functions/native-session'
import { nativeUi as ui } from '../functions/native-ui'
const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft
{{-- Every item in the list is behind an account, and so is the menu itself:
     the guard sends a viewer without one to Login before they read it. So
     there is no signed-out shape left to draw, and nothing here has to wait
     on a keychain round trip to know which shape to draw. `mobileMenuGroups`
     keeps its argument for the web app, which still has public pages. --}}
function groups(): { title: string, items: any[] }[] { return mobileMenuGroups(true) }
onMount(() => {
  craft.navigation.setOptions({ title: 'Menu', largeTitle: true })
  {{-- From `onAppear`, not from here: the shell prepares this tab hidden
       beside the Feed at launch, and a guard that ran at mount would push
       Login over the Feed. --}}
  const appear = craft.navigation.onAppear(() => { void requireNativeAccount(craft, '/menu') })
  return () => { appear?.() }
})
</script>
<View :class="ui.screen">
  <ScrollView class="flex-1 pb-6" testID="native-menu">
    <View :for="group in groups()" :key="group.title">
      <Text :class="ui.header" :text="group.title" />
      <View :class="ui.card">
        <Pressable :for="item in group.items" :key="item.href" :class="ui.row" :testID="'menu-' + item.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')" @click="craft.navigation.open(item.href)" :accessibilityLabel="item.label">
          <Icon :name="item.symbol" class="h-6 w-6 text-accent" />
          <Text :class="ui.body" class="flex-1" :text="item.label" />
          <Icon name="chevron.right" class="h-4 w-4 text-fg-soft" />
        </Pressable>
      </View>
    </View>
  </ScrollView>
</View>
