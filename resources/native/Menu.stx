<script client lang="ts">
import type { NativeCraft } from '@stacksjs/stx/native'
import { mobileMenuGroups } from '../functions/mobile-menu'
import { nativeAccountId, onNativeAccountChange } from '../functions/native-api'
import { nativeUi as ui } from '../functions/native-ui'
const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft
{{-- The snapshot, not the keychain: the id is already in memory, and a menu
     that waited on a round trip would draw the signed-out shape first and
     rearrange itself a moment later. --}}
const account = state(nativeAccountId(craft))
function groups(): { title: string, items: any[] }[] { return mobileMenuGroups(account() > 0) }
onMount(() => {
  craft.navigation.setOptions({ title: 'Menu', largeTitle: true })
  {{-- Signing in happens on another screen, so the menu re-reads on the way
       back rather than only when the account id changes under it. --}}
  const appear = craft.navigation.onAppear(() => account.set(nativeAccountId(craft)))
  const changed = onNativeAccountChange(craft, () => account.set(nativeAccountId(craft)))
  return () => { appear?.(); changed() }
})
</script>
<View :class="ui.screen">
  <ScrollView class="flex-1 pb-6" testID="native-menu">
    {{-- A guest is told what an account is for and given one way to get one.
         Everything behind it has already been filtered out of the list below,
         so this is the only mention of an account on the screen. --}}
    <View :show="account() === 0" testID="menu-signed-out" :class="ui.card" class="mt-4 p-4">
      <Text class="text-base font-semibold text-[#192414] dark:text-[#f0f5ec]">Your runs, trails and territory, on every device.</Text>
      <Button testID="menu-sign-in" :class="ui.action" class="mt-4" @click="craft.navigation.open('/login?next=/menu')" title="Sign in" />
    </View>
    <View :for="group in groups()" :key="group.title">
      <Text :class="ui.header" :text="group.title" />
      <View :class="ui.card">
        <Pressable :for="item in group.items" :key="item.href" :class="ui.row" :testID="'menu-' + item.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')" @click="craft.navigation.open(item.href)" :accessibilityLabel="item.label">
          <Icon :name="item.symbol" class="h-6 w-6 text-[#24724b] dark:text-[#9be579]" />
          <Text :class="ui.body" class="flex-1" :text="item.label" />
          <Icon name="chevron.right" class="h-4 w-4 text-[#75856f]" />
        </Pressable>
      </View>
    </View>
  </ScrollView>
</View>
