<script client lang="ts">
import type { NativeCraft } from '@stacksjs/stx/native'
import { createNativeApi } from '../functions/native-api'
import { nativeBasemap, nativeBasemapOptions } from '../functions/native-basemaps'
import { chooseNativeChoice, nativeChoiceLabel } from '../functions/native-choice'
import { nativeUi as ui } from '../functions/native-ui'
import { normalizeTrailsPayload } from '../assets/scripts/trail-data'
import { decodeRouteParts } from '../functions/trail-geometry'
import { nativeMapParts, nativeRouteRegion, nativeZoomRegion } from '../functions/native-map'
import { trailheadPosition, trailDirectionSigns, trailRouteStyle } from '../functions/trail-map'
import { trailProfilePath, trailProfileRange, type TrailProfilePoint } from '../functions/trail-profile'
import { exportNativeGpx } from '../functions/native-export'
import { planDirections } from '../functions/trip-plans'

const craft = (globalThis as typeof globalThis & { craft: NativeCraft }).craft
const id = Number(craft.route.params.id)
const trail = state<any>(null)
const parts = state<number[][]>([])
const profile = state<TrailProfilePoint[]>([])
const region = state<any>(null)
const loading = state(true)
const error = state('')
const mapType = state('outdoors')
const basemap = derived(() => nativeBasemap(mapType()))
const pitch = state(0)
const heading = state(0)
const showLocation = state(false)
const profileOpen = state(true)
const profilePosition = state(0)
const inspected = state<TrailProfilePoint | null>(null)
const trailhead = derived(() => trailheadPosition(nativeMapParts(parts()), trail()))
const signs = derived(() => trailDirectionSigns(nativeMapParts(parts()), 12))
const figures = derived(() => trailProfileRange(profile()))
const currentRegion = derived(() => region() ?? nativeRouteRegion(parts(), { lat: trail()?.lat ?? 0, lng: trail()?.lng ?? 0 }))
let alive = true
function fit() { region.set(null); inspected.set(null); profilePosition.set(0) }
function camera(event: any) {
  if (!event?.center || !event?.span) return
  region.set({ center: event.center, span: event.span })
  heading.set(Number(event.heading) || 0)
  pitch.set(Number(event.pitch) || 0)
}
function inspect(event: any) {
  const position = Math.round(Number(event?.value) || 0)
  const point = profile()[position]
  if (!point) return
  profilePosition.set(position)
  inspected.set(point)
  region.set({ ...currentRegion(), center: { latitude: point.lat, longitude: point.lng } })
}
async function locate() {
  error.set('')
  try {
    if (!craft.location) throw new Error('Location is unavailable in this app build.')
    const point = await craft.location.getCurrentPosition({ enableHighAccuracy: true, timeout: 15000 })
    showLocation.set(true)
    region.set({ ...currentRegion(), center: { latitude: point.latitude, longitude: point.longitude } })
  }
  catch (cause) { error.set(cause instanceof Error ? cause.message : 'Your position could not be found.') }
}
async function exportRoute() {
  try { await exportNativeGpx(craft, trail()?.name ?? 'Trail', nativeMapParts(parts())) }
  catch (cause) { error.set(cause instanceof Error ? cause.message : 'The route could not be exported.') }
}
async function directions() {
  const links = planDirections({ latitude: trailhead()?.lat, longitude: trailhead()?.lng, activity_type: null })
  if (links) {
    try {
      if (!await craft.linking?.openURL(craft.platform === 'ios' ? links.apple : links.google))
        throw new Error('Directions could not be opened.')
    }
    catch { error.set('Directions could not be opened.') }
  }
}
let loadVersion = 0
async function load() {
  const currentLoad = ++loadVersion
  try {
    const api = createNativeApi(craft)
    const response = await api.send(`/api/trails/${id}`)
    if (!alive || currentLoad !== loadVersion) return
    if (!response.ok) throw new Error('The trail could not be loaded. Go back and try again.')
    const row = normalizeTrailsPayload(response.body).trails[0]
    if (!row) throw new Error('This trail has no recorded trailhead.')
    trail.set(row)
    const raw = response.body.trail
    parts.set([...decodeRouteParts(raw.geometry), ...(Array.isArray(raw.pieceRoutes) ? raw.pieceRoutes : [])].map(part => part.flat()))
    craft.navigation.setOptions({ title: row.name, largeTitle: false })
    const elevations = await api.send(`/api/trails/${id}/profile`)
    if (alive && currentLoad === loadVersion) profile.set(elevations.ok ? elevations.body.points ?? [] : [])
  }
  catch (cause) { if (alive && currentLoad === loadVersion) error.set(cause instanceof Error ? cause.message : 'The map could not be loaded.') }
  finally { if (alive && currentLoad === loadVersion) loading.set(false) }
}
onMount(() => { void load(); return () => { alive = false } })
</script>
<View :class="ui.screen">
  <View class="relative flex-1 overflow-hidden" testID="trail-map-screen">
    <Map :show="trail()" class="absolute inset-0 w-full h-full" testID="trail-full-map"
      :region="parts().some(part=>part.length>2) ? region() : currentRegion()" :fitToBounds="region() === null && parts().some(part=>part.length>2)" :edgePadding="{top:88,left:40,right:40,bottom:profileOpen() ? 240 : 100}"
      :mapType="basemap().mapType" :tileOverlay="basemap().tileOverlay" :cameraPitch="pitch" :cameraHeading="heading" :showsCompass="true" :showsScale="true" :scrollEnabled="true" :zoomEnabled="true" :rotateEnabled="true" :showsUserLocation="showLocation"
      @region-change-complete="camera($event)">
      <MapPolyline :for="(part,index) in parts()" :key="'route-outline-' + index" :id="'route-outline-' + index" :geometry="part" :strokeColor="trailRouteStyle.casing" :strokeWidth="9" />
      <MapPolyline :for="(part,index) in parts()" :key="index" :id="'route-' + index" :geometry="part" :strokeColor="trailRouteStyle.line" :strokeWidth="5" />
      <MapMarker :for="(sign,index) in signs()" :key="index" :id="'direction-' + index" :geometry="sign.point" :bearing="sign.bearing" title="Recorded route direction" />
      <MapMarker id="trailhead" title="Trailhead" :geometry="[trailhead()?.lat, trailhead()?.lng]" />
      <MapMarker :show="inspected()" id="elevation-point" title="Elevation position" :geometry="[inspected()?.lat, inspected()?.lng]" />
    </Map>
    <View class="absolute top-3 left-3 right-3 flex-row flex-wrap gap-2">
      <Button testID="map-layer" class="bg-white dark:bg-[#1b2c22] rounded-[16px]" :class="ui.secondary" :title="'Map layer' + ': ' + nativeChoiceLabel(nativeBasemapOptions,mapType())" accessibilityLabel="Map layer" :accessibilityValue="nativeChoiceLabel(nativeBasemapOptions,mapType())" @click="chooseNativeChoice(craft,'Map layer',nativeBasemapOptions,choice=>{mapType.set(choice)},message=>error.set(message))" />
      <Button testID="map-3d" :class="ui.secondary" :text="pitch() ? '2D' : '3D'" @click="pitch.set(pitch() ? 0 : 45)" />
      <Button testID="map-north" :class="ui.secondary" @click="heading.set(0)">North</Button>
    </View>
    <View class="absolute bottom-5 left-3 right-3 rounded-[20px] bg-white dark:bg-[#1b2c22] p-3 shadow-lg" testID="map-floating-profile">
      <View class="flex-row justify-between items-center">
        <Text :class="ui.title">Elevation profile</Text>
        <Button testID="map-profile-toggle" class="h-11 min-w-[44px] text-[15px] font-semibold text-[#253321] dark:text-[#e3ecdf]" :accessibilityValue="profileOpen() ? 'Elevation profile expanded' : 'Elevation profile collapsed'" :text="profileOpen() ? 'Hide' : 'Show'" @click="profileOpen.set(!profileOpen())" accessibilityLabel="Toggle elevation profile" />
      </View>
      <View :show="profileOpen">
        <svg :show="profile().some(point => point.ft !== null)" viewBox="0 0 1000 108" class="h-16 w-full text-[#253321] dark:text-[#e3ecdf]" preserveAspectRatio="none">
          <path d="M8,54 L992,54 M8,104 L992,104" fill="none" stroke="currentColor" stroke-opacity="0.12" stroke-dasharray="4 4" stroke-width="1" vector-effect="non-scaling-stroke" />
          <path :d="trailProfilePath(profile())" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />
        </svg>
        <View :show="profile().some(point => point.ft !== null)" class="flex-row justify-between">
          <Text :class="ui.caption">0.0 mi</Text><Text :class="ui.caption" :text="(figures().miles / 2).toFixed(1) + ' mi'" /><Text :class="ui.caption" :text="figures().miles.toFixed(1) + ' mi'" />
        </View>
        <Text testID="map-profile-unavailable" :show="!loading() && !profile().some(point => point.ft !== null)" :class="ui.caption">Elevation data is unavailable for this route.</Text>
        <Text testID="map-profile-range" :show="profile().some(point => point.ft !== null)" :text="figures().miles.toFixed(1) + ' mi · ' + Math.round(figures().low) + '–' + Math.round(figures().high) + ' ft'" :class="ui.caption" />
        <Slider testID="map-elevation-slider" :show="profile().length > 1" :value="profilePosition" :minimumValue="0" :maximumValue="Math.max(0,profile().length - 1)" :step="1" @change="inspect($event)" accessibilityLabel="Explore elevation and position along the route" />
        <Text :show="inspected()" :text="inspected()?.mi.toFixed(2) + ' mi · ' + (inspected()?.ft === null ? 'elevation unavailable' : inspected()?.ft + ' ft')" :class="ui.caption" />
      </View>
    </View>
    <ActivityIndicator :show="loading" class="absolute top-24 left-4" />
  </View>
  <Text :show="error" :text="error" :class="ui.danger" class="mx-4 my-2" testID="map-error" />
  <View class="bg-white dark:bg-[#1b2c22] p-2 gap-2" testID="map-actions">
    <View class="flex-row gap-2">
      <Button testID="map-fit" class="flex-1" :class="ui.secondary" @click="fit()">Fit route</Button>
      <Button testID="map-zoom-in" class="w-11" :class="ui.secondary" @click="region.set(nativeZoomRegion(currentRegion(),0.5))" accessibilityLabel="Zoom in">+</Button>
      <Button testID="map-zoom-out" class="w-11" :class="ui.secondary" @click="region.set(nativeZoomRegion(currentRegion(),2))" accessibilityLabel="Zoom out">−</Button>
      <Button testID="map-locate" class="flex-1" :class="ui.secondary" :accessibilityValue="showLocation() ? 'Your location is shown' : ''" @click="locate()">My location</Button>
    </View>
    <View class="flex-row gap-2">
      <Button testID="map-export" class="flex-1" :class="ui.secondary" @click="exportRoute()">Export GPX</Button>
      <Button testID="map-directions" class="flex-1" :class="ui.secondary" @click="directions()">Directions</Button>
      <Button testID="map-customize" class="flex-1" :class="ui.secondary" @click="craft.navigation.open('/routes?trail=' + id)">Customize</Button>
    </View>
  </View>
</View>
