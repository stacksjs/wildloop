{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "module": "esnext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "strict": false,
    "strictNullChecks": false,
    "noUncheckedIndexedAccess": false,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": false,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "Actions/*": ["./app/Actions/*"],
      "Commands/*": ["./app/Commands/*"],
      "Jobs/*": ["./app/Jobs/*"],
      "Middleware/*": ["./app/Middleware/*"],
      "Models/*": ["./app/Models/*"],
      "Notifications/*": ["./app/Notifications/*"],
      "stx": ["./node_modules/@stacksjs/stx/dist/index.d.ts"],
      "~/*": ["./*"],
      "@/*": ["./resources/*"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "app/Models/**/*.ts",
    "config/integrations.ts",
    "app/Support/searchSuggest.ts",
    "app/Support/trailPhotoProcessing.ts",
    "app/Support/photoStorage.ts",
    "app/Support/trailPhotoPayload.ts",
    "resources/assets/scripts/auth.ts",
    "resources/assets/scripts/game-api.ts",
    "resources/assets/scripts/offline-trails.ts",
    "resources/assets/scripts/pwa.ts",
    "resources/assets/scripts/privacy-defaults.ts",
    "resources/assets/scripts/run-upload-queue.ts",
    "resources/composables/**/*.ts",
    "resources/functions/**/*.ts",
    "tests/unit/activity-files.test.ts",
    "tests/unit/activity-share.test.ts",
    "tests/unit/activity-integrity.test.ts",
    "tests/unit/privacy.test.ts",
    "tests/unit/session-identity.test.ts",
    "tests/unit/territory-battle.test.ts",
    "tests/unit/game-integrity-schema.test.ts",
    "tests/unit/search-suggest.test.ts",
    "tests/unit/trail-photo-processing.test.ts",
    "tests/unit/photo-storage.test.ts",
    "tests/unit/trail-photo-payload.test.ts",
    "tests/unit/password-change.test.ts",
    "tests/unit/native-tab-item.test.ts",
    "tests/unit/native-conditional-rendering.test.ts",
    "tests/unit/review-difficulty.test.ts",
    "tests/unit/session-tokens.test.ts",
    "tests/unit/session-requests.test.ts",
    "tests/unit/account-deletion.test.ts",
    "tests/unit/battle-rows.test.ts",
    "tests/unit/toggle-intent.test.ts",
    "tests/unit/native-shell-ready.test.ts"
  ],
  "exclude": [
    "cloud/**",
    "dist/**",
    "node_modules/**",
    "pantry/**",
    "storage/framework/defaults/**",
    "resources/functions/dark.ts",
    "resources/functions/counter.ts"
  ]
}
